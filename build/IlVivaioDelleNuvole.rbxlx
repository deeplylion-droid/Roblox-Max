      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">EventBus</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Bus di eventi interno del server: i servizi reagiscono senza dipendere l'uno dall'altro.
local Signal = require(game:GetService("ReplicatedStorage").Shared.Util.Signal)

local EventBus = { _signals = {} }

function EventBus.Get(name)
	local s = EventBus._signals[name]
	if not s then
		s = Signal.new()
		EventBus._signals[name] = s
	end
	return s
end

function EventBus.Fire(name, ...)
	EventBus.Get(name):Fire(...)
end

function EventBus.On(name, fn)
	return EventBus.Get(name):Connect(fn)
end

--[[
	Eventi usati:
	ProfileLoaded(player, profile)         ProfileReleasing(player, profile)
	SparksCollected(player, amount)        SparksDeposited(player, amount)
	SparksSpent(player, amount, reason)    CreaturePlaced(player, uid, moved)
	CreatureUnlocked(player, creatureId)   VariantUnlocked(player, creatureId, variantId)
	LayoutPublished(player, moduleCount)   LayoutTested(player)
	DecorationPlaced(player, decoId)       RaidCompleted(player, summary)
	RaidDefended(player, amount)           RaidLost(player, amount)
	Visited(player, key)                   Liked(player, key)
	DemoVisited(player)                    CommissionClaimed(player, templateId)
	AlbumMilestone(player, milestoneId)    MasteryTier(player, track, tier)
	TutorialStep(player, step)             TutorialCompleted(player)
	StatDelta(player, statName, delta)     ModuleUnlocked(player, moduleId)
]]

return EventBus
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="38">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Main (server): costruisce il mondo, registra e avvia i servizi.
	Ordine: Init di tutti (collega i remoti), poi Start di tutti (loop e connessioni agli eventi).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Util.Net)
local Config = require(Shared.Config)

local Registry = require(script.Parent.Registry)
local Logger = require(script.Parent.Util.Logger)
local WorldBuilder = require(script.Parent.World.WorldBuilder)

Net.Event("StateSync") -- crea la cartella dei remoti

WorldBuilder.Build()

local servicesFolder = script.Parent.Services
local ORDER = {
	"DataService", "PlayerService", "StatsService", "PoolStore", "EconomyService", "PlotService", "DefenseService",
	"CommissionService", "AlbumService", "CocoonService", "GalleryService", "RaidService", "ShopService",
	"TutorialService", "ThemeService", "AnalyticsService",
}

local services = {}
for _, name in ipairs(ORDER) do
	local module = servicesFolder:FindFirstChild(name)
	assert(module, "Servizio mancante: " .. name)
	local service = require(module)
	services[name] = service
	Registry.Register(name, service)
end

for _, name in ipairs(ORDER) do
	local s = services[name]
	if s.Init then
		local ok, err = pcall(s.Init)
		if not ok then
			Logger.Warn("Main", "Init fallita per", name, err)
		end
	end
end
-- DataService per ultimo: i profili già presenti (Studio) devono trovare tutti i listener pronti
local START_ORDER = table.clone(ORDER)
table.remove(START_ORDER, table.find(START_ORDER, "DataService"))
table.insert(START_ORDER, "DataService")
for _, name in ipairs(START_ORDER) do
	local s = services[name]
	if s.Start then
		local ok, err = pcall(s.Start)
		if not ok then
			Logger.Warn("Main", "Start fallito per", name, err)
		end
	end
end

Logger.Info("Main", Config.GameName .. " · server avviato")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Registro dei servizi: evita require circolari. I servizi si ottengono a runtime.
local Registry = { _services = {} }

function Registry.Register(name, service)
	Registry._services[name] = service
end

function Registry.Get(name)
	local s = Registry._services[name]
	assert(s, "Servizio non registrato: " .. tostring(name))
	return s
end

return Registry
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">AlbumService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	AlbumService: traguardi dell'album (per famiglia e globali), tre tracce di maestria
	(Collezione, Incursione, Difesa) con tier, sblocco varianti cromatiche e deposito automatico.
	Tutte le ricompense sono idempotenti (Album.Claimed / Mastery.ClaimedTiers).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Album = require(Shared.Catalog.Album)
local Creatures = require(Shared.Catalog.Creatures)
local Cosmetics = require(Shared.Catalog.Cosmetics)
local Net = require(Shared.Util.Net)

local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)
local Guard = require(script.Parent.Parent.Util.Guard)

local AlbumService = {}

local function ownedCounts(profile)
	local byFamily = { sole = 0, pioggia = 0, vento = 0, aurora = 0 }
	local total = 0
	for id in pairs(profile.OwnedCreatureIds) do
		local def = Creatures.Get(id)
		if def then
			byFamily[def.Family] += 1
			total += 1
		end
	end
	return byFamily, total
end

function AlbumService.IsMilestoneReached(profile, m)
	local byFamily, total = ownedCounts(profile)
	if m.Family then
		return byFamily[m.Family] >= m.Count
	end
	return total >= m.Count
end

local function grantReward(player, profile, reward, reason)
	local eco = Registry.Get("EconomyService")
	eco.GrantFragments(player, profile, reward.Fragments, reason)
	eco.GrantTokens(player, profile, reward.Tokens, reason)
	eco.GrantSafe(player, profile, reward.Sparks or 0, reason)
	if reward.Decoration then
		eco.GrantDecoration(player, profile, reward.Decoration)
	end
	if reward.Cosmetic then
		Registry.Get("ShopService").GrantCosmetic(player, profile, reward.Cosmetic, reason)
	end
end

function AlbumService.ClaimMilestone(player, milestoneId)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	milestoneId = Guard.Str(milestoneId, 32)
	local m = milestoneId and Album.ById[milestoneId]
	if not m then
		return false, Strings.Error
	end
	if profile.Album.Claimed[milestoneId] then
		return false, "Già riscosso"
	end
	if not AlbumService.IsMilestoneReached(profile, m) then
		return false, "Traguardo non raggiunto"
	end
	profile.Album.Claimed[milestoneId] = true
	grantReward(player, profile, m.Reward, "album:" .. milestoneId)
	profile.Pass.Points += Cosmetics.Pass.PointsPerAlbumMilestone
	profile.StyleTokens += Config.StyleTokens.PerAlbumMilestone
	EventBus.Fire("AlbumMilestone", player, milestoneId)
	Registry.Get("PlayerService").Sync(player, "Album", "Pass", "StyleTokens", "Decorations", "Cosmetics")
	Registry.Get("PlayerService").Sound(player, "Success")
	Registry.Get("PlayerService").Toast(player, "Traguardo dell'album: " .. m.Title, "success")
	return true
end

-- ───────────────────────── maestria ─────────────────────────

local function unlockVariantsForTier(player, profile, track, tier)
	for _, c in ipairs(Creatures.List) do
		if profile.OwnedCreatureIds[c.Id] then
			for _, v in ipairs(c.Variants) do
				if v.Unlock.Kind == "mastery" and v.Unlock.Track == track and v.Unlock.Tier <= tier then
					profile.UnlockedVariants[c.Id] = profile.UnlockedVariants[c.Id] or { base = true }
					if not profile.UnlockedVariants[c.Id][v.Id] then
						profile.UnlockedVariants[c.Id][v.Id] = true
						profile.Mastery.Collection += Config.Mastery.CollectionPerVariant
						EventBus.Fire("VariantUnlocked", player, c.Id, v.Id)
						Registry.Get("PlayerService").Toast(player, string.format(Strings.NewVariant, c.Name, v.Name), "success")
					end
				end
			end
		end
	end
end

local function unlockActivityVariants(player, profile)
	for _, c in ipairs(Creatures.List) do
		if profile.OwnedCreatureIds[c.Id] then
			for _, v in ipairs(c.Variants) do
				if v.Unlock.Kind == "activity" and (profile.Stats[v.Unlock.Stat] or 0) >= v.Unlock.Value then
					profile.UnlockedVariants[c.Id] = profile.UnlockedVariants[c.Id] or { base = true }
					if not profile.UnlockedVariants[c.Id][v.Id] then
						profile.UnlockedVariants[c.Id][v.Id] = true
						profile.Mastery.Collection += Config.Mastery.CollectionPerVariant
						EventBus.Fire("VariantUnlocked", player, c.Id, v.Id)
						Registry.Get("PlayerService").Toast(player, string.format(Strings.NewVariant, c.Name, v.Name), "success")
					end
				end
			end
		end
	end
end

-- Controlla se una traccia ha raggiunto un nuovo tier e assegna i premi (idempotente)
function AlbumService.CheckMastery(player, profile)
	local changed = false
	for _, track in ipairs({ "Collection", "Raid", "Defense" }) do
		local tier = Album.TierFor(profile.Mastery[track], Config.Mastery.Tiers)
		local claimed = profile.Mastery.ClaimedTiers[track] or 0
		while claimed < tier do
			claimed += 1
			profile.Mastery.ClaimedTiers[track] = claimed
			local reward = Album.MasteryRewards[track][claimed]
			if reward then
				Registry.Get("EconomyService").GrantFragments(player, profile, reward.Fragments, "mastery")
				Registry.Get("EconomyService").GrantTokens(player, profile, (reward.Tokens or 0) + Config.StyleTokens.PerMasteryTier, "mastery")
				if reward.Unlock == "AutoDeposit" then
					profile.AutoDepositUnlocked = true
					Registry.Get("PlayerService").Toast(player, "Deposito automatico sbloccato! Attivalo dalle Opzioni.", "success")
				end
				Registry.Get("PlayerService").Toast(player, string.format("Maestria %s · Tier %d: %s", Strings["Mastery" .. track] or track, claimed, reward.Title), "success")
			end
			unlockVariantsForTier(player, profile, track, claimed)
			EventBus.Fire("MasteryTier", player, track, claimed)
			changed = true
		end
	end
	if changed then
		Registry.Get("PlayerService").Sync(player, "Mastery", "AutoDepositUnlocked", "UnlockedVariants")
	end
end

function AlbumService.AddMastery(player, track, points)
	local profile = Registry.Get("DataService").Get(player)
	if not profile or points <= 0 then
		return
	end
	profile.Mastery[track] += points
	Registry.Get("PlayerService").Sync(player, "Mastery")
	AlbumService.CheckMastery(player, profile)
end

-- Vista (per il client): traguardi con stato
function AlbumService.View(profile)
	local out = {}
	for _, m in ipairs(Album.List) do
		table.insert(out, { Id = m.Id, Family = m.Family, Count = m.Count, Title = m.Title, Reward = m.Reward, Reached = AlbumService.IsMilestoneReached(profile, m), Claimed = profile.Album.Claimed[m.Id] == true })
	end
	return out
end

function AlbumService.Init()
	Net.Function("ClaimAlbumMilestone").OnServerInvoke = AlbumService.ClaimMilestone
end

function AlbumService.Start()
	EventBus.On("CreatureUnlocked", function(player, creatureId)
		local profile = Registry.Get("DataService").Get(player)
		if not profile then
			return
		end
		profile.Mastery.Collection += Config.Mastery.CollectionPerCreature
		-- varianti già meritate per i tier raggiunti
		for _, track in ipairs({ "Collection", "Raid", "Defense" }) do
			unlockVariantsForTier(player, profile, track, profile.Mastery.ClaimedTiers[track] or 0)
		end
		unlockActivityVariants(player, profile)
		AlbumService.CheckMastery(player, profile)
		Registry.Get("PlayerService").Sync(player, "Mastery", "UnlockedVariants", "Album")
		-- notifica traguardi raggiunti
		for _, m in ipairs(Album.List) do
			if not profile.Album.Claimed[m.Id] and AlbumService.IsMilestoneReached(profile, m) then
				Registry.Get("PlayerService").Toast(player, "Traguardo raggiunto: " .. m.Title .. " (riscuoti nell'Album)", "info")
			end
		end
	end)
	EventBus.On("RaidDefended", function(player)
		local profile = Registry.Get("DataService").Get(player)
		if profile then
			unlockActivityVariants(player, profile)
			Registry.Get("PlayerService").Sync(player, "UnlockedVariants")
		end
	end)
	EventBus.On("ProfileLoaded", function(player, profile)
		AlbumService.CheckMastery(player, profile)
		unlockActivityVariants(player, profile)
	end)
end

return AlbumService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">AnalyticsService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	AnalyticsService: metriche del GDD §8 (completamento tutorial, prima azione, raid,
	abbandono dopo perdita). Usa AnalyticsService di Roblox con pcall; in Studio stampa.
]]
local RobloxAnalytics = game:GetService("AnalyticsService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)

local Analytics = {}
local lastLoss = {} -- player -> timestamp dell'ultima perdita da raid

function Analytics.Log(player, eventName, value)
	if RunService:IsStudio() then
		print(string.format("[Analytics] %s %s %s", player and player.Name or "-", eventName, tostring(value)))
	end
	pcall(function()
		RobloxAnalytics:LogCustomEvent(player, eventName, value or 1)
	end)
end

function Analytics.Funnel(player, funnelName, step)
	if RunService:IsStudio() then
		print(string.format("[Analytics] funnel %s step %d (%s)", funnelName, step, player.Name))
	end
	pcall(function()
		RobloxAnalytics:LogFunnelStepEvent(player, funnelName, nil, step, "step_" .. step)
	end)
end

function Analytics.Init() end

function Analytics.Start()
	EventBus.On("RaidCompleted", function(player, summary)
		Analytics.Log(player, summary.Success and "raid_success" or "raid_fail", summary.Duration)
	end)
	EventBus.On("RaidLost", function(player, amount)
		lastLoss[player] = os.time()
		Analytics.Log(player, "raid_loss_received", amount)
	end)
	EventBus.On("RaidDefended", function(player, amount)
		Analytics.Log(player, "raid_defended", amount)
	end)
	EventBus.On("LayoutPublished", function(player, count)
		Analytics.Log(player, "layout_published", count)
	end)
	EventBus.On("CommissionClaimed", function(player)
		Analytics.Log(player, "commission_claimed", 1)
	end)
	Players.PlayerRemoving:Connect(function(player)
		local t = lastLoss[player]
		if t and os.time() - t < 120 then
			Analytics.Log(player, "quit_within_2min_of_loss", os.time() - t)
		end
		lastLoss[player] = nil
	end)
end

return Analytics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">CocoonService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	CocoonService: ottenimento deterministico delle creature. Il giocatore sceglie una famiglia,
	vede in anteprima la creatura che otterrà (la prossima mancante) e l'obiettivo di sblocco,
	paga in frammenti e completa l'obiettivo giocando. Nessuna casualità, nessun doppione.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Creatures = require(Shared.Catalog.Creatures)
local TimeUtil = require(Shared.Util.TimeUtil)
local Net = require(Shared.Util.Net)

local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)
local Guard = require(script.Parent.Parent.Util.Guard)

local CocoonService = {}

-- Obiettivi possibili, scalati per ordine di sblocco (1..4) della creatura
local GOALS = {
	{ Id = "collect", Text = "Raccogli %d scintille", Event = "SparksCollected", Base = 250 },
	{ Id = "deposit", Text = "Deposita %d scintille", Event = "SparksDeposited", Base = 200 },
	{ Id = "commissions", Text = "Completa %d commissioni", Event = "CommissionClaimed", Base = 1, Step = 1 },
	{ Id = "raids", Text = "Completa %d incursioni (anche simulate)", Event = "RaidCompleted", Base = 1, Step = 1 },
}

local function goalFor(family, creature, userId)
	local rng = Random.new(TimeUtil.Hash(family .. creature.Id .. userId))
	local g = GOALS[rng:NextInteger(1, #GOALS)]
	local order = creature.UnlockOrder
	local target
	if g.Step then
		target = g.Base + (order - 1) * g.Step
	else
		target = math.floor(g.Base * (1 + (order - 1) * 0.6))
	end
	return { Id = g.Id, Text = string.format(g.Text, target), Target = target, Event = g.Event }
end

function CocoonService.Preview(player, family)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return nil
	end
	family = Guard.Str(family, 16)
	if not family or not Creatures.ByFamily[family] then
		return nil
	end
	local nextC = Creatures.NextMissingInFamily(family, profile.OwnedCreatureIds)
	if not nextC then
		return { Family = family, Complete = true }
	end
	local goal = goalFor(family, nextC, player.UserId)
	return {
		Family = family,
		CreatureId = nextC.Id,
		CreatureName = nextC.Name,
		Rarity = nextC.Rarity,
		Goal = goal,
		Cost = Config.Cocoon.FragmentCost,
		CanAfford = profile.Fragments >= Config.Cocoon.FragmentCost,
	}
end

function CocoonService.Begin(player, family)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	if profile.Cocoon.Active then
		return false, "Hai già un bozzolo attivo"
	end
	local preview = CocoonService.Preview(player, family)
	if not preview or preview.Complete then
		return false, Strings.CocoonFamilyComplete
	end
	if profile.Fragments < Config.Cocoon.FragmentCost then
		return false, Strings.CocoonNoFragments
	end
	profile.Fragments -= Config.Cocoon.FragmentCost
	profile.Cocoon.Active = {
		Family = family,
		CreatureId = preview.CreatureId,
		GoalId = preview.Goal.Id,
		GoalText = preview.Goal.Text,
		Event = preview.Goal.Event,
		Target = preview.Goal.Target,
		Progress = 0,
		StartedAt = os.time(),
	}
	Registry.Get("PlayerService").Sync(player, "Cocoon", "Fragments")
	Registry.Get("PlayerService").Sound(player, "Chime")
	Registry.Get("PlayerService").Toast(player, string.format("Bozzolo %s avviato: %s", Strings.Family[family], preview.Goal.Text), "info")
	return true
end

local function progress(player, eventName, amount)
	local profile = Registry.Get("DataService").Get(player)
	local active = profile and profile.Cocoon.Active
	if not active or active.Event ~= eventName then
		return
	end
	active.Progress = math.min(active.Target, active.Progress + (amount or 1))
	if active.Progress >= active.Target then
		local creatureId = active.CreatureId
		profile.Cocoon.Active = nil
		profile.Cocoon.Completed += 1
		-- se nel frattempo la creatura è stata ottenuta altrove, passa alla successiva mancante
		if profile.OwnedCreatureIds[creatureId] then
			local nextC = Creatures.NextMissingInFamily(active.Family, profile.OwnedCreatureIds)
			creatureId = nextC and nextC.Id or nil
		end
		if creatureId then
			Registry.Get("EconomyService").GrantCreature(player, profile, creatureId, true)
			local def = Creatures.Get(creatureId)
			Registry.Get("PlayerService").Sound(player, "Success")
			Registry.Get("PlayerService").Toast(player, string.format(Strings.CocoonComplete, def.Name), "success")
			Net.Event("RaidEvent"):FireClient(player, "CocoonHatched", { CreatureId = creatureId })
		end
	end
	Registry.Get("PlayerService").Sync(player, "Cocoon")
end

function CocoonService.Init()
	Net.Function("GetCocoonPreview").OnServerInvoke = CocoonService.Preview
	Net.Function("StartCocoon").OnServerInvoke = CocoonService.Begin
end

function CocoonService.Start()
	EventBus.On("SparksCollected", function(player, amount)
		progress(player, "SparksCollected", amount)
	end)
	EventBus.On("SparksDeposited", function(player, amount)
		progress(player, "SparksDeposited", amount)
	end)
	EventBus.On("CommissionClaimed", function(player)
		progress(player, "CommissionClaimed", 1)
	end)
	EventBus.On("RaidCompleted", function(player, summary)
		if not summary.Test then
			progress(player, "RaidCompleted", 1)
		end
	end)
end

return CocoonService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">CommissionService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	CommissionService: 3 commissioni giornaliere pescate da categorie diverse in modo
	deterministico (giorno + userId), una sostituzione gratuita, riscossione idempotente.
	Il progresso deriva dalle statistiche giornaliere (StatsService).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Commissions = require(Shared.Catalog.Commissions)
local Cosmetics = require(Shared.Catalog.Cosmetics)
local TimeUtil = require(Shared.Util.TimeUtil)
local TableUtil = require(Shared.Util.TableUtil)
local Net = require(Shared.Util.Net)

local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)
local Guard = require(script.Parent.Parent.Util.Guard)

local CommissionService = {}

local function pick(profile, player, excludeIds, rng)
	local tier = Registry.Get("EconomyService").Tier(profile)
	local categories = table.clone(Config.Commissions.Categories)
	TableUtil.Shuffle(categories, rng)
	local used = {}
	for _, c in ipairs(profile.Commissions.List) do
		used[c.Category] = true
	end
	for _, cat in ipairs(categories) do
		if not used[cat] then
			local pool = TableUtil.Filter(Commissions.ByCategory(cat, tier), function(t)
				return not excludeIds[t.Id]
			end)
			if #pool > 0 then
				local t = pool[rng:NextInteger(1, #pool)]
				return { Id = t.Id, Category = t.Category, Claimed = false }
			end
		end
	end
	return nil
end

local function ensureDaily(player, profile)
	local key = TimeUtil.DayKey()
	if profile.Commissions.DayKey == key and #profile.Commissions.List == Config.Commissions.DailyCount then
		return
	end
	profile.Commissions = { DayKey = key, List = {}, RerollsUsed = 0 }
	local rng = Random.new(TimeUtil.Hash(key .. ":" .. player.UserId))
	local exclude = {}
	for _ = 1, Config.Commissions.DailyCount do
		local c = pick(profile, player, exclude, rng)
		if c then
			exclude[c.Id] = true
			table.insert(profile.Commissions.List, c)
		end
	end
end

-- Vista inviata al client
function CommissionService.View(player, profile)
	ensureDaily(player, profile)
	local daily = Registry.Get("StatsService").Daily(profile)
	local list = {}
	for i, c in ipairs(profile.Commissions.List) do
		local t = Commissions.ById[c.Id]
		if t then
			local progress = math.min(daily[t.Stat] or 0, t.Target)
			table.insert(list, {
				Index = i,
				Id = t.Id,
				Category = t.Category,
				Text = Commissions.Describe(t),
				Progress = progress,
				Target = t.Target,
				Reward = t.Reward,
				Claimed = c.Claimed,
				Complete = progress >= t.Target,
			})
		end
	end
	return {
		DayKey = profile.Commissions.DayKey,
		List = list,
		RerollAvailable = profile.Commissions.RerollsUsed < Config.Commissions.FreeRerollsPerDay,
		SecondsToReset = TimeUtil.SecondsToNextDay(),
	}
end

function CommissionService.Claim(player, index)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	ensureDaily(player, profile)
	index = Guard.Int(index, 1, #profile.Commissions.List)
	local c = index and profile.Commissions.List[index]
	if not c then
		return false, Strings.Error
	end
	if c.Claimed then
		return false, Strings.CommissionClaimed
	end
	local t = Commissions.ById[c.Id]
	local daily = Registry.Get("StatsService").Daily(profile)
	if (daily[t.Stat] or 0) < t.Target then
		return false, "Commissione non completata"
	end
	local ledgerId = "comm:" .. profile.Commissions.DayKey .. ":" .. index .. ":" .. c.Id
	if profile.Ledger[ledgerId] then
		c.Claimed = true
		return false, Strings.CommissionClaimed
	end
	profile.Ledger[ledgerId] = true
	c.Claimed = true
	local eco = Registry.Get("EconomyService")
	eco.GrantSafe(player, profile, t.Reward.Sparks or 0, "commission")
	eco.GrantFragments(player, profile, t.Reward.Fragments, "commission")
	eco.GrantTokens(player, profile, Config.StyleTokens.PerCommission, "commission")
	profile.Pass.Points += Cosmetics.Pass.PointsPerCommission
	EventBus.Fire("CommissionClaimed", player, c.Id)
	Registry.Get("PlayerService").Sync(player, "Commissions", "Pass", "Fragments", "StyleTokens")
	Registry.Get("PlayerService").Sound(player, "Success")
	Registry.Get("PlayerService").Toast(player, string.format("Commissione completata! +%d scintille, +%d frammenti, +%d gettoni", t.Reward.Sparks or 0, t.Reward.Fragments or 0, Config.StyleTokens.PerCommission), "success")
	return true
end

function CommissionService.Reroll(player, index)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	ensureDaily(player, profile)
	if profile.Commissions.RerollsUsed >= Config.Commissions.FreeRerollsPerDay then
		return false, Strings.CommissionRerollUsed
	end
	index = Guard.Int(index, 1, #profile.Commissions.List)
	local c = index and profile.Commissions.List[index]
	if not c or c.Claimed then
		return false, Strings.Error
	end
	local exclude = {}
	for _, other in ipairs(profile.Commissions.List) do
		exclude[other.Id] = true
	end
	-- rimuove temporaneamente per liberare la categoria
	local removed = table.remove(profile.Commissions.List, index)
	local rng = Random.new(TimeUtil.Hash(profile.Commissions.DayKey .. ":reroll:" .. player.UserId .. ":" .. os.time()))
	local replacement = pick(profile, player, exclude, rng)
	if not replacement then
		-- nessuna categoria nuova: pesca nella stessa categoria
		local tier = Registry.Get("EconomyService").Tier(profile)
		local pool = TableUtil.Filter(Commissions.ByCategory(removed.Category, tier), function(t)
			return not exclude[t.Id]
		end)
		if #pool > 0 then
			local t = pool[rng:NextInteger(1, #pool)]
			replacement = { Id = t.Id, Category = t.Category, Claimed = false }
		end
	end
	if not replacement then
		table.insert(profile.Commissions.List, index, removed)
		return false, "Nessuna commissione alternativa disponibile"
	end
	table.insert(profile.Commissions.List, index, replacement)
	profile.Commissions.RerollsUsed += 1
	Registry.Get("PlayerService").Sync(player, "Commissions")
	return true
end

function CommissionService.Init()
	Net.Function("GetCommissions").OnServerInvoke = function(player)
		local profile = Registry.Get("DataService").Get(player)
		if not profile then
			return nil
		end
		return CommissionService.View(player, profile)
	end
	Net.Function("ClaimCommission").OnServerInvoke = CommissionService.Claim
	Net.Function("RerollCommission").OnServerInvoke = CommissionService.Reroll
end

function CommissionService.Start()
	EventBus.On("ProfileLoaded", function(player, profile)
		ensureDaily(player, profile)
	end)
	-- aggiorna la vista quando cambiano le statistiche (coalescente nel PlayerService)
	EventBus.On("StatDelta", function(player)
		Registry.Get("PlayerService").Sync(player, "Commissions")
	end)
	-- rinnovo a mezzanotte UTC
	task.spawn(function()
		while true do
			task.wait(30)
			for player, profile in pairs(Registry.Get("DataService").GetAll()) do
				if profile.Commissions.DayKey ~= TimeUtil.DayKey() then
					ensureDaily(player, profile)
					Registry.Get("PlayerService").Sync(player, "Commissions")
					Registry.Get("PlayerService").Toast(player, "Nuove commissioni disponibili!", "info")
				end
			end
		end
	end)
end

return CommissionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	DataService: carica/salva i profili con lock di sessione, autosave, riconciliazione
	con il template, migrazioni e salvataggio alla chiusura del server.
	Salvataggi resilienti: retry con backoff, nessuna perdita silenziosa (se il
	caricamento fallisce il giocatore viene espulso con un messaggio, non gioca con dati vuoti).
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local DefaultData = require(Shared.DefaultData)
local TableUtil = require(Shared.Util.TableUtil)
local Signal = require(Shared.Util.Signal)

local Store = require(script.Parent.Parent.Util.Store)
local Logger = require(script.Parent.Parent.Util.Logger)
local EventBus = require(script.Parent.Parent.EventBus)

local DataService = {}
DataService.ProfileLoaded = Signal.new()
DataService.ProfileReleasing = Signal.new()

local profiles = {} -- player -> profile
local loading = {} -- player -> true
local store
local LOCK_TIMEOUT = 120 -- secondi oltre i quali un lock è considerato orfano
local jobId = game.JobId ~= "" and game.JobId or "studio"

local function key(userId)
	return "p_" .. userId
end

-- Migrazioni tra versioni di dati
local migrations = {
	-- [1] = function(data) ... end,
}

local function migrate(data)
	local v = data.Version or 1
	while v < Config.DataVersion do
		local m = migrations[v]
		if m then
			m(data)
		end
		v += 1
		data.Version = v
	end
end

function DataService.Init()
	store = Store.new(Config.DataStoreName)
end

local function loadProfile(player)
	local userId = player.UserId
	local attempts = 0
	while attempts < 5 do
		attempts += 1
		local lockedElsewhere = false
		local ok, data = store:Update(key(userId), function(old)
			local now = os.time()
			if old and old.SessionLock and old.SessionLock.JobId ~= jobId and (now - (old.SessionLock.Time or 0)) < LOCK_TIMEOUT then
				lockedElsewhere = true
				return nil -- non modificare
			end
			local d = old or DefaultData()
			d.SessionLock = { JobId = jobId, Time = now }
			return d
		end)
		if not ok then
			Logger.Warn("Data", "Caricamento fallito per", player.Name, data)
			return nil, "Impossibile caricare i dati. Riprova tra poco."
		end
		if not lockedElsewhere and data then
			return data
		end
		Logger.Info("Data", "Profilo di", player.Name, "bloccato altrove, riprovo...")
		task.wait(3)
	end
	return nil, "I tuoi dati sono ancora in uso su un altro server. Riprova tra un minuto."
end

local function saveProfile(player, profile, release)
	profile.LastSeen = os.time()
	local snapshot = TableUtil.DeepCopy(profile)
	if release then
		snapshot.SessionLock = nil
	else
		snapshot.SessionLock = { JobId = jobId, Time = os.time() }
	end
	local ok, err = store:Update(key(player.UserId), function(old)
		-- Non sovrascrivere un profilo bloccato da un altro server (sicurezza extra)
		if old and old.SessionLock and old.SessionLock.JobId ~= jobId and (os.time() - (old.SessionLock.Time or 0)) < LOCK_TIMEOUT then
			return nil
		end
		return snapshot
	end)
	if not ok then
		Logger.Warn("Data", "Salvataggio fallito per", player.Name, err)
	end
	return ok
end

function DataService.OnPlayerAdded(player)
	loading[player] = true
	local profile, err = loadProfile(player)
	loading[player] = nil
	if not profile then
		player:Kick(err or "Errore dati")
		return
	end
	if not player.Parent then
		-- è uscito durante il caricamento: rilascia il lock
		saveProfile(player, profile, true)
		return
	end
	TableUtil.Reconcile(profile, DefaultData())
	migrate(profile)
	profile.Stats.Sessions += 1
	profiles[player] = profile
	Logger.Info("Data", "Profilo caricato per", player.Name, store:IsMock() and "(memoria)" or "")
	DataService.ProfileLoaded:Fire(player, profile)
	EventBus.Fire("ProfileLoaded", player, profile)
end

function DataService.OnPlayerRemoving(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	DataService.ProfileReleasing:Fire(player, profile)
	EventBus.Fire("ProfileReleasing", player, profile)
	profiles[player] = nil
	saveProfile(player, profile, true)
end

function DataService.Get(player)
	return profiles[player]
end

function DataService.WaitFor(player, timeout)
	local t0 = os.clock()
	while not profiles[player] do
		if not player.Parent or (os.clock() - t0) > (timeout or 30) then
			return nil
		end
		task.wait(0.1)
	end
	return profiles[player]
end

function DataService.GetAll()
	return profiles
end

function DataService.Save(player)
	local profile = profiles[player]
	if profile then
		return saveProfile(player, profile, false)
	end
	return false
end

function DataService.IsMock()
	return store:IsMock()
end

function DataService.Start()
	Players.PlayerAdded:Connect(DataService.OnPlayerAdded)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(DataService.OnPlayerAdded, p)
	end
	Players.PlayerRemoving:Connect(DataService.OnPlayerRemoving)

	-- Autosave scaglionato
	task.spawn(function()
		while true do
			task.wait(Config.Limits.AutosaveSeconds)
			for player, profile in pairs(profiles) do
				task.spawn(saveProfile, player, profile, false)
				task.wait(0.5)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and store:IsMock() then
			return
		end
		local pending = 0
		for player, profile in pairs(profiles) do
			pending += 1
			task.spawn(function()
				DataService.ProfileReleasing:Fire(player, profile)
				saveProfile(player, profile, true)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">DefenseService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	DefenseService: salvataggio/pubblicazione dei layout (validazione server-side con il
	validatore condiviso), ultimo layout valido, alternative tattiche, prova locale gratuita.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Defenses = require(Shared.Catalog.Defenses)
local LayoutValidator = require(Shared.LayoutValidator)
local GridUtil = require(Shared.Util.GridUtil)
local TableUtil = require(Shared.Util.TableUtil)
local Net = require(Shared.Util.Net)

local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)
local Guard = require(script.Parent.Parent.Util.Guard)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local Logger = require(script.Parent.Parent.Util.Logger)

local Defense = {}
local limiter = RateLimiter.new(6, 1)

local function context(profile)
	local creatureCells, decoCells = {}, {}
	for _, c in pairs(profile.Creatures) do
		if c.x ~= nil then
			creatureCells[GridUtil.Key(c.x, c.z)] = true
		end
	end
	for _, d in ipairs(profile.Decorations.Placed) do
		decoCells[GridUtil.Key(d.x, d.z)] = true
	end
	return {
		UnlockedModules = profile.UnlockedModules,
		UnlockedAlternatives = profile.UnlockedAlternatives,
		CreatureCells = creatureCells,
		DecorationCells = decoCells,
	}
end

-- Normalizza il layout ricevuto dal client (solo i campi attesi)
local function sanitize(layout)
	if type(layout) ~= "table" or type(layout.Modules) ~= "table" then
		return nil
	end
	local out = { Modules = {} }
	for i, m in ipairs(layout.Modules) do
		if i > 6 then
			break
		end
		if type(m) ~= "table" then
			return nil
		end
		local id = Guard.Str(m.Id, 32)
		local x = Guard.Int(m.x, 0, Config.Grid.Size - 1)
		local z = Guard.Int(m.z, 0, Config.Grid.Size - 1)
		local rot = Guard.Int(m.Rot or 0, 0, 3)
		local alt = m.Alt ~= nil and Guard.Str(m.Alt, 32) or nil
		if not id or not x or not z or rot == nil then
			return nil
		end
		table.insert(out.Modules, { Id = id, x = x, z = z, Rot = rot, Alt = alt })
	end
	return out
end

function Defense.Validate(profile, layout)
	return LayoutValidator.Validate(layout, context(profile))
end

function Defense.SaveLayout(player, layout)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	if not limiter:Allow(player.UserId .. ":layout") then
		return false, Strings.TooFast
	end
	local clean = sanitize(layout)
	if not clean then
		return false, "Layout non valido"
	end
	-- applica le alternative scelte dal giocatore se il client non le specifica
	for _, m in ipairs(clean.Modules) do
		if m.Alt == nil and profile.ModuleAlternative[m.Id] then
			m.Alt = profile.ModuleAlternative[m.Id]
		end
	end
	local result = Defense.Validate(profile, clean)
	profile.Layout = clean
	if not result.Ok then
		Registry.Get("PlayerService").Sync(player, "Layout")
		Registry.Get("PlayerService").Toast(player, Strings.BuildKeptLast .. " (" .. (result.Reason or "") .. ")", "warning")
		return false, result.Reason
	end
	profile.LastValidLayout = TableUtil.DeepCopy(clean)
	profile.LayoutVersion += 1
	profile.Stats.LayoutsPublished += 1
	profile.Mastery.Defense += Config.Mastery.DefensePerPublish
	Registry.Get("PlotService").RefreshLayout(player)
	Registry.Get("PlayerService").Sync(player, "Layout", "LastValidLayout", "Stats", "Mastery")
	Registry.Get("PlayerService").Sound(player, "Success")
	Registry.Get("PlayerService").Toast(player, Strings.BuildPublished, "success")
	EventBus.Fire("LayoutPublished", player, #clean.Modules)
	Registry.Get("GalleryService").MarkDirty(player)
	Logger.Audit("Defense", player, "publish", string.format("%d moduli, energia %d", #clean.Modules, result.Energy))
	return true, { Energy = result.Energy, Difficulty = LayoutValidator.DifficultyStars(result.Difficulty) }
end

function Defense.SetAlternative(player, moduleId, altId)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	moduleId = Guard.Str(moduleId, 32)
	altId = Guard.Str(altId, 32)
	if not moduleId or not altId or not Defenses.Get(moduleId) then
		return false, Strings.Error
	end
	if altId ~= "base" then
		if not Defenses.GetAlternative(moduleId, altId) then
			return false, Strings.Error
		end
		local set = profile.UnlockedAlternatives[moduleId]
		if not (set and set[altId]) then
			return false, Strings.BuildLocked
		end
	end
	profile.ModuleAlternative[moduleId] = altId
	Registry.Get("PlayerService").Sync(player, "ModuleAlternative")
	return true
end

-- Sblocca alternative in base al tier di maestria Difesa
function Defense.UnlockAlternativesForTier(player, profile, tier)
	local newly = {}
	for _, m in ipairs(Defenses.List) do
		for _, alt in ipairs(m.Alternatives) do
			if alt.Unlock.Kind == "mastery" and alt.Unlock.Track == "Defense" and alt.Unlock.Tier <= tier then
				profile.UnlockedAlternatives[m.Id] = profile.UnlockedAlternatives[m.Id] or {}
				if not profile.UnlockedAlternatives[m.Id][alt.Id] then
					profile.UnlockedAlternatives[m.Id][alt.Id] = true
					table.insert(newly, m.Name .. " → " .. alt.Name)
				end
			end
		end
		if m.Unlock.Kind == "mastery" and m.Unlock.Track == "Defense" and m.Unlock.Tier <= tier and not profile.UnlockedModules[m.Id] then
			profile.UnlockedModules[m.Id] = true
			table.insert(newly, m.Name)
			EventBus.Fire("ModuleUnlocked", player, m.Id)
		end
	end
	if #newly > 0 then
		Registry.Get("PlayerService").Sync(player, "UnlockedAlternatives", "UnlockedModules")
		for _, n in ipairs(newly) do
			Registry.Get("PlayerService").Toast(player, string.format(Strings.Unlocked, n), "success")
		end
	end
end

function Defense.Init()
	Net.Function("SaveLayout").OnServerInvoke = Defense.SaveLayout
	Net.Function("SetModuleAlternative").OnServerInvoke = Defense.SetAlternative
	Net.Function("StartLayoutTest").OnServerInvoke = function(player)
		if not limiter:Allow(player.UserId .. ":test", 2) then
			return false, Strings.TooFast
		end
		return Registry.Get("RaidService").StartTest(player)
	end
end

function Defense.Start()
	EventBus.On("MasteryTier", function(player, track, tier)
		if track == "Defense" then
			local profile = Registry.Get("DataService").Get(player)
			if profile then
				Defense.UnlockAlternativesForTier(player, profile, tier)
			end
		end
	end)
	EventBus.On("ProfileLoaded", function(player, profile)
		local Album = require(Shared.Catalog.Album)
		local tier = Album.TierFor(profile.Mastery.Defense, Config.Mastery.Tiers)
		if tier > 0 then
			Defense.UnlockAlternativesForTier(player, profile, tier)
		end
	end)
end

return Defense
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	EconomyService: produzione delle scintille, ritiro, deposito, deposito automatico,
	riserva offline, potenziamenti (cassaforte, espansione plot), sblocco moduli,
	posizionamento creature e decorazioni. Tutte le modifiche alle risorse passano da qui
	e sono verificate dal server.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Creatures = require(Shared.Catalog.Creatures)
local Defenses = require(Shared.Catalog.Defenses)
local Decorations = require(Shared.Catalog.Decorations)
local GridUtil = require(Shared.Util.GridUtil)
local Net = require(Shared.Util.Net)
local Format = require(Shared.Util.Format)

local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)
local Guard = require(script.Parent.Parent.Util.Guard)
local Logger = require(script.Parent.Parent.Util.Logger)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local Economy = {}
local limiter = RateLimiter.new(12, 4)

local function data()
	return Registry.Get("DataService")
end
local function ps()
	return Registry.Get("PlayerService")
end
local function plots()
	return Registry.Get("PlotService")
end

-- ───────────────────────── helper economia ─────────────────────────

function Economy.VaultCapacity(profile)
	return Config.Vault.Capacities[profile.Sparks.VaultLevel] or Config.Vault.Capacities[#Config.Vault.Capacities]
end

function Economy.PlotCapacity(profile)
	return Config.PlotSlots.Capacities[profile.PlotLevel] or Config.PlotSlots.Capacities[#Config.PlotSlots.Capacities]
end

-- Fascia di progressione (per matchmaking e commissioni)
function Economy.Tier(profile)
	local owned = 0
	for _ in pairs(profile.OwnedCreatureIds) do
		owned += 1
	end
	local score = profile.Sparks.VaultLevel * 2 + owned
	local tier = 1
	for i, th in ipairs(Config.Tiers.Thresholds) do
		if score >= th then
			tier = i
		end
	end
	return math.clamp(tier, 1, #Config.Raid.TierTakeCaps)
end

-- Spende scintille dalla cassaforte (prima) e poi dalle esposte. Ritorna ok.
function Economy.Spend(player, profile, amount, reason)
	local total = profile.Sparks.Vault + profile.Sparks.Exposed
	if amount > total then
		return false
	end
	local fromVault = math.min(profile.Sparks.Vault, amount)
	profile.Sparks.Vault -= fromVault
	profile.Sparks.Exposed -= (amount - fromVault)
	profile.Stats.TotalSpent += amount
	EventBus.Fire("SparksSpent", player, amount, reason)
	Logger.Audit("Economy", player, "spend", string.format("%d (%s)", amount, reason or "?"))
	ps().Sync(player, "Sparks")
	plots().RefreshSparks(player)
	return true
end

-- Aggiunge scintille al sicuro (ricompense di sistema): nella cassaforte, l'eccedenza va alle esposte
function Economy.GrantSafe(player, profile, amount, reason)
	if amount <= 0 then
		return
	end
	local cap = Economy.VaultCapacity(profile)
	local room = math.max(0, cap - profile.Sparks.Vault)
	local toVault = math.min(room, amount)
	profile.Sparks.Vault += toVault
	profile.Sparks.Exposed += (amount - toVault)
	Logger.Audit("Economy", player, "grant", string.format("%d (%s)", amount, reason or "?"))
	ps().Sync(player, "Sparks")
	plots().RefreshSparks(player)
end

function Economy.GrantExposed(player, profile, amount, reason)
	if amount <= 0 then
		return
	end
	profile.Sparks.Exposed += amount
	Logger.Audit("Economy", player, "grantExposed", string.format("%d (%s)", amount, reason or "?"))
	ps().Sync(player, "Sparks")
	plots().RefreshSparks(player)
end

function Economy.GrantFragments(player, profile, amount, reason)
	if amount and amount > 0 then
		profile.Fragments += amount
		ps().Sync(player, "Fragments")
		Logger.Audit("Economy", player, "fragments", string.format("+%d (%s)", amount, reason or "?"))
	end
end

function Economy.GrantTokens(player, profile, amount, reason)
	if amount and amount > 0 then
		profile.StyleTokens += amount
		ps().Sync(player, "StyleTokens")
		Logger.Audit("Economy", player, "tokens", string.format("+%d (%s)", amount, reason or "?"))
	end
end

-- Totale esposto (pool + buffer delle creature): è ciò che un'incursione può colpire
function Economy.ExposedTotal(profile)
	local total = profile.Sparks.Exposed
	for _, c in pairs(profile.Creatures) do
		if c.x ~= nil then
			total += (c.Buffer or 0)
		end
	end
	return total
end

-- Sottrae scintille esposte (incursione subita): prima dal pool, poi dai buffer
function Economy.RemoveExposed(player, profile, amount)
	local removed = math.min(profile.Sparks.Exposed, amount)
	profile.Sparks.Exposed -= removed
	local remaining = amount - removed
	if remaining > 0 then
		for uid, c in pairs(profile.Creatures) do
			if remaining <= 0 then
				break
			end
			if c.x ~= nil and (c.Buffer or 0) > 0 then
				local take = math.min(c.Buffer, remaining)
				c.Buffer -= take
				remaining -= take
				removed += take
				if player then
					plots().RefreshBuffer(player, uid)
				end
			end
		end
	end
	if player then
		ps().Sync(player, "Sparks", "Creatures")
		plots().RefreshSparks(player)
	end
	return removed
end

-- ───────────────────────── produzione ─────────────────────────

-- Fattori di rendimento marginale: ordina le creature esposte per produzione decrescente
local function productionFactors(profile)
	local placed = {}
	for uid, c in pairs(profile.Creatures) do
		if c.x ~= nil then
			local def = Creatures.Get(c.Id)
			if def then
				table.insert(placed, { Uid = uid, Prod = def.Production })
			end
		end
	end
	table.sort(placed, function(a, b)
		if a.Prod == b.Prod then
			return a.Uid < b.Uid
		end
		return a.Prod > b.Prod
	end)
	local factors = {}
	for i, e in ipairs(placed) do
		factors[e.Uid] = Config.Production.DiminishingFactors[i] or (i > 12 and 0.2 or 1)
	end
	return factors
end

function Economy.ProductionPerInterval(profile)
	local factors = productionFactors(profile)
	local total = 0
	for uid, c in pairs(profile.Creatures) do
		if c.x ~= nil then
			local def = Creatures.Get(c.Id)
			if def then
				total += def.Production * (factors[uid] or 1)
			end
		end
	end
	return total
end

local function tick(player, profile, now)
	local factors = productionFactors(profile)
	local changed = false
	for uid, c in pairs(profile.Creatures) do
		if c.x ~= nil then
			local def = Creatures.Get(c.Id)
			if def then
				c.LastTick = c.LastTick or now
				local interval = Config.Production.BaseInterval
				if now - c.LastTick >= interval then
					local n = math.floor((now - c.LastTick) / interval)
					c.LastTick += n * interval
					local maxBuffer = def.Production * Config.Production.BufferIntervals
					local gain = math.floor(def.Production * (factors[uid] or 1) * n + 0.5)
					local before = c.Buffer or 0
					c.Buffer = math.min(maxBuffer, before + gain)
					if c.Buffer ~= before then
						changed = true
						plots().RefreshBuffer(player, uid)
						-- deposito automatico: le scintille vanno dritte in cassaforte se c'è spazio
						if profile.Settings.AutoDeposit and profile.AutoDepositUnlocked then
							Economy.Collect(player, uid, true)
						end
					end
				end
			end
		end
	end
	if changed then
		ps().Sync(player, "Creatures")
	end
end

-- Riserva offline: al rientro, una frazione della produzione accumulata fino a un tetto
local function applyOfflineReserve(player, profile)
	local elapsed = os.time() - (profile.LastSeen or os.time())
	if elapsed < 60 then
		return
	end
	local minutes = math.min(elapsed / 60, Config.Production.OfflineCapMinutes)
	local perMinute = Economy.ProductionPerInterval(profile) * (60 / Config.Production.BaseInterval)
	local gain = math.floor(perMinute * minutes * Config.Production.OfflineRateFraction)
	gain = math.min(gain, Config.Production.OfflineCapSparks)
	if gain > 0 then
		-- distribuisce nei buffer delle creature (restano esposte: va ritirato e depositato)
		local placed = {}
		for uid, c in pairs(profile.Creatures) do
			if c.x ~= nil then
				table.insert(placed, uid)
			end
		end
		table.sort(placed)
		if #placed > 0 then
			local each = math.floor(gain / #placed)
			for _, uid in ipairs(placed) do
				local c = profile.Creatures[uid]
				local def = Creatures.Get(c.Id)
				local maxBuffer = def and def.Production * Config.Production.BufferIntervals or 60
				c.Buffer = math.min(maxBuffer, (c.Buffer or 0) + each)
			end
			ps().Toast(player, string.format("Bentornato! Le creature hanno messo da parte %d scintille per te.", gain), "success")
		end
	end
	for _, c in pairs(profile.Creatures) do
		c.LastTick = os.time()
	end
end

-- ───────────────────────── ritiro / deposito ─────────────────────────

function Economy.Collect(player, uid, silent)
	local profile = data().Get(player)
	if not profile then
		return false, Strings.Error
	end
	uid = Guard.Str(uid, 32)
	local c = uid and profile.Creatures[uid]
	if not c or c.x == nil then
		return false, Strings.Error
	end
	if not silent then
		if not limiter:Allow(player.UserId .. ":collect") then
			return false, Strings.TooFast
		end
		-- distanza: il giocatore deve essere vicino alla creatura
		local plot = plots().GetPlot(player)
		local model = plot and plot.CreatureModels[uid]
		if model and model.PrimaryPart and plots().DistanceTo(player, model.PrimaryPart.Position) > Config.Limits.InteractDistance then
			return false, "Troppo lontano"
		end
	end
	local amount = c.Buffer or 0
	if amount <= 0 then
		return false, "Nessuna scintilla da ritirare"
	end
	c.Buffer = 0
	local deposited = 0
	if profile.Settings.AutoDeposit and profile.AutoDepositUnlocked then
		local room = math.max(0, Economy.VaultCapacity(profile) - profile.Sparks.Vault)
		deposited = math.min(room, amount)
		profile.Sparks.Vault += deposited
		profile.Sparks.Exposed += amount - deposited
		if deposited > 0 then
			profile.Stats.TotalDeposited += deposited
			EventBus.Fire("SparksDeposited", player, deposited)
		end
	else
		profile.Sparks.Exposed += amount
	end
	profile.Stats.TotalCollected += amount
	if not profile.Stats.FirstActionAt then
		profile.Stats.FirstActionAt = os.time()
		Registry.Get("AnalyticsService").Log(player, "first_action", profile.Stats.PlayTime)
	end
	EventBus.Fire("SparksCollected", player, amount, not silent)
	plots().RefreshBuffer(player, uid)
	plots().RefreshSparks(player)
	ps().Sync(player, "Sparks", "Creatures", "Stats")
	if not silent then
		ps().Sound(player, "Collect")
		local plot = plots().GetPlot(player)
		local model = plot and plot.CreatureModels[uid]
		if model and model.PrimaryPart then
			Net.Event("SparkFx"):FireClient(player, model.PrimaryPart.Position, amount)
		end
	end
	return true, amount
end

function Economy.CollectAll(player)
	local profile = data().Get(player)
	if not profile then
		return false
	end
	if not limiter:Allow(player.UserId .. ":collectAll", 3) then
		return false, Strings.TooFast
	end
	if not plots().IsAtHome(player, Config.Limits.CollectAllDistance) then
		return false, "Devi essere nel tuo vivaio"
	end
	local total = 0
	for uid, c in pairs(profile.Creatures) do
		if c.x ~= nil and (c.Buffer or 0) > 0 then
			local ok, amount = Economy.Collect(player, uid, true)
			if ok then
				total += amount
			end
		end
	end
	if total > 0 then
		ps().Sound(player, "Collect")
		local plot = plots().GetPlot(player)
		if plot and plot.Pozza then
			Net.Event("SparkFx"):FireClient(player, plot.Pozza.Position, total)
		end
	end
	return true, total
end

function Economy.Deposit(player)
	local profile = data().Get(player)
	if not profile then
		return false, Strings.Error
	end
	if not limiter:Allow(player.UserId .. ":deposit") then
		return false, Strings.TooFast
	end
	local plot = plots().GetPlot(player)
	if not plot or not plot.Vault or plots().DistanceTo(player, plot.Vault.Position) > Config.Limits.InteractDistance + 4 then
		return false, "Avvicinati alla cassaforte"
	end
	local room = math.max(0, Economy.VaultCapacity(profile) - profile.Sparks.Vault)
	local amount = math.min(room, profile.Sparks.Exposed)
	if amount <= 0 then
		if profile.Sparks.Exposed > 0 then
			ps().Toast(player, Strings.VaultFull, "warning")
			return false, Strings.VaultFull
		end
		return false, "Nessuna scintilla da depositare"
	end
	profile.Sparks.Exposed -= amount
	profile.Sparks.Vault += amount
	profile.Stats.TotalDeposited += amount
	EventBus.Fire("SparksDeposited", player, amount)
	ps().Sync(player, "Sparks", "Stats")
	ps().Sound(player, "Deposit")
	plots().RefreshSparks(player)
	Net.Event("SparkFx"):FireClient(player, plot.Vault.Position, amount)
	if profile.Sparks.Exposed > 0 and room - amount <= 0 then
		ps().Toast(player, Strings.VaultFull, "warning")
	end
	return true, amount
end

-- ───────────────────────── potenziamenti ─────────────────────────

function Economy.UpgradeVault(player)
	local profile = data().Get(player)
	if not profile then
		return false, Strings.Error
	end
	local nextLevel = profile.Sparks.VaultLevel + 1
	local cost = Config.Vault.UpgradeCosts[nextLevel]
	if not cost then
		return false, "Cassaforte al massimo"
	end
	if not Economy.Spend(player, profile, cost, "vault_upgrade") then
		return false, Strings.NotEnoughSparks
	end
	profile.Sparks.VaultLevel = nextLevel
	ps().Sync(player, "Sparks")
	ps().Sound(player, "Success")
	ps().Toast(player, string.format("Cassaforte potenziata: capienza %s", Format.Number(Economy.VaultCapacity(profile))), "success")
	plots().RefreshSparks(player)
	Registry.Get("GalleryService").MarkDirty(player)
	return true
end

function Economy.UpgradePlot(player)
	local profile = data().Get(player)
	if not profile then
		return false, Strings.Error
	end
	local nextLevel = profile.PlotLevel + 1
	local cost = Config.PlotSlots.UpgradeCosts[nextLevel]
	if not cost then
		return false, "Vivaio già al massimo"
	end
	if not Economy.Spend(player, profile, cost, "plot_upgrade") then
		return false, Strings.NotEnoughSparks
	end
	profile.PlotLevel = nextLevel
	ps().Sync(player, "PlotLevel")
	ps().Sound(player, "Success")
	ps().Toast(player, string.format("Vivaio ampliato: %d creature esponibili", Economy.PlotCapacity(profile)), "success")
	return true
end

function Economy.UnlockModule(player, moduleId)
	local profile = data().Get(player)
	if not profile then
		return false, Strings.Error
	end
	moduleId = Guard.Str(moduleId, 32)
	local def = moduleId and Defenses.Get(moduleId)
	if not def then
		return false, Strings.Error
	end
	if profile.UnlockedModules[moduleId] then
		return false, "Già sbloccato"
	end
	if def.Unlock.Kind ~= "sparks" then
		return false, Strings.BuildLocked
	end
	if not Economy.Spend(player, profile, def.Unlock.Cost, "module_" .. moduleId) then
		return false, Strings.NotEnoughSparks
	end
	profile.UnlockedModules[moduleId] = true
	EventBus.Fire("ModuleUnlocked", player, moduleId)
	ps().Sync(player, "UnlockedModules")
	ps().Sound(player, "Success")
	ps().Toast(player, string.format(Strings.Unlocked, def.Name), "success")
	return true
end

-- ───────────────────────── creature ─────────────────────────

local function occupiedCells(profile, exceptUid)
	local set = {}
	for uid, c in pairs(profile.Creatures) do
		if c.x ~= nil and uid ~= exceptUid then
			set[GridUtil.Key(c.x, c.z)] = "creature"
		end
	end
	for _, d in ipairs(profile.Decorations.Placed) do
		set[GridUtil.Key(d.x, d.z)] = "deco"
	end
	for _, m in ipairs(profile.LastValidLayout.Modules or {}) do
		for _, cell in ipairs(GridUtil.ModuleCells(Defenses.EffectiveFootprint(m.Id, m.Alt), m.x, m.z, m.Rot or 0)) do
			set[GridUtil.Key(cell.x, cell.z)] = "module"
		end
	end
	for k in pairs(GridUtil.ReservedSet()) do
		set[k] = "reserved"
	end
	return set
end

function Economy.OccupiedCells(profile)
	return occupiedCells(profile, nil)
end

function Economy.PlaceCreature(player, uid, x, z)
	local profile = data().Get(player)
	if not profile then
		return false, Strings.Error
	end
	uid = Guard.Str(uid, 32)
	x = Guard.Int(x, 0, Config.Grid.Size - 1)
	z = Guard.Int(z, 0, Config.Grid.Size - 1)
	local c = uid and profile.Creatures[uid]
	if not c or not x or not z then
		return false, Strings.Error
	end
	local occupied = occupiedCells(profile, uid)
	if occupied[GridUtil.Key(x, z)] then
		return false, "Cella occupata"
	end
	local wasPlaced = c.x ~= nil
	if not wasPlaced then
		local placedCount = 0
		for _, other in pairs(profile.Creatures) do
			if other.x ~= nil then
				placedCount += 1
			end
		end
		if placedCount >= Economy.PlotCapacity(profile) then
			return false, "Spazio esaurito: amplia il vivaio"
		end
	end
	c.x, c.z = x, z
	c.LastTick = c.LastTick or os.time()
	EventBus.Fire("CreaturePlaced", player, uid, wasPlaced)
	plots().RefreshCreature(player, uid)
	ps().Sync(player, "Creatures")
	ps().Sound(player, "Place")
	Registry.Get("GalleryService").MarkDirty(player)
	return true
end

function Economy.RemoveCreature(player, uid)
	local profile = data().Get(player)
	if not profile then
		return false, Strings.Error
	end
	uid = Guard.Str(uid, 32)
	local c = uid and profile.Creatures[uid]
	if not c or c.x == nil then
		return false, Strings.Error
	end
	-- le scintille nel buffer vengono ritirate (restano esposte)
	if (c.Buffer or 0) > 0 then
		profile.Sparks.Exposed += c.Buffer
		profile.Stats.TotalCollected += c.Buffer
		c.Buffer = 0
	end
	c.x, c.z = nil, nil
	plots().RefreshCreature(player, uid)
	plots().RefreshSparks(player)
	ps().Sync(player, "Creatures", "Sparks")
	Registry.Get("GalleryService").MarkDirty(player)
	return true
end

-- Aggiunge una creatura al profilo (bozzolo, tutorial). Ritorna uid.
function Economy.GrantCreature(player, profile, creatureId, autoPlace)
	local def = Creatures.Get(creatureId)
	if not def then
		return nil
	end
	local uid = "c" .. profile.NextCreatureUid
	profile.NextCreatureUid += 1
	profile.Creatures[uid] = { Id = creatureId, Variant = "base", Buffer = 0, LastTick = os.time() }
	local first = not profile.OwnedCreatureIds[creatureId]
	profile.OwnedCreatureIds[creatureId] = true
	profile.UnlockedVariants[creatureId] = profile.UnlockedVariants[creatureId] or { base = true }
	if autoPlace then
		local occupied = occupiedCells(profile, nil)
		local placedCount = 0
		for _, other in pairs(profile.Creatures) do
			if other.x ~= nil then
				placedCount += 1
			end
		end
		if placedCount < Economy.PlotCapacity(profile) then
			-- cerca una cella libera a spirale partendo dagli angoli interni
			local candidates = { { 2, 2 }, { 9, 2 }, { 2, 9 }, { 9, 9 }, { 2, 5 }, { 9, 6 }, { 5, 2 }, { 6, 9 }, { 1, 7 }, { 10, 4 }, { 3, 4 }, { 8, 7 } }
			for _, cand in ipairs(candidates) do
				if not occupied[GridUtil.Key(cand[1], cand[2])] then
					profile.Creatures[uid].x = cand[1]
					profile.Creatures[uid].z = cand[2]
					break
				end
			end
			if profile.Creatures[uid].x == nil then
				for x = 0, Config.Grid.Size - 1 do
					for z = 0, Config.Grid.Size - 1 do
						if not occupied[GridUtil.Key(x, z)] and profile.Creatures[uid].x == nil then
							profile.Creatures[uid].x = x
							profile.Creatures[uid].z = z
						end
					end
				end
			end
		end
	end
	if first then
		EventBus.Fire("CreatureUnlocked", player, creatureId)
	end
	plots().RefreshCreature(player, uid)
	ps().Sync(player, "Creatures", "OwnedCreatureIds", "UnlockedVariants")
	Registry.Get("GalleryService").MarkDirty(player)
	return uid
end

function Economy.SetVariant(player, uid, variantId)
	local profile = data().Get(player)
	if not profile then
		return false
	end
	local c = profile.Creatures[uid]
	if not c then
		return false
	end
	local unlocked = profile.UnlockedVariants[c.Id]
	if not (unlocked and unlocked[variantId]) then
		return false, "Variante non sbloccata"
	end
	c.Variant = variantId
	plots().RefreshCreature(player, uid)
	ps().Sync(player, "Creatures")
	return true
end

-- ───────────────────────── decorazioni ─────────────────────────

function Economy.PlaceDecoration(player, decoId, x, z, rot)
	local profile = data().Get(player)
	if not profile then
		return false, Strings.Error
	end
	decoId = Guard.Str(decoId, 32)
	x = Guard.Int(x, 0, Config.Grid.Size - 1)
	z = Guard.Int(z, 0, Config.Grid.Size - 1)
	rot = Guard.Int(rot or 0, 0, 3) or 0
	if not decoId or not Decorations.ById[decoId] or not x or not z then
		return false, Strings.Error
	end
	if not profile.Decorations.Owned[decoId] then
		return false, "Decorazione non posseduta"
	end
	if #profile.Decorations.Placed >= Decorations.MaxPlaced then
		return false, "Troppe decorazioni (massimo " .. Decorations.MaxPlaced .. ")"
	end
	local occupied = occupiedCells(profile, nil)
	if occupied[GridUtil.Key(x, z)] then
		return false, "Cella occupata"
	end
	table.insert(profile.Decorations.Placed, { Id = decoId, x = x, z = z, Rot = rot })
	EventBus.Fire("DecorationPlaced", player, decoId)
	plots().RefreshDecorations(player)
	ps().Sync(player, "Decorations")
	ps().Sound(player, "Place")
	Registry.Get("GalleryService").MarkDirty(player)
	return true
end

function Economy.RemoveDecoration(player, index)
	local profile = data().Get(player)
	if not profile then
		return false, Strings.Error
	end
	index = Guard.Int(index, 1, #profile.Decorations.Placed)
	if not index then
		return false, Strings.Error
	end
	table.remove(profile.Decorations.Placed, index)
	plots().RefreshDecorations(player)
	ps().Sync(player, "Decorations")
	Registry.Get("GalleryService").MarkDirty(player)
	return true
end

function Economy.GrantDecoration(player, profile, decoId)
	if Decorations.ById[decoId] and not profile.Decorations.Owned[decoId] then
		profile.Decorations.Owned[decoId] = true
		ps().Sync(player, "Decorations")
		return true
	end
	return false
end

-- ───────────────────────── init ─────────────────────────

function Economy.Init()
	Net.Function("Collect").OnServerInvoke = function(player, uid)
		return Economy.Collect(player, uid, false)
	end
	Net.Function("Deposit").OnServerInvoke = Economy.Deposit
	Net.Event("CollectAll").OnServerEvent:Connect(function(player)
		local ok, msg = Economy.CollectAll(player)
		if not ok and msg then
			ps().Toast(player, msg, "warning")
		end
	end)
	Net.Event("DepositAll").OnServerEvent:Connect(function(player)
		Economy.Deposit(player)
	end)
	Net.Function("UpgradeVault").OnServerInvoke = Economy.UpgradeVault
	Net.Function("UpgradePlot").OnServerInvoke = Economy.UpgradePlot
	Net.Function("UnlockModule").OnServerInvoke = Economy.UnlockModule
	Net.Function("PlaceCreature").OnServerInvoke = function(player, uid, x, z)
		if not limiter:Allow(player.UserId .. ":place") then
			return false, Strings.TooFast
		end
		return Economy.PlaceCreature(player, uid, x, z)
	end
	Net.Function("RemoveCreature").OnServerInvoke = Economy.RemoveCreature
	Net.Function("SetVariant").OnServerInvoke = function(player, uid, variantId)
		uid = Guard.Str(uid, 32)
		variantId = Guard.Str(variantId, 32)
		if not uid or not variantId then
			return false, Strings.Error
		end
		return Economy.SetVariant(player, uid, variantId)
	end
	Net.Function("PlaceDecoration").OnServerInvoke = function(player, decoId, x, z, rot)
		if not limiter:Allow(player.UserId .. ":place") then
			return false, Strings.TooFast
		end
		return Economy.PlaceDecoration(player, decoId, x, z, rot)
	end
	Net.Function("RemoveDecoration").OnServerInvoke = Economy.RemoveDecoration
end

function Economy.Start()
	EventBus.On("ProfileLoaded", function(player, profile)
		-- creatura iniziale del tutorial (in inventario finché non la posiziona)
		local hasAny = next(profile.Creatures) ~= nil
		if not hasAny then
			Economy.GrantCreature(player, profile, Creatures.StarterCreatureId, false)
		end
		applyOfflineReserve(player, profile)
		ps().Sync(player, "Creatures", "Sparks")
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Production.TickSeconds)
			local now = os.time()
			for player, profile in pairs(data().GetAll()) do
				tick(player, profile, now)
			end
		end
	end)
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">GalleryService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	GalleryService: pubblicazione delle istantanee del vivaio nel pool condiviso, galleria
	con «mi piace» (senza effetti sulla produzione), visite (al plot online o a una copia
	istanziata se il proprietario è offline), ricompense di visita con tetto basso, codici layout.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Defenses = require(Shared.Catalog.Defenses)
local LayoutValidator = require(Shared.LayoutValidator)
local PlotBuilder = require(Shared.Models.PlotBuilder)
local TimeUtil = require(Shared.Util.TimeUtil)
local Net = require(Shared.Util.Net)

local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)
local Guard = require(script.Parent.Parent.Util.Guard)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local PoolStore = require(script.Parent.PoolStore)
local ArenaPool = require(script.Parent.Parent.World.ArenaPool)

local Gallery = {}
local dirty = {} -- player -> timestamp della richiesta
local lastPublished = {} -- player -> tier
local visits = {} -- player -> { Slot, Plot, Key }
local limiter = RateLimiter.new(8, 1)

local ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"

local function encodeCode(userId)
	local n = userId
	local s = ""
	repeat
		local d = n % 32
		s = ALPHABET:sub(d + 1, d + 1) .. s
		n = n // 32
	until n == 0
	return "NV-" .. s
end

local function decodeCode(code)
	code = code:upper():gsub("^NV%-", ""):gsub("[^0-9A-Z]", "")
	if #code == 0 then
		return nil
	end
	local n = 0
	for i = 1, #code do
		local idx = ALPHABET:find(code:sub(i, i), 1, true)
		if not idx then
			return nil
		end
		n = n * 32 + (idx - 1)
	end
	return n
end

Gallery.EncodeCode = encodeCode

-- Istantanea per il pool (niente dati privati; nome solo se consentito)
function Gallery.BuildSnapshot(player, profile)
	local eco = Registry.Get("EconomyService")
	local creatures = {}
	for _, c in pairs(profile.Creatures) do
		if c.x ~= nil then
			table.insert(creatures, { Id = c.Id, Variant = c.Variant or "base", x = c.x, z = c.z })
		end
	end
	local result = LayoutValidator.Validate(profile.LastValidLayout, {})
	local now = os.time()
	local recentLosses = {}
	for _, t in ipairs(profile.Raid.LossTimestamps) do
		if now - t < Config.Raid.LossWindowSeconds then
			table.insert(recentLosses, t)
		end
	end
	return {
		UserId = player.UserId,
		Name = profile.Settings.ShowName and player.DisplayName or nil,
		Tier = eco.Tier(profile),
		Updated = now,
		Published = profile.Gallery.Published and not profile.Settings.HideProfile,
		Hidden = profile.Settings.HideProfile,
		Layout = profile.LastValidLayout,
		LayoutVersion = profile.LayoutVersion,
		Difficulty = result.Difficulty or 0,
		Stars = LayoutValidator.DifficultyStars(result.Difficulty or 0),
		Exposed = eco.ExposedTotal(profile),
		ShieldUntil = profile.Raid.ShieldUntil,
		LossTs = recentLosses,
		Protected = Registry.Get("PlayerService").HasNewPlayerShield(profile),
		Creatures = creatures,
		Decorations = profile.Decorations.Placed,
		Skin = profile.Cosmetics.Equipped.skin,
		Nameplate = profile.Cosmetics.Equipped.nameplate,
		Likes = profile.Gallery.Likes,
		VaultLevel = profile.Sparks.VaultLevel,
		ShareCode = encodeCode(player.UserId),
	}
end

function Gallery.Publish(player)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return
	end
	if profile.Gallery.ShareCode == "" then
		profile.Gallery.ShareCode = encodeCode(player.UserId)
		Registry.Get("PlayerService").Sync(player, "Gallery")
	end
	-- un vivaio entra nel pool quando ha pubblicato almeno un layout (anche vuoto va bene) e non è protetto
	profile.Gallery.Published = profile.LayoutVersion > 0
	local snapshot = Gallery.BuildSnapshot(player, profile)
	local prevTier = lastPublished[player]
	if prevTier and prevTier ~= snapshot.Tier then
		PoolStore.Remove(player.UserId, prevTier)
	end
	lastPublished[player] = snapshot.Tier
	PoolStore.Upsert(snapshot)
	-- allinea i «mi piace» ricevuti mentre eravamo offline
	local entry = PoolStore.FindByUserId(player.UserId)
	if entry and (entry.Likes or 0) > profile.Gallery.Likes then
		profile.Gallery.Likes = entry.Likes
		Registry.Get("PlayerService").Sync(player, "Gallery")
	end
end

function Gallery.MarkDirty(player)
	dirty[player] = os.clock()
end

-- ───────────────────────── vista galleria ─────────────────────────

local function entryView(e, viewer, profile)
	local dayKey = TimeUtil.DayKey()
	local key = "u_" .. e.UserId
	return {
		Key = key,
		Name = e.Name or "Vivaio anonimo",
		Likes = e.Likes or 0,
		Stars = e.Stars or 1,
		Creatures = #(e.Creatures or {}),
		Modules = #((e.Layout and e.Layout.Modules) or {}),
		Skin = e.Skin,
		Nameplate = e.Nameplate,
		ShareCode = e.ShareCode or encodeCode(e.UserId),
		LikedByMe = profile.Gallery.LikesGiven[key] == dayKey,
		IsMine = e.UserId == viewer.UserId,
		Online = Players:GetPlayerByUserId(e.UserId) ~= nil,
	}
end

function Gallery.GetGallery(player)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return nil
	end
	if not limiter:Allow(player.UserId .. ":gallery") then
		return nil
	end
	local entries = PoolStore.AllEntries()
	-- giocatori online in questo server sempre aggiornati
	for other, otherProfile in pairs(Registry.Get("DataService").GetAll()) do
		if otherProfile.LayoutVersion > 0 then
			entries[tostring(other.UserId)] = Gallery.BuildSnapshot(other, otherProfile)
		end
	end
	local list = {}
	for _, e in pairs(entries) do
		if e.Published and not e.Hidden then
			table.insert(list, entryView(e, player, profile))
		end
	end
	table.sort(list, function(a, b)
		if a.Likes == b.Likes then
			return a.Name < b.Name
		end
		return a.Likes > b.Likes
	end)
	while #list > Config.Gallery.ListLimit do
		table.remove(list)
	end
	local dayKey = TimeUtil.DayKey()
	local visitsToday = (profile.Gallery.VisitDay == dayKey) and (profile.Gallery.VisitsToday or 0) or 0
	return { List = list, VisitsToday = visitsToday, VisitsMax = Config.Gallery.VisitRewardsPerDay, MyCode = encodeCode(player.UserId), Published = profile.Gallery.Published }
end

-- ───────────────────────── visite ─────────────────────────

local function parseKey(key)
	key = Guard.Str(key, 32)
	if not key then
		return nil
	end
	local id = key:match("^u_(%d+)$")
	return id and tonumber(id)
end

local function grantVisitReward(player, profile)
	local dayKey = TimeUtil.DayKey()
	if profile.Gallery.VisitDay ~= dayKey then
		profile.Gallery.VisitDay = dayKey
		profile.Gallery.VisitsToday = 0
	end
	if profile.Gallery.VisitsToday < Config.Gallery.VisitRewardsPerDay then
		profile.Gallery.VisitsToday += 1
		Registry.Get("EconomyService").GrantSafe(player, profile, Config.Gallery.VisitRewardSparks, "visit")
		Registry.Get("PlayerService").Toast(player, string.format(Strings.GalleryVisitReward, Config.Gallery.VisitRewardSparks, profile.Gallery.VisitsToday, Config.Gallery.VisitRewardsPerDay), "success")
		Registry.Get("PlayerService").Sync(player, "Gallery")
	end
end

function Gallery.Visit(player, key)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	if not limiter:Allow(player.UserId .. ":visit", 2) then
		return false, Strings.TooFast
	end
	local userId = parseKey(key)
	if not userId or userId == player.UserId then
		return false, Strings.Error
	end
	if Registry.Get("PlotService").Location(player) == "raid" then
		return false, "Sei in un'incursione"
	end
	Gallery.EndVisit(player)
	-- proprietario online qui: visita diretta al suo plot
	local owner, entry = Registry.Get("PlotService").FindByUserId(userId)
	if owner and entry then
		local ownerProfile = Registry.Get("DataService").Get(owner)
		if ownerProfile and ownerProfile.Settings.HideProfile then
			return false, Strings.GalleryHidden
		end
		local char = player.Character
		if char and char.PrimaryPart then
			char:PivotTo(entry.Plot:EntranceCFrame())
		end
		Registry.Get("PlotService").SetLocation(player, "visit")
		visits[player] = { Key = key, Live = true }
		EventBus.Fire("Visited", player, key)
		grantVisitReward(player, profile)
		return true
	end
	local snapshot = PoolStore.FindByUserId(userId)
	if not snapshot or snapshot.Hidden or not snapshot.Published then
		return false, Strings.GalleryHidden
	end
	local slot = ArenaPool.Acquire("visit")
	if not slot then
		return false, "Troppe visite in corso, riprova tra poco"
	end
	local creatures = {}
	for i, c in ipairs(snapshot.Creatures or {}) do
		table.insert(creatures, { Uid = "v" .. i, Id = c.Id, Variant = c.Variant, x = c.x, z = c.z, Buffer = 0 })
	end
	local plot = PlotBuilder.Build(slot.Folder, slot.Origin, {
		Creatures = creatures,
		Layout = snapshot.Layout,
		Decorations = snapshot.Decorations,
		Skin = snapshot.Skin,
		OwnerName = snapshot.Name or "Vivaio anonimo",
		Nameplate = snapshot.Nameplate ~= "plate_nessuna" and snapshot.Nameplate or nil,
		Exposed = snapshot.Exposed or 0,
		Vault = 0,
		VaultCap = Config.Vault.Capacities[snapshot.VaultLevel or 1],
	}, "visit")
	plot:SetVault(0, Config.Vault.Capacities[snapshot.VaultLevel or 1])
	if plot.VaultLabel then
		plot.VaultLabel.Text = "🔒 al sicuro"
	end
	local char = player.Character
	if char and char.PrimaryPart then
		char:PivotTo(plot:SpawnCFrame())
	end
	Registry.Get("PlotService").SetLocation(player, "visit")
	visits[player] = { Key = key, Slot = slot, Plot = plot }
	EventBus.Fire("Visited", player, key)
	grantVisitReward(player, profile)
	-- fine automatica dopo 4 minuti
	task.delay(240, function()
		local v = visits[player]
		if v and v.Slot == slot then
			Gallery.EndVisit(player)
			Registry.Get("PlotService").TeleportHome(player)
		end
	end)
	return true
end

function Gallery.EndVisit(player)
	local v = visits[player]
	if not v then
		return
	end
	visits[player] = nil
	if v.Slot then
		ArenaPool.Release(v.Slot)
	end
	if Registry.Get("PlotService").Location(player) == "visit" then
		Registry.Get("PlotService").SetLocation(player, "home")
	end
end

function Gallery.Like(player, key)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	if not limiter:Allow(player.UserId .. ":like") then
		return false, Strings.TooFast
	end
	local userId = parseKey(key)
	if not userId or userId == player.UserId then
		return false, Strings.Error
	end
	local dayKey = TimeUtil.DayKey()
	if profile.Gallery.LikesGiven[key] == dayKey then
		return false, "Hai già messo «mi piace» oggi"
	end
	local given = 0
	for _, d in pairs(profile.Gallery.LikesGiven) do
		if d == dayKey then
			given += 1
		end
	end
	if given >= Config.Gallery.LikesPerDay then
		return false, "Limite giornaliero di «mi piace» raggiunto"
	end
	-- pulizia chiavi vecchie
	for k, d in pairs(profile.Gallery.LikesGiven) do
		if d ~= dayKey then
			profile.Gallery.LikesGiven[k] = nil
		end
	end
	profile.Gallery.LikesGiven[key] = dayKey
	local owner = Players:GetPlayerByUserId(userId)
	local ownerProfile = owner and Registry.Get("DataService").Get(owner)
	if ownerProfile then
		ownerProfile.Gallery.Likes += 1
		Registry.Get("PlayerService").Sync(owner, "Gallery")
		Registry.Get("PlayerService").Toast(owner, "Qualcuno ha apprezzato il tuo vivaio ♥", "info")
		Gallery.MarkDirty(owner)
	else
		local entry, tier = PoolStore.FindByUserId(userId)
		if entry then
			PoolStore.ModifyEntry(userId, tier, function(e)
				e.Likes = (e.Likes or 0) + 1
			end)
		end
	end
	EventBus.Fire("Liked", player, key)
	Registry.Get("PlayerService").Sync(player, "Gallery")
	return true
end

function Gallery.ImportCode(player, code)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	code = Guard.Str(code, 24)
	local userId = code and decodeCode(code)
	if not userId then
		return false, "Codice non valido"
	end
	local layout
	local owner = Players:GetPlayerByUserId(userId)
	local ownerProfile = owner and Registry.Get("DataService").Get(owner)
	if ownerProfile then
		if ownerProfile.Settings.HideProfile then
			return false, Strings.GalleryHidden
		end
		layout = ownerProfile.LastValidLayout
	else
		local entry = PoolStore.FindByUserId(userId)
		if not entry or entry.Hidden then
			return false, "Nessun vivaio con questo codice"
		end
		layout = entry.Layout
	end
	local missing = {}
	for _, m in ipairs(layout.Modules or {}) do
		if not profile.UnlockedModules[m.Id] then
			local def = Defenses.Get(m.Id)
			table.insert(missing, def and def.Name or m.Id)
		end
	end
	return true, { Layout = layout, Missing = missing }
end

function Gallery.Init()
	Net.Function("GetGallery").OnServerInvoke = Gallery.GetGallery
	Net.Function("VisitVivaio").OnServerInvoke = Gallery.Visit
	Net.Function("LikeVivaio").OnServerInvoke = Gallery.Like
	Net.Function("ImportLayoutCode").OnServerInvoke = Gallery.ImportCode
end

function Gallery.Start()
	EventBus.On("ProfileLoaded", function(player, profile)
		task.delay(3, function()
			if player.Parent then
				Gallery.Publish(player)
			end
		end)
	end)
	EventBus.On("ProfileReleasing", function(player, profile)
		Gallery.EndVisit(player)
		-- ultima istantanea con dati freschi (scintille esposte, scudo)
		Gallery.Publish(player)
		lastPublished[player] = nil
		dirty[player] = nil
	end)
	-- pubblicazione differita delle modifiche + aggiornamento periodico
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for player, t in pairs(dirty) do
				if now - t >= 5 then
					dirty[player] = nil
					if player.Parent then
						task.spawn(Gallery.Publish, player)
					end
				end
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(180)
			for player in pairs(Registry.Get("DataService").GetAll()) do
				Gallery.MarkDirty(player)
				task.wait(1)
			end
		end
	end)
end

return Gallery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	PlayerService: sincronizzazione dello stato verso il client (sezioni del profilo,
	coalescenza degli aggiornamenti), toast, suoni, tempo di gioco, remoti di base.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Util.Net)
local Guard = require(script.Parent.Parent.Util.Guard)
local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)

local PlayerService = {}

local dirty = {} -- player -> { key = true }
local ready = {} -- player -> true quando il client ha chiesto lo stato
local lastSync = {}

-- Sezioni del profilo replicate al client (il resto resta privato al server)
local SYNC_KEYS = {
	"Sparks", "Fragments", "StyleTokens", "PlotLevel", "Creatures", "OwnedCreatureIds", "UnlockedVariants",
	"Layout", "LastValidLayout", "UnlockedModules", "UnlockedAlternatives", "ModuleAlternative", "Decorations",
	"Cosmetics", "Pass", "Founder", "Commissions", "Album", "Mastery", "AutoDepositUnlocked", "Cocoon",
	"Gallery", "Stats", "Settings", "Tutorial", "WeeklyChallengeClaimed",
}
local SYNC_SET = {}
for _, k in ipairs(SYNC_KEYS) do
	SYNC_SET[k] = true
end

local function sanitizedRaid(profile)
	local r = profile.Raid
	return {
		ShieldUntil = r.ShieldUntil,
		Attempts = r.Attempts,
		Successes = r.Successes,
		Defended = r.Defended,
		Lost = r.Lost,
		History = r.History,
		LastRaidAt = r.LastRaidAt,
		NewPlayerShield = PlayerService.HasNewPlayerShield(profile),
	}
end

function PlayerService.HasNewPlayerShield(profile)
	return profile.Stats.PlayTime < Config.Raid.NewPlayerShieldPlaytime and profile.Sparks.VaultLevel < Config.Raid.NewPlayerShieldMinVaultLevel
end

function PlayerService.BuildState(player, profile)
	local state = {}
	for _, k in ipairs(SYNC_KEYS) do
		state[k] = profile[k]
	end
	state.Raid = sanitizedRaid(profile)
	state.Commissions = Registry.Get("CommissionService").View(player, profile)
	state.ServerInfo = {
		Mock = Registry.Get("DataService").IsMock(),
		ThemeId = Registry.Get("ThemeService").CurrentThemeId(),
		WeeklyProgress = Registry.Get("ThemeService").Progress(profile),
	}
	return state
end

-- Segna sezioni da inviare; l'invio è coalescente (max N al secondo)
function PlayerService.Sync(player, ...)
	if not player or not player.Parent then
		return
	end
	local set = dirty[player]
	if not set then
		set = {}
		dirty[player] = set
	end
	for _, k in ipairs({ ... }) do
		set[k] = true
	end
end

function PlayerService.SyncAll(player)
	PlayerService.Sync(player, table.unpack(SYNC_KEYS))
	PlayerService.Sync(player, "Raid", "Commissions")
end

local function flush(player)
	local set = dirty[player]
	if not set or not ready[player] then
		return
	end
	dirty[player] = nil
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return
	end
	local payload = {}
	for k in pairs(set) do
		if k == "Raid" then
			payload.Raid = sanitizedRaid(profile)
		elseif k == "Commissions" then
			payload.Commissions = Registry.Get("CommissionService").View(player, profile)
		elseif k == "ServerInfo" then
			payload.ServerInfo = {
				Mock = Registry.Get("DataService").IsMock(),
				ThemeId = Registry.Get("ThemeService").CurrentThemeId(),
				WeeklyProgress = Registry.Get("ThemeService").Progress(profile),
			}
		elseif SYNC_SET[k] then
			payload[k] = profile[k]
		end
	end
	Net.Event("StateSync"):FireClient(player, payload)
end

function PlayerService.Toast(player, message, kind)
	if player and player.Parent then
		Net.Event("Toast"):FireClient(player, message, kind or "info")
	end
end

function PlayerService.Sound(player, soundKey)
	if player and player.Parent then
		Net.Event("PlaySound"):FireClient(player, soundKey)
	end
end

function PlayerService.Init()
	Net.Function("GetState").OnServerInvoke = function(player)
		local profile = Registry.Get("DataService").WaitFor(player, 30)
		if not profile then
			return nil
		end
		ready[player] = true
		dirty[player] = nil
		return PlayerService.BuildState(player, profile)
	end

	Net.Event("ClientReady").OnServerEvent:Connect(function(player)
		ready[player] = true
	end)

	Net.Event("SetSetting").OnServerEvent:Connect(function(player, settingKey, value)
		local profile = Registry.Get("DataService").Get(player)
		if not profile then
			return
		end
		local k = Guard.Str(settingKey, 32)
		if not k or profile.Settings[k] == nil then
			return
		end
		local v = Guard.Bool(value)
		if v == nil then
			return
		end
		if k == "AutoDeposit" and v and not profile.AutoDepositUnlocked then
			return
		end
		profile.Settings[k] = v
		PlayerService.Sync(player, "Settings")
		if k == "HideProfile" or k == "ShowName" then
			Registry.Get("GalleryService").MarkDirty(player)
		end
	end)
end

function PlayerService.Start()
	-- Flush coalescente
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 1 / Config.Limits.StateSyncMaxPerSecond then
			return
		end
		acc = 0
		for player in pairs(dirty) do
			if player.Parent then
				flush(player)
			else
				dirty[player] = nil
			end
		end
	end)

	-- Tempo di gioco
	task.spawn(function()
		while true do
			task.wait(10)
			for player, profile in pairs(Registry.Get("DataService").GetAll()) do
				profile.Stats.PlayTime += 10
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
		ready[player] = nil
		lastSync[player] = nil
	end)

	EventBus.On("ProfileLoaded", function(player, profile)
		PlayerService.SyncAll(player)
	end)
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	PlotService: assegna un'isola a ogni giocatore, costruisce il vivaio dai dati del profilo,
	gestisce teletrasporti (hub ↔ vivaio), caduta dal bordo e visite al vivaio di altri.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Catalog.Cosmetics)
local PlotBuilder = require(Shared.Models.PlotBuilder)
local Net = require(Shared.Util.Net)

local WorldBuilder = require(script.Parent.Parent.World.WorldBuilder)
local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)
local Logger = require(script.Parent.Parent.Util.Logger)

local PlotService = {}

local plotsByPlayer = {} -- player -> { Index, Plot (PlotBuilder), Origin }
local freeIndices = {}
local playerLocation = {} -- player -> "home" | "hub" | "raid" | "visit"

function PlotService.BuildView(player, profile)
	local creatures = {}
	for uid, c in pairs(profile.Creatures) do
		if c.x ~= nil and c.z ~= nil then
			table.insert(creatures, { Uid = uid, Id = c.Id, Variant = c.Variant or "base", x = c.x, z = c.z, Buffer = c.Buffer or 0 })
		end
	end
	local equipped = profile.Cosmetics.Equipped
	return {
		Creatures = creatures,
		Layout = profile.LastValidLayout,
		Decorations = profile.Decorations.Placed,
		Skin = equipped.skin,
		OwnerName = profile.Settings.ShowName and player.DisplayName or nil,
		Nameplate = equipped.nameplate ~= "plate_nessuna" and equipped.nameplate or nil,
		Exposed = profile.Sparks.Exposed,
		Vault = profile.Sparks.Vault,
		VaultCap = Config.Vault.Capacities[profile.Sparks.VaultLevel] or Config.Vault.Capacities[#Config.Vault.Capacities],
	}
end

function PlotService.Get(player)
	return plotsByPlayer[player]
end

function PlotService.GetPlot(player)
	local e = plotsByPlayer[player]
	return e and e.Plot
end

function PlotService.Location(player)
	return playerLocation[player] or "hub"
end

function PlotService.SetLocation(player, loc)
	playerLocation[player] = loc
	player:SetAttribute("Location", loc)
end

local function teleport(player, cf)
	local char = player.Character
	if char and char.PrimaryPart then
		char:PivotTo(cf)
	end
end

function PlotService.TeleportHome(player)
	local e = plotsByPlayer[player]
	if not e then
		return false
	end
	teleport(player, e.Plot:SpawnCFrame())
	PlotService.SetLocation(player, "home")
	return true
end

function PlotService.TeleportHub(player)
	teleport(player, WorldBuilder.HubSpawnCFrame())
	PlotService.SetLocation(player, "hub")
end

-- È il giocatore fisicamente nel proprio vivaio (per "Raccogli tutto"/"Deposita")?
function PlotService.IsAtHome(player, maxDist)
	local e = plotsByPlayer[player]
	local char = player.Character
	if not e or not char or not char.PrimaryPart then
		return false
	end
	local d = (char.PrimaryPart.Position - e.Origin.Position)
	return math.abs(d.X) <= (maxDist or 48) and math.abs(d.Z) <= (maxDist or 48) and math.abs(d.Y) < 30
end

function PlotService.DistanceTo(player, position)
	local char = player.Character
	if not char or not char.PrimaryPart then
		return math.huge
	end
	return (char.PrimaryPart.Position - position).Magnitude
end

-- Collega i ProximityPrompt del vivaio (cassaforte e creature) al proprietario
local function wirePlot(player, plot)
	if plot.DepositPrompt then
		plot.DepositPrompt.Triggered:Connect(function(who)
			if who == player then
				Registry.Get("EconomyService").Deposit(player)
			end
		end)
	end
	local function wirePrompt(d)
		if d:IsA("ProximityPrompt") and d.Name == "CollectPrompt" then
			d.Triggered:Connect(function(who)
				if who == player then
					Registry.Get("EconomyService").Collect(player, d:GetAttribute("Uid"))
				end
			end)
		end
	end
	for _, d in ipairs(plot.Folders.Creatures:GetDescendants()) do
		wirePrompt(d)
	end
	plot.Folders.Creatures.DescendantAdded:Connect(wirePrompt)
end

local function assign(player, profile)
	local index = table.remove(freeIndices, 1)
	if not index then
		Logger.Warn("Plot", "Nessun plot libero per", player.Name)
		player:Kick("Server pieno, riprova tra poco.")
		return
	end
	local origin = WorldBuilder.PlotOrigin(index)
	local plot = PlotBuilder.Build(Workspace.Plots, origin, PlotService.BuildView(player, profile), "home")
	plot.Model.Name = "Plot_" .. index
	plot.Model:SetAttribute("OwnerUserId", player.UserId)
	plot.Model:SetAttribute("OwnerName", player.Name)
	plotsByPlayer[player] = { Index = index, Plot = plot, Origin = origin }
	player:SetAttribute("PlotIndex", index)

	wirePlot(player, plot)

	-- al primo spawn porta il giocatore sul suo vivaio
	local function onCharacter(char)
		char:WaitForChild("HumanoidRootPart", 5)
		task.wait(0.2)
		if plotsByPlayer[player] and playerLocation[player] ~= "raid" and playerLocation[player] ~= "visit" then
			PlotService.TeleportHome(player)
		end
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end

local function release(player)
	local e = plotsByPlayer[player]
	if e then
		e.Plot:Destroy()
		table.insert(freeIndices, e.Index)
		plotsByPlayer[player] = nil
	end
	playerLocation[player] = nil
end

-- Aggiornamenti incrementali chiamati dagli altri servizi
function PlotService.RefreshCreature(player, uid)
	local e = plotsByPlayer[player]
	local profile = Registry.Get("DataService").Get(player)
	if not e or not profile then
		return
	end
	local c = profile.Creatures[uid]
	if c and c.x ~= nil then
		e.Plot:AddCreature({ Uid = uid, Id = c.Id, Variant = c.Variant or "base", x = c.x, z = c.z, Buffer = c.Buffer or 0 })
	else
		e.Plot:RemoveCreature(uid)
	end
end

function PlotService.RefreshBuffer(player, uid)
	local e = plotsByPlayer[player]
	local profile = Registry.Get("DataService").Get(player)
	if not e or not profile then
		return
	end
	local c = profile.Creatures[uid]
	if c then
		e.Plot:SetCreatureBuffer(uid, c.Buffer or 0, c.Id)
	end
end

function PlotService.RefreshSparks(player)
	local e = plotsByPlayer[player]
	local profile = Registry.Get("DataService").Get(player)
	if not e or not profile then
		return
	end
	e.Plot:SetExposed(profile.Sparks.Exposed)
	e.Plot:SetVault(profile.Sparks.Vault, Config.Vault.Capacities[profile.Sparks.VaultLevel])
end

function PlotService.RefreshLayout(player)
	local e = plotsByPlayer[player]
	local profile = Registry.Get("DataService").Get(player)
	if not e or not profile then
		return
	end
	-- la cupola cambia la struttura della pozza: ricostruzione completa
	local hadCupola, hasCupola = false, false
	for _, m in ipairs(e.Plot.View.Layout.Modules or {}) do
		if m.Id == "cupola" then
			hadCupola = true
		end
	end
	for _, m in ipairs(profile.LastValidLayout.Modules or {}) do
		if m.Id == "cupola" then
			hasCupola = true
		end
	end
	if hadCupola ~= hasCupola then
		PlotService.Rebuild(player)
		return
	end
	e.Plot.View.Layout = profile.LastValidLayout
	e.Plot:RebuildModules(profile.LastValidLayout)
end

function PlotService.RefreshDecorations(player)
	local e = plotsByPlayer[player]
	local profile = Registry.Get("DataService").Get(player)
	if e and profile then
		e.Plot:RebuildDecorations(profile.Decorations.Placed)
	end
end

function PlotService.RefreshSkin(player)
	local e = plotsByPlayer[player]
	local profile = Registry.Get("DataService").Get(player)
	if e and profile then
		e.Plot:SetSkin(profile.Cosmetics.Equipped.skin)
	end
end

function PlotService.Rebuild(player)
	local e = plotsByPlayer[player]
	local profile = Registry.Get("DataService").Get(player)
	if not e or not profile then
		return
	end
	local wasHome = playerLocation[player] == "home"
	e.Plot:Destroy()
	local plot = PlotBuilder.Build(Workspace.Plots, e.Origin, PlotService.BuildView(player, profile), "home")
	plot.Model.Name = "Plot_" .. e.Index
	plot.Model:SetAttribute("OwnerUserId", player.UserId)
	e.Plot = plot
	wirePlot(player, plot)
	if wasHome then
		PlotService.TeleportHome(player)
	end
end

-- Trova il proprietario online di un plot dato lo userId
function PlotService.FindByUserId(userId)
	for player, e in pairs(plotsByPlayer) do
		if player.UserId == userId then
			return player, e
		end
	end
	return nil
end

function PlotService.Init()
	for i = 1, Config.Plots.Count do
		table.insert(freeIndices, i)
	end
	Net.Function("ReturnHome").OnServerInvoke = function(player)
		local loc = playerLocation[player]
		if loc == "raid" then
			Registry.Get("RaidService").Abort(player, "ritorno")
			return true
		end
		if loc == "visit" then
			Registry.Get("GalleryService").EndVisit(player)
		end
		return PlotService.TeleportHome(player)
	end
end

function PlotService.Start()
	EventBus.On("ProfileLoaded", function(player, profile)
		assign(player, profile)
	end)
	Players.PlayerRemoving:Connect(release)

	-- Prompt delle stazioni dell'hub e del pad verso l'hub nei plot
	Workspace.DescendantAdded:Connect(function(d)
		if d:IsA("ProximityPrompt") and d.Name == "StationPrompt" then
			d.Triggered:Connect(function(player)
				local station = d:GetAttribute("Station")
				if station == "home" then
					PlotService.TeleportHome(player)
				elseif station == "demo" then
					EventBus.Fire("DemoVisited", player)
					Net.Event("RaidEvent"):FireClient(player, "OpenPanel", { Panel = "demo" })
				else
					Net.Event("RaidEvent"):FireClient(player, "OpenPanel", { Panel = station })
				end
			end)
		end
	end)
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Name == "StationPrompt" then
			d.Triggered:Connect(function(player)
				local station = d:GetAttribute("Station")
				if station == "home" then
					PlotService.TeleportHome(player)
				elseif station == "demo" then
					EventBus.Fire("DemoVisited", player)
					Net.Event("RaidEvent"):FireClient(player, "OpenPanel", { Panel = "demo" })
				else
					Net.Event("RaidEvent"):FireClient(player, "OpenPanel", { Panel = station })
				end
			end)
		end
	end

	-- Caduta dal bordo / pad verso l'hub
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.25 then
			return
		end
		acc = 0
		for player, e in pairs(plotsByPlayer) do
			local char = player.Character
			local hrp = char and char.PrimaryPart
			if hrp then
				local loc = playerLocation[player]
				if loc ~= "raid" then
					if hrp.Position.Y < -60 then
						if loc == "home" then
							PlotService.TeleportHome(player)
						elseif loc == "visit" then
							Registry.Get("GalleryService").EndVisit(player)
							PlotService.TeleportHome(player)
						else
							PlotService.TeleportHub(player)
						end
					elseif loc == "home" and e.Plot.HubPad then
						local d = hrp.Position - e.Plot.HubPad.Position
						if math.abs(d.X) < 2.4 and math.abs(d.Z) < 2.4 and d.Y > 0 and d.Y < 6 then
							PlotService.TeleportHub(player)
						end
					end
				end
			end
		end
	end)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">PoolStore</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	PoolStore: archivio condiviso tra server delle "istantanee" dei vivai pubblicati.
	Serve a: matchmaking asincrono delle incursioni (nessuna attesa che il proprietario sia online),
	galleria, codici layout. Include la "inbox" degli esiti di raid per i proprietari offline.
	Bucket per fascia: chiave "tier_<n>" -> { Entries = { [userId] = snapshot } }.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Store = require(script.Parent.Parent.Util.Store)
local Logger = require(script.Parent.Parent.Util.Logger)

local PoolStore = {}
local poolStore, inboxStore
local cache = {} -- tier -> { Time, Entries }
local CACHE_SECONDS = 45

function PoolStore.Init()
	poolStore = Store.new(Config.RaidPoolStoreName)
	inboxStore = Store.new(Config.RaidInboxStoreName)
end

local function bucketKey(tier)
	return "tier_" .. tier
end

local function trim(entries)
	local list = {}
	for id, e in pairs(entries) do
		table.insert(list, { id = id, t = e.Updated or 0 })
	end
	if #list <= Config.Raid.PoolBucketLimit then
		return entries
	end
	table.sort(list, function(a, b)
		return a.t > b.t
	end)
	local keep = {}
	for i = 1, Config.Raid.PoolBucketLimit do
		keep[list[i].id] = entries[list[i].id]
	end
	return keep
end

function PoolStore.Upsert(snapshot)
	local key = bucketKey(snapshot.Tier)
	local id = tostring(snapshot.UserId)
	local ok, result = poolStore:Update(key, function(old)
		old = old or { Entries = {} }
		old.Entries = old.Entries or {}
		local existing = old.Entries[id]
		if existing then
			snapshot.Likes = math.max(existing.Likes or 0, snapshot.Likes or 0)
		end
		old.Entries[id] = snapshot
		old.Entries = trim(old.Entries)
		return old
	end)
	if ok then
		cache[snapshot.Tier] = { Time = os.clock(), Entries = result and result.Entries or {} }
	end
	return ok
end

function PoolStore.Remove(userId, tier)
	local id = tostring(userId)
	poolStore:Update(bucketKey(tier), function(old)
		if not old or not old.Entries or not old.Entries[id] then
			return nil
		end
		old.Entries[id] = nil
		return old
	end)
	if cache[tier] then
		cache[tier].Entries[id] = nil
	end
end

function PoolStore.GetBucket(tier, force)
	local c = cache[tier]
	if c and not force and os.clock() - c.Time < CACHE_SECONDS then
		return c.Entries
	end
	local ok, data = poolStore:Get(bucketKey(tier))
	local entries = (ok and data and data.Entries) or (c and c.Entries) or {}
	cache[tier] = { Time = os.clock(), Entries = entries }
	return entries
end

function PoolStore.AllEntries()
	local out = {}
	for tier = 1, #Config.Raid.TierTakeCaps do
		for id, e in pairs(PoolStore.GetBucket(tier)) do
			out[id] = e
		end
	end
	return out
end

function PoolStore.FindByUserId(userId)
	local id = tostring(userId)
	for tier = 1, #Config.Raid.TierTakeCaps do
		local e = PoolStore.GetBucket(tier)[id]
		if e then
			return e, tier
		end
	end
	return nil
end

-- Modifica atomica di una voce (es. dopo un raid riuscito contro un proprietario offline)
function PoolStore.ModifyEntry(userId, tier, fn)
	local id = tostring(userId)
	local ok, result = poolStore:Update(bucketKey(tier), function(old)
		if not old or not old.Entries or not old.Entries[id] then
			return nil
		end
		local e = old.Entries[id]
		fn(e)
		e.Updated = e.Updated or os.time()
		return old
	end)
	if ok and result and result.Entries then
		cache[tier] = { Time = os.clock(), Entries = result.Entries }
	end
	return ok
end

-- ───────────────────────── inbox esiti raid ─────────────────────────

function PoolStore.PushInbox(userId, item)
	local ok = inboxStore:Update("inbox_" .. userId, function(old)
		old = old or { Items = {} }
		table.insert(old.Items, item)
		while #old.Items > Config.Raid.InboxLimit do
			table.remove(old.Items, 1)
		end
		return old
	end)
	if not ok then
		Logger.Warn("Pool", "Inbox non aggiornata per", userId)
	end
	return ok
end

-- Preleva e svuota gli elementi (restituisce la lista)
function PoolStore.DrainInbox(userId)
	local drained = {}
	local ok = inboxStore:Update("inbox_" .. userId, function(old)
		if not old or not old.Items or #old.Items == 0 then
			return nil
		end
		drained = old.Items
		return { Items = {} }
	end)
	if not ok then
		return {}
	end
	return drained
end

function PoolStore.IsMock()
	return poolStore:IsMock()
end

return PoolStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">RaidService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	RaidService: incursioni asincrone istanziate.
	- Matchmaking per fascia, difficoltà del layout e tasso di successo recente; esclude
	  bersagli con scudo, con 2 perdite nella finestra di 30 minuti, protetti (nuovi) o
	  già colpiti di recente. Nessuna identità mostrata.
	- Arena: copia del layout difensivo del bersaglio; ostacoli simulati dal server
	  (sentinelle, piattaforme, campana, ponte, faro). Errori → checkpoint, mai combattimento.
	- Esiti verificati dal server: bottino ≤ 25% delle esposte e ≤ tetto di fascia; difensore
	  riceve bonus (sistema) o consolazione; proprietari offline ricevono tutto via inbox.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Creatures = require(Shared.Catalog.Creatures)
local Simulated = require(Shared.Catalog.SimulatedVivai)
local LayoutValidator = require(Shared.LayoutValidator)
local PlotBuilder = require(Shared.Models.PlotBuilder)
local ModuleModel = require(Shared.Models.ModuleModel)
local Net = require(Shared.Util.Net)
local TableUtil = require(Shared.Util.TableUtil)

local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)
local Guard = require(script.Parent.Parent.Util.Guard)
local Logger = require(script.Parent.Parent.Util.Logger)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local PoolStore = require(script.Parent.PoolStore)
local ArenaPool = require(script.Parent.Parent.World.ArenaPool)

local RaidService = {}
local R = Config.Raid

local offered = {} -- player -> { [key] = targetInfo }
local active = {} -- player -> raid
local limiter = RateLimiter.new(6, 0.5)

local function data()
	return Registry.Get("DataService")
end
local function ps()
	return Registry.Get("PlayerService")
end
local function eco()
	return Registry.Get("EconomyService")
end
local function send(player, name, payload)
	if player.Parent then
		Net.Event("RaidEvent"):FireClient(player, name, payload or {})
	end
end

-- ───────────────────────── matchmaking ─────────────────────────

local function recentLossCount(lossTs, now)
	local n = 0
	for _, t in ipairs(lossTs or {}) do
		if now - t < R.LossWindowSeconds then
			n += 1
		end
	end
	return n
end

local function successRate(profile)
	local results = profile.Raid.RecentResults
	if #results == 0 then
		return 0.5
	end
	local s = 0
	for _, r in ipairs(results) do
		s += r
	end
	return s / #results
end

local function maxTakeFor(exposed, tier)
	return math.min(math.floor(exposed * R.MaxTakeFraction), R.TierTakeCaps[math.clamp(tier, 1, #R.TierTakeCaps)])
end

local function simulatedTarget(sim)
	return {
		Key = sim.Key,
		Name = sim.Name,
		Tier = sim.Tier,
		Difficulty = LayoutValidator.DifficultyStars(LayoutValidator.Validate(sim.Layout, {}).Difficulty or 0),
		ExposedEstimate = sim.Exposed,
		MaxTake = math.floor(maxTakeFor(sim.Exposed, sim.Tier) * R.SimulatedRewardFraction),
		Simulated = true,
		ModuleCount = #sim.Layout.Modules,
		Snapshot = sim,
	}
end

function RaidService.RequestTargets(player)
	local profile = data().Get(player)
	if not profile then
		return nil
	end
	if not limiter:Allow(player.UserId .. ":targets") then
		return nil, Strings.TooFast
	end
	local now = os.time()
	local myTier = eco().Tier(profile)
	local rate = successRate(profile)
	local candidates = {}
	for tier = math.max(1, myTier - 1), math.min(#R.TierTakeCaps, myTier + 1) do
		for id, e in pairs(PoolStore.GetBucket(tier)) do
			local uid = tonumber(id)
			local ok = uid ~= player.UserId
				and (e.Updated or 0) > now - 7 * 86400
				and (e.ShieldUntil or 0) < now
				and not e.Protected
				and recentLossCount(e.LossTs, now) < R.MaxLossesPerWindow
				and (e.Exposed or 0) >= 40
				and (profile.Raid.RecentTargets["u_" .. id] or 0) < now - R.RepeatTargetCooldown
				and e.Layout ~= nil
			-- un proprietario online in questo server e in incursione/visita va bene comunque: la copia è istanziata
			if ok then
				-- punteggio: preferisci difficoltà adatta al tasso di successo e fascia vicina
				local stars = e.Stars or 1
				local desired = 1 + rate * 4 -- chi vince spesso vede layout più difficili
				local score = -math.abs(stars - desired) * 2 - math.abs(tier - myTier) * 1.5 + math.random() * 0.8
				table.insert(candidates, { Entry = e, Tier = tier, Score = score, UserId = uid })
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.Score > b.Score
	end)
	local list = {}
	local offer = {}
	for i = 1, math.min(#candidates, R.CandidateCount - 1) do
		local c = candidates[i]
		local e = c.Entry
		local t = {
			Key = "u_" .. c.UserId,
			Name = "Vivaio rivale · fascia " .. c.Tier, -- nessuna identità
			Tier = c.Tier,
			Difficulty = e.Stars or 1,
			ExposedEstimate = e.Exposed or 0,
			MaxTake = maxTakeFor(e.Exposed or 0, c.Tier),
			Simulated = false,
			ModuleCount = #((e.Layout and e.Layout.Modules) or {}),
		}
		table.insert(list, t)
		offer[t.Key] = { Info = t, Snapshot = e, Tier = c.Tier, UserId = c.UserId }
	end
	-- almeno un Vivaio del Guardiano, sempre
	local sims = Simulated.ForTier(myTier)
	TableUtil.Shuffle(sims)
	for i = 1, math.max(1, R.CandidateCount - #list) do
		local sim = sims[((i - 1) % #sims) + 1]
		if sim and not offer[sim.Key] then
			local t = simulatedTarget(sim)
			table.insert(list, t)
			offer[t.Key] = { Info = t, Snapshot = sim, Simulated = true }
		end
	end
	-- tutorial: proponi l'allenamento
	if profile.Tutorial.Active and profile.Tutorial.Step == 4 then
		local sim = Simulated.ByKey.sim_allenamento
		local t = simulatedTarget(sim)
		table.insert(list, 1, t)
		offer[t.Key] = { Info = t, Snapshot = sim, Simulated = true }
	end
	offered[player] = offer
	return { Targets = list, Cooldown = math.max(0, (profile.Raid.LastRaidAt + R.AttackerCooldownSeconds) - now) }
end

-- ───────────────────────── istanza ─────────────────────────

local function viewFromSnapshot(snapshot, simulated)
	local creatures = {}
	for i, c in ipairs(snapshot.Creatures or {}) do
		table.insert(creatures, { Uid = "r" .. i, Id = c.Id, Variant = c.Variant or "base", x = c.x, z = c.z, Buffer = 0 })
	end
	return {
		Creatures = creatures,
		Layout = snapshot.Layout or { Modules = {} },
		Decorations = snapshot.Decorations or {},
		Skin = snapshot.Skin or "skin_prato",
		Exposed = snapshot.Exposed or 0,
	}
end

local function setupRuntime(raid)
	local plot = raid.Plot
	local rt = { Sentinels = {}, Platforms = {}, Zones = {}, Faro = {}, Bridges = {}, Bell = nil }
	for _, model in ipairs(plot.Folders.Modules:GetChildren()) do
		local id = model:GetAttribute("ModuleId")
		local root = model.PrimaryPart
		if id == "sentinella" then
			local cone = model:FindFirstChild("Cone")
			local pillar = model:FindFirstChild("Pillar")
			if cone and pillar and root then
				table.insert(rt.Sentinels, {
					Model = model, Root = root, Cone = cone, Base = root.Position, Radius = cone:GetAttribute("Radius") or 9,
					Arc = cone:GetAttribute("Arc") or 50, Speed = cone:GetAttribute("Speed") or 55, Erratic = cone:GetAttribute("Erratic") == true,
					Offset = math.random() * 360,
				})
			end
		elseif id == "piattaforma" then
			for _, name in ipairs({ "Platform", "Platform2" }) do
				local p = model:FindFirstChild(name)
				if p and root then
					table.insert(rt.Platforms, { Part = p, Root = root, Period = p:GetAttribute("Period") or 3.2, Travel = p:GetAttribute("Travel") or 8, Phase = p:GetAttribute("Phase") or 0, LastPos = p.Position })
				end
			end
		elseif id == "corrente" then
			local zone = model:FindFirstChild("Zone")
			if zone then
				table.insert(rt.Zones, { Zone = zone, Pulse = zone:GetAttribute("Pulse") == true, Period = zone:GetAttribute("PulsePeriod") or 2.4 })
			end
		elseif id == "faro" and root then
			table.insert(rt.Faro, { Root = root, Radius = root:GetAttribute("TriggerRadius") or 3.2, Dazzle = root:GetAttribute("Dazzle") or 3.5 })
		elseif id == "arcobaleno" then
			local bridge = model:FindFirstChild("Bridge")
			if bridge then
				local stripes = {}
				for _, s in ipairs(model:GetChildren()) do
					if s:GetAttribute("BridgeVisual") then
						table.insert(stripes, s)
					end
				end
				table.insert(rt.Bridges, { Part = bridge, Stripes = stripes, Period = bridge:GetAttribute("Period") or 4 })
			end
		elseif id == "campana" and root then
			rt.Bell = { Root = root, Fraction = root:GetAttribute("TriggerFraction") or 0.5, Rung = false }
		end
	end
	raid.Runtime = rt
end

local function teleportToCheckpoint(raid, reason)
	local player = raid.Player
	local char = player.Character
	if char and char.PrimaryPart then
		char:PivotTo(raid.Checkpoint)
		local hrp = char.PrimaryPart
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	raid.Checkpoints += 1
	raid.LastTeleport = os.clock()
	send(player, "Checkpoint", { Reason = reason })
	ps().Sound(player, "Whoosh")
end

local function dazzle(raid, seconds)
	local player = raid.Player
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or raid.DazzledUntil > os.clock() then
		return
	end
	raid.DazzledUntil = os.clock() + seconds
	raid.DazzleCount += 1
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.UseJumpPower = true
	send(player, "Dazzled", { Seconds = seconds })
	ps().Sound(player, "Sentinel")
	task.delay(seconds, function()
		if active[player] == raid and hum.Parent then
			hum.WalkSpeed = 18
			hum.JumpPower = 50
		end
	end)
end

local function progressFraction(raid, hrp)
	local origin = raid.Slot.Origin
	local lp = origin:PointToObjectSpace(hrp.Position)
	-- da z=-32 (ingresso) a 0 (pozza) a +32 (uscita)
	if raid.Phase == 1 then
		return math.clamp((lp.Z + 32) / 32, 0, 1) * 0.5
	end
	return 0.5 + math.clamp(lp.Z / 32, 0, 1) * 0.5
end

local function step(raid, dt)
	local player = raid.Player
	local char = player.Character
	local hrp = char and char.PrimaryPart
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local now = os.clock()
	if not hrp or not hum or hum.Health <= 0 then
		-- personaggio in respawn: tolleriamo fino a 12 s, poi consideriamo abbandono
		raid.MissingSince = raid.MissingSince or now
		if now - raid.MissingSince > 12 then
			return "abbandono"
		end
		return nil
	end
	raid.MissingSince = nil
	local t = now - raid.StartTime
	local rt = raid.Runtime
	local origin = raid.Slot.Origin

	if raid.Countdown then
		if t >= R.StartCountdown then
			raid.Countdown = false
			raid.StartTime = now
			send(player, "Go")
			t = 0
		else
			return nil
		end
	end

	if t >= raid.Duration then
		return "tempo"
	end

	-- caduta
	if hrp.Position.Y < origin.Y - 25 then
		raid.Falls += 1
		teleportToCheckpoint(raid, "caduta")
		return nil
	end

	-- anti-exploit leggero: spostamenti impossibili
	if raid.LastPos and now - raid.LastTeleport > 0.6 then
		local speed = (hrp.Position - raid.LastPos).Magnitude / math.max(dt, 1 / 60)
		if speed > 140 then
			raid.Anomalies += 1
			teleportToCheckpoint(raid, "anomalia")
			return nil
		end
	end
	raid.LastPos = hrp.Position

	-- sentinelle
	for _, s in ipairs(rt.Sentinels) do
		local angle = s.Offset + t * s.Speed
		if s.Erratic then
			angle += math.sin(t * 1.7) * 45
		end
		local baseCF = ModuleModel.OrientSentinel(s.Model, angle) or CFrame.new(s.Base)
		local rel = hrp.Position - s.Base
		local flat = Vector3.new(rel.X, 0, rel.Z)
		if flat.Magnitude <= s.Radius and rel.Y > -3 and rel.Y < 7 and raid.DazzledUntil < now and now - raid.LastTeleport > 0.8 then
			-- direzione del cono: -Z locale ruotata
			local coneDir = baseCF.LookVector
			local cosang = flat.Unit:Dot(coneDir)
			if cosang >= math.cos(math.rad(s.Arc / 2)) then
				raid.SentinelHits += 1
				send(player, "Spotted")
				teleportToCheckpoint(raid, "sentinella")
				return nil
			end
		end
	end

	-- piattaforme mobili (anchored + velocità per trasportare il personaggio)
	for _, p in ipairs(rt.Platforms) do
		local phase = (t / p.Period + p.Phase) * math.pi * 2
		local z = math.sin(phase) * (p.Travel / 2)
		local target = p.Root.CFrame * CFrame.new(0, 0.1, z)
		local newPos = target.Position
		p.Part.CFrame = CFrame.new(newPos) * (p.Root.CFrame - p.Root.CFrame.Position)
		p.Part.AssemblyLinearVelocity = (newPos - p.LastPos) / math.max(dt, 1 / 60)
		p.LastPos = newPos
	end

	-- correnti pulsanti
	for _, z in ipairs(rt.Zones) do
		if z.Pulse then
			local on = (t % z.Period) < z.Period * 0.55
			if z.Zone:GetAttribute("Active") ~= on then
				z.Zone:SetAttribute("Active", on)
			end
		end
	end

	-- campana del vento: inverte le correnti a metà tempo
	if rt.Bell and not rt.Bell.Rung and t >= raid.Duration * rt.Bell.Fraction then
		rt.Bell.Rung = true
		for _, z in ipairs(rt.Zones) do
			z.Zone:SetAttribute("Dir", -(z.Zone:GetAttribute("Dir") or 1))
		end
		send(player, "Bell")
		ps().Sound(player, "Chime")
	end

	-- ponte arcobaleno intermittente
	for _, b in ipairs(rt.Bridges) do
		local visible = (t % b.Period) < b.Period * 0.5
		if b.Part:GetAttribute("Visible") ~= visible then
			b.Part:SetAttribute("Visible", visible)
			b.Part.CanCollide = visible
			b.Part.Transparency = visible and 0.1 or 0.9
			for _, s in ipairs(b.Stripes) do
				s.Transparency = visible and 0.15 or 0.95
			end
		end
	end

	-- faro distrattore
	for _, f in ipairs(rt.Faro) do
		if raid.DazzledUntil < now and (hrp.Position - f.Root.Position).Magnitude <= f.Radius + 1.5 then
			dazzle(raid, f.Dazzle)
		end
	end

	-- obiettivi
	local plot = raid.Plot
	if raid.Phase == 1 then
		local rel = hrp.Position - plot.Pozza.Position
		if Vector3.new(rel.X, 0, rel.Z).Magnitude <= 4.6 and math.abs(rel.Y) < 7 then
			raid.Phase = 2
			raid.PozzaAt = t
			raid.Checkpoint = CFrame.new(plot.Pozza.Position + Vector3.new(0, 4, 0))
			plot.Pozza.Color = Color3.fromRGB(190, 200, 230)
			plot.PozzaEmitter.Enabled = false
			send(player, "Collected", { Amount = raid.Info.MaxTake })
			ps().Sound(player, "Collect")
		end
	else
		local rel = hrp.Position - plot.Exit.Position
		if Vector3.new(rel.X, 0, rel.Z).Magnitude <= 4 and rel.Y > -2 and rel.Y < 8 then
			return "successo"
		end
	end
	return nil
end

-- ───────────────────────── esiti ─────────────────────────

local function pushHistory(profile, entry)
	table.insert(profile.Raid.History, entry)
	TableUtil.Truncate(profile.Raid.History, 10)
end

-- Applica una perdita al difensore (online qui o tramite inbox già scaricata)
function RaidService.ApplyLoss(player, profile, item)
	if profile.Raid.AppliedInbox[item.RaidId] then
		return
	end
	profile.Raid.AppliedInbox[item.RaidId] = true
	table.insert(profile.Raid.AppliedInboxOrder, item.RaidId)
	while #profile.Raid.AppliedInboxOrder > 60 do
		local old = table.remove(profile.Raid.AppliedInboxOrder, 1)
		profile.Raid.AppliedInbox[old] = nil
	end
	local now = os.time()
	-- scudo o finestra già saturi (raid partiti da un'istantanea vecchia): la perdita decade
	if profile.Raid.ShieldUntil > now or recentLossCount(profile.Raid.LossTimestamps, now) >= R.MaxLossesPerWindow or Registry.Get("PlayerService").HasNewPlayerShield(profile) then
		return
	end
	local exposedNow = eco().ExposedTotal(profile)
	local amount = math.min(item.Amount or 0, math.floor(exposedNow * R.MaxTakeFraction))
	if amount <= 0 then
		return
	end
	eco().RemoveExposed(player, profile, amount)
	table.insert(profile.Raid.LossTimestamps, now)
	while #profile.Raid.LossTimestamps > 10 do
		table.remove(profile.Raid.LossTimestamps, 1)
	end
	profile.Raid.ShieldUntil = now + R.ShieldAfterLossSeconds
	profile.Raid.Lost += 1
	profile.Stats.RaidsLost += 1
	local consolation = math.max(5, math.floor(amount * R.DefenderConsolationFraction))
	eco().GrantSafe(player, profile, consolation, "consolation")
	pushHistory(profile, { Type = "lost", Time = now, Amount = amount, Consolation = consolation })
	EventBus.Fire("RaidLost", player, amount)
	ps().Sync(player, "Raid", "Stats")
	ps().Toast(player, string.format(Strings.RaidLostToast, amount, consolation), "warning")
	Logger.Audit("Raid", player, "loss_applied", string.format("raid=%s amount=%d", item.RaidId, amount))
	Registry.Get("GalleryService").MarkDirty(player)
end

function RaidService.ApplyDefend(player, profile, item)
	if profile.Raid.AppliedInbox[item.RaidId] then
		return
	end
	profile.Raid.AppliedInbox[item.RaidId] = true
	table.insert(profile.Raid.AppliedInboxOrder, item.RaidId)
	profile.Raid.Defended += 1
	profile.Stats.RaidsDefended += 1
	profile.Mastery.Defense += R.MasteryDefend
	eco().GrantSafe(player, profile, R.DefenderBonus, "defense_bonus")
	pushHistory(profile, { Type = "defended", Time = os.time(), Amount = R.DefenderBonus, Feedback = item.Feedback })
	EventBus.Fire("RaidDefended", player, R.DefenderBonus)
	Registry.Get("AlbumService").CheckMastery(player, profile)
	ps().Sync(player, "Raid", "Stats", "Mastery")
	ps().Toast(player, string.format(Strings.RaidDefendedToast, R.DefenderBonus), "success")
end

local function drainInbox(player, profile)
	local items = PoolStore.DrainInbox(player.UserId)
	for _, item in ipairs(items) do
		if item.Type == "loss" then
			RaidService.ApplyLoss(player, profile, item)
		elseif item.Type == "defend" then
			RaidService.ApplyDefend(player, profile, item)
		end
	end
end

local function notifyDefender(raid, success, take, feedback)
	local userId = raid.Offer.UserId
	if not userId then
		return
	end
	local raidId = raid.Id
	local item = { RaidId = raidId, Type = success and "loss" or "defend", Amount = take, Time = os.time(), Feedback = feedback }
	local victim = Players:GetPlayerByUserId(userId)
	local victimProfile = victim and data().Get(victim)
	if victimProfile then
		if success then
			RaidService.ApplyLoss(victim, victimProfile, item)
		else
			RaidService.ApplyDefend(victim, victimProfile, item)
		end
		return
	end
	PoolStore.PushInbox(userId, item)
	if success then
		-- aggiorna l'istantanea così il matchmaking rispetta scudo e finestra perdite
		PoolStore.ModifyEntry(userId, raid.Offer.Tier, function(e)
			e.Exposed = math.max(0, (e.Exposed or 0) - take)
			e.LossTs = e.LossTs or {}
			table.insert(e.LossTs, os.time())
			e.ShieldUntil = os.time() + R.ShieldAfterLossSeconds
		end)
	end
end

local function finish(raid, reason)
	local player = raid.Player
	if active[player] ~= raid then
		return
	end
	active[player] = nil
	raid.Ended = true
	local profile = data().Get(player)
	local now = os.clock()
	local duration = raid.Countdown and 0 or (now - raid.StartTime)
	local success = reason == "successo" and duration >= R.MinPlausibleSeconds and raid.Phase == 2 and raid.Anomalies < 3

	local feedback = {}
	if raid.SentinelHits > 0 then
		table.insert(feedback, string.format(Strings.RaidFeedbackSentinel, raid.SentinelHits))
	end
	if raid.Falls > 0 then
		table.insert(feedback, string.format(Strings.RaidFeedbackFall, raid.Falls))
	end
	if reason == "tempo" then
		local char = player.Character
		local frac = (char and char.PrimaryPart) and progressFraction(raid, char.PrimaryPart) or 0
		table.insert(feedback, string.format(Strings.RaidFeedbackTime, math.floor(frac * 100)))
	end
	if success and raid.Checkpoints == 0 then
		table.insert(feedback, Strings.RaidFeedbackClean)
	end

	local summary = {
		Success = success,
		Take = 0,
		Participation = 0,
		Mastery = 0,
		Feedback = feedback,
		Duration = math.floor(duration),
		Simulated = raid.Simulated,
		Test = raid.Test,
		Checkpoints = raid.Checkpoints,
		Reason = reason,
	}

	if profile and not raid.Test then
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = 18
			hum.JumpPower = 50
		end
		profile.Raid.Attempts += 1
		profile.Raid.LastRaidAt = os.time()
		table.insert(profile.Raid.RecentResults, success and 1 or 0)
		TableUtil.Truncate(profile.Raid.RecentResults, 10)
		if success then
			local take = raid.Info.MaxTake
			if raid.Simulated then
				take = math.floor(maxTakeFor(raid.Offer.Snapshot.Exposed, raid.Offer.Snapshot.Tier) * R.SimulatedRewardFraction)
			else
				-- ricalcola sull'istantanea più recente (il bersaglio potrebbe aver depositato)
				local fresh = PoolStore.FindByUserId(raid.Offer.UserId)
				local exposed = fresh and fresh.Exposed or raid.Offer.Snapshot.Exposed
				local victim = Players:GetPlayerByUserId(raid.Offer.UserId)
				local victimProfile = victim and data().Get(victim)
				if victimProfile then
					exposed = eco().ExposedTotal(victimProfile)
				end
				take = maxTakeFor(exposed, raid.Offer.Tier)
			end
			summary.Take = take
			summary.Mastery = R.MasteryWin
			profile.Raid.Successes += 1
			profile.Stats.RaidsWon += 1
			eco().GrantExposed(player, profile, take, raid.Simulated and "raid_sim" or "raid")
		else
			if duration >= 20 or raid.Phase == 2 then
				summary.Participation = R.ParticipationReward
				eco().GrantSafe(player, profile, R.ParticipationReward, "raid_participation")
			end
			summary.Mastery = R.MasteryLoss
		end
		if not raid.Simulated then
			profile.Raid.RecentTargets[raid.Offer.Key] = os.time()
			-- pulizia bersagli vecchi
			for k, t in pairs(profile.Raid.RecentTargets) do
				if os.time() - t > R.RepeatTargetCooldown then
					profile.Raid.RecentTargets[k] = nil
				end
			end
			notifyDefender(raid, success, summary.Take, feedback)
		end
		pushHistory(profile, { Type = success and "won" or "failed", Time = os.time(), Amount = summary.Take + summary.Participation, Stars = raid.Info.Difficulty, Simulated = raid.Simulated })
		Registry.Get("AlbumService").AddMastery(player, "Raid", summary.Mastery)
		ps().Sync(player, "Raid", "Stats", "Sparks")
		EventBus.Fire("RaidCompleted", player, summary)
		Logger.Audit("Raid", player, success and "success" or "fail", string.format("id=%s target=%s take=%d reason=%s dur=%d", raid.Id, raid.Info.Key, summary.Take, reason, summary.Duration))
	elseif profile and raid.Test then
		EventBus.Fire("LayoutTested", player)
		EventBus.Fire("RaidCompleted", player, summary)
	end

	send(player, "Summary", summary)
	ps().Sound(player, success and "Success" or "Error")
	Registry.Get("PlotService").SetLocation(player, "home")
	task.delay(0.3, function()
		if player.Parent then
			Registry.Get("PlotService").TeleportHome(player)
		end
	end)
	task.delay(2, function()
		ArenaPool.Release(raid.Slot)
	end)
end

-- ───────────────────────── avvio ─────────────────────────

local function begin(player, profile, offer, test)
	local slot = ArenaPool.Acquire(test and "test" or "raid")
	if not slot then
		return false, "Tutte le arene sono occupate, riprova tra poco"
	end
	local view = viewFromSnapshot(offer.Snapshot, offer.Simulated)
	local plot = PlotBuilder.Build(slot.Folder, slot.Origin, view, "raid")
	local raid = {
		Id = HttpService:GenerateGUID(false),
		Player = player,
		Slot = slot,
		Plot = plot,
		Offer = offer,
		Info = offer.Info,
		Simulated = offer.Simulated == true,
		Test = test == true,
		StartTime = os.clock(),
		Countdown = true,
		Duration = R.DurationSeconds,
		Phase = 1,
		Checkpoint = plot:EntranceCFrame(),
		Checkpoints = 0,
		Falls = 0,
		SentinelHits = 0,
		DazzleCount = 0,
		Anomalies = 0,
		DazzledUntil = 0,
		LastTeleport = os.clock(),
		LastPos = nil,
	}
	setupRuntime(raid)
	active[player] = raid
	Registry.Get("GalleryService").EndVisit(player)
	Registry.Get("PlotService").SetLocation(player, "raid")
	local char = player.Character
	if char and char.PrimaryPart then
		char:PivotTo(raid.Checkpoint)
		char.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
	end
	send(player, "Start", {
		Duration = R.DurationSeconds,
		Countdown = R.StartCountdown,
		TargetName = offer.Info.Name,
		Simulated = raid.Simulated,
		Test = raid.Test,
		MaxTake = offer.Info.MaxTake,
		Difficulty = offer.Info.Difficulty,
	})
	ps().Sound(player, "Whoosh")
	return true
end

function RaidService.StartRaid(player, key)
	local profile = data().Get(player)
	if not profile then
		return false, Strings.Error
	end
	if active[player] then
		return false, "Sei già in un'incursione"
	end
	key = Guard.Str(key, 32)
	local offer = key and offered[player] and offered[player][key]
	if not offer then
		return false, "Bersaglio non più disponibile: aggiorna la lista"
	end
	local now = os.time()
	local remaining = (profile.Raid.LastRaidAt + R.AttackerCooldownSeconds) - now
	if remaining > 0 then
		return false, string.format(Strings.RaidCooldown, remaining)
	end
	if not offer.Simulated then
		-- ricontrolla lo stato fresco del bersaglio
		local fresh = PoolStore.FindByUserId(offer.UserId)
		if fresh then
			if (fresh.ShieldUntil or 0) > now or recentLossCount(fresh.LossTs, now) >= R.MaxLossesPerWindow or fresh.Protected then
				offered[player][key] = nil
				return false, "Questo vivaio è protetto al momento. Scegli un altro bersaglio."
			end
			offer.Snapshot = fresh
			offer.Info.ExposedEstimate = fresh.Exposed or 0
			offer.Info.MaxTake = maxTakeFor(fresh.Exposed or 0, offer.Tier)
		end
	end
	offered[player] = nil
	return begin(player, profile, offer, false)
end

function RaidService.StartTest(player)
	local profile = data().Get(player)
	if not profile then
		return false, Strings.Error
	end
	if active[player] then
		return false, "Sei già in un'incursione"
	end
	-- usa il layout in modifica se valido, altrimenti l'ultimo pubblicato
	local layout = profile.Layout
	local res = Registry.Get("DefenseService").Validate(profile, layout)
	if not res.Ok then
		layout = profile.LastValidLayout
		res = LayoutValidator.Validate(layout, {})
	end
	local snapshot = Registry.Get("GalleryService").BuildSnapshot(player, profile)
	snapshot.Layout = layout
	local info = {
		Key = "test",
		Name = Strings.RaidTestTitle,
		Tier = snapshot.Tier,
		Difficulty = LayoutValidator.DifficultyStars(res.Difficulty or 0),
		ExposedEstimate = snapshot.Exposed,
		MaxTake = 0,
		Simulated = true,
		ModuleCount = #(layout.Modules or {}),
	}
	return begin(player, profile, { Info = info, Snapshot = snapshot, Simulated = true, Test = true }, true)
end

function RaidService.Abort(player, reason)
	local raid = active[player]
	if raid then
		finish(raid, reason or "abbandono")
	end
end

function RaidService.IsInRaid(player)
	return active[player] ~= nil
end

function RaidService.Init()
	ArenaPool.Init()
	Net.Function("RequestRaidTargets").OnServerInvoke = RaidService.RequestTargets
	Net.Function("StartRaid").OnServerInvoke = function(player, key)
		if not limiter:Allow(player.UserId .. ":start", 2) then
			return false, Strings.TooFast
		end
		return RaidService.StartRaid(player, key)
	end
	Net.Event("RaidAbort").OnServerEvent:Connect(function(player)
		RaidService.Abort(player, "abbandono")
	end)
end

function RaidService.Start()
	RunService.Heartbeat:Connect(function(dt)
		for player, raid in pairs(active) do
			if not raid.Ended then
				local ok, result = pcall(step, raid, dt)
				if not ok then
					Logger.Warn("Raid", "Errore nello step:", result)
					finish(raid, "errore")
				elseif result then
					finish(raid, result)
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		local raid = active[player]
		if raid then
			finish(raid, "abbandono")
		end
		offered[player] = nil
	end)
	EventBus.On("ProfileLoaded", function(player, profile)
		task.delay(2, function()
			if player.Parent then
				drainInbox(player, profile)
			end
		end)
	end)
	-- controllo periodico della inbox per i giocatori online (esiti di raid subiti altrove)
	task.spawn(function()
		while true do
			task.wait(120)
			for player, profile in pairs(data().GetAll()) do
				task.spawn(drainInbox, player, profile)
				task.wait(0.5)
			end
		end
	end)
	-- la morte del personaggio durante un raid riporta al checkpoint (non termina il raid)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(char)
			local raid = active[player]
			if raid then
				task.wait(0.3)
				if active[player] == raid then
					teleportToCheckpoint(raid, "respawn")
				end
			end
		end)
	end)
end

return RaidService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	ShopService: cosmetici con gettoni stile, acquisti Robux opzionali (DeveloperProduct),
	Pass delle Nuvole trasparente, bundle fondatore (gamepass). Tutto idempotente via Ledger.
	Nessun acquisto tocca produzione, raid o protezioni.
]]
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Cosmetics = require(Shared.Catalog.Cosmetics)
local Decorations = require(Shared.Catalog.Decorations)
local Net = require(Shared.Util.Net)

local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)
local Guard = require(script.Parent.Parent.Util.Guard)
local Logger = require(script.Parent.Parent.Util.Logger)

local ShopService = {}

local function ps()
	return Registry.Get("PlayerService")
end

function ShopService.GrantCosmetic(player, profile, cosmeticId, reason)
	local c = Cosmetics.Get(cosmeticId)
	if not c then
		return false
	end
	if profile.Cosmetics.Owned[cosmeticId] then
		return false
	end
	profile.Cosmetics.Owned[cosmeticId] = true
	ps().Sync(player, "Cosmetics")
	Logger.Audit("Shop", player, "grant", cosmeticId .. " (" .. (reason or "?") .. ")")
	return true
end

function ShopService.Buy(player, id)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	id = Guard.Str(id, 48)
	if not id then
		return false, Strings.Error
	end
	-- decorazioni acquistabili con gettoni
	local deco = Decorations.ById[id]
	if deco and deco.TokenPrice then
		if profile.Decorations.Owned[id] then
			return false, Strings.ShopOwned
		end
		if profile.StyleTokens < deco.TokenPrice then
			return false, "Gettoni insufficienti"
		end
		profile.StyleTokens -= deco.TokenPrice
		Registry.Get("EconomyService").GrantDecoration(player, profile, id)
		ps().Sync(player, "StyleTokens", "Decorations")
		ps().Sound(player, "Success")
		return true
	end
	local c = Cosmetics.Get(id)
	if not c then
		return false, Strings.Error
	end
	if profile.Cosmetics.Owned[id] then
		return false, Strings.ShopOwned
	end
	if not c.TokenPrice then
		return false, "Non acquistabile con gettoni"
	end
	if profile.StyleTokens < c.TokenPrice then
		return false, "Gettoni insufficienti"
	end
	profile.StyleTokens -= c.TokenPrice
	ShopService.GrantCosmetic(player, profile, id, "tokens")
	ps().Sync(player, "StyleTokens")
	ps().Sound(player, "Success")
	ps().Toast(player, string.format("Acquistato: %s", c.Name), "success")
	return true
end

function ShopService.Equip(player, id)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	id = Guard.Str(id, 48)
	local c = id and Cosmetics.Get(id)
	if not c then
		return false, Strings.Error
	end
	if not profile.Cosmetics.Owned[id] then
		return false, "Non posseduto"
	end
	profile.Cosmetics.Equipped[c.Slot] = id
	ps().Sync(player, "Cosmetics")
	if c.Slot == "skin" then
		Registry.Get("PlotService").RefreshSkin(player)
	elseif c.Slot == "nameplate" then
		Registry.Get("PlotService").Rebuild(player)
	end
	player:SetAttribute("Trail", profile.Cosmetics.Equipped.trail)
	player:SetAttribute("Nameplate", profile.Cosmetics.Equipped.nameplate)
	Registry.Get("GalleryService").MarkDirty(player)
	return true
end

-- ───────────────────────── Pass delle Nuvole ─────────────────────────

function ShopService.ClaimPassTier(player, tierIndex)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	tierIndex = Guard.Int(tierIndex, 1, #Cosmetics.Pass.Tiers)
	local tier = tierIndex and Cosmetics.Pass.Tiers[tierIndex]
	if not tier then
		return false, Strings.Error
	end
	if profile.Pass.Points < tier.Points then
		return false, "Punti pass insufficienti"
	end
	local granted = false
	local eco = Registry.Get("EconomyService")
	if not profile.Pass.ClaimedFree[tostring(tierIndex)] then
		profile.Pass.ClaimedFree[tostring(tierIndex)] = true
		if tier.Free.Tokens then
			eco.GrantTokens(player, profile, tier.Free.Tokens, "pass")
		end
		if tier.Free.Cosmetic then
			ShopService.GrantCosmetic(player, profile, tier.Free.Cosmetic, "pass")
		end
		granted = true
	end
	if profile.Pass.Premium and not profile.Pass.ClaimedPremium[tostring(tierIndex)] then
		profile.Pass.ClaimedPremium[tostring(tierIndex)] = true
		if tier.Premium.Tokens then
			eco.GrantTokens(player, profile, tier.Premium.Tokens, "pass_premium")
		end
		if tier.Premium.Cosmetic then
			ShopService.GrantCosmetic(player, profile, tier.Premium.Cosmetic, "pass_premium")
		end
		granted = true
	end
	if not granted then
		return false, "Già riscosso"
	end
	ps().Sync(player, "Pass")
	ps().Sound(player, "Success")
	return true
end

-- ───────────────────────── Robux (opzionale) ─────────────────────────

local function productForCosmetic(cosmeticId)
	return Config.Monetization.CosmeticProducts[cosmeticId]
end

function ShopService.PromptPurchase(player, cosmeticId)
	cosmeticId = Guard.Str(cosmeticId, 48)
	local productId = cosmeticId and productForCosmetic(cosmeticId)
	if not productId or productId == 0 then
		return false, "Acquisto non disponibile"
	end
	local ok = pcall(function()
		MarketplaceService:PromptProductPurchase(player, productId)
	end)
	return ok
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = Registry.Get("DataService").WaitFor(player, 10)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ledgerId = "receipt:" .. receipt.PurchaseId
	if profile.Ledger[ledgerId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	for cosmeticId, productId in pairs(Config.Monetization.CosmeticProducts) do
		if productId == receipt.ProductId then
			ShopService.GrantCosmetic(player, profile, cosmeticId, "robux")
			profile.Ledger[ledgerId] = true
			Logger.Audit("Shop", player, "robux_purchase", cosmeticId)
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function checkGamePasses(player, profile)
	local M = Config.Monetization
	if M.FounderGamePassId ~= 0 and not profile.Founder then
		local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, M.FounderGamePassId)
		if ok and owns then
			profile.Founder = true
			for _, id in ipairs(Cosmetics.FounderBundle) do
				ShopService.GrantCosmetic(player, profile, id, "founder")
			end
			ps().Sync(player, "Founder")
		end
	end
	if M.CosmeticPassGamePassId ~= 0 and not profile.Pass.Premium then
		local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, M.CosmeticPassGamePassId)
		if ok and owns then
			profile.Pass.Premium = true
			ps().Sync(player, "Pass")
		end
	end
end

function ShopService.Init()
	Net.Function("BuyCosmetic").OnServerInvoke = ShopService.Buy
	Net.Function("EquipCosmetic").OnServerInvoke = ShopService.Equip
	Net.Function("ClaimPassTier").OnServerInvoke = ShopService.ClaimPassTier
	Net.Function("PromptPurchase").OnServerInvoke = ShopService.PromptPurchase
	Net.Event("Emote").OnServerEvent:Connect(function(player)
		local profile = Registry.Get("DataService").Get(player)
		if not profile then
			return
		end
		local emote = Cosmetics.Get(profile.Cosmetics.Equipped.emote)
		if emote and player.Character and player.Character.PrimaryPart then
			-- mostra a tutti un'emote non invasiva sopra la testa
			for _, other in ipairs(Players:GetPlayers()) do
				Net.Event("RaidEvent"):FireClient(other, "Emote", { UserId = player.UserId, Text = emote.Data.Text })
			end
		end
	end)
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased then
			local profile = Registry.Get("DataService").Get(player)
			if profile then
				checkGamePasses(player, profile)
			end
		end
	end)
end

function ShopService.Start()
	EventBus.On("ProfileLoaded", function(player, profile)
		task.spawn(checkGamePasses, player, profile)
		player:SetAttribute("Trail", profile.Cosmetics.Equipped.trail)
		player:SetAttribute("Nameplate", profile.Cosmetics.Equipped.nameplate)
	end)
	EventBus.On("RaidCompleted", function(player, summary)
		if summary.Test then
			return
		end
		local profile = Registry.Get("DataService").Get(player)
		if profile then
			profile.Pass.Points += Cosmetics.Pass.PointsPerRaid
			ps().Sync(player, "Pass")
		end
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">StatsService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	StatsService: contatori giornalieri/settimanali usati da commissioni, bozzoli e sfide
	settimanali. Converte gli eventi del bus in statistiche.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local TimeUtil = require(Shared.Util.TimeUtil)

local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)

local Stats = {}

local function ensureDay(profile)
	local key = TimeUtil.DayKey()
	if profile.DailyStats.DayKey ~= key then
		profile.DailyStats = { DayKey = key }
	end
	return profile.DailyStats
end

local function ensureWeek(profile)
	local w = TimeUtil.WeekIndex()
	if profile.WeeklyStats.WeekIndex ~= w then
		profile.WeeklyStats = { WeekIndex = w }
	end
	return profile.WeeklyStats
end

function Stats.Daily(profile)
	return ensureDay(profile)
end

function Stats.Weekly(profile)
	return ensureWeek(profile)
end

-- Incrementa una statistica giornaliera (e settimanale con prefisso "Weekly")
function Stats.Add(player, statName, delta)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return
	end
	delta = delta or 1
	local d = ensureDay(profile)
	d[statName] = (d[statName] or 0) + delta
	EventBus.Fire("StatDelta", player, statName, delta, d[statName])
end

function Stats.Max(player, statName, value)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return
	end
	local d = ensureDay(profile)
	if (d[statName] or 0) < value then
		d[statName] = value
		EventBus.Fire("StatDelta", player, statName, value, value)
	end
end

function Stats.AddWeekly(player, statName, delta)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return
	end
	local w = ensureWeek(profile)
	w[statName] = (w[statName] or 0) + (delta or 1)
	EventBus.Fire("WeeklyStatDelta", player, statName, w[statName])
end

function Stats.Init() end

function Stats.Start()
	EventBus.On("SparksCollected", function(player, amount, manual)
		Stats.Add(player, "Collected", amount)
		if manual then
			Stats.Add(player, "CollectActions", 1)
		end
	end)
	EventBus.On("SparksDeposited", function(player, amount)
		Stats.Add(player, "Deposited", amount)
		Stats.AddWeekly(player, "WeeklyDeposited", amount)
	end)
	EventBus.On("LayoutPublished", function(player, moduleCount)
		Stats.Add(player, "LayoutsPublished", 1)
		Stats.Max(player, "LayoutModulesMax", moduleCount)
		Stats.AddWeekly(player, "WeeklyLayouts", 1)
	end)
	EventBus.On("LayoutTested", function(player)
		Stats.Add(player, "LayoutTests", 1)
	end)
	EventBus.On("DecorationPlaced", function(player)
		Stats.Add(player, "DecorationsPlaced", 1)
	end)
	EventBus.On("CreaturePlaced", function(player, uid, moved)
		if moved then
			Stats.Add(player, "CreaturesMoved", 1)
		end
	end)
	EventBus.On("Visited", function(player)
		Stats.Add(player, "Visits", 1)
	end)
	EventBus.On("Liked", function(player)
		Stats.Add(player, "Likes", 1)
	end)
	EventBus.On("DemoVisited", function(player)
		Stats.Add(player, "DemoVisits", 1)
	end)
	EventBus.On("RaidCompleted", function(player, summary)
		if summary.Test then
			return
		end
		Stats.Add(player, "RaidsCompleted", 1)
		Stats.AddWeekly(player, "WeeklyRaids", 1)
		if summary.Success then
			Stats.Add(player, "RaidsWon", 1)
			if summary.Checkpoints == 0 then
				Stats.Add(player, "RaidsClean", 1)
			end
		end
	end)
	EventBus.On("CommissionClaimed", function(player)
		Stats.AddWeekly(player, "WeeklyCommissions", 1)
	end)
end

return Stats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">ThemeService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	ThemeService: tema settimanale (modificatore visivo + sfida facoltativa con premio).
	Il tema cambia ogni lunedì; le creature e i sistemi restano invariati.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Themes = require(Shared.Catalog.Themes)
local TimeUtil = require(Shared.Util.TimeUtil)
local Net = require(Shared.Util.Net)

local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)

local ThemeService = {}
local currentWeek = TimeUtil.WeekIndex()

function ThemeService.CurrentThemeId()
	return Themes.ForWeek(currentWeek).Id
end

function ThemeService.Progress(profile)
	local theme = Themes.ForWeek(currentWeek)
	local weekly = Registry.Get("StatsService").Weekly(profile)
	return {
		ThemeId = theme.Id,
		Progress = math.min(weekly[theme.Challenge.Stat] or 0, theme.Challenge.Target),
		Target = theme.Challenge.Target,
		Claimed = profile.WeeklyChallengeClaimed[tostring(currentWeek)] == true,
		SecondsToNextWeek = TimeUtil.SecondsToNextWeek(),
	}
end

function ThemeService.Claim(player)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	local theme = Themes.ForWeek(currentWeek)
	local weekly = Registry.Get("StatsService").Weekly(profile)
	if (weekly[theme.Challenge.Stat] or 0) < theme.Challenge.Target then
		return false, "Sfida non completata"
	end
	local key = tostring(currentWeek)
	if profile.WeeklyChallengeClaimed[key] then
		return false, "Già riscosso"
	end
	profile.WeeklyChallengeClaimed[key] = true
	local r = theme.Challenge.Reward
	if r.Tokens then
		Registry.Get("EconomyService").GrantTokens(player, profile, r.Tokens, "weekly")
	end
	if r.Cosmetic then
		Registry.Get("ShopService").GrantCosmetic(player, profile, r.Cosmetic, "weekly")
	end
	Registry.Get("PlayerService").Sync(player, "WeeklyChallengeClaimed", "ServerInfo")
	Registry.Get("PlayerService").Sound(player, "Success")
	Registry.Get("PlayerService").Toast(player, "Sfida settimanale completata!", "success")
	return true
end

function ThemeService.Init()
	Net.Function("ClaimWeeklyChallenge").OnServerInvoke = ThemeService.Claim
end

function ThemeService.Start()
	EventBus.On("WeeklyStatDelta", function(player)
		Registry.Get("PlayerService").Sync(player, "ServerInfo")
	end)
	task.spawn(function()
		while true do
			task.wait(60)
			local w = TimeUtil.WeekIndex()
			if w ~= currentWeek then
				currentWeek = w
				for player in pairs(Registry.Get("DataService").GetAll()) do
					Net.Event("ThemeChanged"):FireClient(player, ThemeService.CurrentThemeId())
					Registry.Get("PlayerService").Sync(player, "ServerInfo")
				end
			end
		end
	end)
end

return ThemeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	TutorialService: 5 passi (posiziona, raccogli+deposita, difesa, incursione guidata,
	decorazione gratuita). Avanza osservando gli eventi di gioco. Saltabile solo dopo la prima
	volta (GDD §7). Ricompense idempotenti.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Net = require(Shared.Util.Net)

local Registry = require(script.Parent.Parent.Registry)
local EventBus = require(script.Parent.Parent.EventBus)
local Guard = require(script.Parent.Parent.Util.Guard)

local TutorialService = {}

local function setStep(player, profile, step)
	profile.Tutorial.Step = step
	EventBus.Fire("TutorialStep", player, step)
	Registry.Get("AnalyticsService").Funnel(player, "tutorial", step)
	Registry.Get("PlayerService").Sync(player, "Tutorial")
	Net.Event("TutorialStep"):FireClient(player, step, profile.Tutorial.Active)
end

local function complete(player, profile)
	profile.Tutorial.Active = false
	profile.Tutorial.CompletedOnce = true
	profile.Tutorial.Step = Config.Tutorial.Steps + 1
	EventBus.Fire("TutorialCompleted", player)
	Registry.Get("AnalyticsService").Log(player, "tutorial_complete", profile.Stats.PlayTime)
	Registry.Get("PlayerService").Sync(player, "Tutorial")
	Registry.Get("PlayerService").Toast(player, Strings.TutorialDone, "success")
	Net.Event("TutorialStep"):FireClient(player, profile.Tutorial.Step, false)
end

local function advanceIf(player, step)
	local profile = Registry.Get("DataService").Get(player)
	if not profile or not profile.Tutorial.Active then
		return
	end
	if profile.Tutorial.Step == step then
		setStep(player, profile, step + 1)
	end
end

-- Passo 5: scelta di una decorazione gratuita
function TutorialService.ChooseDecoration(player, decoId)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	decoId = Guard.Str(decoId, 32)
	if not decoId or not table.find(Config.Tutorial.FreeDecorationChoices, decoId) then
		return false, Strings.Error
	end
	if profile.Tutorial.Step ~= 5 or not profile.Tutorial.Active then
		return false, Strings.Error
	end
	if not profile.Ledger["tutorial_deco"] then
		profile.Ledger["tutorial_deco"] = true
		Registry.Get("EconomyService").GrantDecoration(player, profile, decoId)
		Registry.Get("PlayerService").Toast(player, "Decorazione ottenuta! Posizionala da Costruisci → Decorazioni", "success")
	end
	complete(player, profile)
	return true
end

function TutorialService.Skip(player)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false, Strings.Error
	end
	if not profile.Tutorial.CompletedOnce then
		return false, "Il tutorial si può saltare dalla seconda volta"
	end
	profile.Tutorial.Active = false
	profile.Tutorial.Step = Config.Tutorial.Steps + 1
	Registry.Get("PlayerService").Sync(player, "Tutorial")
	Net.Event("TutorialStep"):FireClient(player, profile.Tutorial.Step, false)
	return true
end

function TutorialService.Replay(player)
	local profile = Registry.Get("DataService").Get(player)
	if not profile then
		return false
	end
	profile.Tutorial.Active = true
	setStep(player, profile, 1)
	return true
end

function TutorialService.Init()
	Net.Function("TutorialAdvance").OnServerInvoke = function(player, step, payload)
		step = Guard.Int(step, 0, Config.Tutorial.Steps)
		if step == 5 then
			return TutorialService.ChooseDecoration(player, payload)
		end
		if step == 0 then
			return TutorialService.Replay(player)
		end
		return false, Strings.Error
	end
	Net.Function("TutorialSkip").OnServerInvoke = TutorialService.Skip
end

function TutorialService.Start()
	EventBus.On("ProfileLoaded", function(player, profile)
		if profile.Tutorial.Active then
			task.delay(1, function()
				if player.Parent then
					Net.Event("TutorialStep"):FireClient(player, profile.Tutorial.Step, true)
				end
			end)
		end
	end)
	EventBus.On("CreaturePlaced", function(player)
		advanceIf(player, 1)
	end)
	EventBus.On("SparksDeposited", function(player)
		advanceIf(player, 2)
	end)
	EventBus.On("LayoutPublished", function(player, count)
		if count >= 1 then
			advanceIf(player, 3)
		end
	end)
	EventBus.On("RaidCompleted", function(player, summary)
		advanceIf(player, 4)
	end)
end

return TutorialService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="57">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Guard</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Validazione difensiva degli argomenti ricevuti dai client.
local Guard = {}

function Guard.Int(v, min, max)
	if type(v) ~= "number" or v ~= v or v ~= math.floor(v) then
		return nil
	end
	if min and v < min then
		return nil
	end
	if max and v > max then
		return nil
	end
	return v
end

function Guard.Str(v, maxLen)
	if type(v) ~= "string" then
		return nil
	end
	if maxLen and #v > maxLen then
		return nil
	end
	return v
end

function Guard.Bool(v)
	if type(v) ~= "boolean" then
		return nil
	end
	return v
end

function Guard.Table(v)
	if type(v) ~= "table" then
		return nil
	end
	return v
end

return Guard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Logger</string>
            <string name="Source"><![CDATA[--!nonstrict
local RunService = game:GetService("RunService")

local Logger = {}
local verbose = RunService:IsStudio()

function Logger.Info(tag, ...)
	if verbose then
		print(string.format("[%s]", tag), ...)
	end
end

function Logger.Warn(tag, ...)
	warn(string.format("[%s]", tag), ...)
end

function Logger.Audit(tag, player, action, details)
	-- Log strutturato per rollback mirato/analisi (sezione 9 del GDD)
	local line = string.format("[AUDIT][%s] %s (%d) %s %s", tag, player and player.Name or "server", player and player.UserId or 0, action, details or "")
	print(line)
end

return Logger
]]></string>
          </Properties>
