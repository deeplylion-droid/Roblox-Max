	Sparks = "scintille",
	Fragments = "frammenti di cielo",
	Tokens = "gettoni stile",
	NotEnoughSparks = "Scintille insufficienti",
	VaultFull = "Cassaforte piena: potenziala dal menu Costruisci",
	Upgraded = "Potenziato!",
	Unlocked = "Sbloccato: %s",
	Saved = "Salvato",
	Error = "Qualcosa è andato storto, riprova",
	TooFast = "Troppo veloce, attendi un attimo",
	NewVariant = "Nuova variante cromatica: %s %s",
	Rarity = { comune = "Comune", insolito = "Insolito", raro = "Raro", leggendario = "Leggendario" },
	Family = { sole = "Sole", pioggia = "Pioggia", vento = "Vento", aurora = "Aurora" },
}

return Strings
]]></string>
