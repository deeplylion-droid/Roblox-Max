        </Properties>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Album</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Album delle famiglie meteo: traguardi permanenti per numero di creature possedute
	in ciascuna famiglia, più traguardi globali. Premi: frammenti, gettoni, decorazioni,
	targhette. Tutto idempotente lato server (ClaimedMilestones).
]]

export type Milestone = {
	Id: string,
	Family: string?, -- nil = globale
	Count: number, -- creature possedute (famiglia) o totali (globale)
	Title: string,
	Reward: { Fragments: number?, Tokens: number?, Decoration: string?, Cosmetic: string?, Sparks: number? },
}

local Album = {}
local list: { Milestone } = {}

local familyNames = { sole = "Sole", pioggia = "Pioggia", vento = "Vento", aurora = "Aurora" }
local familyDeco = { sole = "meridiana", pioggia = "fontanella", vento = "girandola", aurora = "arco_luce" }

for _, fam in ipairs({ "sole", "pioggia", "vento", "aurora" }) do
	table.insert(list, { Id = fam .. "_1", Family = fam, Count = 1, Title = "Primo " .. familyNames[fam], Reward = { Fragments = 3, Sparks = 60 } })
	table.insert(list, { Id = fam .. "_2", Family = fam, Count = 2, Title = "Coppia di " .. familyNames[fam], Reward = { Fragments = 5, Tokens = 10 } })
	table.insert(list, { Id = fam .. "_3", Family = fam, Count = 3, Title = "Trio di " .. familyNames[fam], Reward = { Fragments = 6, Decoration = familyDeco[fam] } })
	table.insert(list, { Id = fam .. "_4", Family = fam, Count = 4, Title = "Famiglia " .. familyNames[fam] .. " completa", Reward = { Fragments = 10, Tokens = 20, Cosmetic = "plate_collezionista" } })
end

table.insert(list, { Id = "global_4", Count = 4, Title = "Quattro stagioni", Reward = { Fragments = 4, Tokens = 10 } })
table.insert(list, { Id = "global_8", Count = 8, Title = "Metà cielo", Reward = { Fragments = 8, Decoration = "fontana_stelle" } })
table.insert(list, { Id = "global_12", Count = 12, Title = "Meteorologo provetto", Reward = { Fragments = 10, Tokens = 25 } })
table.insert(list, { Id = "global_16", Count = 16, Title = "Il cielo intero", Reward = { Fragments = 15, Tokens = 50, Decoration = "trono_nuvola" } })

Album.List = list
Album.ById = {}
for _, m in ipairs(list) do
	Album.ById[m.Id] = m
end

-- Maestria: tre tracce. Soglie in Config.Mastery.Tiers. Premi per tier.
Album.MasteryRewards = {
	Collection = {
		{ Title = "Apprendista del cielo", Fragments = 4 },
		{ Title = "Custode", Fragments = 6, Unlock = "AutoDeposit" },
		{ Title = "Giardiniere delle nuvole", Fragments = 8, Tokens = 15 },
		{ Title = "Maestro del vivaio", Fragments = 12, Tokens = 25 },
		{ Title = "Leggenda meteorologica", Fragments = 20, Tokens = 40 },
	},
	Raid = {
		{ Title = "Esploratore", Fragments = 3 },
		{ Title = "Acrobata", Fragments = 5, Tokens = 10 },
		{ Title = "Ombra tra le nuvole", Fragments = 8, Tokens = 15 },
		{ Title = "Danzatore del vento", Fragments = 12, Tokens = 25 },
		{ Title = "Leggenda delle incursioni", Fragments = 20, Tokens = 40 },
	},
	Defense = {
		{ Title = "Guardiano", Fragments = 3 },
		{ Title = "Architetto", Fragments = 5, Tokens = 10 },
		{ Title = "Stratega", Fragments = 8, Tokens = 15 },
		{ Title = "Custode supremo", Fragments = 12, Tokens = 25 },
		{ Title = "Leggenda della difesa", Fragments = 20, Tokens = 40 },
	},
}

function Album.TierFor(points, tiers)
	local tier = 0
	for i, threshold in ipairs(tiers) do
		if points >= threshold then
			tier = i
		end
	end
	return tier
end

return Album
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Commissions</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Modelli di commissioni giornaliere. Ogni giorno il server pesca 3 commissioni
	da categorie diverse. Nessuna richiede di sottrarre risorse ad altri:
	la categoria "incursione" accetta sempre anche i Vivai del Guardiano (simulati).
	Stat = nome della statistica giornaliera incrementata dal server.
]]

export type Template = {
	Id: string,
	Category: string,
	Text: string,
	Stat: string,
	Target: number,
	Reward: { Sparks: number?, Fragments: number?, Tokens: number? },
	MinTier: number?,
}

local list: { Template } = {
	-- raccolta
	{ Id = "raccolta_120", Category = "raccolta", Text = "Raccogli %d scintille", Stat = "Collected", Target = 120, Reward = { Sparks = 60, Fragments = 2 } },
	{ Id = "raccolta_300", Category = "raccolta", Text = "Raccogli %d scintille", Stat = "Collected", Target = 300, Reward = { Sparks = 120, Fragments = 3 }, MinTier = 2 },
	{ Id = "deposito_200", Category = "raccolta", Text = "Deposita %d scintille nella cassaforte", Stat = "Deposited", Target = 200, Reward = { Sparks = 80, Fragments = 2 } },
	{ Id = "deposito_500", Category = "raccolta", Text = "Deposita %d scintille nella cassaforte", Stat = "Deposited", Target = 500, Reward = { Sparks = 150, Fragments = 3 }, MinTier = 2 },
	{ Id = "ritiri_8", Category = "raccolta", Text = "Ritira le scintille da una creatura %d volte", Stat = "CollectActions", Target = 8, Reward = { Sparks = 50, Fragments = 2 } },
	-- costruzione
	{ Id = "pubblica_1", Category = "costruzione", Text = "Pubblica un layout difensivo valido", Stat = "LayoutsPublished", Target = 1, Reward = { Sparks = 70, Fragments = 2 } },
	{ Id = "prova_1", Category = "costruzione", Text = "Prova il tuo percorso difensivo %d volta", Stat = "LayoutTests", Target = 1, Reward = { Sparks = 50, Fragments = 2 } },
	{ Id = "moduli_3", Category = "costruzione", Text = "Pubblica un layout con almeno %d moduli", Stat = "LayoutModulesMax", Target = 3, Reward = { Sparks = 90, Fragments = 3 }, MinTier = 2 },
	{ Id = "decora_2", Category = "costruzione", Text = "Posiziona %d decorazioni", Stat = "DecorationsPlaced", Target = 2, Reward = { Sparks = 40, Fragments = 2 } },
	{ Id = "sposta_creatura", Category = "costruzione", Text = "Riordina il vivaio: sposta %d creature", Stat = "CreaturesMoved", Target = 2, Reward = { Sparks = 40, Fragments = 2 } },
	-- visita
	{ Id = "visita_2", Category = "visita", Text = "Visita %d vivai dalla galleria", Stat = "Visits", Target = 2, Reward = { Sparks = 60, Fragments = 2 } },
	{ Id = "like_1", Category = "visita", Text = "Lascia %d «mi piace» in galleria", Stat = "Likes", Target = 1, Reward = { Sparks = 40, Fragments = 2 } },
	{ Id = "demo_1", Category = "visita", Text = "Osserva il vivaio dimostrativo nell'hub", Stat = "DemoVisits", Target = 1, Reward = { Sparks = 30, Fragments = 1 } },
	-- incursione (sempre valida anche contro i Vivai del Guardiano)
	{ Id = "raid_1", Category = "incursione", Text = "Completa %d incursione (anche contro un Vivaio del Guardiano)", Stat = "RaidsCompleted", Target = 1, Reward = { Sparks = 80, Fragments = 3 } },
	{ Id = "raid_win_1", Category = "incursione", Text = "Supera %d incursione (anche simulata)", Stat = "RaidsWon", Target = 1, Reward = { Sparks = 100, Fragments = 3 }, MinTier = 2 },
	{ Id = "raid_2", Category = "incursione", Text = "Completa %d incursioni (anche simulate)", Stat = "RaidsCompleted", Target = 2, Reward = { Sparks = 120, Fragments = 4 }, MinTier = 2 },
	{ Id = "raid_clean", Category = "incursione", Text = "Supera un'incursione senza tornare al checkpoint", Stat = "RaidsClean", Target = 1, Reward = { Sparks = 110, Fragments = 4 }, MinTier = 3 },
}

local Commissions = { List = list, ById = {} }
for _, t in ipairs(list) do
	Commissions.ById[t.Id] = t
end

function Commissions.ByCategory(category, tier)
	local out = {}
	for _, t in ipairs(list) do
		if t.Category == category and (t.MinTier or 1) <= (tier or 1) then
			table.insert(out, t)
		end
	end
	return out
end

function Commissions.Describe(t: Template)
	if t.Text:find("%%d") then
		return string.format(t.Text, t.Target)
	end
	return t.Text
end

return Commissions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Cosmetics</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Cosmetici: skin del vivaio, cieli, scie di particelle, emote, targhette.
	Prezzo in gettoni stile (guadagnabili giocando). Opzionalmente un
	DeveloperProduct Robux per acquisto diretto (id in Config.Monetization).
	Nessun cosmetico ha effetti sul gameplay.
]]

export type Cosmetic = {
	Id: string,
	Name: string,
	Slot: string, -- skin | sky | trail | emote | nameplate
	TokenPrice: number?, -- nil = non acquistabile con gettoni (es. solo pass/fondatore)
	Description: string,
	Data: { [string]: any },
	Source: string?, -- "tokens" | "pass" | "founder" | "weekly" | "album"
}

local list: { Cosmetic } = {
	-- Skin del vivaio (materiale/colore della piattaforma)
	{ Id = "skin_prato", Name = "Prato di nuvola", Slot = "skin", TokenPrice = 0, Description = "La base classica: erba soffice sulle nuvole.", Data = { Material = "Grass", Color = Color3.fromRGB(128, 200, 120), Trim = Color3.fromRGB(240, 246, 255) }, Source = "default" },
	{ Id = "skin_sabbia", Name = "Spiaggia celeste", Slot = "skin", TokenPrice = 45, Description = "Sabbia dorata e bordi di schiuma.", Data = { Material = "Sand", Color = Color3.fromRGB(236, 214, 160), Trim = Color3.fromRGB(180, 230, 255) } },
	{ Id = "skin_cristallo", Name = "Giardino di cristallo", Slot = "skin", TokenPrice = 90, Description = "Pavimento lucido come vetro ghiacciato.", Data = { Material = "Glass", Color = Color3.fromRGB(190, 230, 255), Trim = Color3.fromRGB(255, 255, 255) } },
	{ Id = "skin_notte", Name = "Velluto notturno", Slot = "skin", TokenPrice = 90, Description = "Blu profondo con bordi che brillano.", Data = { Material = "Fabric", Color = Color3.fromRGB(60, 70, 120), Trim = Color3.fromRGB(200, 170, 255) } },
	-- Cieli
	{ Id = "sky_giorno", Name = "Cielo del mattino", Slot = "sky", TokenPrice = 0, Description = "Azzurro limpido e nuvole bianche.", Data = { ClockTime = 13.5, Ambient = Color3.fromRGB(143, 161, 199), Tint = Color3.fromRGB(255, 255, 255) }, Source = "default" },
	{ Id = "sky_tramonto", Name = "Tramonto pesca", Slot = "sky", TokenPrice = 60, Description = "Arancio tenue che sfuma nel rosa.", Data = { ClockTime = 17.6, Ambient = Color3.fromRGB(200, 150, 140), Tint = Color3.fromRGB(255, 220, 190) } },
	{ Id = "sky_aurora", Name = "Notte d'aurora", Slot = "sky", TokenPrice = 120, Description = "Cielo scuro attraversato da veli verdi e viola.", Data = { ClockTime = 1.5, Ambient = Color3.fromRGB(90, 110, 170), Tint = Color3.fromRGB(170, 200, 255) } },
	-- Scie di particelle leggere (sul personaggio)
	{ Id = "trail_nessuna", Name = "Nessuna scia", Slot = "trail", TokenPrice = 0, Description = "Niente effetti.", Data = {}, Source = "default" },
	{ Id = "trail_stelline", Name = "Scia di stelline", Slot = "trail", TokenPrice = 40, Description = "Piccole stelle dorate che si spengono piano.", Data = { Color = Color3.fromRGB(255, 220, 120), Rate = 6 } },
	{ Id = "trail_gocce", Name = "Scia di gocce", Slot = "trail", TokenPrice = 40, Description = "Goccioline azzurre leggere.", Data = { Color = Color3.fromRGB(140, 200, 255), Rate = 6 } },
	{ Id = "trail_petali", Name = "Scia di petali", Slot = "trail", TokenPrice = 75, Description = "Petali rosa trasportati dal vento.", Data = { Color = Color3.fromRGB(255, 170, 210), Rate = 8 } },
	-- Emote non invasive
	{ Id = "emote_saluto", Name = "Saluto", Slot = "emote", TokenPrice = 0, Description = "Un gesto amichevole.", Data = { Text = "👋" }, Source = "default" },
	{ Id = "emote_applauso", Name = "Applauso", Slot = "emote", TokenPrice = 30, Description = "Per un layout ben fatto.", Data = { Text = "👏" } },
	{ Id = "emote_stella", Name = "Stellina", Slot = "emote", TokenPrice = 30, Description = "Una stellina sopra la testa.", Data = { Text = "✨" } },
	-- Targhette
	{ Id = "plate_nessuna", Name = "Nessuna targhetta", Slot = "nameplate", TokenPrice = 0, Description = "", Data = {}, Source = "default" },
	{ Id = "plate_fondatore", Name = "Targhetta Fondatore", Slot = "nameplate", Description = "Per chi ha creduto nel vivaio dal primo giorno.", Data = { Text = "Fondatore", Color = Color3.fromRGB(255, 200, 90) }, Source = "founder" },
	{ Id = "plate_collezionista", Name = "Targhetta Collezionista", Slot = "nameplate", Description = "Album di una famiglia completato.", Data = { Text = "Collezionista", Color = Color3.fromRGB(150, 200, 255) }, Source = "album" },
	-- Premi del pass / tema settimanale
	{ Id = "skin_fondatore", Name = "Terrazza del Fondatore", Slot = "skin", Description = "Marmo bianco con venature dorate.", Data = { Material = "Marble", Color = Color3.fromRGB(240, 236, 225), Trim = Color3.fromRGB(255, 200, 90) }, Source = "founder" },
	{ Id = "trail_aurora", Name = "Scia d'aurora", Slot = "trail", Description = "Nastri di luce verde e viola.", Data = { Color = Color3.fromRGB(180, 140, 255), Rate = 10 }, Source = "pass" },
	{ Id = "sky_monsone", Name = "Cielo del monsone", Slot = "sky", Description = "Grigio perla con pioggia luminosa.", Data = { ClockTime = 15, Ambient = Color3.fromRGB(150, 160, 180), Tint = Color3.fromRGB(200, 210, 230) }, Source = "pass" },
	{ Id = "emote_pioggia", Name = "Pioggerella", Slot = "emote", Description = "Una nuvoletta che piove felice.", Data = { Text = "🌧️" }, Source = "pass" },
	{ Id = "skin_alisei", Name = "Terrazza degli alisei", Slot = "skin", Description = "Legno chiaro battuto dal vento.", Data = { Material = "WoodPlanks", Color = Color3.fromRGB(220, 200, 160), Trim = Color3.fromRGB(170, 240, 215) }, Source = "weekly" },
	{ Id = "plate_meteorologo", Name = "Targhetta Meteorologo", Slot = "nameplate", Description = "Sfida settimanale completata.", Data = { Text = "Meteorologo", Color = Color3.fromRGB(170, 240, 215) }, Source = "weekly" },
}

local Cosmetics = { List = list, ById = {} }
for _, c in ipairs(list) do
	Cosmetics.ById[c.Id] = c
end

Cosmetics.Slots = { "skin", "sky", "trail", "emote", "nameplate" }
Cosmetics.SlotNames = { skin = "Skin del vivaio", sky = "Cielo", trail = "Scia", emote = "Emote", nameplate = "Targhetta" }

Cosmetics.Defaults = {
	skin = "skin_prato",
	sky = "sky_giorno",
	trail = "trail_nessuna",
	emote = "emote_saluto",
	nameplate = "plate_nessuna",
}

-- Pass delle Nuvole: percorso trasparente, solo premi estetici, visibile per intero.
-- Punti pass guadagnati con commissioni/attività. Premium = sblocca la corsia "Premium" (gamepass opzionale).
Cosmetics.Pass = {
	PointsPerCommission = 10,
	PointsPerRaid = 4,
	PointsPerAlbumMilestone = 15,
	Tiers = {
		{ Points = 20, Free = { Tokens = 10 }, Premium = { Cosmetic = "emote_pioggia" } },
		{ Points = 50, Free = { Tokens = 15 }, Premium = { Tokens = 20 } },
		{ Points = 90, Free = { Cosmetic = "trail_gocce" }, Premium = { Cosmetic = "sky_monsone" } },
		{ Points = 140, Free = { Tokens = 20 }, Premium = { Tokens = 30 } },
		{ Points = 200, Free = { Tokens = 25 }, Premium = { Cosmetic = "trail_aurora" } },
	},
}

Cosmetics.FounderBundle = { "plate_fondatore", "skin_fondatore" }

function Cosmetics.Get(id): Cosmetic?
	return Cosmetics.ById[id]
end

return Cosmetics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Creatures</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Catalogo dei 16 Nimbini: 4 famiglie × 4 creature.
	Ogni creatura ha produzione base (scintille per intervallo), rarità visuale,
	comportamento di animazione, specifiche visive procedurali e 4 varianti cromatiche.
	UnlockOrder definisce il percorso deterministico dei bozzoli (nessuna loot box).
]]

export type Variant = { Id: string, Name: string, Color: Color3, Unlock: { Kind: string, Value: any } }
export type Creature = {
	Id: string,
	Name: string,
	Family: string,
	Rarity: string,
	Production: number,
	UnlockOrder: number,
	Behavior: string, -- bob | hop | orbit | drift
	Description: string,
	Visual: { Color: Color3, Accent: Color3, Size: number, Shape: string, Glow: number },
	Variants: { Variant },
}

local function variants(base: Color3, a: Color3, b: Color3, c: Color3)
	return {
		{ Id = "base", Name = "Classica", Color = base, Unlock = { Kind = "default" } },
		{ Id = "alba", Name = "Alba", Color = a, Unlock = { Kind = "mastery", Track = "Collection", Tier = 1 } },
		{ Id = "crepuscolo", Name = "Crepuscolo", Color = b, Unlock = { Kind = "mastery", Track = "Raid", Tier = 2 } },
		{ Id = "tempesta", Name = "Tempesta", Color = c, Unlock = { Kind = "activity", Stat = "RaidsDefended", Value = 10 } },
	}
end

local C = {}

local list: { Creature } = {
	-- ─────────── SOLE ───────────
	{
		Id = "sole_lumino", Name = "Lumino", Family = "sole", Rarity = "comune", Production = 10, UnlockOrder = 1,
		Behavior = "bob", Description = "Una pallina di luce calda che ronza felice al sole.",
		Visual = { Color = Color3.fromRGB(255, 214, 102), Accent = Color3.fromRGB(255, 240, 180), Size = 2.2, Shape = "Ball", Glow = 0.6 },
		Variants = variants(Color3.fromRGB(255, 214, 102), Color3.fromRGB(255, 170, 120), Color3.fromRGB(240, 120, 90), Color3.fromRGB(255, 240, 200)),
	},
	{
		Id = "sole_raggiolo", Name = "Raggiolo", Family = "sole", Rarity = "insolito", Production = 13, UnlockOrder = 2,
		Behavior = "hop", Description = "Salta tra i fasci di luce e lascia scie dorate.",
		Visual = { Color = Color3.fromRGB(255, 184, 60), Accent = Color3.fromRGB(255, 230, 140), Size = 2.4, Shape = "Ball", Glow = 0.8 },
		Variants = variants(Color3.fromRGB(255, 184, 60), Color3.fromRGB(255, 150, 100), Color3.fromRGB(220, 110, 60), Color3.fromRGB(255, 250, 220)),
	},
	{
		Id = "sole_meriggia", Name = "Meriggia", Family = "sole", Rarity = "raro", Production = 16, UnlockOrder = 3,
		Behavior = "orbit", Description = "Orbita lenta come un piccolo mezzogiorno privato.",
		Visual = { Color = Color3.fromRGB(255, 160, 40), Accent = Color3.fromRGB(255, 220, 110), Size = 2.8, Shape = "Ball", Glow = 1.0 },
		Variants = variants(Color3.fromRGB(255, 160, 40), Color3.fromRGB(255, 120, 90), Color3.fromRGB(200, 90, 50), Color3.fromRGB(255, 235, 170)),
	},
	{
		Id = "sole_solstizia", Name = "Solstizia", Family = "sole", Rarity = "leggendario", Production = 20, UnlockOrder = 4,
		Behavior = "drift", Description = "Porta con sé il giorno più lungo dell'anno.",
		Visual = { Color = Color3.fromRGB(255, 140, 30), Accent = Color3.fromRGB(255, 250, 200), Size = 3.2, Shape = "Ball", Glow = 1.4 },
		Variants = variants(Color3.fromRGB(255, 140, 30), Color3.fromRGB(255, 100, 80), Color3.fromRGB(180, 70, 40), Color3.fromRGB(255, 255, 230)),
	},
	-- ─────────── PIOGGIA ───────────
	{
		Id = "pioggia_gocciolo", Name = "Gocciolo", Family = "pioggia", Rarity = "comune", Production = 10, UnlockOrder = 1,
		Behavior = "bob", Description = "Una goccia timida con un cappellino di nuvola.",
		Visual = { Color = Color3.fromRGB(110, 170, 250), Accent = Color3.fromRGB(230, 240, 255), Size = 2.2, Shape = "Ball", Glow = 0.4 },
		Variants = variants(Color3.fromRGB(110, 170, 250), Color3.fromRGB(150, 210, 255), Color3.fromRGB(70, 110, 200), Color3.fromRGB(60, 80, 140)),
	},
	{
		Id = "pioggia_acquerella", Name = "Acquerella", Family = "pioggia", Rarity = "insolito", Production = 13, UnlockOrder = 2,
		Behavior = "hop", Description = "Saltella e dipinge pozzanghere arcobaleno.",
		Visual = { Color = Color3.fromRGB(90, 150, 240), Accent = Color3.fromRGB(200, 230, 255), Size = 2.4, Shape = "Ball", Glow = 0.5 },
		Variants = variants(Color3.fromRGB(90, 150, 240), Color3.fromRGB(140, 200, 255), Color3.fromRGB(60, 100, 190), Color3.fromRGB(50, 70, 130)),
	},
	{
		Id = "pioggia_monsonia", Name = "Monsonia", Family = "pioggia", Rarity = "raro", Production = 16, UnlockOrder = 3,
		Behavior = "orbit", Description = "Gira in tondo trascinando una pioggerella gentile.",
		Visual = { Color = Color3.fromRGB(70, 130, 230), Accent = Color3.fromRGB(190, 220, 255), Size = 2.8, Shape = "Ball", Glow = 0.7 },
		Variants = variants(Color3.fromRGB(70, 130, 230), Color3.fromRGB(120, 190, 255), Color3.fromRGB(50, 90, 180), Color3.fromRGB(40, 60, 120)),
	},
	{
		Id = "pioggia_diluvia", Name = "Diluvia", Family = "pioggia", Rarity = "leggendario", Production = 20, UnlockOrder = 4,
		Behavior = "drift", Description = "La custode delle grandi piogge, calma e profonda.",
		Visual = { Color = Color3.fromRGB(50, 110, 220), Accent = Color3.fromRGB(220, 240, 255), Size = 3.2, Shape = "Ball", Glow = 1.0 },
		Variants = variants(Color3.fromRGB(50, 110, 220), Color3.fromRGB(110, 180, 255), Color3.fromRGB(40, 80, 170), Color3.fromRGB(30, 50, 110)),
	},
	-- ─────────── VENTO ───────────
	{
		Id = "vento_brezzolo", Name = "Brezzolo", Family = "vento", Rarity = "comune", Production = 10, UnlockOrder = 1,
		Behavior = "drift", Description = "Un soffio con gli occhi, sempre in movimento.",
		Visual = { Color = Color3.fromRGB(170, 240, 210), Accent = Color3.fromRGB(240, 255, 250), Size = 2.2, Shape = "Ball", Glow = 0.4 },
		Variants = variants(Color3.fromRGB(170, 240, 210), Color3.fromRGB(210, 255, 230), Color3.fromRGB(110, 190, 170), Color3.fromRGB(80, 130, 130)),
	},
	{
		Id = "vento_alisea", Name = "Alisea", Family = "vento", Rarity = "insolito", Production = 13, UnlockOrder = 2,
		Behavior = "orbit", Description = "Segue rotte invisibili come i venti dei marinai.",
		Visual = { Color = Color3.fromRGB(140, 230, 200), Accent = Color3.fromRGB(230, 255, 245), Size = 2.4, Shape = "Ball", Glow = 0.5 },
		Variants = variants(Color3.fromRGB(140, 230, 200), Color3.fromRGB(190, 250, 220), Color3.fromRGB(90, 170, 150), Color3.fromRGB(70, 110, 120)),
	},
	{
		Id = "vento_zefirio", Name = "Zefirio", Family = "vento", Rarity = "raro", Production = 16, UnlockOrder = 3,
		Behavior = "hop", Description = "Rimbalza leggero portando il profumo della primavera.",
		Visual = { Color = Color3.fromRGB(110, 220, 190), Accent = Color3.fromRGB(220, 255, 240), Size = 2.8, Shape = "Ball", Glow = 0.7 },
		Variants = variants(Color3.fromRGB(110, 220, 190), Color3.fromRGB(170, 245, 215), Color3.fromRGB(70, 160, 140), Color3.fromRGB(60, 100, 110)),
	},
	{
		Id = "vento_tramontana", Name = "Tramontana", Family = "vento", Rarity = "leggendario", Production = 20, UnlockOrder = 4,
		Behavior = "drift", Description = "Il vento del nord, fiero e cristallino.",
		Visual = { Color = Color3.fromRGB(80, 210, 180), Accent = Color3.fromRGB(240, 255, 255), Size = 3.2, Shape = "Ball", Glow = 1.0 },
		Variants = variants(Color3.fromRGB(80, 210, 180), Color3.fromRGB(150, 240, 210), Color3.fromRGB(50, 150, 130), Color3.fromRGB(50, 90, 100)),
	},
	-- ─────────── AURORA ───────────
	{
		Id = "aurora_velina", Name = "Velina", Family = "aurora", Rarity = "comune", Production = 10, UnlockOrder = 1,
		Behavior = "bob", Description = "Un velo di luce colorata che ondeggia piano.",
		Visual = { Color = Color3.fromRGB(200, 150, 255), Accent = Color3.fromRGB(150, 255, 220), Size = 2.2, Shape = "Ball", Glow = 0.8 },
		Variants = variants(Color3.fromRGB(200, 150, 255), Color3.fromRGB(255, 180, 230), Color3.fromRGB(140, 100, 220), Color3.fromRGB(90, 60, 160)),
	},
	{
		Id = "aurora_boreala", Name = "Boreala", Family = "aurora", Rarity = "insolito", Production = 13, UnlockOrder = 2,
		Behavior = "drift", Description = "Scivola come un nastro verde nel cielo notturno.",
		Visual = { Color = Color3.fromRGB(180, 130, 255), Accent = Color3.fromRGB(120, 255, 200), Size = 2.4, Shape = "Ball", Glow = 1.0 },
		Variants = variants(Color3.fromRGB(180, 130, 255), Color3.fromRGB(240, 170, 220), Color3.fromRGB(120, 90, 210), Color3.fromRGB(80, 50, 150)),
	},
	{
		Id = "aurora_australa", Name = "Australa", Family = "aurora", Rarity = "raro", Production = 16, UnlockOrder = 3,
		Behavior = "orbit", Description = "La gemella del sud, con riflessi rosa e turchese.",
		Visual = { Color = Color3.fromRGB(160, 110, 255), Accent = Color3.fromRGB(255, 160, 220), Size = 2.8, Shape = "Ball", Glow = 1.2 },
		Variants = variants(Color3.fromRGB(160, 110, 255), Color3.fromRGB(230, 160, 210), Color3.fromRGB(110, 80, 200), Color3.fromRGB(70, 40, 140)),
	},
	{
		Id = "aurora_corona", Name = "Corona", Family = "aurora", Rarity = "leggendario", Production = 20, UnlockOrder = 4,
		Behavior = "orbit", Description = "La corona dell'aurora: ogni colore del cielo in un solo essere.",
		Visual = { Color = Color3.fromRGB(140, 90, 255), Accent = Color3.fromRGB(255, 220, 140), Size = 3.2, Shape = "Ball", Glow = 1.6 },
		Variants = variants(Color3.fromRGB(140, 90, 255), Color3.fromRGB(220, 150, 200), Color3.fromRGB(100, 70, 190), Color3.fromRGB(60, 30, 130)),
	},
}

C.List = list
C.ById = {}
C.ByFamily = { sole = {}, pioggia = {}, vento = {}, aurora = {} }
for _, c in ipairs(list) do
	C.ById[c.Id] = c
	table.insert(C.ByFamily[c.Family], c)
end
for _, fam in pairs(C.ByFamily) do
	table.sort(fam, function(a, b)
		return a.UnlockOrder < b.UnlockOrder
	end)
end

C.Families = { "sole", "pioggia", "vento", "aurora" }
C.FamilyInfo = {
	sole = { Name = "Sole", Description = "Luce calda e scintille dorate.", Starter = "sole_lumino" },
	pioggia = { Name = "Pioggia", Description = "Gocce gentili e riflessi azzurri.", Starter = "pioggia_gocciolo" },
	vento = { Name = "Vento", Description = "Soffi leggeri e scie turchesi.", Starter = "vento_brezzolo" },
	aurora = { Name = "Aurora", Description = "Nastri di luce colorata.", Starter = "aurora_velina" },
}

-- Creatura di partenza del tutorial
C.StarterCreatureId = "sole_lumino"

function C.Get(id): Creature?
	return C.ById[id]
end

function C.GetVariant(creatureId, variantId): Variant?
	local c = C.ById[creatureId]
	if not c then
		return nil
	end
	for _, v in ipairs(c.Variants) do
		if v.Id == variantId then
			return v
		end
	end
	return nil
end

-- Prossima creatura mancante di una famiglia (percorso deterministico dei bozzoli)
function C.NextMissingInFamily(family, ownedSet)
	for _, c in ipairs(C.ByFamily[family] or {}) do
		if not ownedSet[c.Id] then
			return c
		end
	end
	return nil
end

return C
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Decorations</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Decorazioni: oggetti estetici posizionabili sulla griglia (non bloccano il percorso).
export type Decoration = { Id: string, Name: string, Description: string, Visual: { Kind: string, Color: Color3, Accent: Color3?, Height: number? }, Source: string }

local list: { Decoration } = {
	{ Id = "lanterna_nube", Name = "Lanterna di nube", Description = "Una lanterna che ondeggia con luce calda.", Visual = { Kind = "lantern", Color = Color3.fromRGB(255, 220, 150), Accent = Color3.fromRGB(120, 90, 60) }, Source = "tutorial" },
	{ Id = "cespuglio_stellato", Name = "Cespuglio stellato", Description = "Foglie azzurre punteggiate di stelline.", Visual = { Kind = "bush", Color = Color3.fromRGB(110, 190, 150), Accent = Color3.fromRGB(255, 240, 180) }, Source = "tutorial" },
	{ Id = "meridiana", Name = "Meridiana solare", Description = "Segna le ore con un'ombra di luce.", Visual = { Kind = "sundial", Color = Color3.fromRGB(240, 220, 170), Accent = Color3.fromRGB(255, 190, 70) }, Source = "album" },
	{ Id = "fontanella", Name = "Fontanella di pioggia", Description = "Zampilla goccioline azzurre.", Visual = { Kind = "fountain", Color = Color3.fromRGB(200, 220, 240), Accent = Color3.fromRGB(100, 170, 250) }, Source = "album" },
	{ Id = "girandola", Name = "Girandola del vento", Description = "Gira sempre, anche senza vento.", Visual = { Kind = "pinwheel", Color = Color3.fromRGB(250, 250, 255), Accent = Color3.fromRGB(150, 232, 200) }, Source = "album" },
	{ Id = "arco_luce", Name = "Arco di luce", Description = "Un piccolo arco d'aurora sopra il prato.", Visual = { Kind = "arch", Color = Color3.fromRGB(196, 130, 255), Accent = Color3.fromRGB(150, 255, 220) }, Source = "album" },
	{ Id = "fontana_stelle", Name = "Fontana di stelle", Description = "Stelline che salgono verso il cielo.", Visual = { Kind = "fountain", Color = Color3.fromRGB(240, 240, 255), Accent = Color3.fromRGB(255, 220, 120) }, Source = "album" },
	{ Id = "trono_nuvola", Name = "Trono di nuvola", Description = "Il posto d'onore di chi ha completato il cielo.", Visual = { Kind = "throne", Color = Color3.fromRGB(250, 250, 255), Accent = Color3.fromRGB(255, 200, 90) }, Source = "album" },
	{ Id = "panchina", Name = "Panchina di nube", Description = "Per osservare le creature in pace.", Visual = { Kind = "bench", Color = Color3.fromRGB(240, 244, 255), Accent = Color3.fromRGB(150, 180, 220) }, Source = "shop", TokenPrice = 20 },
	{ Id = "fiori_cielo", Name = "Fiori di cielo", Description = "Un'aiuola di fiori azzurri e rosa.", Visual = { Kind = "bush", Color = Color3.fromRGB(120, 200, 140), Accent = Color3.fromRGB(255, 170, 210) }, Source = "shop", TokenPrice = 20 },
}

local Decorations = { List = list, ById = {} }
for _, d in ipairs(list) do
	Decorations.ById[d.Id] = d
end

Decorations.MaxPlaced = 10 -- limite per performance su mobile

return Decorations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Defenses</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Moduli di difesa. Tre categorie: ostacolo, distrazione, firma.
	Footprint = celle relative {dx,dz}; Solid = celle che bloccano il cammino
	(usate dal validatore per garantire un percorso completabile).
	Le "Alternatives" sono varianti tattiche (non muri di statistiche).
]]

export type Alternative = { Id: string, Name: string, Description: string, Params: { [string]: any }, Unlock: { Kind: string, Track: string?, Tier: number? } }
export type Module = {
	Id: string,
	Name: string,
	Category: string, -- ostacolo | distrazione | firma
	Energy: number,
	Difficulty: number, -- peso per la stima difficoltà (1..5)
	Footprint: { { number } },
	Solid: boolean,
	Description: string,
	Unlock: { Kind: string, Cost: number?, Track: string?, Tier: number? },
	Color: Color3,
	Params: { [string]: any },
	Alternatives: { Alternative },
}

local D = {}

local list: { Module } = {
	-- ───────── OSTACOLI ─────────
	{
		Id = "corrente", Name = "Corrente d'aria", Category = "ostacolo", Energy = 20, Difficulty = 1.5,
		Footprint = { { 0, 0 }, { -1, 0 }, { 1, 0 } }, Solid = false,
		Description = "Una lama di vento spinge l'incursore di lato. Telegrafata da foglie e particelle.",
		Unlock = { Kind = "default" }, Color = Color3.fromRGB(170, 235, 215),
		Params = { Push = 55, Pulse = false },
		Alternatives = {
			{ Id = "raffica", Name = "Raffica pulsante", Description = "Si attiva a intermittenza ma spinge più forte: premia il tempismo.", Params = { Push = 95, Pulse = true, PulsePeriod = 2.4 }, Unlock = { Kind = "mastery", Track = "Defense", Tier = 1 } },
			{ Id = "ascensionale", Name = "Corrente ascensionale", Description = "Solleva verso l'alto invece di spingere di lato: lo slancio gioca brutti scherzi.", Params = { Push = 70, Up = true }, Unlock = { Kind = "mastery", Track = "Defense", Tier = 2 } },
		},
	},
	{
		Id = "piattaforma", Name = "Piattaforma mobile", Category = "ostacolo", Energy = 25, Difficulty = 2,
		Footprint = { { 0, 0 }, { 0, -1 }, { 0, 1 } }, Solid = false,
		Description = "Apre un vuoto tra le nuvole attraversabile solo su una piattaforma in movimento.",
		Unlock = { Kind = "sparks", Cost = 180 }, Color = Color3.fromRGB(255, 220, 150),
		Params = { Period = 3.2, Width = 1 },
		Alternatives = {
			{ Id = "lenta_larga", Name = "Piattaforma lenta e larga", Description = "Più facile da prendere ma lentissima: costa tempo prezioso.", Params = { Period = 5.5, Width = 1.6 }, Unlock = { Kind = "mastery", Track = "Defense", Tier = 1 } },
			{ Id = "doppia", Name = "Coppia sfasata", Description = "Due piattaforme piccole in controfase: serve ritmo.", Params = { Period = 2.6, Width = 0.7, Double = true }, Unlock = { Kind = "mastery", Track = "Defense", Tier = 3 } },
		},
	},
	{
		Id = "sentinella", Name = "Sentinella luminosa", Category = "ostacolo", Energy = 30, Difficulty = 3,
		Footprint = { { 0, 0 } }, Solid = true,
		Description = "Un faro rotante: chi finisce nel cono di luce torna al checkpoint.",
		Unlock = { Kind = "sparks", Cost = 320 }, Color = Color3.fromRGB(255, 250, 200),
		Params = { Radius = 9, Arc = 50, Speed = 55 },
		Alternatives = {
			{ Id = "ampia", Name = "Sentinella ampia", Description = "Più lenta ma con un cono molto più largo.", Params = { Radius = 11, Arc = 90, Speed = 32 }, Unlock = { Kind = "mastery", Track = "Defense", Tier = 1 } },
			{ Id = "nervosa", Name = "Sentinella nervosa", Description = "Cono stretto che cambia direzione all'improvviso.", Params = { Radius = 9, Arc = 35, Speed = 80, Erratic = true }, Unlock = { Kind = "mastery", Track = "Defense", Tier = 2 } },
		},
	},
	{
		Id = "muro_nube", Name = "Muro di nubi", Category = "ostacolo", Energy = 15, Difficulty = 1,
		Footprint = { { 0, 0 }, { 1, 0 } }, Solid = true,
		Description = "Una nuvola compatta che blocca il passaggio e allunga il percorso.",
		Unlock = { Kind = "default" }, Color = Color3.fromRGB(235, 240, 255),
		Params = {},
		Alternatives = {
			{ Id = "lungo", Name = "Muraglia", Description = "Tre celle di nuvola: deviazioni più lunghe, stessa energia.", Params = { Long = true }, Unlock = { Kind = "mastery", Track = "Defense", Tier = 2 } },
		},
	},
	-- ───────── DISTRAZIONI ─────────
	{
		Id = "faro", Name = "Faro distrattore", Category = "distrazione", Energy = 15, Difficulty = 1,
		Footprint = { { 0, 0 } }, Solid = false,
		Description = "Brilla come una pozza di scintille: chi lo tocca resta abbagliato per qualche secondo.",
		Unlock = { Kind = "sparks", Cost = 150 }, Color = Color3.fromRGB(255, 200, 90),
		Params = { Dazzle = 3.5 },
		Alternatives = {},
	},
	{
		Id = "nebbia", Name = "Banco di nebbia", Category = "distrazione", Energy = 20, Difficulty = 1.5,
		Footprint = { { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }, Solid = false,
		Description = "Riduce la visibilità: le sentinelle vicine diventano difficili da leggere.",
		Unlock = { Kind = "sparks", Cost = 220 }, Color = Color3.fromRGB(215, 225, 240),
		Params = {},
		Alternatives = {},
	},
	{
		Id = "scivolo", Name = "Prato di rugiada", Category = "distrazione", Energy = 15, Difficulty = 1,
		Footprint = { { 0, 0 }, { 1, 0 } }, Solid = false,
		Description = "Erba bagnata e scivolosa: il controllo del personaggio diventa impreciso.",
		Unlock = { Kind = "sparks", Cost = 150 }, Color = Color3.fromRGB(160, 230, 170),
		Params = { Friction = 0.05 },
		Alternatives = {},
	},
	-- ───────── MODULI FIRMA ─────────
	{
		Id = "cupola", Name = "Cupola prismatica", Category = "firma", Energy = 30, Difficulty = 2.5,
		Footprint = { { 0, 0 } }, Solid = false,
		Description = "Solleva la pozza su un piedistallo raggiungibile solo saltando sui trampolini di luce.",
		Unlock = { Kind = "mastery", Track = "Defense", Tier = 1 }, Color = Color3.fromRGB(220, 180, 255),
		Params = { Height = 7 },
		Alternatives = {},
	},
	{
		Id = "campana", Name = "Campana del vento", Category = "firma", Energy = 25, Difficulty = 2,
		Footprint = { { 0, 0 } }, Solid = false,
		Description = "A metà del tempo suona e inverte tutte le correnti d'aria del vivaio.",
		Unlock = { Kind = "mastery", Track = "Defense", Tier = 2 }, Color = Color3.fromRGB(255, 230, 170),
		Params = { TriggerFraction = 0.5 },
		Alternatives = {},
	},
	{
		Id = "arcobaleno", Name = "Ponte arcobaleno", Category = "firma", Energy = 35, Difficulty = 3,
		Footprint = { { 0, 0 }, { 0, 1 }, { 0, 2 } }, Solid = false,
		Description = "Un ponte che appare e scompare a ritmo: l'unico passaggio sopra un vuoto di tre celle.",
		Unlock = { Kind = "mastery", Track = "Defense", Tier = 3 }, Color = Color3.fromRGB(255, 160, 220),
		Params = { Period = 4 },
		Alternatives = {},
	},
}

D.List = list
D.ById = {}
for _, m in ipairs(list) do
	D.ById[m.Id] = m
end

function D.Get(id): Module?
	return D.ById[id]
end

function D.GetAlternative(moduleId, altId): Alternative?
	local m = D.ById[moduleId]
	if not m or not altId or altId == "base" then
		return nil
	end
	for _, a in ipairs(m.Alternatives) do
		if a.Id == altId then
			return a
		end
	end
	return nil
end

-- Footprint effettivo tenendo conto dell'alternativa (es. muraglia lunga)
function D.EffectiveFootprint(moduleId, altId)
	local m = D.ById[moduleId]
	if not m then
		return {}
	end
	if moduleId == "muro_nube" and altId == "lungo" then
		return { { 0, 0 }, { 1, 0 }, { -1, 0 } }
	end
	return m.Footprint
end

-- Parametri effettivi = base + alternativa
function D.EffectiveParams(moduleId, altId)
	local m = D.ById[moduleId]
	if not m then
		return {}
	end
	local out = table.clone(m.Params)
	local alt = D.GetAlternative(moduleId, altId)
	if alt then
		for k, v in pairs(alt.Params) do
			out[k] = v
		end
	end
	return out
end

D.CategoryNames = { ostacolo = "Ostacolo", distrazione = "Distrazione", firma = "Modulo firma" }

return D
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">SimulatedVivai</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Vivai del Guardiano: bersagli simulati sempre disponibili. Servono per il tutorial,
	per le commissioni (nessuna richiede di colpire giocatori reali) e quando non ci sono
	bersagli idonei. Ricompensa ridotta (Config.Raid.SimulatedRewardFraction), nessuno perde nulla.
]]

local list = {
	{
		Key = "sim_allenamento", Name = "Vivaio del Guardiano · Allenamento", Tier = 1, Exposed = 160,
		Creatures = { { Id = "sole_lumino", x = 2, z = 3 }, { Id = "pioggia_gocciolo", x = 9, z = 8 } },
		Layout = { Modules = { { Id = "corrente", x = 5, z = 3, Rot = 0 } } },
		Tutorial = true,
	},
	{
		Key = "sim_brezza", Name = "Vivaio del Guardiano · Brezza", Tier = 1, Exposed = 220,
		Creatures = { { Id = "vento_brezzolo", x = 2, z = 2 }, { Id = "sole_lumino", x = 9, z = 3 }, { Id = "pioggia_gocciolo", x = 2, z = 9 } },
		Layout = { Modules = { { Id = "corrente", x = 5, z = 3, Rot = 0 }, { Id = "muro_nube", x = 4, z = 8, Rot = 0 } } },
	},
	{
		Key = "sim_faro", Name = "Vivaio del Guardiano · Faro", Tier = 2, Exposed = 380,
		Creatures = { { Id = "sole_raggiolo", x = 2, z = 2 }, { Id = "pioggia_acquerella", x = 9, z = 2 }, { Id = "vento_alisea", x = 2, z = 9 }, { Id = "aurora_velina", x = 9, z = 9 } },
		Layout = { Modules = { { Id = "sentinella", x = 3, z = 5, Rot = 0 }, { Id = "corrente", x = 6, z = 8, Rot = 0 }, { Id = "faro", x = 8, z = 5, Rot = 0 } } },
	},
	{
		Key = "sim_abisso", Name = "Vivaio del Guardiano · Abisso", Tier = 3, Exposed = 620,
		Creatures = { { Id = "sole_meriggia", x = 2, z = 2 }, { Id = "pioggia_monsonia", x = 9, z = 2 }, { Id = "vento_zefirio", x = 2, z = 9 }, { Id = "aurora_boreala", x = 9, z = 9 }, { Id = "sole_lumino", x = 1, z = 6 } },
		Layout = { Modules = { { Id = "piattaforma", x = 5, z = 2, Rot = 1 }, { Id = "sentinella", x = 8, z = 6, Rot = 0 }, { Id = "muro_nube", x = 3, z = 8, Rot = 0 }, { Id = "nebbia", x = 6, z = 7, Rot = 0 } } },
	},
	{
		Key = "sim_tempesta", Name = "Vivaio del Guardiano · Tempesta", Tier = 4, Exposed = 900,
		Creatures = { { Id = "sole_solstizia", x = 2, z = 2 }, { Id = "pioggia_diluvia", x = 9, z = 2 }, { Id = "vento_tramontana", x = 2, z = 9 }, { Id = "aurora_corona", x = 9, z = 9 }, { Id = "aurora_australa", x = 1, z = 6 }, { Id = "vento_alisea", x = 10, z = 6 } },
		-- energia: 30 + 20 + 25 + 25 = 100 (budget pieno)
		Layout = { Modules = { { Id = "sentinella", x = 4, z = 3, Rot = 0, Alt = "ampia" }, { Id = "corrente", x = 7, z = 8, Rot = 0, Alt = "raffica" }, { Id = "piattaforma", x = 6, z = 2, Rot = 1 }, { Id = "campana", x = 10, z = 10, Rot = 0 } } },
	},
}

local Simulated = { List = list, ByKey = {} }
for _, s in ipairs(list) do
	Simulated.ByKey[s.Key] = s
end

function Simulated.ForTier(tier)
	local out = {}
	for _, s in ipairs(list) do
		if not s.Tutorial and math.abs(s.Tier - tier) <= 1 then
			table.insert(out, s)
		end
	end
	if #out == 0 then
		table.insert(out, list[2])
	end
	return out
end

return Simulated
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Themes</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Temi settimanali: modificatore visivo + sfida facoltativa con premio cosmetico/gettoni.
export type Theme = {
	Id: string,
	Name: string,
	Description: string,
	Visual: { Tint: Color3, Ambient: Color3, ParticleColor: Color3, Particle: string, ClockTime: number },
	Challenge: { Text: string, Stat: string, Target: number, Reward: { Tokens: number?, Cosmetic: string? } },
}

local list: { Theme } = {
	{
		Id = "aurora", Name = "Settimana dell'Aurora", Description = "Veli verdi e viola attraversano il cielo dell'hub.",
		Visual = { Tint = Color3.fromRGB(205, 190, 255), Ambient = Color3.fromRGB(120, 130, 190), ParticleColor = Color3.fromRGB(150, 255, 210), Particle = "ribbon", ClockTime = 18.5 },
		Challenge = { Text = "Deposita 1.500 scintille questa settimana", Stat = "WeeklyDeposited", Target = 1500, Reward = { Tokens = 25 } },
	},
	{
		Id = "monsone", Name = "Monsone gentile", Description = "Pioggia luminosa e riflessi perlati.",
		Visual = { Tint = Color3.fromRGB(200, 215, 235), Ambient = Color3.fromRGB(140, 150, 175), ParticleColor = Color3.fromRGB(170, 210, 255), Particle = "rain", ClockTime = 15 },
		Challenge = { Text = "Completa 6 incursioni questa settimana (anche simulate)", Stat = "WeeklyRaids", Target = 6, Reward = { Tokens = 25 } },
	},
	{
		Id = "alisei", Name = "Settimana degli Alisei", Description = "Correnti di foglie e nastri di vento.",
		Visual = { Tint = Color3.fromRGB(215, 250, 235), Ambient = Color3.fromRGB(140, 175, 170), ParticleColor = Color3.fromRGB(190, 245, 220), Particle = "leaf", ClockTime = 11 },
		Challenge = { Text = "Pubblica 3 layout diversi questa settimana", Stat = "WeeklyLayouts", Target = 3, Reward = { Cosmetic = "skin_alisei" } },
	},
	{
		Id = "solstizio", Name = "Solstizio dorato", Description = "Luce lunga e calda su tutto il vivaio.",
		Visual = { Tint = Color3.fromRGB(255, 230, 190), Ambient = Color3.fromRGB(190, 160, 130), ParticleColor = Color3.fromRGB(255, 220, 130), Particle = "spark", ClockTime = 17 },
		Challenge = { Text = "Completa 8 commissioni questa settimana", Stat = "WeeklyCommissions", Target = 8, Reward = { Cosmetic = "plate_meteorologo" } },
	},
}

local Themes = { List = list, ById = {} }
for _, t in ipairs(list) do
	Themes.ById[t.Id] = t
end

function Themes.ForWeek(weekIndex)
	return list[(weekIndex % #list) + 1]
end

return Themes
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Config.luau
	Tutti i numeri di bilanciamento del gioco in un unico posto.
	I valori seguono l'"esempio numerico da testare" del GDD (sezione 5) e
	le regole anti-frustrazione (sezione 4.2). Sono pensati per essere
	ritoccati senza toccare la logica.
]]

local Config = {}

Config.GameName = "Il Vivaio delle Nuvole"
Config.DataVersion = 1
Config.DataStoreName = "VivaioProfili_v1"
Config.RaidPoolStoreName = "VivaioRaidPool_v1"
Config.RaidInboxStoreName = "VivaioRaidInbox_v1"
Config.GalleryStoreName = "VivaioGalleria_v1"

-- ───────────────────────────── Griglia e plot ─────────────────────────────
Config.Grid = {
	Size = 12, -- celle per lato
	CellSize = 4, -- studs per cella
	-- celle riservate al percorso di incursione (non edificabili)
	EntranceCells = { { x = 5, z = 0 }, { x = 6, z = 0 } },
	ExitCells = { { x = 5, z = 11 }, { x = 6, z = 11 } },
	PozzaCells = { { x = 5, z = 5 }, { x = 6, z = 5 }, { x = 5, z = 6 }, { x = 6, z = 6 } },
}

Config.Plots = {
	Count = 12,
	RingRadius = 300,
	PlatformSize = 64,
	Height = 0,
}

Config.Arenas = {
	Count = 8,
	Origin = Vector3.new(0, 420, 1500),
	Spacing = 220,
}

-- ───────────────────────────── Produzione ─────────────────────────────
Config.Production = {
	BaseInterval = 30, -- secondi (GDD: 10 scintille ogni 30 s)
	BufferIntervals = 6, -- la creatura accumula al massimo 6 intervalli non ritirati
	-- rendimento marginale decrescente oltre la sesta creatura (ordinate per produzione)
	DiminishingFactors = { [7] = 0.5, [8] = 0.5, [9] = 0.35, [10] = 0.35, [11] = 0.25, [12] = 0.25 },
	-- riserva offline: frazione della produzione normale, con tetto
	OfflineRateFraction = 0.25,
	OfflineCapMinutes = 120,
	OfflineCapSparks = 240,
	TickSeconds = 1,
}

-- ───────────────────────────── Cassaforte ─────────────────────────────
Config.Vault = {
	-- capienza per livello (livello 1 = base 300 dal GDD)
	Capacities = { 300, 600, 1200, 2400, 4800, 9000 },
	-- costo in scintille per salire al livello successivo (indice = livello di arrivo)
	UpgradeCosts = { [2] = 250, [3] = 600, [4] = 1200, [5] = 2400, [6] = 4500 },
}

Config.PlotSlots = {
	-- quante creature possono essere esposte per livello di espansione
	Capacities = { 6, 8, 10, 12 },
	UpgradeCosts = { [2] = 400, [3] = 1200, [4] = 2600 },
}

-- ───────────────────────────── Incursioni ─────────────────────────────
Config.Raid = {
	DurationSeconds = 90,
	MinPlausibleSeconds = 6, -- sotto questa durata il server rifiuta il successo
	MaxTakeFraction = 0.25, -- massimo 25% delle scintille esposte
	TierTakeCaps = { 90, 180, 320, 520, 800 }, -- tetto assoluto per fascia del bersaglio
	MaxLossesPerWindow = 2,
	LossWindowSeconds = 30 * 60,
	ShieldAfterLossSeconds = 20 * 60,
	NewPlayerShieldPlaytime = 2 * 60 * 60, -- 2 ore di gioco
	NewPlayerShieldMinVaultLevel = 2,
	RepeatTargetCooldown = 60 * 60, -- non riproporre lo stesso bersaglio per 1 ora
	ParticipationReward = 15,
	DefenderBonus = 45, -- bonus difesa finanziato dal sistema
	DefenderConsolationFraction = 0.2, -- consolazione in % di quanto perso
	SimulatedRewardFraction = 0.6,
	MasteryWin = 6,
	MasteryLoss = 2,
	MasteryDefend = 5,
	CandidateCount = 3,
	DazzleSeconds = 3.5, -- faro distrattore
	CheckpointRespawnDelay = 0.8,
	StartCountdown = 3,
	PoolBucketLimit = 120, -- bersagli per fascia conservati nel pool
	InboxLimit = 30,
	AttackerCooldownSeconds = 20,
}

-- fasce di progressione (in base alla cassaforte + numero creature)
Config.Tiers = {
	-- punteggio = livello cassaforte*2 + creature possedute
	Thresholds = { 0, 8, 14, 20, 28 },
}

-- ───────────────────────────── Difesa ─────────────────────────────
Config.Defense = {
	EnergyBudget = 100,
	MaxObstacles = 3,
	MaxDistractions = 2,
	MaxSignature = 1,
	TestIsFree = true,
}

-- ───────────────────────────── Commissioni ─────────────────────────────
Config.Commissions = {
	DailyCount = 3,
	FreeRerollsPerDay = 1,
	Categories = { "raccolta", "costruzione", "visita", "incursione" },
}

-- ───────────────────────────── Bozzoli ─────────────────────────────
Config.Cocoon = {
	FragmentCost = 8,
}

-- ───────────────────────────── Galleria / social ─────────────────────────────
Config.Gallery = {
	VisitRewardSparks = 20,
	VisitRewardsPerDay = 3,
	LikesPerDay = 5,
	ListLimit = 24,
}

-- ───────────────────────────── Maestria ─────────────────────────────
Config.Mastery = {
	Tiers = { 10, 30, 60, 100, 160 },
	CollectionPerCreature = 6,
	CollectionPerVariant = 4,
	DefensePerPublish = 2,
}

-- ───────────────────────────── Tutorial ─────────────────────────────
Config.Tutorial = {
	Steps = 5,
	FreeDecorationChoices = { "lanterna_nube", "cespuglio_stellato" },
}

-- ───────────────────────────── Economia / anti-exploit ─────────────────────────────
Config.Limits = {
	InteractDistance = 14,
	CollectAllDistance = 48,
	MaxRemoteCallsPerMinute = 240,
	AutosaveSeconds = 60,
	StateSyncMaxPerSecond = 10,
}

Config.StyleTokens = {
	PerCommission = 5,
	PerAlbumMilestone = 10,
	WeeklyChallenge = 25,
	PerMasteryTier = 15,
}

-- ───────────────────────────── Suoni (asset integrati Roblox, nessuna dipendenza esterna) ─────────────────────────────
Config.Sounds = {
	Collect = "rbxasset://sounds/electronicpingshort.wav",
	Deposit = "rbxasset://sounds/snap.wav",
	Click = "rbxasset://sounds/button.wav",
	Place = "rbxasset://sounds/switch.wav",
	Error = "rbxasset://sounds/uuhhh.mp3",
	Success = "rbxasset://sounds/victory.wav",
	Whoosh = "rbxasset://sounds/swoosh.wav",
	Splash = "rbxasset://sounds/impact_water.mp3",
	Sentinel = "rbxasset://sounds/flashbulb.wav",
	Chime = "rbxasset://sounds/bass.wav",
}

-- ID prodotti Robux (0 = disattivato, nessun pulsante mostrato). Da compilare nel Creator Dashboard.
Config.Monetization = {
	FounderGamePassId = 0,
	CosmeticPassGamePassId = 0,
	-- cosmeticId -> DeveloperProductId
	CosmeticProducts = {},
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">DefaultData</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Template del profilo giocatore. Il DataService riconcilia i profili esistenti con questo.
local Config = require(script.Parent.Config)
local Cosmetics = require(script.Parent.Catalog.Cosmetics)

return function()
	return {
		Version = Config.DataVersion,
		Created = os.time(),
		LastSeen = os.time(),

		Sparks = {
			Exposed = 0, -- raccolte ma non depositate (sottraibili)
			Vault = 0, -- depositate (al sicuro)
			VaultLevel = 1,
		},
		Fragments = 0,
		StyleTokens = 0,

		PlotLevel = 1,
		-- Creature possedute: uid -> { Id, Variant, x, z (nil se in inventario), Buffer, LastTick }
		Creatures = {},
		OwnedCreatureIds = {},
		UnlockedVariants = {}, -- creatureId -> { variantId = true }
		NextCreatureUid = 1,

		Layout = { Modules = {} },
		LastValidLayout = { Modules = {} },
		LayoutVersion = 0,
		UnlockedModules = { corrente = true, muro_nube = true },
		UnlockedAlternatives = {}, -- moduleId -> { altId = true }
		ModuleAlternative = {}, -- moduleId -> altId scelto

		Decorations = {
			Owned = {},
			Placed = {}, -- { Id, x, z, Rot }
		},

		Cosmetics = {
			Owned = { skin_prato = true, sky_giorno = true, trail_nessuna = true, emote_saluto = true, plate_nessuna = true },
			Equipped = table.clone(Cosmetics.Defaults),
		},
		Pass = { Points = 0, ClaimedFree = {}, ClaimedPremium = {}, Premium = false },
		Founder = false,

		Commissions = { DayKey = "", List = {}, RerollsUsed = 0 },
		DailyStats = { DayKey = "" },
		WeeklyStats = { WeekIndex = -1 },
		WeeklyChallengeClaimed = {}, -- weekIndex -> true

		Album = { Claimed = {} },
		Mastery = {
			Collection = 0,
			Raid = 0,
			Defense = 0,
			ClaimedTiers = { Collection = 0, Raid = 0, Defense = 0 },
		},
		AutoDepositUnlocked = false,

		Cocoon = { Active = nil, Completed = 0 },

		Raid = {
			LossTimestamps = {},
			ShieldUntil = 0,
			RecentTargets = {}, -- key -> timestamp
			Attempts = 0,
			Successes = 0,
			Defended = 0,
			Lost = 0,
			RecentResults = {}, -- ultimi 10 esiti: 1 successo, 0 fallimento
			History = {}, -- riepiloghi (max 10)
			LastRaidAt = 0,
			AppliedInbox = {}, -- raidId -> true (idempotenza)
			AppliedInboxOrder = {},
		},

		Gallery = {
			Published = false,
			Likes = 0,
			LikesGiven = {}, -- key -> dayKey
			ShareCode = "",
		},

		Stats = {
			TotalCollected = 0,
			TotalDeposited = 0,
			TotalSpent = 0,
			RaidsDefended = 0,
			RaidsWon = 0,
			RaidsLost = 0,
			LayoutsPublished = 0,
			PlayTime = 0,
			Sessions = 0,
			FirstActionAt = nil,
		},

		Settings = {
			AudioEnabled = true,
			ReducedEffects = false,
			AutoDeposit = false,
			HideProfile = false,
			ShowName = true,
		},

		Tutorial = { Step = 1, CompletedOnce = false, Active = true },

		Ledger = {}, -- id ricompensa -> true (idempotenza acquisti/commissioni)
	}
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">LayoutValidator</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	LayoutValidator: usato sia dal client (anteprima) sia dal server (autorità).
	Verifica: formato, moduli esistenti e sbloccati, limiti per categoria, budget energia,
	celle in griglia, nessuna sovrapposizione (moduli, creature, decorazioni, celle riservate)
	e che esista almeno un percorso completabile: ingresso → pozza → uscita
	attraverso celle non solide (BFS a 4 direzioni).
]]

local Config = require(script.Parent.Config)
local Defenses = require(script.Parent.Catalog.Defenses)
local GridUtil = require(script.Parent.Util.GridUtil)

local Validator = {}
local G = Config.Grid

export type PlacedModule = { Id: string, x: number, z: number, Rot: number?, Alt: string? }
export type Layout = { Modules: { PlacedModule } }
export type Result = {
	Ok: boolean,
	Reason: string?,
	Energy: number,
	Counts: { ostacolo: number, distrazione: number, firma: number },
	Difficulty: number,
	Path: { { x: number, z: number } }?, -- percorso trovato (per anteprima)
	Occupied: { [string]: string }, -- cella -> moduleId
}

local function neighbors(x, z)
	return { { x + 1, z }, { x - 1, z }, { x, z + 1 }, { x, z - 1 } }
end

-- BFS da un insieme di celle sorgente a un insieme bersaglio; restituisce il percorso o nil
local function bfs(solid, sources, targets)
	local targetSet = {}
	for _, c in ipairs(targets) do
		targetSet[GridUtil.Key(c.x, c.z)] = true
	end
	local visited, parent, queue = {}, {}, {}
	for _, c in ipairs(sources) do
		local k = GridUtil.Key(c.x, c.z)
		if not solid[k] then
			visited[k] = true
			table.insert(queue, { c.x, c.z })
		end
	end
	local head = 1
	while head <= #queue do
		local cur = queue[head]
		head += 1
		local ck = GridUtil.Key(cur[1], cur[2])
		if targetSet[ck] then
			local path = {}
			local k = ck
			while k do
				local px, pz = GridUtil.FromKey(k)
				table.insert(path, 1, { x = px, z = pz })
				k = parent[k]
			end
			return path
		end
		for _, n in ipairs(neighbors(cur[1], cur[2])) do
			local nx, nz = n[1], n[2]
			if GridUtil.InBounds(nx, nz) then
				local nk = GridUtil.Key(nx, nz)
				if not visited[nk] and not solid[nk] then
					visited[nk] = true
					parent[nk] = ck
					table.insert(queue, { nx, nz })
				end
			end
		end
	end
	return nil
end

--[[
	layout: Layout
	context: {
		UnlockedModules: {[id]=true}?,  -- se nil, non controlla gli sblocchi (anteprima)
		UnlockedAlternatives: {[moduleId]={[alt]=true}}?,
		CreatureCells: {[key]=true}?,
		DecorationCells: {[key]=true}?,
	}
]]
function Validator.Validate(layout, context): Result
	context = context or {}
	local result: Result = {
		Ok = false,
		Reason = nil,
		Energy = 0,
		Counts = { ostacolo = 0, distrazione = 0, firma = 0 },
		Difficulty = 0,
		Path = nil,
		Occupied = {},
	}

	if type(layout) ~= "table" or type(layout.Modules) ~= "table" then
		result.Reason = "Formato layout non valido"
		return result
	end
	if #layout.Modules > 6 then
		result.Reason = "Troppi moduli (massimo 6)"
		return result
	end

	local reserved = GridUtil.ReservedSet()
	local solid = {}

	for i, pm in ipairs(layout.Modules) do
		if type(pm) ~= "table" or type(pm.Id) ~= "string" or type(pm.x) ~= "number" or type(pm.z) ~= "number" then
			result.Reason = "Modulo #" .. i .. " malformato"
			return result
		end
		local def = Defenses.Get(pm.Id)
		if not def then
			result.Reason = "Modulo sconosciuto: " .. tostring(pm.Id)
			return result
		end
		if pm.x ~= math.floor(pm.x) or pm.z ~= math.floor(pm.z) then
			result.Reason = "Coordinate non intere"
			return result
		end
		local rot = pm.Rot or 0
		if type(rot) ~= "number" or rot < 0 or rot > 3 or rot ~= math.floor(rot) then
			result.Reason = "Rotazione non valida"
			return result
		end
		if pm.Alt ~= nil then
			if type(pm.Alt) ~= "string" then
				result.Reason = "Alternativa non valida"
				return result
			end
			if pm.Alt ~= "base" and not Defenses.GetAlternative(pm.Id, pm.Alt) then
				result.Reason = "Alternativa sconosciuta per " .. def.Name
				return result
			end
			if context.UnlockedAlternatives and pm.Alt ~= "base" then
				local set = context.UnlockedAlternatives[pm.Id]
				if not (set and set[pm.Alt]) then
					result.Reason = "Alternativa non sbloccata: " .. pm.Alt
					return result
				end
			end
		end
		if context.UnlockedModules and not context.UnlockedModules[pm.Id] then
			result.Reason = def.Name .. " non è sbloccato"
			return result
		end

		result.Counts[def.Category] += 1
		result.Energy += def.Energy
		result.Difficulty += def.Difficulty

		local cells = GridUtil.ModuleCells(Defenses.EffectiveFootprint(pm.Id, pm.Alt), pm.x, pm.z, rot)
		for _, c in ipairs(cells) do
			if not GridUtil.InBounds(c.x, c.z) then
				result.Reason = def.Name .. " esce dalla griglia"
				return result
			end
			local k = GridUtil.Key(c.x, c.z)
			if reserved[k] then
				result.Reason = def.Name .. " occupa una cella riservata (ingresso, pozza o uscita)"
				return result
			end
			if result.Occupied[k] then
				result.Reason = def.Name .. " si sovrappone a un altro modulo"
				return result
			end
			if context.CreatureCells and context.CreatureCells[k] then
				result.Reason = def.Name .. " si sovrappone a una creatura"
				return result
			end
			if context.DecorationCells and context.DecorationCells[k] then
				result.Reason = def.Name .. " si sovrappone a una decorazione"
				return result
			end
			result.Occupied[k] = pm.Id
			if def.Solid then
				solid[k] = true
			end
		end
	end

	local D = Config.Defense
	if result.Counts.ostacolo > D.MaxObstacles then
		result.Reason = "Troppi ostacoli (massimo " .. D.MaxObstacles .. ")"
		return result
	end
	if result.Counts.distrazione > D.MaxDistractions then
		result.Reason = "Troppe distrazioni (massimo " .. D.MaxDistractions .. ")"
		return result
	end
	if result.Counts.firma > D.MaxSignature then
		result.Reason = "Un solo modulo firma"
		return result
	end
	if result.Energy > D.EnergyBudget then
		result.Reason = "Energia difensiva insufficiente (" .. result.Energy .. "/" .. D.EnergyBudget .. ")"
		return result
	end

	-- Percorso: ingresso → pozza → uscita
	local toPozza = bfs(solid, G.EntranceCells, G.PozzaCells)
	if not toPozza then
		result.Reason = "Nessun percorso dall'ingresso alla pozza"
		return result
	end
	local toExit = bfs(solid, G.PozzaCells, G.ExitCells)
	if not toExit then
		result.Reason = "Nessun percorso dalla pozza all'uscita"
		return result
	end
	local path = table.clone(toPozza)
	for i = 2, #toExit do
		table.insert(path, toExit[i])
	end
	result.Path = path
	result.Ok = true
	return result
end

-- Stima difficoltà 1..5 ("nuvole") a partire dal peso dei moduli
function Validator.DifficultyStars(difficultySum)
	if difficultySum <= 0 then
		return 1
	end
	return math.clamp(math.floor(difficultySum / 2.2) + 1, 1, 5)
end

-- Layout vuoto
function Validator.Empty(): Layout
	return { Modules = {} }
end

return Validator
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Models</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">CreatureModel</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	CreatureModel: costruisce un Nimbino proceduralmente (nessun asset esterno).
	Il PrimaryPart è il corpo; l'animazione è cosmetica lato client (WorldAnimator).
]]
local Creatures = require(script.Parent.Parent.Catalog.Creatures)
local PartUtil = require(script.Parent.PartUtil)

local CreatureModel = {}

local function face(body, size, accent)
	local eyeR = size * 0.12
	for _, side in ipairs({ -1, 1 }) do
		local eye = PartUtil.Ball(eyeR * 2, Color3.fromRGB(30, 30, 40), body.CFrame * CFrame.new(side * size * 0.2, size * 0.1, -size * 0.42), body.Parent, { Name = "Eye" })
		PartUtil.Ball(eyeR * 0.8, Color3.new(1, 1, 1), eye.CFrame * CFrame.new(-side * eyeR * 0.3, eyeR * 0.4, -eyeR * 0.7), body.Parent, { Name = "EyeShine", Material = Enum.Material.Neon })
		-- guancia
		PartUtil.Part({
			Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.1, size * 0.18, size * 0.18), Color = Color3.fromRGB(255, 160, 170), Transparency = 0.25,
			CFrame = body.CFrame * CFrame.new(side * size * 0.33, -size * 0.08, -size * 0.36) * CFrame.Angles(0, math.rad(90 + side * 25), 0),
			Parent = body.Parent, CanCollide = false, Name = "Cheek",
		})
	end
	-- bocca sorridente (piccolo cilindro scuro)
	PartUtil.Part({
		Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.08, size * 0.08, size * 0.22), Color = Color3.fromRGB(70, 40, 60),
		CFrame = body.CFrame * CFrame.new(0, -size * 0.18, -size * 0.48) * CFrame.Angles(0, math.rad(90), 0),
		Parent = body.Parent, CanCollide = false, Name = "Mouth",
	})
end

local function familyFeature(def, body, size, color, accent)
	local parent = body.Parent
	local fam = def.Family
	if fam == "sole" then
		for i = 1, 8 do
			local a = (i / 8) * math.pi * 2
			local cf = body.CFrame * CFrame.Angles(0, 0, a) * CFrame.new(0, size * 0.75, 0)
			PartUtil.Part({ Size = Vector3.new(size * 0.16, size * 0.42, size * 0.1), Color = accent, Material = Enum.Material.Neon, CFrame = cf, Parent = parent, CanCollide = false, Name = "Ray", CastShadow = false })
		end
	elseif fam == "pioggia" then
		-- cappellino di nuvola
		PartUtil.Cloud(body.CFrame * CFrame.new(0, size * 0.62, 0), size * 0.22, parent, Color3.fromRGB(245, 248, 255), 0)
		-- codina a goccia
		PartUtil.Ball(size * 0.35, color, body.CFrame * CFrame.new(0, -size * 0.55, size * 0.1), parent, { Name = "Drop", Material = Enum.Material.Glass, Transparency = 0.2 })
		PartUtil.Emitter(body, { Color = accent, Rate = 3, Speed = NumberRange.new(1, 2), Acceleration = Vector3.new(0, -6, 0), Size = NumberSequence.new(0.18), Lifetime = NumberRange.new(0.5, 0.9), Spread = Vector2.new(30, 30), Name = "Drizzle" })
	elseif fam == "vento" then
		for i = 1, 3 do
			local a = i * 0.9
			local cf = body.CFrame * CFrame.new(math.cos(a) * size * 0.55, (i - 2) * size * 0.18, size * 0.45 + i * 0.12) * CFrame.Angles(0, a, math.rad(20))
			PartUtil.Part({ Size = Vector3.new(size * 0.55, size * 0.08, size * 0.12), Color = accent, Material = Enum.Material.Neon, Transparency = 0.25, CFrame = cf, Parent = parent, CanCollide = false, Name = "Swirl", CastShadow = false })
		end
		PartUtil.Emitter(body, { Color = accent, Rate = 4, Speed = NumberRange.new(1.5, 2.5), Acceleration = Vector3.new(0, 0.3, 0), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 0) }), Lifetime = NumberRange.new(0.6, 1.1), Name = "Gust" })
	elseif fam == "aurora" then
		local segs = 7
		for i = 1, segs do
			local t = (i - 1) / (segs - 1)
			local a = math.rad(200 - t * 220)
			local c = color:Lerp(accent, t)
			local cf = body.CFrame * CFrame.new(math.cos(a) * size * 0.72, size * 0.25 + math.sin(a) * size * 0.55, 0) * CFrame.Angles(0, 0, a + math.rad(90))
			PartUtil.Part({ Size = Vector3.new(size * 0.14, size * 0.3, size * 0.18), Color = c, Material = Enum.Material.Neon, Transparency = 0.15, CFrame = cf, Parent = parent, CanCollide = false, Name = "Arc", CastShadow = false })
		end
	end
end

function CreatureModel.Build(creatureId, variantId, parent)
	local def = Creatures.Get(creatureId)
	if not def then
		return nil
	end
	local variant = Creatures.GetVariant(creatureId, variantId or "base") or def.Variants[1]
	local color = variant.Color
	local accent = def.Visual.Accent
	local size = def.Visual.Size

	local model = PartUtil.Model("Creature_" .. creatureId, nil)
	model:SetAttribute("CreatureId", creatureId)
	model:SetAttribute("Variant", variant.Id)
	model:SetAttribute("Behavior", def.Behavior)

	local body = PartUtil.Ball(size, color, CFrame.new(0, 0, 0), model, { Name = "Body", Material = Enum.Material.SmoothPlastic, CanQuery = true })
	model.PrimaryPart = body
	-- cuore luminoso interno (dà profondità)
	PartUtil.Ball(size * 0.55, accent, body.CFrame, model, { Name = "Core", Material = Enum.Material.Neon, Transparency = 0.55, CastShadow = false })

	face(body, size, accent)
	familyFeature(def, body, size, color, accent)

	local glow = def.Visual.Glow or 0.5
	PartUtil.Light(body, color, 0.6 + glow * 0.8, 8 + glow * 6)

	if def.Rarity == "leggendario" or def.Rarity == "raro" then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = accent
		sparkles.Enabled = def.Rarity == "leggendario"
		sparkles.Parent = body
		if def.Rarity == "raro" then
			PartUtil.Emitter(body, { Color = accent, Rate = 3, Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) }), Name = "Twinkle" })
		end
	end

	-- ombra morbida a terra (disco scuro trasparente)
	PartUtil.Part({
		Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.05, size * 0.9, size * 0.9), Color = Color3.fromRGB(40, 60, 100), Transparency = 0.75,
		CFrame = CFrame.new(0, -2.45, 0) * CFrame.Angles(0, 0, math.rad(90)), Parent = model, CanCollide = false, Name = "Shadow", CastShadow = false,
	})

	if parent then
		model.Parent = parent
	end
	return model
end

return CreatureModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">DecorationModel</string>
            <string name="Source"><![CDATA[--!nonstrict
local Decorations = require(script.Parent.Parent.Catalog.Decorations)
local PartUtil = require(script.Parent.PartUtil)

local DecorationModel = {}

local kinds = {}

kinds.lantern = function(m, v)
	PartUtil.Part({ Size = Vector3.new(0.35, 4.5, 0.35), Color = v.Accent, Material = Enum.Material.Wood, CFrame = CFrame.new(0, 2.25, 0), Parent = m, Name = "Post" })
	PartUtil.Part({ Size = Vector3.new(1.6, 0.25, 0.35), Color = v.Accent, Material = Enum.Material.Wood, CFrame = CFrame.new(0.6, 4.4, 0), Parent = m, Name = "Arm" })
	local lamp = PartUtil.Part({ Size = Vector3.new(0.9, 1.1, 0.9), Color = v.Color, Material = Enum.Material.Neon, Transparency = 0.1, CFrame = CFrame.new(1.2, 3.7, 0), Parent = m, Name = "Lamp", CanCollide = false })
	lamp:SetAttribute("Anim", "sway")
	PartUtil.Light(lamp, v.Color, 1.2, 12)
end

kinds.bush = function(m, v)
	for i, o in ipairs({ { 0, 0.9, 0, 2.2 }, { 0.8, 0.7, 0.4, 1.6 }, { -0.7, 0.75, -0.3, 1.7 }, { 0.1, 1.5, -0.5, 1.3 } }) do
		PartUtil.Ball(o[4], v.Color, CFrame.new(o[1], o[2], o[3]), m, { Material = Enum.Material.Grass, Name = "Leaf", CanCollide = false })
	end
	for i = 1, 6 do
		local a = i * 1.05
		PartUtil.Ball(0.3, v.Accent or Color3.new(1, 1, 1), CFrame.new(math.cos(a) * 1.1, 1.1 + math.sin(a * 2) * 0.5, math.sin(a) * 1.1), m, { Material = Enum.Material.Neon, Name = "Star", CastShadow = false })
	end
end

kinds.sundial = function(m, v)
	PartUtil.Cylinder(1.6, 0.5, v.Color, CFrame.new(0, 0.25, 0), m, { Material = Enum.Material.Marble, Name = "Disc" })
	local gnomon = PartUtil.Part({ Class = "WedgePart", Size = Vector3.new(0.3, 1.6, 1.6), Color = v.Accent, Material = Enum.Material.Neon, CFrame = CFrame.new(0, 1.3, -0.3), Parent = m, Name = "Gnomon", CanCollide = false })
	PartUtil.Light(gnomon, v.Accent, 0.6, 8)
end

kinds.fountain = function(m, v)
	PartUtil.Cylinder(1.8, 0.9, v.Color, CFrame.new(0, 0.45, 0), m, { Material = Enum.Material.Marble, Name = "Basin" })
	local water = PartUtil.Cylinder(1.5, 0.3, v.Accent, CFrame.new(0, 0.95, 0), m, { Material = Enum.Material.Neon, Transparency = 0.3, Name = "Water", CanCollide = false })
	PartUtil.Cylinder(0.35, 1.6, v.Color, CFrame.new(0, 1.6, 0), m, { Material = Enum.Material.Marble, Name = "Spout", CanCollide = false })
	PartUtil.Emitter(water, { Color = v.Accent, Rate = 14, Speed = NumberRange.new(6, 9), Lifetime = NumberRange.new(0.8, 1.2), Acceleration = Vector3.new(0, -14, 0), Spread = Vector2.new(12, 12), Size = NumberSequence.new(0.2), Name = "Jet" })
	PartUtil.Light(water, v.Accent, 0.8, 9)
end

kinds.pinwheel = function(m, v)
	PartUtil.Part({ Size = Vector3.new(0.25, 3.5, 0.25), Color = Color3.fromRGB(230, 230, 240), CFrame = CFrame.new(0, 1.75, 0), Parent = m, Name = "Post" })
	local hub = PartUtil.Ball(0.5, v.Accent or Color3.new(1, 1, 1), CFrame.new(0, 3.6, -0.3), m, { Material = Enum.Material.Neon, Name = "Hub" })
	hub:SetAttribute("Anim", "spin")
	for i = 1, 4 do
		local a = (i / 4) * math.pi * 2
		local blade = PartUtil.Part({ Class = "WedgePart", Size = Vector3.new(0.12, 1.1, 1.1), Color = (i % 2 == 0) and v.Color or (v.Accent or v.Color), Material = Enum.Material.SmoothPlastic, CFrame = CFrame.new(0, 3.6, -0.3) * CFrame.Angles(0, 0, a) * CFrame.new(0, 0.75, 0) * CFrame.Angles(math.rad(90), 0, 0), Parent = m, Name = "Blade", CanCollide = false })
		blade:SetAttribute("SpinChild", true)
	end
end

kinds.arch = function(m, v)
	local segs = 9
	for i = 1, segs do
		local t = (i - 1) / (segs - 1)
		local a = math.rad(180 - t * 180)
		local c = v.Color:Lerp(v.Accent or v.Color, t)
		PartUtil.Part({ Size = Vector3.new(0.5, 0.9, 0.5), Color = c, Material = Enum.Material.Neon, Transparency = 0.1, CFrame = CFrame.new(math.cos(a) * 2.2, 0.4 + math.sin(a) * 3.2, 0) * CFrame.Angles(0, 0, a + math.rad(90)), Parent = m, Name = "Seg", CanCollide = false, CastShadow = false })
	end
end

kinds.throne = function(m, v)
	PartUtil.Cloud(CFrame.new(0, 0.9, 0), 1.3, m, v.Color, 0)
	PartUtil.Part({ Size = Vector3.new(2.6, 0.6, 2.4), Color = v.Color, CFrame = CFrame.new(0, 1.7, 0), Parent = m, Name = "Seat" })
	PartUtil.Part({ Size = Vector3.new(2.6, 3, 0.5), Color = v.Color, CFrame = CFrame.new(0, 3.2, 1.0), Parent = m, Name = "Back" })
	local crown = PartUtil.Part({ Size = Vector3.new(1.4, 0.6, 0.4), Color = v.Accent, Material = Enum.Material.Neon, CFrame = CFrame.new(0, 5.0, 1.0), Parent = m, Name = "Crown", CanCollide = false })
	PartUtil.Light(crown, v.Accent, 1, 10)
end

kinds.bench = function(m, v)
	PartUtil.Part({ Size = Vector3.new(3.2, 0.4, 1.2), Color = v.Color, CFrame = CFrame.new(0, 1.2, 0), Parent = m, Name = "Seat" })
	PartUtil.Part({ Size = Vector3.new(3.2, 1.2, 0.3), Color = v.Color, CFrame = CFrame.new(0, 2.0, 0.5), Parent = m, Name = "Back" })
	for _, dx in ipairs({ -1.3, 1.3 }) do
		PartUtil.Part({ Size = Vector3.new(0.3, 1.0, 1.0), Color = v.Accent, Material = Enum.Material.Metal, CFrame = CFrame.new(dx, 0.5, 0), Parent = m, Name = "Leg" })
	end
end

function DecorationModel.Build(decoId, parent, ghost)
	local def = Decorations.ById[decoId]
	if not def then
		return nil
	end
	local m = PartUtil.Model("Deco_" .. decoId, nil)
	m:SetAttribute("DecorationId", decoId)
	local r = PartUtil.Part({ Size = Vector3.new(4, 0.2, 4), Transparency = 1, CanCollide = false, CanQuery = false, CFrame = CFrame.new(), Parent = m, Name = "Root" })
	m.PrimaryPart = r
	local builder = kinds[def.Visual.Kind]
	if builder then
		builder(m, def.Visual)
	end
	if ghost then
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.Transparency = math.max(d.Transparency, 0.5)
			elseif d:IsA("ParticleEmitter") or d:IsA("PointLight") then
				d.Enabled = false
			end
		end
	end
	if parent then
		m.Parent = parent
	end
	return m
end

return DecorationModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">ModuleModel</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	ModuleModel: geometria procedurale dei moduli di difesa.
	Build(moduleId, altId, mode) -> Model con PrimaryPart "Root" centrato sulla cella principale.
	mode: "home" | "raid" | "visit" | "ghost". Gli attributi sul Root descrivono il comportamento
	(letti dal client per animazione/push e dal server per la simulazione del raid).
]]
local Defenses = require(script.Parent.Parent.Catalog.Defenses)
local Config = require(script.Parent.Parent.Config)
local PartUtil = require(script.Parent.PartUtil)

local CELL = Config.Grid.CellSize
local ModuleModel = {}

local function root(model, moduleId, params, cellCount)
	local r = PartUtil.Part({ Size = Vector3.new(CELL, 0.2, CELL), Transparency = 1, CanCollide = false, CanQuery = false, CFrame = CFrame.new(), Parent = model, Name = "Root" })
	model.PrimaryPart = r
	r:SetAttribute("ModuleId", moduleId)
	for k, v in pairs(params) do
		if type(v) == "number" or type(v) == "boolean" or type(v) == "string" then
			r:SetAttribute(k, v)
		end
	end
	return r
end

local builders = {}

builders.corrente = function(model, def, params, mode)
	local r = root(model, def.Id, params)
	-- bocchette alle 3 celle (asse X locale)
	for dx = -1, 1 do
		local base = PartUtil.Cylinder(1.3, 0.5, Color3.fromRGB(120, 190, 170), CFrame.new(dx * CELL, 0.25, 0), model, { Material = Enum.Material.Metal, Name = "Vent" })
		PartUtil.Cylinder(0.8, 0.3, def.Color, CFrame.new(dx * CELL, 0.55, 0), model, { Material = Enum.Material.Neon, Name = "VentGlow", CanCollide = false })
		PartUtil.Light(base, def.Color, 0.6, 7)
	end
	-- zona di spinta (invisibile; il client applica la spinta leggendo Dir/Push)
	local zone = PartUtil.Part({ Size = Vector3.new(CELL * 3, 9, CELL), Transparency = params.Up and 0.9 or 0.92, Color = def.Color, Material = Enum.Material.ForceField, CanCollide = false, CanQuery = false, CFrame = CFrame.new(0, 4.5, 0), Parent = model, Name = "Zone" })
	zone:SetAttribute("Push", params.Push or 55)
	zone:SetAttribute("Up", params.Up == true)
	zone:SetAttribute("Pulse", params.Pulse == true)
	zone:SetAttribute("PulsePeriod", params.PulsePeriod or 2.4)
	zone:SetAttribute("Active", true)
	zone:SetAttribute("Dir", 1) -- +1 / -1 lungo l'asse X locale (la campana lo inverte)
	-- particelle telegrafate: foglie/strisce di vento nella direzione di spinta
	local e = PartUtil.Emitter(zone, {
		Color = Color3.fromRGB(220, 255, 240), Rate = 18, Speed = NumberRange.new(12, 18), Lifetime = NumberRange.new(0.5, 0.8),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(0.3, 0.5), NumberSequenceKeypoint.new(1, 0) }),
		Spread = Vector2.new(10, 10), Acceleration = Vector3.new(0, 0, 0), LightEmission = 0.4, Name = "Wind",
	})
	e.EmissionDirection = Enum.NormalId.Right
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
	return r
end

builders.piattaforma = function(model, def, params, mode)
	local r = root(model, def.Id, params)
	-- bordi del vuoto
	for _, dz in ipairs({ -1.5, 1.5 }) do
		PartUtil.Part({ Size = Vector3.new(CELL, 0.5, 0.4), Color = Color3.fromRGB(255, 230, 170), Material = Enum.Material.Neon, CFrame = CFrame.new(0, 0.1, dz * CELL), Parent = model, Name = "Edge", CanCollide = false })
	end
	-- fondo del vuoto: cielo scuro (visual) — in raid non è calpestabile
	PartUtil.Part({ Size = Vector3.new(CELL, 0.2, CELL * 3), Color = Color3.fromRGB(80, 110, 170), Material = Enum.Material.Glass, Transparency = 0.35, CFrame = CFrame.new(0, -1.2, 0), Parent = model, Name = "Void", CanCollide = false, CanQuery = false })
	local width = (params.Width or 1) * 3.4
	local plat = PartUtil.Part({ Size = Vector3.new(width, 0.7, width), Color = def.Color, Material = Enum.Material.SmoothPlastic, CFrame = CFrame.new(0, 0.1, -CELL), Parent = model, Name = "Platform" })
	plat:SetAttribute("Period", params.Period or 3.2)
	plat:SetAttribute("Travel", CELL * 2) -- da -CELL a +CELL lungo Z locale
	plat:SetAttribute("Phase", 0)
	PartUtil.Light(plat, def.Color, 0.8, 8)
	if params.Double then
		local plat2 = plat:Clone()
		plat2.Name = "Platform2"
		plat2:SetAttribute("Phase", 0.5)
		plat2.Parent = model
	end
	return r
end

builders.sentinella = function(model, def, params, mode)
	local r = root(model, def.Id, params)
	local pillar = PartUtil.Cylinder(1.1, 7, Color3.fromRGB(205, 210, 230), CFrame.new(0, 3.5, 0), model, { Material = Enum.Material.Slate, Name = "Pillar" })
	PartUtil.Cylinder(1.5, 0.6, Color3.fromRGB(180, 190, 215), CFrame.new(0, 0.3, 0), model, { Material = Enum.Material.Slate, Name = "Base" })
	local lamp = PartUtil.Ball(2.2, Color3.fromRGB(255, 250, 200), CFrame.new(0, 7.6, 0), model, { Material = Enum.Material.Neon, Name = "Lamp", CanCollide = false })
	PartUtil.Light(lamp, Color3.fromRGB(255, 240, 180), 1.5, 16)
	-- cono di luce: ventaglio di fasci Neon a terra (apice al pilastro). Orientato da ModuleModel.OrientSentinel
	local radius = params.Radius or 9
	local arc = params.Arc or 50
	local cone = PartUtil.Part({ Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, CanCollide = false, CanQuery = false, CFrame = CFrame.new(0, 0.3, 0), Parent = model, Name = "Cone", CastShadow = false })
	cone:SetAttribute("Radius", radius)
	cone:SetAttribute("Arc", arc)
	cone:SetAttribute("Speed", params.Speed or 55)
	cone:SetAttribute("Erratic", params.Erratic == true)
	local beams = 5
	for i = 1, beams do
		local frac = (i - 1) / (beams - 1) - 0.5
		local beam = PartUtil.Part({ Size = Vector3.new(0.7, 0.18, radius), Color = Color3.fromRGB(255, 245, 170), Material = Enum.Material.Neon, Transparency = 0.35 + math.abs(frac) * 0.4, CanCollide = false, CanQuery = false, Parent = model, Name = "Beam", CastShadow = false })
		beam:SetAttribute("BeamAngle", frac * arc)
	end
	-- disco di luce al suolo intorno al pilastro
	PartUtil.Cylinder(2.2, 0.1, Color3.fromRGB(255, 245, 170), CFrame.new(0, 0.12, 0), model, { Material = Enum.Material.Neon, Transparency = 0.5, Name = "Glow", CanCollide = false, CanQuery = false })
	r:SetAttribute("Angle", 0)
	ModuleModel.OrientSentinel(model, 0)
	return r
end

builders.muro_nube = function(model, def, params, mode)
	local r = root(model, def.Id, params)
	local cells = (params.Long and { -1, 0, 1 }) or { 0, 1 }
	for _, dx in ipairs(cells) do
		local block = PartUtil.Part({ Size = Vector3.new(CELL, 6, CELL), Color = Color3.fromRGB(240, 244, 255), Material = Enum.Material.SmoothPlastic, CFrame = CFrame.new(dx * CELL, 3, 0), Parent = model, Name = "Wall" })
		PartUtil.Cloud(CFrame.new(dx * CELL, 6.2, 0), 1.3, model, Color3.fromRGB(250, 252, 255), 0)
		PartUtil.Cloud(CFrame.new(dx * CELL, 1.2, 0), 1.0, model, Color3.fromRGB(244, 247, 255), 0)
		block.CanCollide = true
	end
	return r
end

builders.faro = function(model, def, params, mode)
	local r = root(model, def.Id, params)
	PartUtil.Cylinder(1.7, 0.8, Color3.fromRGB(230, 225, 210), CFrame.new(0, 0.4, 0), model, { Material = Enum.Material.Marble, Name = "Basin" })
	local glow = PartUtil.Cylinder(1.4, 0.3, Color3.fromRGB(255, 205, 90), CFrame.new(0, 0.85, 0), model, { Material = Enum.Material.Neon, Name = "FakePool", CanCollide = false })
	PartUtil.Light(glow, Color3.fromRGB(255, 200, 90), 1.4, 12)
	PartUtil.Emitter(glow, { Color = Color3.fromRGB(255, 220, 120), Rate = 10, Speed = NumberRange.new(1, 3), Lifetime = NumberRange.new(0.6, 1.2), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) }), Name = "Lure" })
	r:SetAttribute("Dazzle", params.Dazzle or 3.5)
	r:SetAttribute("TriggerRadius", 3.2)
	return r
end

builders.nebbia = function(model, def, params, mode)
	local r = root(model, def.Id, params)
	local zone = PartUtil.Part({ Size = Vector3.new(CELL * 2, 7, CELL * 2), Transparency = 1, CanCollide = false, CanQuery = false, CFrame = CFrame.new(CELL / 2, 3.5, CELL / 2), Parent = model, Name = "FogZone" })
	for i = 1, 5 do
		local a = i * 1.3
		PartUtil.Ball(3 + (i % 2), Color3.fromRGB(225, 232, 245), CFrame.new(CELL / 2 + math.cos(a) * 2.2, 1.5 + (i % 3) * 0.8, CELL / 2 + math.sin(a) * 2.2), model, { Transparency = 0.55, Material = Enum.Material.SmoothPlastic, Name = "Puff", CastShadow = false })
	end
	PartUtil.Emitter(zone, { Color = Color3.fromRGB(230, 236, 248), Rate = 10, Speed = NumberRange.new(0.3, 0.8), Lifetime = NumberRange.new(2, 3.5), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(0.5, 4), NumberSequenceKeypoint.new(1, 2) }), Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 1) }), LightEmission = 0.1, Name = "Fog" })
	return r
end

builders.scivolo = function(model, def, params, mode)
	local r = root(model, def.Id, params)
	for dx = 0, 1 do
		local wet = PartUtil.Part({ Size = Vector3.new(CELL, 0.15, CELL), Color = Color3.fromRGB(150, 225, 180), Material = Enum.Material.Glass, Transparency = 0.25, Reflectance = 0.2, CFrame = CFrame.new(dx * CELL, 0.08, 0), Parent = model, Name = "WetTile" })
		wet.CustomPhysicalProperties = PhysicalProperties.new(0.7, params.Friction or 0.05, 0.2, 100, 1)
		PartUtil.Emitter(wet, { Color = Color3.fromRGB(200, 240, 255), Rate = 4, Speed = NumberRange.new(0.5, 1.5), Lifetime = NumberRange.new(0.5, 1), Size = NumberSequence.new(0.12), Name = "Dew" })
	end
	return r
end

builders.cupola = function(model, def, params, mode)
	local r = root(model, def.Id, params)
	-- cristallo di controllo decorativo sulla cella del modulo
	local crystal = PartUtil.Part({ Size = Vector3.new(1.4, 3.2, 1.4), Color = def.Color, Material = Enum.Material.Glass, Transparency = 0.2, Reflectance = 0.3, CFrame = CFrame.new(0, 1.8, 0) * CFrame.Angles(0, math.rad(45), 0), Parent = model, Name = "Crystal", CanCollide = false })
	PartUtil.Light(crystal, def.Color, 1.2, 12)
	PartUtil.Cylinder(1.2, 0.5, Color3.fromRGB(200, 190, 230), CFrame.new(0, 0.25, 0), model, { Material = Enum.Material.Marble, Name = "Base" })
	r:SetAttribute("Height", params.Height or 7)
	return r
end

builders.campana = function(model, def, params, mode)
	local r = root(model, def.Id, params)
	for _, dx in ipairs({ -1.4, 1.4 }) do
		PartUtil.Part({ Size = Vector3.new(0.4, 6, 0.4), Color = Color3.fromRGB(120, 90, 60), Material = Enum.Material.Wood, CFrame = CFrame.new(dx, 3, 0), Parent = model, Name = "Post" })
	end
	PartUtil.Part({ Size = Vector3.new(3.4, 0.4, 0.5), Color = Color3.fromRGB(120, 90, 60), Material = Enum.Material.Wood, CFrame = CFrame.new(0, 6.1, 0), Parent = model, Name = "Beam" })
	local bell = PartUtil.Cylinder(1.1, 1.8, Color3.fromRGB(240, 200, 110), CFrame.new(0, 4.6, 0), model, { Material = Enum.Material.Metal, Reflectance = 0.35, Name = "Bell", CanCollide = false })
	PartUtil.Ball(0.9, Color3.fromRGB(240, 200, 110), CFrame.new(0, 5.6, 0), model, { Material = Enum.Material.Metal, Reflectance = 0.35, Name = "BellTop" })
	PartUtil.Light(bell, Color3.fromRGB(255, 220, 140), 0.8, 10)
	r:SetAttribute("TriggerFraction", params.TriggerFraction or 0.5)
	return r
end

builders.arcobaleno = function(model, def, params, mode)
	local r = root(model, def.Id, params)
	-- vuoto di 3 celle lungo Z
	PartUtil.Part({ Size = Vector3.new(CELL, 0.2, CELL * 3), Color = Color3.fromRGB(80, 110, 170), Material = Enum.Material.Glass, Transparency = 0.35, CFrame = CFrame.new(0, -1.2, CELL), Parent = model, Name = "Void", CanCollide = false, CanQuery = false })
	local colors = { Color3.fromRGB(255, 120, 120), Color3.fromRGB(255, 200, 100), Color3.fromRGB(150, 230, 140), Color3.fromRGB(120, 180, 255), Color3.fromRGB(200, 140, 255) }
	local bridge = PartUtil.Part({ Size = Vector3.new(CELL * 0.9, 0.5, CELL * 3), Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.Neon, Transparency = 0.1, CFrame = CFrame.new(0, 0.1, CELL), Parent = model, Name = "Bridge" })
	for i, c in ipairs(colors) do
		local stripe = PartUtil.Part({ Size = Vector3.new(CELL * 0.9 / #colors, 0.52, CELL * 3), Color = c, Material = Enum.Material.Neon, Transparency = 0.15, CFrame = CFrame.new(-CELL * 0.45 + (i - 0.5) * (CELL * 0.9 / #colors), 0.1, CELL), Parent = model, Name = "Stripe", CanCollide = false, CanQuery = false })
		stripe:SetAttribute("BridgeVisual", true)
	end
	bridge:SetAttribute("Period", params.Period or 4)
	bridge:SetAttribute("Visible", true)
	return r
end

-- Orienta i fasci della sentinella (angolo in gradi, 0 = -Z locale del Root). Usato da server (raid) e client (cosmetico).
function ModuleModel.OrientSentinel(model, angleDeg)
	local root = model.PrimaryPart or model:FindFirstChild("Root")
	if not root then
		return
	end
	local radius = (model:FindFirstChild("Cone") and model.Cone:GetAttribute("Radius")) or 9
	local base = CFrame.new(root.Position) * CFrame.Angles(0, -math.rad(angleDeg), 0)
	for _, beam in ipairs(model:GetChildren()) do
		if beam.Name == "Beam" then
			local a = beam:GetAttribute("BeamAngle") or 0
			beam.CFrame = base * CFrame.Angles(0, -math.rad(a), 0) * CFrame.new(0, 0.3, -radius / 2)
		end
	end
	root:SetAttribute("Angle", angleDeg)
	return base
end

-- Costruisce il modello; la CFrame viene impostata dal chiamante tramite PivotTo
function ModuleModel.Build(moduleId, altId, mode, parent)
	local def = Defenses.Get(moduleId)
	if not def then
		return nil
	end
	local params = Defenses.EffectiveParams(moduleId, altId)
	local model = PartUtil.Model("Module_" .. moduleId, nil)
	model:SetAttribute("ModuleId", moduleId)
	model:SetAttribute("Alt", altId or "base")
	model:SetAttribute("Category", def.Category)
	local builder = builders[moduleId]
	if builder then
		builder(model, def, params, mode or "home")
	else
		root(model, moduleId, params)
	end
	if mode == "ghost" then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
				d.Transparency = math.max(d.Transparency, 0.5)
			elseif d:IsA("ParticleEmitter") or d:IsA("PointLight") then
				d.Enabled = false
			elseif d:IsA("ProximityPrompt") then
				d:Destroy()
			end
		end
	end
	if parent then
		model.Parent = parent
	end
	return model
end

return ModuleModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">PartUtil</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Helper per costruire geometria procedurale in modo conciso.
local PartUtil = {}

function PartUtil.Part(props)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.CanCollide = props.CanCollide ~= false
	p.CanTouch = props.CanTouch == true
	p.CanQuery = props.CanQuery ~= false
	p.CastShadow = props.CastShadow ~= false
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Color = props.Color or Color3.fromRGB(255, 255, 255)
	p.Transparency = props.Transparency or 0
	p.Reflectance = props.Reflectance or 0
	p.Size = props.Size or Vector3.new(1, 1, 1)
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape and p:IsA("Part") then
		p.Shape = props.Shape
	end
	if props.CFrame then
		p.CFrame = props.CFrame
	elseif props.Position then
		p.Position = props.Position
	end
	p.Name = props.Name or "Part"
	if props.Attributes then
		for k, v in pairs(props.Attributes) do
			p:SetAttribute(k, v)
		end
	end
	if props.Parent then
		p.Parent = props.Parent
	end
	return p
end

function PartUtil.Ball(size, color, cf, parent, extra)
	local props = { Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), Color = color, CFrame = cf, Parent = parent, CanCollide = false }
	if extra then
		for k, v in pairs(extra) do
			props[k] = v
		end
	end
	return PartUtil.Part(props)
end

function PartUtil.Cylinder(radius, height, color, cf, parent, extra)
	-- il cilindro Roblox è orientato lungo X: ruotiamo per averlo verticale
	local props = { Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, radius * 2, radius * 2), Color = color, CFrame = cf * CFrame.Angles(0, 0, math.rad(90)), Parent = parent }
	if extra then
		for k, v in pairs(extra) do
			props[k] = v
		end
	end
	return PartUtil.Part(props)
end

function PartUtil.Light(parent, color, brightness, range)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness or 1
	l.Range = range or 12
	l.Shadows = false
	l.Parent = parent
	return l
end

function PartUtil.Emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(props.Color or Color3.new(1, 1, 1))
	e.Size = props.Size or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = props.Transparency or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = props.Lifetime or NumberRange.new(0.8, 1.6)
	e.Rate = props.Rate or 4
	e.Speed = props.Speed or NumberRange.new(0.5, 1.5)
	e.SpreadAngle = props.Spread or Vector2.new(180, 180)
	e.Acceleration = props.Acceleration or Vector3.new(0, 0.5, 0)
	e.LightEmission = props.LightEmission or 0.6
	e.LightInfluence = 0.2
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-40, 40)
	e.Drag = props.Drag or 1
	e.Enabled = props.Enabled ~= false
	e.Name = props.Name or "Emitter"
	if props.Texture then
		e.Texture = props.Texture
	end
	e.Parent = parent
	return e
end

function PartUtil.Billboard(parent, props)
	local bb = Instance.new("BillboardGui")
	bb.Name = props.Name or "Billboard"
	bb.Size = props.Size or UDim2.fromOffset(160, 44)
	bb.StudsOffset = props.Offset or Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = props.AlwaysOnTop == true
	bb.MaxDistance = props.MaxDistance or 90
	bb.LightInfluence = 0
	bb.Parent = parent
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = props.TextColor or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.TextStrokeColor3 = Color3.fromRGB(30, 40, 70)
	label.Text = props.Text or ""
	label.Parent = bb
	return bb, label
end

function PartUtil.Prompt(parent, actionText, objectText, holdDuration, maxDistance)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = actionText
	pp.ObjectText = objectText or ""
	pp.HoldDuration = holdDuration or 0
	pp.MaxActivationDistance = maxDistance or 10
	pp.RequiresLineOfSight = false
	pp.Style = Enum.ProximityPromptStyle.Default
	pp.Parent = parent
	return pp
end

function PartUtil.Model(name, parent)
	local m = Instance.new("Model")
	m.Name = name
	if parent then
		m.Parent = parent
	end
	return m
end

-- Nuvola soffice: gruppo di sfere bianche
function PartUtil.Cloud(cf, scale, parent, color, transparency)
	local m = PartUtil.Model("Cloud", parent)
	color = color or Color3.fromRGB(250, 252, 255)
	local offsets = {
		{ 0, 0, 0, 1 }, { 0.9, -0.1, 0.2, 0.75 }, { -0.9, -0.05, -0.1, 0.8 }, { 0.3, 0.35, -0.4, 0.6 }, { -0.4, 0.3, 0.5, 0.55 }, { 0.1, -0.3, 0.8, 0.6 },
	}
	for _, o in ipairs(offsets) do
		PartUtil.Ball(scale * o[4] * 2, color, cf * CFrame.new(o[1] * scale, o[2] * scale, o[3] * scale), m, { Transparency = transparency or 0.05, CastShadow = false, Material = Enum.Material.SmoothPlastic })
	end
	return m
end

return PartUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">PlotBuilder</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	PlotBuilder: costruisce un vivaio completo (piattaforma, pozza, cassaforte, creature,
	moduli di difesa, decorazioni, ingresso/uscita) a partire da una "vista" dei dati.
	Usato per i plot dei giocatori, le arene di incursione (copia istanziata del layout),
	le visite e il vivaio dimostrativo dell'hub.

	view = {
		Creatures = { {Uid, Id, Variant, x, z, Buffer} }, Layout = {Modules}, Decorations = { {Id,x,z,Rot} },
		Skin = cosmeticId, OwnerName = string?, Nameplate = cosmeticId?, Exposed = n, Vault = n, VaultCap = n,
	}
	mode = "home" | "raid" | "visit" | "demo"
]]
local Config = require(script.Parent.Parent.Config)
local Cosmetics = require(script.Parent.Parent.Catalog.Cosmetics)
local Creatures = require(script.Parent.Parent.Catalog.Creatures)
local Defenses = require(script.Parent.Parent.Catalog.Defenses)
local GridUtil = require(script.Parent.Parent.Util.GridUtil)
local Format = require(script.Parent.Parent.Util.Format)
local Strings = require(script.Parent.Parent.Strings)
local PartUtil = require(script.Parent.PartUtil)
local CreatureModel = require(script.Parent.CreatureModel)
local ModuleModel = require(script.Parent.ModuleModel)
local DecorationModel = require(script.Parent.DecorationModel)

local G = Config.Grid
local CELL = G.CellSize
local HALF = G.Size * CELL / 2 -- 24
local MARGIN = (Config.Plots.PlatformSize - G.Size * CELL) / 2 -- 8

local PlotBuilder = {}
PlotBuilder.__index = PlotBuilder

local GAP_MODULES = { piattaforma = true, arcobaleno = true }

local function skinData(skinId)
	local c = Cosmetics.Get(skinId or "skin_prato") or Cosmetics.Get("skin_prato")
	return c.Data
end

local function materialFromName(name)
	local ok, mat = pcall(function()
		return Enum.Material[name]
	end)
	return ok and mat or Enum.Material.Grass
end

-- ───────────────────────── costruzione base ─────────────────────────

function PlotBuilder.Build(parent, origin: CFrame, view, mode)
	local self = setmetatable({}, PlotBuilder)
	self.Origin = origin
	self.Mode = mode or "home"
	self.View = view
	self.Model = PartUtil.Model("Vivaio", nil)
	self.Model:SetAttribute("Mode", self.Mode)
	self.Model:SetAttribute("Origin", origin)
	self.Folders = {}
	for _, name in ipairs({ "Tiles", "Creatures", "Modules", "Decorations", "Structure" }) do
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = self.Model
		self.Folders[name] = f
	end
	self.CreatureModels = {} -- uid -> model
	self.Tiles = {} -- key -> tile part

	self:_buildBase()
	self:_buildStructures()
	self:RebuildModules(view.Layout)
	for _, c in ipairs(view.Creatures or {}) do
		self:AddCreature(c)
	end
	for i, d in ipairs(view.Decorations or {}) do
		self:AddDecoration(d, i)
	end
	self:SetExposed(view.Exposed or 0)
	self:SetVault(view.Vault or 0, view.VaultCap or Config.Vault.Capacities[1])
	self.Model.Parent = parent
	return self
end

function PlotBuilder:_buildBase()
	local skin = skinData(self.View.Skin)
	local mat = materialFromName(skin.Material)
	local structure = self.Folders.Structure
	local origin = self.Origin
	local size = Config.Plots.PlatformSize

	-- piastrelle della griglia (scacchiera leggera)
	for x = 0, G.Size - 1 do
		for z = 0, G.Size - 1 do
			local shade = ((x + z) % 2 == 0) and 1 or 0.92
			local tile = PartUtil.Part({
				Size = Vector3.new(CELL, 1, CELL), Material = mat,
				Color = Color3.new(skin.Color.R * shade, skin.Color.G * shade, skin.Color.B * shade),
				CFrame = origin * CFrame.new(GridUtil.CellToLocal(x, z, -0.5)), Parent = self.Folders.Tiles, Name = "Tile",
			})
			tile:SetAttribute("x", x)
			tile:SetAttribute("z", z)
			self.Tiles[GridUtil.Key(x, z)] = tile
		end
	end
	-- cornice esterna (margine) con colore trim
	local trim = skin.Trim or Color3.new(1, 1, 1)
	local half = size / 2
	for _, side in ipairs({
		{ CFrame.new(0, -0.6, -(HALF + MARGIN / 2)), Vector3.new(size, 1.2, MARGIN) },
		{ CFrame.new(0, -0.6, HALF + MARGIN / 2), Vector3.new(size, 1.2, MARGIN) },
		{ CFrame.new(-(HALF + MARGIN / 2), -0.6, 0), Vector3.new(MARGIN, 1.2, G.Size * CELL) },
		{ CFrame.new(HALF + MARGIN / 2, -0.6, 0), Vector3.new(MARGIN, 1.2, G.Size * CELL) },
	}) do
		PartUtil.Part({ Size = side[2], Material = Enum.Material.SmoothPlastic, Color = trim, CFrame = origin * side[1], Parent = structure, Name = "Frame" })
	end
	-- bordo luminoso sottile
	for _, side in ipairs({
		{ CFrame.new(0, 0.05, -half + 0.3), Vector3.new(size, 0.3, 0.6) },
		{ CFrame.new(0, 0.05, half - 0.3), Vector3.new(size, 0.3, 0.6) },
		{ CFrame.new(-half + 0.3, 0.05, 0), Vector3.new(0.6, 0.3, size) },
		{ CFrame.new(half - 0.3, 0.05, 0), Vector3.new(0.6, 0.3, size) },
	}) do
		PartUtil.Part({ Size = side[2], Material = Enum.Material.Neon, Color = trim, Transparency = 0.35, CFrame = origin * side[1], Parent = structure, Name = "Rim", CanCollide = false, CastShadow = false })
	end
	-- roccia sotto l'isola e nuvole
	PartUtil.Part({ Size = Vector3.new(size * 0.8, 6, size * 0.8), Material = Enum.Material.Slate, Color = Color3.fromRGB(150, 160, 190), CFrame = origin * CFrame.new(0, -4.2, 0), Parent = structure, Name = "Rock", CanCollide = false })
	PartUtil.Part({ Size = Vector3.new(size * 0.5, 7, size * 0.5), Material = Enum.Material.Slate, Color = Color3.fromRGB(130, 140, 175), CFrame = origin * CFrame.new(0, -10, 0) * CFrame.Angles(0, math.rad(20), 0), Parent = structure, Name = "Rock2", CanCollide = false })
	PartUtil.Part({ Size = Vector3.new(size * 0.22, 8, size * 0.22), Material = Enum.Material.Slate, Color = Color3.fromRGB(115, 125, 160), CFrame = origin * CFrame.new(0, -16, 0) * CFrame.Angles(0, math.rad(40), 0), Parent = structure, Name = "Rock3", CanCollide = false })
	local rng = Random.new(math.floor(origin.X * 13 + origin.Z * 7))
	for i = 1, 7 do
		local a = (i / 7) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local r = half * rng:NextNumber(0.85, 1.05)
		PartUtil.Cloud(origin * CFrame.new(math.cos(a) * r, -3 + rng:NextNumber(-1.5, 1), math.sin(a) * r), rng:NextNumber(3.2, 4.8), structure, Color3.fromRGB(250, 252, 255), 0.02)
	end
end

function PlotBuilder:_buildStructures()
	local origin = self.Origin
	local structure = self.Folders.Structure
	local mode = self.Mode

	-- Pozza delle scintille (centro)
	local pozzaY = 0
	local hasCupola = false
	for _, m in ipairs((self.View.Layout and self.View.Layout.Modules) or {}) do
		if m.Id == "cupola" then
			hasCupola = true
		end
	end
	if hasCupola then
		local h = Defenses.EffectiveParams("cupola").Height or 7
		pozzaY = h
		PartUtil.Cylinder(4.2, h, Color3.fromRGB(220, 200, 255), origin * CFrame.new(0, h / 2, 0), structure, { Material = Enum.Material.Glass, Transparency = 0.25, Reflectance = 0.2, Name = "Pedestal" })
		-- trampolini di luce intorno
		for i = 1, 3 do
			local a = (i / 3) * math.pi * 2 + math.rad(90)
			local pad = PartUtil.Cylinder(1.6, 0.4, Color3.fromRGB(255, 200, 255), origin * CFrame.new(math.cos(a) * 7.5, 0.2, math.sin(a) * 7.5), structure, { Material = Enum.Material.Neon, Name = "BouncePad" })
			pad:SetAttribute("Bounce", 95)
			PartUtil.Light(pad, Color3.fromRGB(255, 200, 255), 1, 10)
		end
	end
	local basin = PartUtil.Cylinder(3.6, 1.4, Color3.fromRGB(236, 232, 220), origin * CFrame.new(0, pozzaY + 0.7, 0), structure, { Material = Enum.Material.Marble, Name = "PozzaBasin" })
	local water = PartUtil.Cylinder(3.1, 0.4, Color3.fromRGB(255, 205, 90), origin * CFrame.new(0, pozzaY + 1.3, 0), structure, { Material = Enum.Material.Neon, Transparency = 0.15, Name = "Pozza", CanCollide = false })
	water:SetAttribute("Interactive", true)
	PartUtil.Light(water, Color3.fromRGB(255, 200, 90), 1.6, 18)
	self.PozzaEmitter = PartUtil.Emitter(water, { Color = Color3.fromRGB(255, 225, 130), Rate = 8, Speed = NumberRange.new(1.5, 3.5), Lifetime = NumberRange.new(0.8, 1.6), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) }), Name = "Sparks" })
	self.Pozza = water
	self.PozzaBasin = basin
	local _, exposedLabel = PartUtil.Billboard(water, { Size = UDim2.fromOffset(200, 50), Offset = Vector3.new(0, 3.2, 0), TextColor = Color3.fromRGB(255, 225, 130), MaxDistance = 120 })
	self.ExposedLabel = exposedLabel

	-- Ingresso (fronte, -Z) e Uscita (retro, +Z)
	local entrance = PartUtil.Cylinder(3, 0.4, Color3.fromRGB(150, 232, 200), origin * CFrame.new(0, 0.1, -(HALF + MARGIN / 2)), structure, { Material = Enum.Material.Neon, Transparency = 0.2, Name = "Entrance" })
	self.Entrance = entrance
	local exitPad = PartUtil.Cylinder(3, 0.4, Color3.fromRGB(255, 170, 220), origin * CFrame.new(0, 0.1, HALF + MARGIN / 2), structure, { Material = Enum.Material.Neon, Transparency = 0.2, Name = "Exit" })
	self.Exit = exitPad
	-- arco dell'uscita
	for _, dx in ipairs({ -3.2, 3.2 }) do
		PartUtil.Part({ Size = Vector3.new(0.7, 7, 0.7), Color = Color3.fromRGB(250, 250, 255), CFrame = origin * CFrame.new(dx, 3.5, HALF + MARGIN / 2), Parent = structure, Name = "ExitPost" })
	end
	PartUtil.Part({ Size = Vector3.new(7.4, 0.7, 0.7), Color = Color3.fromRGB(250, 250, 255), CFrame = origin * CFrame.new(0, 7, HALF + MARGIN / 2), Parent = structure, Name = "ExitBeam" })
	local swirl = PartUtil.Part({ Size = Vector3.new(5.8, 6, 0.3), Color = Color3.fromRGB(255, 170, 220), Material = Enum.Material.ForceField, Transparency = 0.3, CFrame = origin * CFrame.new(0, 3.5, HALF + MARGIN / 2), Parent = structure, Name = "ExitSwirl", CanCollide = false, CanQuery = false })
	PartUtil.Light(swirl, Color3.fromRGB(255, 170, 220), 1, 14)
	PartUtil.Billboard(exitPad, { Size = UDim2.fromOffset(140, 36), Offset = Vector3.new(0, 8.5, 0), Text = "USCITA", TextColor = Color3.fromRGB(255, 190, 230) })
	PartUtil.Billboard(entrance, { Size = UDim2.fromOffset(140, 36), Offset = Vector3.new(0, 4, 0), Text = "INGRESSO", TextColor = Color3.fromRGB(170, 240, 215) })

	-- Cassaforte (lato sinistro) e pad di spawn (lato destro): solo per home/visit/demo
	if mode ~= "raid" then
		local vaultCF = origin * CFrame.new(-(HALF + MARGIN / 2), 0, 6)
		local vaultBody = PartUtil.Cylinder(2.6, 4.6, Color3.fromRGB(120, 150, 210), vaultCF * CFrame.new(0, 2.3, 0), structure, { Material = Enum.Material.Metal, Reflectance = 0.15, Name = "VaultBody" })
		PartUtil.Cylinder(2.8, 0.5, Color3.fromRGB(90, 115, 170), vaultCF * CFrame.new(0, 4.75, 0), structure, { Material = Enum.Material.Metal, Name = "VaultTop" })
		local door = PartUtil.Part({ Size = Vector3.new(3.2, 3.2, 0.5), Color = Color3.fromRGB(150, 180, 235), Material = Enum.Material.Metal, CFrame = vaultCF * CFrame.new(0, 2.3, 2.5), Parent = structure, Name = "VaultDoor" })
		local dial = PartUtil.Cylinder(0.7, 0.4, Color3.fromRGB(255, 215, 110), vaultCF * CFrame.new(0, 2.3, 2.85) * CFrame.Angles(math.rad(90), 0, 0), structure, { Material = Enum.Material.Neon, Name = "VaultDial", CanCollide = false })
		PartUtil.Light(dial, Color3.fromRGB(255, 215, 110), 1, 10)
		self.Vault = vaultBody
		local _, vaultLabel = PartUtil.Billboard(vaultBody, { Size = UDim2.fromOffset(200, 50), Offset = Vector3.new(0, 4.2, 0), TextColor = Color3.fromRGB(190, 215, 255) })
		self.VaultLabel = vaultLabel
		if mode == "home" then
			local prompt = PartUtil.Prompt(door, Strings.PromptDeposit, "Cassaforte", 0, 12)
			prompt.Name = "DepositPrompt"
			self.DepositPrompt = prompt
		end

		local spawn = PartUtil.Cylinder(3, 0.4, Color3.fromRGB(190, 230, 255), origin * CFrame.new(HALF + MARGIN / 2, 0.1, 6), structure, { Material = Enum.Material.Neon, Transparency = 0.3, Name = "SpawnPad" })
		self.SpawnPad = spawn
		-- portale verso l'hub (lato destro, dietro lo spawn)
		local hubPad = PartUtil.Cylinder(2.2, 0.4, Color3.fromRGB(160, 200, 255), origin * CFrame.new(HALF + MARGIN / 2, 0.1, -12), structure, { Material = Enum.Material.Neon, Transparency = 0.2, Name = "HubPad" })
		local hubRing = PartUtil.Part({ Size = Vector3.new(5, 5, 0.4), Color = Color3.fromRGB(160, 200, 255), Material = Enum.Material.ForceField, Transparency = 0.35, CFrame = origin * CFrame.new(HALF + MARGIN / 2, 3, -12) * CFrame.Angles(0, math.rad(90), 0), Parent = structure, Name = "HubRing", CanCollide = false, CanQuery = false })
		PartUtil.Light(hubRing, Color3.fromRGB(160, 200, 255), 1, 14)
		PartUtil.Billboard(hubPad, { Size = UDim2.fromOffset(160, 36), Offset = Vector3.new(0, 6.5, 0), Text = "HUB", TextColor = Color3.fromRGB(200, 225, 255) })
		self.HubPad = hubPad

		-- targhetta del proprietario
		if self.View.OwnerName then
			local sign = PartUtil.Part({ Size = Vector3.new(0.4, 0.4, 0.4), Transparency = 1, CanCollide = false, CanQuery = false, CFrame = origin * CFrame.new(HALF + MARGIN / 2, 7, 22), Parent = structure, Name = "SignAnchor" })
			local plate = self.View.Nameplate and Cosmetics.Get(self.View.Nameplate)
			local text = self.View.OwnerName
			if plate and plate.Data.Text then
				text = text .. "\n" .. plate.Data.Text
			end
			PartUtil.Billboard(sign, { Size = UDim2.fromOffset(260, 70), Offset = Vector3.new(0, 0, 0), Text = text, TextColor = (plate and plate.Data.Color) or Color3.new(1, 1, 1), MaxDistance = 160 })
		end
	else
		-- in raid il pad di spawn è l'ingresso
		self.SpawnPad = entrance
	end
end

-- ───────────────────────── creature ─────────────────────────

function PlotBuilder:AddCreature(c)
	if self.CreatureModels[c.Uid] then
		self:RemoveCreature(c.Uid)
	end
	local model = CreatureModel.Build(c.Id, c.Variant, nil)
	if not model then
		return nil
	end
	model.Name = "Creature_" .. tostring(c.Uid)
	model:SetAttribute("Uid", c.Uid)
	model:SetAttribute("x", c.x)
	model:SetAttribute("z", c.z)
	model:PivotTo(self.Origin * CFrame.new(GridUtil.CellToLocal(c.x, c.z, 2.6)))
	local def = Creatures.Get(c.Id)
	local body = model.PrimaryPart
	local _, label = PartUtil.Billboard(body, { Size = UDim2.fromOffset(180, 56), Offset = Vector3.new(0, def.Visual.Size / 2 + 1.6, 0), TextColor = Color3.new(1, 1, 1), MaxDistance = 80 })
	label.Name = "Label"
	label.RichText = true
	if self.Mode == "home" then
		local prompt = PartUtil.Prompt(body, Strings.PromptCollect, def.Name, 0, 10)
		prompt.Name = "CollectPrompt"
		prompt:SetAttribute("Uid", c.Uid)
	end
	model.Parent = self.Folders.Creatures
	self.CreatureModels[c.Uid] = model
	self:SetCreatureBuffer(c.Uid, c.Buffer or 0, c.Id)
	return model
end

function PlotBuilder:RemoveCreature(uid)
	local m = self.CreatureModels[uid]
	if m then
		m:Destroy()
		self.CreatureModels[uid] = nil
	end
end

function PlotBuilder:SetCreatureBuffer(uid, buffer, creatureId)
	local m = self.CreatureModels[uid]
	if not m or not m.PrimaryPart then
		return
	end
	local def = Creatures.Get(creatureId or m:GetAttribute("CreatureId"))
	local label = m.PrimaryPart:FindFirstChild("Billboard") and m.PrimaryPart.Billboard:FindFirstChild("Label")
	if label then
		if buffer > 0 and self.Mode == "home" then
			label.Text = string.format('%s\n<font color="#FFD86A">+%d ✦</font>', def.Name, buffer)
		else
			label.Text = def.Name
		end
	end
	m:SetAttribute("Buffer", buffer)
	local prompt = m.PrimaryPart:FindFirstChild("CollectPrompt")
	if prompt then
		prompt.Enabled = buffer > 0
	end
end

-- ───────────────────────── moduli ─────────────────────────

function PlotBuilder:RebuildModules(layout)
	self.Folders.Modules:ClearAllChildren()
	-- ripristina piastrelle eventualmente trasformate in vuoto
	local skin = skinData(self.View.Skin)
	local mat = materialFromName(skin.Material)
	for key, tile in pairs(self.Tiles) do
		if tile:GetAttribute("Gap") then
			tile:SetAttribute("Gap", nil)
			tile.Transparency = 0
			tile.CanCollide = true
			tile.Material = mat
			local x, z = GridUtil.FromKey(key)
			local shade = ((x + z) % 2 == 0) and 1 or 0.92
			tile.Color = Color3.new(skin.Color.R * shade, skin.Color.G * shade, skin.Color.B * shade)
			tile.CustomPhysicalProperties = nil
		end
	end
	self.ModuleModels = {}
	for i, pm in ipairs((layout and layout.Modules) or {}) do
		local def = Defenses.Get(pm.Id)
		if def then
			local model = ModuleModel.Build(pm.Id, pm.Alt, self.Mode, nil)
			if model then
				local rot = pm.Rot or 0
				model:SetAttribute("Index", i)
				model:SetAttribute("x", pm.x)
				model:SetAttribute("z", pm.z)
				model:SetAttribute("Rot", rot)
				model:PivotTo(self.Origin * CFrame.new(GridUtil.CellToLocal(pm.x, pm.z, 0)) * CFrame.Angles(0, -rot * math.pi / 2, 0))
				model.Parent = self.Folders.Modules
				table.insert(self.ModuleModels, model)
				-- celle a vuoto
				if GAP_MODULES[pm.Id] then
					for _, c in ipairs(GridUtil.ModuleCells(Defenses.EffectiveFootprint(pm.Id, pm.Alt), pm.x, pm.z, rot)) do
						local tile = self.Tiles[GridUtil.Key(c.x, c.z)]
						if tile then
							tile:SetAttribute("Gap", true)
							tile.Transparency = (self.Mode == "raid") and 1 or 0.7
							tile.Material = Enum.Material.Glass
							tile.Color = Color3.fromRGB(90, 120, 180)
							tile.CanCollide = self.Mode ~= "raid"
						end
					end
				elseif pm.Id == "scivolo" then
					for _, c in ipairs(GridUtil.ModuleCells(def.Footprint, pm.x, pm.z, rot)) do
						local tile = self.Tiles[GridUtil.Key(c.x, c.z)]
						if tile then
							tile:SetAttribute("Gap", true) -- riutilizziamo il flag per il ripristino
							tile.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.05, 0.2, 100, 1)
						end
					end
				end
			end
		end
	end
end

-- ───────────────────────── decorazioni ─────────────────────────

function PlotBuilder:AddDecoration(d, index)
	local model = DecorationModel.Build(d.Id, nil, false)
	if not model then
		return nil
	end
	model:SetAttribute("Index", index)
	model:SetAttribute("x", d.x)
	model:SetAttribute("z", d.z)
	model:PivotTo(self.Origin * CFrame.new(GridUtil.CellToLocal(d.x, d.z, 0)) * CFrame.Angles(0, -(d.Rot or 0) * math.pi / 2, 0))
	model.Parent = self.Folders.Decorations
	return model
end

function PlotBuilder:RebuildDecorations(list)
	self.Folders.Decorations:ClearAllChildren()
	for i, d in ipairs(list or {}) do
		self:AddDecoration(d, i)
	end
end

-- ───────────────────────── etichette ─────────────────────────

function PlotBuilder:SetExposed(n)
	self.Exposed = n
	if self.ExposedLabel then
		self.ExposedLabel.Text = string.format("✦ %s esposte", Format.Number(n))
	end
	if self.PozzaEmitter then
		self.PozzaEmitter.Rate = math.clamp(4 + n / 25, 4, 40)
	end
end

function PlotBuilder:SetVault(cur, cap)
	if self.VaultLabel then
		self.VaultLabel.Text = string.format("🔒 %s / %s", Format.Number(cur), Format.Number(cap))
	end
end

function PlotBuilder:SetSkin(skinId)
	self.View.Skin = skinId
	local skin = skinData(skinId)
	local mat = materialFromName(skin.Material)
	for key, tile in pairs(self.Tiles) do
		if not tile:GetAttribute("Gap") then
			local x, z = GridUtil.FromKey(key)
			local shade = ((x + z) % 2 == 0) and 1 or 0.92
			tile.Material = mat
			tile.Color = Color3.new(skin.Color.R * shade, skin.Color.G * shade, skin.Color.B * shade)
		end
	end
	for _, p in ipairs(self.Folders.Structure:GetChildren()) do
		if p.Name == "Frame" or p.Name == "Rim" then
			p.Color = skin.Trim or Color3.new(1, 1, 1)
		end
	end
end

function PlotBuilder:SpawnCFrame()
	local pad = self.SpawnPad or self.Entrance
	return CFrame.new(pad.Position + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.rad(90), 0)
end

function PlotBuilder:EntranceCFrame()
	return CFrame.new(self.Entrance.Position + Vector3.new(0, 4, 0))
end

function PlotBuilder:Destroy()
	self.Model:Destroy()
end

return PlotBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Elenco dei remoti. Il server li crea in ReplicatedStorage.Remotes; il client li attende.
return {
	Events = {
		-- server → client
		"StateSync", -- (key, value) aggiornamento di una sezione dello stato
		"Toast", -- (message, kind)
		"PlaySound", -- (soundKey)
		"SparkFx", -- (fromPos, toPos, amount)
		"RaidEvent", -- (eventName, payload)
		"TutorialStep", -- (step)
		"ThemeChanged", -- (themeId)
		-- client → server
		"CollectAll",
		"DepositAll",
		"ClientReady",
		"SetSetting", -- (key, value)
		"RaidAbort",
		"Emote",
	},
	Functions = {
		"GetState", -- () -> full state
		"Collect", -- (creatureUid) -> ok, msg
		"Deposit", -- () -> ok, msg
		"UpgradeVault",
		"UpgradePlot",
		"PlaceCreature", -- (uid, x, z)
		"RemoveCreature", -- (uid)
		"SetVariant", -- (uid, variantId)
		"SaveLayout", -- (layout) -> ok, msg
		"UnlockModule", -- (moduleId)
		"SetModuleAlternative", -- (moduleId, altId)
		"PlaceDecoration", -- (decoId, x, z, rot)
		"RemoveDecoration", -- (index)
		"RequestRaidTargets", -- () -> list
		"StartRaid", -- (targetKey) -> ok, msg
		"StartLayoutTest", -- () -> ok, msg
		"GetCommissions",
		"ClaimCommission", -- (index)
		"RerollCommission", -- (index)
		"ClaimAlbumMilestone", -- (milestoneId)
		"GetCocoonPreview", -- (family)
		"StartCocoon", -- (family)
		"GetGallery", -- () -> list
		"VisitVivaio", -- (key)
		"LikeVivaio", -- (key)
		"ImportLayoutCode", -- (code)
		"ReturnHome",
		"BuyCosmetic", -- (id)
		"EquipCosmetic", -- (id)
		"ClaimPassTier", -- (tier)
		"TutorialAdvance", -- (step, payload)
		"TutorialSkip",
		"ClaimWeeklyChallenge",
		"PromptPurchase", -- (cosmeticId)
	},
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Strings</string>
          <string name="Source"><![CDATA[--!nonstrict
