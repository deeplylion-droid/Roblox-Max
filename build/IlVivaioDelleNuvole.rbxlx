          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Audio</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Effetti sonori (asset integrati Roblox) con interruttore audio.
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Util.Net)

local Audio = { Enabled = true }
local sounds = {}
local group

local VOLUMES = { Collect = 0.5, Deposit = 0.6, Click = 0.35, Place = 0.5, Error = 0.4, Success = 0.6, Whoosh = 0.5, Splash = 0.5, Sentinel = 0.5, Chime = 0.5 }

function Audio.Init()
	group = Instance.new("SoundGroup")
	group.Name = "VivaioSFX"
	group.Volume = 1
	group.Parent = SoundService
	for key, id in pairs(Config.Sounds) do
		local s = Instance.new("Sound")
		s.Name = key
		s.SoundId = id
		s.Volume = VOLUMES[key] or 0.5
		s.SoundGroup = group
		s.Parent = group
		sounds[key] = s
	end
	Net.Event("PlaySound").OnClientEvent:Connect(function(key)
		Audio.Play(key)
	end)
end

function Audio.Play(key, pitch)
	if not Audio.Enabled then
		return
	end
	local s = sounds[key]
	if not s then
		return
	end
	local clone = s:Clone()
	clone.PlaybackSpeed = pitch or (0.95 + math.random() * 0.1)
	clone.Parent = group
	clone:Play()
	clone.Ended:Once(function()
		clone:Destroy()
	end)
	task.delay(6, function()
		if clone.Parent then
			clone:Destroy()
		end
	end)
end

function Audio.SetEnabled(enabled)
	Audio.Enabled = enabled
	if group then
		group.Volume = enabled and 1 or 0
	end
end

return Audio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">BuildController</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	BuildController: modalità costruzione nel proprio vivaio.
	Griglia visibile, fantasma del modulo/creatura/decorazione, rotazione, anteprima del
	percorso (validatore condiviso), energia difensiva. Mobile-first: tocco = posiziona.
	I moduli si modificano in un layout di lavoro e si pubblicano in un colpo solo.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Defenses = require(Shared.Catalog.Defenses)
local Creatures = require(Shared.Catalog.Creatures)
local LayoutValidator = require(Shared.LayoutValidator)
local GridUtil = require(Shared.Util.GridUtil)
local TableUtil = require(Shared.Util.TableUtil)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Util.Net)
local PartUtil = require(Shared.Models.PartUtil)
local ModuleModel = require(Shared.Models.ModuleModel)
local CreatureModel = require(Shared.Models.CreatureModel)
local DecorationModel = require(Shared.Models.DecorationModel)
local State = require(script.Parent.State)
local Audio = require(script.Parent.Audio)

local Build = {}
Build.Active = false
Build.Mode = nil -- "creature" | "module" | "decoration" | "edit"
Build.Payload = nil
Build.Rot = 0
Build.Layout = { Modules = {} } -- layout di lavoro
Build.Changed = Signal.new() -- (result: Validator.Result)
Build.ModeChanged = Signal.new()
Build.Toast = nil -- impostato da Main

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local folder -- parti locali (griglia, fantasma, evidenziazioni)
local ghost
local cursor
local gridParts = {}
local pathParts = {}
local hoverCell = nil
local renderConn
local CELL = Config.Grid.CellSize

local function myPlot()
	local plots = Workspace:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, m in ipairs(plots:GetChildren()) do
		if m:GetAttribute("OwnerUserId") == player.UserId then
			return m
		end
	end
	return nil
end

local function origin()
	local plot = myPlot()
	return plot and plot:GetAttribute("Origin")
end

local function ensureFolder()
	if folder and folder.Parent then
		return folder
	end
	folder = Instance.new("Folder")
	folder.Name = "BuildLocal"
	folder.Parent = Workspace
	return folder
end

local function clearGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
end

local function buildGrid()
	for _, p in ipairs(gridParts) do
		p:Destroy()
	end
	gridParts = {}
	local o = origin()
	if not o then
		return
	end
	local half = Config.Grid.Size * CELL / 2
	for i = 0, Config.Grid.Size do
		local offset = -half + i * CELL
		local a = PartUtil.Part({ Size = Vector3.new(0.12, 0.08, Config.Grid.Size * CELL), Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.Neon, Transparency = 0.45, CanCollide = false, CanQuery = false, CFrame = o * CFrame.new(offset, 0.06, 0), Parent = ensureFolder(), Name = "GridLine", CastShadow = false })
		local b = PartUtil.Part({ Size = Vector3.new(Config.Grid.Size * CELL, 0.08, 0.12), Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.Neon, Transparency = 0.45, CanCollide = false, CanQuery = false, CFrame = o * CFrame.new(0, 0.06, offset), Parent = folder, Name = "GridLine", CastShadow = false })
		table.insert(gridParts, a)
		table.insert(gridParts, b)
	end
	-- celle riservate evidenziate (ingresso/pozza/uscita)
	for key in pairs(GridUtil.ReservedSet()) do
		local x, z = GridUtil.FromKey(key)
		local p = PartUtil.Part({ Size = Vector3.new(CELL - 0.3, 0.06, CELL - 0.3), Color = Color3.fromRGB(255, 190, 230), Material = Enum.Material.Neon, Transparency = 0.7, CanCollide = false, CanQuery = false, CFrame = o * CFrame.new(GridUtil.CellToLocal(x, z, 0.08)), Parent = folder, Name = "Reserved", CastShadow = false })
		table.insert(gridParts, p)
	end
end

local function context()
	local creatureCells, decoCells = {}, {}
	for uid, c in pairs(State.Get("Creatures") or {}) do
		if c.x ~= nil and not (Build.Mode == "creature" and Build.Payload and Build.Payload.Uid == uid) then
			creatureCells[GridUtil.Key(c.x, c.z)] = true
		end
	end
	for _, d in ipairs((State.Get("Decorations") or { Placed = {} }).Placed or {}) do
		decoCells[GridUtil.Key(d.x, d.z)] = true
	end
	return {
		UnlockedModules = State.Get("UnlockedModules"),
		UnlockedAlternatives = State.Get("UnlockedAlternatives"),
		CreatureCells = creatureCells,
		DecorationCells = decoCells,
	}
end

function Build.Validate()
	return LayoutValidator.Validate(Build.Layout, context())
end

local function refreshPath()
	for _, p in ipairs(pathParts) do
		p:Destroy()
	end
	pathParts = {}
	local o = origin()
	if not o or not Build.Active then
		return
	end
	local result = Build.Validate()
	if result.Path then
		for _, cell in ipairs(result.Path) do
			local p = PartUtil.Part({ Size = Vector3.new(CELL - 1.2, 0.06, CELL - 1.2), Color = Color3.fromRGB(140, 240, 180), Material = Enum.Material.Neon, Transparency = 0.6, CanCollide = false, CanQuery = false, CFrame = o * CFrame.new(GridUtil.CellToLocal(cell.x, cell.z, 0.1)), Parent = ensureFolder(), Name = "Path", CastShadow = false })
			table.insert(pathParts, p)
		end
	end
	-- moduli del layout di lavoro non ancora pubblicati: fantasmi fissi
	for _, pm in ipairs(Build.Layout.Modules) do
		local m = ModuleModel.Build(pm.Id, pm.Alt, "ghost", nil)
		if m then
			m.Name = "Working_" .. pm.Id
			m:PivotTo(o * CFrame.new(GridUtil.CellToLocal(pm.x, pm.z, 0)) * CFrame.Angles(0, -(pm.Rot or 0) * math.pi / 2, 0))
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Color = d.Color:Lerp(Color3.fromRGB(120, 200, 255), 0.5)
				end
			end
			m.Parent = folder
			table.insert(pathParts, m)
		end
	end
	Build.Changed:Fire(result)
end

local function occupiedByWorking()
	local set = {}
	for _, pm in ipairs(Build.Layout.Modules) do
		for _, c in ipairs(GridUtil.ModuleCells(Defenses.EffectiveFootprint(pm.Id, pm.Alt), pm.x, pm.z, pm.Rot or 0)) do
			set[GridUtil.Key(c.x, c.z)] = true
		end
	end
	return set
end

local function cellFree(x, z)
	if not GridUtil.InBounds(x, z) then
		return false
	end
	local key = GridUtil.Key(x, z)
	if GridUtil.ReservedSet()[key] then
		return false
	end
	local ctx = context()
	if ctx.CreatureCells[key] or ctx.DecorationCells[key] then
		return false
	end
	if occupiedByWorking()[key] then
		return false
	end
	return true
end

local function canPlaceAt(x, z)
	if Build.Mode == "module" then
		local test = TableUtil.DeepCopy(Build.Layout)
		table.insert(test.Modules, { Id = Build.Payload.Id, x = x, z = z, Rot = Build.Rot, Alt = Build.Payload.Alt })
		local res = LayoutValidator.Validate(test, context())
		return res.Ok, res.Reason
	end
	return cellFree(x, z), "Cella occupata"
end

local function makeGhost()
	clearGhost()
	if Build.Mode == "module" then
		ghost = ModuleModel.Build(Build.Payload.Id, Build.Payload.Alt, "ghost", nil)
	elseif Build.Mode == "creature" then
		local c = (State.Get("Creatures") or {})[Build.Payload.Uid]
		if c then
			ghost = CreatureModel.Build(c.Id, c.Variant, nil)
			for _, d in ipairs(ghost:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Transparency = math.max(d.Transparency, 0.4)
					d.CanCollide = false
					d.CanQuery = false
				elseif d:IsA("ParticleEmitter") then
					d.Enabled = false
				end
			end
		end
	elseif Build.Mode == "decoration" then
		ghost = DecorationModel.Build(Build.Payload.Id, nil, true)
	end
	if ghost then
		ghost.Name = "Ghost"
		ghost.Parent = ensureFolder()
	end
	if not cursor then
		cursor = PartUtil.Part({ Size = Vector3.new(CELL - 0.2, 0.1, CELL - 0.2), Color = Color3.fromRGB(140, 240, 180), Material = Enum.Material.Neon, Transparency = 0.4, CanCollide = false, CanQuery = false, CFrame = CFrame.new(0, -100, 0), Parent = ensureFolder(), Name = "Cursor", CastShadow = false })
	end
end

local function pointerPosition()
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		return nil -- su touch usiamo solo il tap
	end
	return UserInputService:GetMouseLocation()
end

local function cellFromScreen(pos)
	local plot = myPlot()
	local o = origin()
	if not plot or not o then
		return nil
	end
	local ray = camera:ViewportPointToRay(pos.X, pos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { plot.Tiles }
	local hit = Workspace:Raycast(ray.Origin, ray.Direction * 500, params)
	if not hit then
		return nil
	end
	local x, z = GridUtil.WorldToCell(o, hit.Position)
	if GridUtil.InBounds(x, z) then
		return x, z
	end
	return nil
end

local function updateGhost(x, z)
	hoverCell = x and { x = x, z = z } or nil
	local o = origin()
	if not o or not x then
		if cursor then
			cursor.CFrame = CFrame.new(0, -100, 0)
		end
		if ghost then
			ghost:PivotTo(CFrame.new(0, -100, 0))
		end
		return
	end
	local ok = canPlaceAt(x, z)
	if cursor then
		cursor.CFrame = o * CFrame.new(GridUtil.CellToLocal(x, z, 0.12))
		cursor.Color = ok and Color3.fromRGB(140, 240, 180) or Color3.fromRGB(240, 120, 120)
	end
	if ghost then
		local y = Build.Mode == "creature" and 2.6 or 0
		ghost:PivotTo(o * CFrame.new(GridUtil.CellToLocal(x, z, y)) * CFrame.Angles(0, -Build.Rot * math.pi / 2, 0))
	end
end

local function hitExisting(pos)
	local plot = myPlot()
	if not plot then
		return nil
	end
	local ray = camera:ViewportPointToRay(pos.X, pos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { plot.Creatures, plot.Decorations, ensureFolder() }
	local hit = Workspace:Raycast(ray.Origin, ray.Direction * 500, params)
	if not hit then
		return nil
	end
	local inst = hit.Instance
	while inst and inst ~= Workspace do
		if inst:IsA("Model") and (inst:GetAttribute("Uid") or inst:GetAttribute("DecorationId") or inst.Name:match("^Working_")) then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

local function tryPlace(pos)
	if not Build.Active then
		return
	end
	if Build.Mode == "edit" then
		local model = hitExisting(pos)
		if not model then
			return
		end
		if model:GetAttribute("Uid") then
			Build.Enter("creature", { Uid = model:GetAttribute("Uid") })
			return
		end
		if model:GetAttribute("DecorationId") then
			local index = model:GetAttribute("Index")
			if index then
				local ok, msg = Net.Invoke("RemoveDecoration", index)
				if not ok and Build.Toast then
					Build.Toast(msg or Strings.Error, "warning")
				end
			end
			return
		end
		if model.Name:match("^Working_") then
			-- rimuove il modulo del layout di lavoro sotto il puntatore
			local o = origin()
			local x, z = GridUtil.WorldToCell(o, model:GetPivot().Position)
			for i, pm in ipairs(Build.Layout.Modules) do
				for _, c in ipairs(GridUtil.ModuleCells(Defenses.EffectiveFootprint(pm.Id, pm.Alt), pm.x, pm.z, pm.Rot or 0)) do
					if c.x == x and c.z == z then
						table.remove(Build.Layout.Modules, i)
						Audio.Play("Click")
						refreshPath()
						return
					end
				end
			end
		end
		return
	end
	local x, z = cellFromScreen(pos)
	if not x then
		return
	end
	local ok, reason = canPlaceAt(x, z)
	if not ok then
		Audio.Play("Error")
		if Build.Toast then
			Build.Toast(reason or "Posizione non valida", "warning")
		end
		return
	end
	if Build.Mode == "module" then
		table.insert(Build.Layout.Modules, { Id = Build.Payload.Id, x = x, z = z, Rot = Build.Rot, Alt = Build.Payload.Alt })
		Audio.Play("Place")
		refreshPath()
		-- resta in modalità per piazzare altri moduli? Passa a edit per evitare piazzamenti accidentali
		Build.Enter("edit")
	elseif Build.Mode == "creature" then
		local okS, msg = Net.Invoke("PlaceCreature", Build.Payload.Uid, x, z)
		if okS then
			Build.Enter("edit")
		elseif Build.Toast then
			Build.Toast(msg or Strings.Error, "warning")
		end
	elseif Build.Mode == "decoration" then
		local okS, msg = Net.Invoke("PlaceDecoration", Build.Payload.Id, x, z, Build.Rot)
		if okS then
			Build.Enter("edit")
		elseif Build.Toast then
			Build.Toast(msg or Strings.Error, "warning")
		end
	end
end

function Build.Rotate()
	Build.Rot = (Build.Rot + 1) % 4
	if hoverCell then
		updateGhost(hoverCell.x, hoverCell.z)
	end
	Audio.Play("Click")
end

function Build.Enter(mode, payload)
	if not Build.Active then
		Build.Start()
	end
	if not Build.Active then
		return -- non nel proprio vivaio
	end
	Build.Mode = mode
	Build.Payload = payload
	Build.Rot = 0
	makeGhost()
	if mode == "edit" then
		clearGhost()
	end
	Build.ModeChanged:Fire(mode, payload)
end

function Build.Start()
	if Build.Active then
		return
	end
	if not myPlot() then
		if Build.Toast then
			Build.Toast("Torna nel tuo vivaio per costruire", "warning")
		end
		return
	end
	Build.Active = true
	Build.Layout = TableUtil.DeepCopy(State.Get("Layout") or State.Get("LastValidLayout") or { Modules = {} })
	if #Build.Layout.Modules == 0 and State.Get("LastValidLayout") then
		Build.Layout = TableUtil.DeepCopy(State.Get("LastValidLayout"))
	end
	ensureFolder()
	buildGrid()
	refreshPath()
	Build.Mode = "edit"
	renderConn = RunService.RenderStepped:Connect(function()
		local pos = pointerPosition()
		if pos then
			local x, z = cellFromScreen(pos)
			updateGhost(x, z)
		end
	end)
	Build.ModeChanged:Fire("edit")
end

function Build.Stop()
	if not Build.Active then
		return
	end
	Build.Active = false
	Build.Mode = nil
	if renderConn then
		renderConn:Disconnect()
		renderConn = nil
	end
	clearGhost()
	if folder then
		folder:Destroy()
		folder = nil
		cursor = nil
	end
	gridParts, pathParts = {}, {}
	Build.ModeChanged:Fire(nil)
end

function Build.Publish()
	local result = Build.Validate()
	if not result.Ok then
		if Build.Toast then
			Build.Toast(result.Reason or Strings.BuildPathBlocked, "warning")
		end
		Audio.Play("Error")
		return false
	end
	local ok, msg = Net.Invoke("SaveLayout", Build.Layout)
	if not ok and Build.Toast then
		Build.Toast(type(msg) == "string" and msg or Strings.Error, "warning")
	end
	return ok
end

function Build.RestoreLastValid()
	Build.Layout = TableUtil.DeepCopy(State.Get("LastValidLayout") or { Modules = {} })
	refreshPath()
end

function Build.Clear()
	Build.Layout = { Modules = {} }
	refreshPath()
end

function Build.SetLayout(layout)
	Build.Layout = TableUtil.DeepCopy(layout)
	refreshPath()
end

function Build.Init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if not Build.Active then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 and not processed then
			tryPlace(UserInputService:GetMouseLocation())
		elseif input.KeyCode == Enum.KeyCode.R then
			Build.Rotate()
		elseif input.KeyCode == Enum.KeyCode.X then
			Build.Enter("edit")
		elseif input.KeyCode == Enum.KeyCode.Escape then
			Build.Stop()
		end
	end)
	UserInputService.TouchTap:Connect(function(positions, processed)
		if not Build.Active or processed then
			return
		end
		local p = positions[1]
		if p then
			local pos = Vector2.new(p.X, p.Y)
			local x, z = cellFromScreen(pos)
			updateGhost(x, z)
			tryPlace(pos)
		end
	end)
	-- aggiorna l'anteprima quando il server conferma modifiche
	State.Changed:Connect(function(key)
		if Build.Active and (key == "Creatures" or key == "Decorations" or key == "LastValidLayout" or key == "UnlockedModules") then
			if key == "LastValidLayout" then
				Build.Layout = TableUtil.DeepCopy(State.Get("LastValidLayout"))
			end
			refreshPath()
		end
	end)
	-- esci dalla costruzione se il giocatore lascia il vivaio
	player:GetAttributeChangedSignal("Location"):Connect(function()
		if player:GetAttribute("Location") ~= "home" then
			Build.Stop()
		end
	end)
end

return Build
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">RaidController</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	RaidController: fisica "di sensazione" lato client (il personaggio è di proprietà del client):
	spinta delle correnti d'aria, trampolini di luce della cupola, nebbia locale.
	Il server verifica solo gli esiti (pozza raggiunta, uscita, sentinelle, cadute).
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Util.Net)

local RaidController = {}
local player = Players.LocalPlayer
local zones = {} -- part -> true
local pads = {}
local fogZones = {}
local lastBounce = 0
local baseFogEnd

local function track(inst)
	if inst:IsA("BasePart") then
		if inst.Name == "Zone" and inst:GetAttribute("Push") then
			zones[inst] = true
		elseif inst.Name == "BouncePad" then
			pads[inst] = true
		elseif inst.Name == "FogZone" then
			fogZones[inst] = true
		end
	end
end

local function untrack(inst)
	zones[inst] = nil
	pads[inst] = nil
	fogZones[inst] = nil
end

local function inside(part, pos, margin)
	local lp = part.CFrame:PointToObjectSpace(pos)
	local h = part.Size / 2 + Vector3.new(margin or 0, margin or 0, margin or 0)
	return math.abs(lp.X) <= h.X and math.abs(lp.Y) <= h.Y and math.abs(lp.Z) <= h.Z
end

function RaidController.Init(onEvent)
	for _, folderName in ipairs({ "Plots", "Arenas", "World" }) do
		local f = Workspace:WaitForChild(folderName, 30)
		if f then
			for _, d in ipairs(f:GetDescendants()) do
				track(d)
			end
			f.DescendantAdded:Connect(track)
			f.DescendantRemoving:Connect(untrack)
		end
	end
	baseFogEnd = Lighting.FogEnd

	Net.Event("RaidEvent").OnClientEvent:Connect(function(name, payload)
		if onEvent then
			onEvent(name, payload or {})
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum then
			return
		end
		local pos = hrp.Position
		-- correnti d'aria
		for zone in pairs(zones) do
			if zone.Parent and zone:GetAttribute("Active") ~= false and inside(zone, pos, 0.5) then
				local push = zone:GetAttribute("Push") or 55
				local dir = zone:GetAttribute("Dir") or 1
				local v
				if zone:GetAttribute("Up") then
					v = Vector3.new(0, push * 0.9, 0)
				else
					v = zone.CFrame.RightVector * push * dir
				end
				-- accelerazione dolce ma decisa (telegrafata dalle particelle)
				hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity:Lerp(Vector3.new(v.X, hrp.AssemblyLinearVelocity.Y + v.Y * dt, v.Z), math.clamp(dt * 6, 0, 1))
			end
		end
		-- trampolini
		if os.clock() - lastBounce > 0.4 then
			for pad in pairs(pads) do
				if pad.Parent then
					local rel = pos - pad.Position
					if Vector3.new(rel.X, 0, rel.Z).Magnitude <= pad.Size.Y / 2 + 0.6 and rel.Y > 0 and rel.Y < 5 and hum.FloorMaterial ~= Enum.Material.Air then
						local power = pad:GetAttribute("Bounce") or 90
						hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X * 0.4, power, hrp.AssemblyLinearVelocity.Z * 0.4)
						lastBounce = os.clock()
						break
					end
				end
			end
		end
		-- nebbia locale
		local inFog = false
		for fz in pairs(fogZones) do
			if fz.Parent and inside(fz, pos, 1) then
				inFog = true
				break
			end
		end
		local targetEnd = inFog and 45 or baseFogEnd
		if math.abs(Lighting.FogEnd - targetEnd) > 1 then
			Lighting.FogEnd = Lighting.FogEnd + (targetEnd - Lighting.FogEnd) * math.clamp(dt * 3, 0, 1)
		end
	end)
end

return RaidController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Stato replicato dal server (sezioni del profilo). Changed(key, value) per aggiornare la UI.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Util.Net)
local Signal = require(Shared.Util.Signal)

local State = { Data = {}, Changed = Signal.new(), Ready = Signal.new(), IsReady = false }

function State.Get(key)
	return State.Data[key]
end

function State.Init()
	Net.Event("StateSync").OnClientEvent:Connect(function(payload)
		for k, v in pairs(payload) do
			State.Data[k] = v
			State.Changed:Fire(k, v)
		end
	end)
	-- stato iniziale completo (riprova finché il profilo non è caricato)
	task.spawn(function()
		local tries = 0
		while not State.IsReady do
			tries += 1
			local ok, full = pcall(function()
				return Net.Function("GetState"):InvokeServer()
			end)
			if ok and full then
				for k, v in pairs(full) do
					State.Data[k] = v
				end
				State.IsReady = true
				for k, v in pairs(full) do
					State.Changed:Fire(k, v)
				end
				State.Ready:Fire()
				Net.Fire("ClientReady")
			else
				task.wait(math.min(5, 0.5 * tries))
			end
		end
	end)
end

function State.OnReady(fn)
	if State.IsReady then
		task.spawn(fn)
	else
		State.Ready:Once(fn)
	end
end

-- Osserva una chiave: chiama subito se già presente, poi a ogni cambio
function State.Observe(key, fn)
	if State.Data[key] ~= nil then
		task.spawn(fn, State.Data[key])
	end
	return State.Changed:Connect(function(k, v)
		if k == key then
			fn(v)
		end
	end)
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Tutorial guidato in 5 passi con banner, evidenziazione del menu e scelta della decorazione.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Decorations = require(Shared.Catalog.Decorations)
local Net = require(Shared.Util.Net)
local PartUtil = require(Shared.Models.PartUtil)
local DecorationModel = require(Shared.Models.DecorationModel)
local UI = require(script.Parent.Parent.UI.UI)
local Toast = require(script.Parent.Parent.UI.Toast)
local State = require(script.Parent.State)

local Tutorial = {}
local C = UI.Colors
local player = Players.LocalPlayer
local banner, bannerText, stepLabel, skipButton, choicePanel
local beacon
local hud

local HIGHLIGHT = { [1] = "build", [2] = nil, [3] = "build", [4] = "raid", [5] = nil }

local function clearBeacon()
	if beacon then
		beacon:Destroy()
		beacon = nil
	end
end

local function placeBeacon(position)
	clearBeacon()
	beacon = PartUtil.Part({ Size = Vector3.new(1.2, 40, 1.2), Color = Color3.fromRGB(255, 220, 110), Material = Enum.Material.Neon, Transparency = 0.5, CanCollide = false, CanQuery = false, CFrame = CFrame.new(position + Vector3.new(0, 20, 0)), Parent = Workspace, Name = "TutorialBeacon", CastShadow = false })
end

local function myPlot()
	local plots = Workspace:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, m in ipairs(plots:GetChildren()) do
		if m:GetAttribute("OwnerUserId") == player.UserId then
			return m
		end
	end
	return nil
end

local function updateBeacon(step)
	clearBeacon()
	local plot = myPlot()
	if step == 2 and plot then
		local vault = plot.Structure:FindFirstChild("VaultBody")
		if vault then
			placeBeacon(vault.Position)
		end
	elseif step == 4 and plot then
		local pad = plot.Structure:FindFirstChild("HubPad")
		if pad and player:GetAttribute("Location") == "home" then
			placeBeacon(pad.Position)
		else
			local world = Workspace:FindFirstChild("World")
			local hub = world and world:FindFirstChild("Hub")
			local portal = hub and hub:FindFirstChild("PortaleIncursioni")
			if portal and portal:FindFirstChild("Base") then
				placeBeacon(portal.Base.Position)
			end
		end
	end
end

local function showChoice()
	if choicePanel then
		return
	end
	choicePanel = UI.Panel(banner.Parent, "🎁 Scegli una decorazione gratuita", UDim2.new(0.6, 0, 0.6, 0))
	local content = choicePanel.Content
	UI.Grid(content, UDim2.new(0.5, -10, 1, -10), 10)
	for i, id in ipairs(Config.Tutorial.FreeDecorationChoices) do
		local def = Decorations.ById[id]
		local card = UI.Card(content, { LayoutOrder = i })
		UI.Viewport(card, DecorationModel.Build(id, nil, false), { Size = UDim2.new(1, -16, 0.55, 0), Position = UDim2.fromOffset(8, 8) })
		UI.Label(card, def.Name, { Font = UI.Theme.Font, TextSize = 20, Size = UDim2.new(1, -16, 0, 28), Position = UDim2.new(0, 8, 0.55, 12), ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Center })
		UI.Label(card, def.Description, { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.new(1, -16, 0, 36), Position = UDim2.new(0, 8, 0.55, 40), ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Center })
		local b = UI.Button(card, "Scelgo questa", function()
			local ok, msg = Net.Invoke("TutorialAdvance", 5, id)
			if ok then
				choicePanel:Close()
				choicePanel.Overlay:Destroy()
				choicePanel = nil
			else
				Toast.Show(msg or Strings.Error, "warning")
			end
		end, { Size = UDim2.new(1, -16, 0, 46), Position = UDim2.new(0, 8, 1, -54), Color = C.Success })
		b.ZIndex = 13
	end
	choicePanel.CloseButton.Visible = false
	choicePanel:Open()
end

local function apply(step, active)
	for _, id in pairs({ "build", "raid" }) do
		hud.Highlight(id, false)
	end
	if not active or step > Config.Tutorial.Steps then
		banner.Visible = false
		clearBeacon()
		return
	end
	banner.Visible = true
	stepLabel.Text = string.format("Tutorial %d / %d", step, Config.Tutorial.Steps)
	bannerText.Text = Strings.Tutorial[step] or ""
	local tut = State.Get("Tutorial") or {}
	skipButton.Visible = tut.CompletedOnce == true
	if HIGHLIGHT[step] then
		hud.Highlight(HIGHLIGHT[step], true)
	end
	updateBeacon(step)
	if step == 5 then
		showChoice()
	end
end

function Tutorial.Init(screenGui, hudModule)
	hud = hudModule
	banner = UI.Frame(screenGui, { Name = "TutorialBanner", BackgroundColor3 = C.PanelDark, BackgroundTransparency = 0.1, Size = UDim2.new(0, 620, 0, 74), Position = UDim2.new(0.5, 0, 1, -100), AnchorPoint = Vector2.new(0.5, 1), Visible = false, ZIndex = 25 })
	UI.Corner(banner, UDim.new(0, 18))
	UI.Stroke(banner, C.Accent, 2)
	stepLabel = UI.Label(banner, "", { Size = UDim2.fromOffset(160, 20), Position = UDim2.fromOffset(14, 6), TextColor3 = C.Accent, Font = UI.Theme.FontBold, TextSize = 13, ZIndex = 26 })
	bannerText = UI.Label(banner, "", { Size = UDim2.new(1, -170, 0, 44), Position = UDim2.fromOffset(14, 26), TextColor3 = C.TextOnDark, TextSize = 15, ZIndex = 26, TextYAlignment = Enum.TextYAlignment.Top })
	skipButton = UI.Button(banner, Strings.TutorialSkip, function()
		local ok, msg = Net.Invoke("TutorialSkip")
		if not ok then
			Toast.Show(msg or Strings.Error, "warning")
		end
	end, { Size = UDim2.fromOffset(130, 36), Position = UDim2.new(1, -142, 0.5, -18), Color = C.TextMuted, TextSize = 13, Visible = false })
	skipButton.ZIndex = 26

	Net.Event("TutorialStep").OnClientEvent:Connect(function(step, active)
		apply(step, active)
	end)
	State.Observe("Tutorial", function(t)
		apply(t.Step, t.Active)
	end)
	player:GetAttributeChangedSignal("Location"):Connect(function()
		local t = State.Get("Tutorial")
		if t and t.Active then
			updateBeacon(t.Step)
		end
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Visuals</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	Visuals: scie cosmetiche sui personaggi, targhette sopra la testa, emote, tema settimanale
	e cielo equipaggiato (illuminazione locale), effetto "scintille che volano" verso l'HUD.
]]
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Cosmetics = require(Shared.Catalog.Cosmetics)
local Themes = require(Shared.Catalog.Themes)
local Net = require(Shared.Util.Net)
local PartUtil = require(Shared.Models.PartUtil)
local UI = require(script.Parent.Parent.UI.UI)
local State = require(script.Parent.State)

local Visuals = {}
local localPlayer = Players.LocalPlayer
local screenGui, hud
local themeParticles

-- ───────────────────────── scie e targhette ─────────────────────────

local function applyTrail(player, char)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local old = hrp:FindFirstChild("CosmeticTrail")
	if old then
		old:Destroy()
	end
	local trailId = player:GetAttribute("Trail")
	local c = trailId and Cosmetics.Get(trailId)
	if c and c.Data.Color then
		PartUtil.Emitter(hrp, { Name = "CosmeticTrail", Color = c.Data.Color, Rate = c.Data.Rate or 6, Speed = NumberRange.new(0.3, 1), Lifetime = NumberRange.new(0.6, 1.2), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) }), Acceleration = Vector3.new(0, 1.5, 0) })
	end
end

local function applyNameplate(player, char)
	local head = char:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("CosmeticPlate")
	if old then
		old:Destroy()
	end
	local plateId = player:GetAttribute("Nameplate")
	local c = plateId and Cosmetics.Get(plateId)
	if c and c.Data.Text then
		local bb = PartUtil.Billboard(head, { Name = "CosmeticPlate", Size = UDim2.fromOffset(140, 26), Offset = Vector3.new(0, 3.2, 0), Text = "✦ " .. c.Data.Text .. " ✦", TextColor = c.Data.Color or Color3.new(1, 1, 1), MaxDistance = 60 })
		bb.AlwaysOnTop = false
	end
end

local function watchPlayer(player)
	local function onChar(char)
		task.wait(0.5)
		applyTrail(player, char)
		applyNameplate(player, char)
	end
	player.CharacterAdded:Connect(onChar)
	if player.Character then
		task.spawn(onChar, player.Character)
	end
	player:GetAttributeChangedSignal("Trail"):Connect(function()
		if player.Character then
			applyTrail(player, player.Character)
		end
	end)
	player:GetAttributeChangedSignal("Nameplate"):Connect(function()
		if player.Character then
			applyNameplate(player, player.Character)
		end
	end)
end

local function showEmote(userId, text)
	local p = Players:GetPlayerByUserId(userId)
	local head = p and p.Character and p.Character:FindFirstChild("Head")
	if not head then
		return
	end
	local bb, label = PartUtil.Billboard(head, { Name = "Emote", Size = UDim2.fromOffset(80, 80), Offset = Vector3.new(0, 4.5, 0), Text = text, MaxDistance = 80 })
	label.TextScaled = true
	TweenService:Create(bb, TweenInfo.new(1.6, Enum.EasingStyle.Quad), { StudsOffset = Vector3.new(0, 7, 0) }):Play()
	task.delay(1.4, function()
		TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.wait(0.45)
		bb:Destroy()
	end)
end

-- ───────────────────────── tema e cielo ─────────────────────────

local function applySkyAndTheme()
	local cos = State.Get("Cosmetics")
	local skyId = cos and cos.Equipped and cos.Equipped.sky or "sky_giorno"
	local sky = Cosmetics.Get(skyId) or Cosmetics.Get("sky_giorno")
	local info = State.Get("ServerInfo")
	local theme = info and Themes.ById[info.ThemeId]
	local clock = sky.Data.ClockTime or 13.5
	local tint = sky.Data.Tint or Color3.new(1, 1, 1)
	if theme then
		tint = tint:Lerp(theme.Visual.Tint, 0.5)
	end
	TweenService:Create(Lighting, TweenInfo.new(2), { ClockTime = clock, Ambient = sky.Data.Ambient or Lighting.Ambient }):Play()
	local cc = Lighting:FindFirstChild("ThemeCorrection")
	if cc then
		TweenService:Create(cc, TweenInfo.new(2), { TintColor = tint }):Play()
	end
	-- particelle del tema nell'hub
	if themeParticles then
		themeParticles:Destroy()
		themeParticles = nil
	end
	if theme and not (State.Get("Settings") or {}).ReducedEffects then
		themeParticles = PartUtil.Part({ Size = Vector3.new(220, 2, 220), Transparency = 1, CanCollide = false, CanQuery = false, CFrame = CFrame.new(0, 45, 0), Parent = Workspace, Name = "ThemeParticles" })
		local props = { Color = theme.Visual.ParticleColor, Rate = 25, Lifetime = NumberRange.new(4, 7), Speed = NumberRange.new(2, 5), LightEmission = 0.5, Name = "Theme" }
		if theme.Visual.Particle == "rain" then
			props.Acceleration = Vector3.new(0, -30, 0)
			props.Size = NumberSequence.new(0.15)
			props.Rate = 60
		elseif theme.Visual.Particle == "leaf" then
			props.Acceleration = Vector3.new(6, -3, 2)
			props.Size = NumberSequence.new(0.5)
		elseif theme.Visual.Particle == "ribbon" then
			props.Acceleration = Vector3.new(1, 0.5, 0)
			props.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.5, 2.5), NumberSequenceKeypoint.new(1, 0) })
		else
			props.Acceleration = Vector3.new(0, -2, 0)
			props.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
		end
		local e = PartUtil.Emitter(themeParticles, props)
		e.EmissionDirection = Enum.NormalId.Bottom
	end
end

-- ───────────────────────── scintille verso l'HUD ─────────────────────────

local function sparkFx(worldPos, amount)
	if not screenGui or (State.Get("Settings") or {}).ReducedEffects then
		return
	end
	local camera = Workspace.CurrentCamera
	local screenPos, onScreen = camera:WorldToViewportPoint(worldPos)
	if not onScreen then
		return
	end
	local target = hud and hud.CardPosition("Exposed") or Vector2.new(200, 40)
	local n = math.clamp(math.floor(amount / 8) + 1, 1, 10)
	for i = 1, n do
		local orb = UI.Frame(screenGui, { Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(screenPos.X + math.random(-30, 30), screenPos.Y + math.random(-30, 30)), BackgroundColor3 = Color3.fromRGB(255, 220, 110), ZIndex = 60 })
		UI.Corner(orb, UDim.new(1, 0))
		UI.Stroke(orb, Color3.fromRGB(255, 250, 220), 2)
		task.delay(i * 0.04, function()
			local tw = TweenService:Create(orb, TweenInfo.new(0.55 + math.random() * 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.fromOffset(target.X, target.Y), Size = UDim2.fromOffset(6, 6) })
			tw:Play()
			tw.Completed:Once(function()
				orb:Destroy()
			end)
		end)
	end
	local label = UI.Label(screenGui, "+" .. amount .. " ✦", { Size = UDim2.fromOffset(120, 30), Position = UDim2.fromOffset(screenPos.X - 60, screenPos.Y - 40), Font = UI.Theme.Font, TextSize = 22, TextColor3 = Color3.fromRGB(255, 220, 110), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 60, TextStrokeTransparency = 0.4 })
	TweenService:Create(label, TweenInfo.new(0.9), { Position = UDim2.fromOffset(screenPos.X - 60, screenPos.Y - 100), TextTransparency = 1 }):Play()
	task.delay(1, function()
		label:Destroy()
	end)
end

function Visuals.Init(gui, hudModule)
	screenGui = gui
	hud = hudModule
	for _, p in ipairs(Players:GetPlayers()) do
		watchPlayer(p)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	Net.Event("SparkFx").OnClientEvent:Connect(sparkFx)
	Net.Event("ThemeChanged").OnClientEvent:Connect(applySkyAndTheme)
	State.Changed:Connect(function(key)
		if key == "Cosmetics" or key == "ServerInfo" or key == "Settings" then
			applySkyAndTheme()
		end
	end)
	State.OnReady(applySkyAndTheme)
end

Visuals.ShowEmote = showEmote
return Visuals
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">WorldAnimator</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	WorldAnimator: animazioni cosmetiche lato client (le parti sono ancorate: muoverle
	localmente non costa rete). Creature (bob/hop/orbit/drift), sentinelle e piattaforme
	fuori dalle arene, girandole, lanterne, portale, albero. LOD per distanza e
	modalità effetti ridotti.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local ModuleModel = require(ReplicatedStorage.Shared.Models.ModuleModel)

local Animator = { Reduced = false }
local creatures = {} -- model -> data
local spinners = {} -- part -> kind
local sentinels = {} -- model -> data
local platforms = {} -- part -> data
local camera = Workspace.CurrentCamera
local emitters = {} -- emitter -> originalEnabled
local CELL = Config.Grid.CellSize
local LOD_DISTANCE = 220

local function isRaidArena(inst)
	local v = inst:FindFirstAncestor("Vivaio")
	return v and v:GetAttribute("Mode") == "raid"
end

local function register(inst)
	if inst:IsA("Model") then
		if inst:GetAttribute("CreatureId") and inst.PrimaryPart then
			creatures[inst] = { Base = inst:GetPivot(), Phase = math.random() * math.pi * 2, Behavior = inst:GetAttribute("Behavior") or "bob" }
		elseif inst:GetAttribute("ModuleId") == "sentinella" then
			task.defer(function()
				local cone = inst:FindFirstChild("Cone")
				if cone and inst.PrimaryPart and not isRaidArena(inst) then
					sentinels[inst] = { Cone = cone, Base = inst.PrimaryPart.Position, Radius = cone:GetAttribute("Radius") or 9, Speed = cone:GetAttribute("Speed") or 55, Offset = math.random() * 360 }
				end
			end)
		elseif inst:GetAttribute("ModuleId") == "piattaforma" then
			task.defer(function()
				if isRaidArena(inst) or not inst.PrimaryPart then
					return
				end
				for _, name in ipairs({ "Platform", "Platform2" }) do
					local p = inst:FindFirstChild(name)
					if p then
						platforms[p] = { Root = inst.PrimaryPart, Period = p:GetAttribute("Period") or 3.2, Travel = p:GetAttribute("Travel") or 8, Phase = p:GetAttribute("Phase") or 0 }
					end
				end
			end)
		end
	elseif inst:IsA("BasePart") then
		local anim = inst:GetAttribute("Anim")
		if anim then
			spinners[inst] = { Kind = anim, Base = inst.CFrame, Phase = math.random() * math.pi * 2, Children = {} }
			if anim == "spin" and inst.Parent then
				for _, c in ipairs(inst.Parent:GetChildren()) do
					if c:IsA("BasePart") and c:GetAttribute("SpinChild") then
						table.insert(spinners[inst].Children, { Part = c, Offset = inst.CFrame:ToObjectSpace(c.CFrame) })
					end
				end
			end
		end
	elseif inst:IsA("ParticleEmitter") then
		emitters[inst] = inst.Enabled
		if Animator.Reduced then
			inst.Enabled = false
		end
	end
end

local function unregister(inst)
	creatures[inst] = nil
	spinners[inst] = nil
	sentinels[inst] = nil
	platforms[inst] = nil
	emitters[inst] = nil
end

local function creatureOffset(data, t)
	local b = data.Behavior
	local p = data.Phase
	if b == "hop" then
		local cycle = (t * 1.6 + p) % (math.pi * 2)
		local h = math.max(0, math.sin(cycle)) * 2.2
		local squash = 1 - math.max(0, -math.sin(cycle)) * 0.15
		return CFrame.new(0, h, 0) * CFrame.Angles(0, math.sin(t * 0.3 + p) * 0.3, 0), squash
	elseif b == "orbit" then
		local a = t * 0.8 + p
		return CFrame.new(math.cos(a) * 1.2, math.sin(t * 2 + p) * 0.25, math.sin(a) * 1.2) * CFrame.Angles(0, -a + math.pi / 2, 0), 1
	elseif b == "drift" then
		local a = t * 0.5 + p
		return CFrame.new(math.sin(a) * 1.4, math.sin(t * 1.3 + p) * 0.4, math.sin(a * 2) * 0.7) * CFrame.Angles(0, math.sin(a) * 0.5, math.cos(a) * 0.08), 1
	end
	return CFrame.new(0, math.sin(t * 1.8 + p) * 0.35, 0) * CFrame.Angles(0, math.sin(t * 0.4 + p) * 0.4, 0), 1
end

function Animator.SetReduced(reduced)
	Animator.Reduced = reduced
	for e, original in pairs(emitters) do
		if e.Parent then
			e.Enabled = if reduced then false else original
		end
	end
end

function Animator.Init()
	for _, folderName in ipairs({ "Plots", "Arenas", "World" }) do
		local f = Workspace:WaitForChild(folderName, 30)
		if f then
			for _, d in ipairs(f:GetDescendants()) do
				register(d)
			end
			f.DescendantAdded:Connect(register)
			f.DescendantRemoving:Connect(unregister)
		end
	end
	local frame = 0
	RunService.RenderStepped:Connect(function(dt)
		frame += 1
		if Animator.Reduced and frame % 2 == 0 then
			return
		end
		local t = os.clock()
		local camPos = camera.CFrame.Position
		for model, data in pairs(creatures) do
			if model.Parent and model.PrimaryPart then
				if (data.Base.Position - camPos).Magnitude < LOD_DISTANCE then
					local offset, squash = creatureOffset(data, t)
					model:PivotTo(data.Base * offset)
					if squash ~= 1 and model.PrimaryPart then
						-- lieve schiacciamento del corpo nel salto
						local s = model.PrimaryPart:GetAttribute("BaseSize")
						if not s then
							model.PrimaryPart:SetAttribute("BaseSize", model.PrimaryPart.Size)
							s = model.PrimaryPart.Size
						end
						model.PrimaryPart.Size = Vector3.new(s.X * (2 - squash), s.Y * squash, s.Z * (2 - squash))
					end
				end
			else
				creatures[model] = nil
			end
		end
		for part, data in pairs(spinners) do
			if part.Parent then
				if (data.Base.Position - camPos).Magnitude < LOD_DISTANCE then
					if data.Kind == "spin" then
						part.CFrame = data.Base * CFrame.Angles(0, 0, t * 2.5)
						for _, c in ipairs(data.Children) do
							c.Part.CFrame = part.CFrame * c.Offset
						end
					elseif data.Kind == "spinZ" then
						part.CFrame = data.Base * CFrame.Angles(t * 0.6, 0, 0)
					elseif data.Kind == "sway" then
						part.CFrame = data.Base * CFrame.Angles(0, 0, math.sin(t * 1.5 + data.Phase) * 0.12)
					elseif data.Kind == "bob" then
						part.CFrame = data.Base * CFrame.new(0, math.sin(t * 2 + data.Phase) * 0.2, 0) * CFrame.Angles(0, t * 0.8, 0)
					elseif data.Kind == "pulse" then
						local s = 1 + math.sin(t * 2) * 0.08
						part.Size = Vector3.new(3 * s, 3 * s, 3 * s)
					end
				end
			else
				spinners[part] = nil
			end
		end
		for model, data in pairs(sentinels) do
			if model.Parent and data.Cone.Parent then
				if (data.Base - camPos).Magnitude < LOD_DISTANCE then
					ModuleModel.OrientSentinel(model, data.Offset + t * data.Speed * 0.5)
				end
			else
				sentinels[model] = nil
			end
		end
		for part, data in pairs(platforms) do
			if part.Parent and data.Root.Parent then
				if (data.Root.Position - camPos).Magnitude < LOD_DISTANCE then
					local phase = (t / data.Period + data.Phase) * math.pi * 2
					part.CFrame = data.Root.CFrame * CFrame.new(0, 0.1, math.sin(phase) * data.Travel / 2)
				end
			else
				platforms[part] = nil
			end
		end
	end)
end

return Animator
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="78">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Main (client): crea la ScreenGui, avvia controller e pannelli, collega il menu.
]]
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Strings = require(Shared.Strings)
local Net = require(Shared.Util.Net)

local Controllers = script.Parent.Controllers
local UIFolder = script.Parent.UI

local State = require(Controllers.State)
local Audio = require(Controllers.Audio)
local Build = require(Controllers.BuildController)
local RaidController = require(Controllers.RaidController)
local WorldAnimator = require(Controllers.WorldAnimator)
local Visuals = require(Controllers.Visuals)
local Tutorial = require(Controllers.TutorialController)

local UI = require(UIFolder.UI)
local Toast = require(UIFolder.Toast)
local HUD = require(UIFolder.HUD)
local BuildPanel = require(UIFolder.BuildPanel)
local CommissionPanel = require(UIFolder.CommissionPanel)
local AlbumPanel = require(UIFolder.AlbumPanel)
local CocoonPanel = require(UIFolder.CocoonPanel)
local GalleryPanel = require(UIFolder.GalleryPanel)
local ShopPanel = require(UIFolder.ShopPanel)
local SettingsPanel = require(UIFolder.SettingsPanel)
local RaidPanel = require(UIFolder.RaidPanel)
local DemoPanel = require(UIFolder.DemoPanel)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- disattiva la lista giocatori di default per lasciare spazio alla UI; chat resta
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "VivaioUI"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
screenGui.Parent = playerGui

-- scala per schermi piccoli (mobile-first)
local scale = Instance.new("UIScale")
scale.Parent = screenGui
local camera = workspace.CurrentCamera
while not camera do
	workspace:GetPropertyChangedSignal("CurrentCamera"):Wait()
	camera = workspace.CurrentCamera
end
local function updateScale()
	local w = camera.ViewportSize.X
	scale.Scale = math.clamp(w / 1280, 0.62, 1)
end
updateScale()
camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

State.Init()
Audio.Init()
Toast.Init(screenGui)

local panels = {}
local function closeAll(except)
	for id, p in pairs(panels) do
		if id ~= except and p.Close then
			p.Close()
		end
	end
end

HUD.Init(screenGui, {
	OnMenu = function(id)
		if RaidPanel.IsActive() then
			Toast.Show("Termina l'incursione prima di aprire i menu", "warning")
			return
		end
		Audio.Play("Click")
		closeAll(id)
		local p = panels[id]
		if p then
			p.Toggle()
		end
	end,
})

BuildPanel.Init(screenGui)
CommissionPanel.Init(screenGui)
AlbumPanel.Init(screenGui)
CocoonPanel.Init(screenGui)
GalleryPanel.Init(screenGui)
ShopPanel.Init(screenGui)
SettingsPanel.Init(screenGui)
RaidPanel.Init(screenGui)
DemoPanel.Init(screenGui)
panels.build = BuildPanel
panels.board = CommissionPanel
panels.album = AlbumPanel
panels.cocoon = CocoonPanel
panels.gallery = GalleryPanel
panels.shop = ShopPanel
panels.settings = SettingsPanel
panels.raid = RaidPanel
panels.demo = { Open = DemoPanel.Open, Close = DemoPanel.Close, Toggle = DemoPanel.Open }

Build.Init()
WorldAnimator.Init()
Visuals.Init(screenGui, HUD)
Tutorial.Init(screenGui, HUD)
SettingsPanel.ReducedEffectsChanged = function(v)
	WorldAnimator.SetReduced(v)
end

RaidController.Init(function(name, payload)
	if name == "OpenPanel" then
		Audio.Play("Click")
		closeAll(payload.Panel)
		local p = panels[payload.Panel]
		if p then
			p.Open()
		end
	elseif name == "Emote" then
		Visuals.ShowEmote(payload.UserId, payload.Text)
	elseif name == "CocoonHatched" then
		Audio.Play("Success")
	else
		if name == "Start" then
			closeAll()
			Build.Stop()
		end
		RaidPanel.HandleEvent(name, payload)
	end
end)

Net.Event("Toast").OnClientEvent:Connect(function(message, kind)
	Toast.Show(message, kind)
	if kind == "warning" or kind == "error" then
		Audio.Play("Error", 1)
	end
end)

-- emote con il tasto T / pulsante su mobile gestito dalle Opzioni
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.T then
		Net.Fire("Emote")
	end
end)

State.OnReady(function()
	Toast.Show("Benvenuto in " .. Strings.Game .. "!", "success")
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="79">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">AlbumPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Album delle famiglie meteo: creature, varianti, traguardi, maestria.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Creatures = require(Shared.Catalog.Creatures)
local Album = require(Shared.Catalog.Album)
local Net = require(Shared.Util.Net)
local CreatureModel = require(Shared.Models.CreatureModel)
local UI = require(script.Parent.UI)
local Toast = require(script.Parent.Toast)
local State = require(script.Parent.Parent.Controllers.State)

local AlbumPanel = {}
local C = UI.Colors
local panel, tabs, body
local current = "sole"

local function ownedCounts()
	local owned = State.Get("OwnedCreatureIds") or {}
	local byFamily, total = { sole = 0, pioggia = 0, vento = 0, aurora = 0 }, 0
	for id in pairs(owned) do
		local def = Creatures.Get(id)
		if def then
			byFamily[def.Family] += 1
			total += 1
		end
	end
	return byFamily, total, owned
end

local function renderFamily(family)
	body:ClearAllChildren()
	local scroll = UI.Scroll(body)
	UI.List(scroll, Enum.FillDirection.Vertical, 10)
	UI.Padding(scroll, 6)
	local byFamily, total, owned = ownedCounts()
	local info = Creatures.FamilyInfo[family]
	UI.Label(scroll, string.format("%s · %s  —  " .. Strings.AlbumOwned, info.Name, info.Description, byFamily[family], 4), { Font = UI.Theme.FontBold, TextSize = 15, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 0, ZIndex = 13 })
	local grid = UI.Frame(scroll, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 270), LayoutOrder = 1, ZIndex = 12 })
	UI.Grid(grid, UDim2.fromOffset(200, 260), 10)
	local variants = State.Get("UnlockedVariants") or {}
	for i, def in ipairs(Creatures.ByFamily[family]) do
		local has = owned[def.Id] == true
		local card = UI.Card(grid, { Size = UDim2.fromOffset(200, 260), LayoutOrder = i, BackgroundColor3 = has and C.PanelAlt or Color3.fromRGB(215, 222, 235) })
		local model = CreatureModel.Build(def.Id, "base", nil)
		if not has then
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Color = Color3.fromRGB(70, 80, 110)
					d.Material = Enum.Material.SmoothPlastic
				elseif d:IsA("PointLight") or d:IsA("ParticleEmitter") or d:IsA("Sparkles") then
					d:Destroy()
				end
			end
		end
		UI.Viewport(card, model, { Size = UDim2.new(1, -16, 0, 120), Position = UDim2.fromOffset(8, 8) })
		UI.Label(card, has and def.Name or (Strings.AlbumLocked .. " #" .. def.UnlockOrder), { Font = UI.Theme.Font, TextSize = 18, Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 132), ZIndex = 13 })
		UI.Pill(card, Strings.Rarity[def.Rarity], C.Rarity[def.Rarity], { Position = UDim2.fromOffset(8, 158), Size = UDim2.fromOffset(90, 20) })
		UI.Label(card, has and def.Description or "Ottienila con un bozzolo " .. info.Name, { TextSize = 12, TextColor3 = C.TextMuted, Size = UDim2.new(1, -16, 0, 44), Position = UDim2.fromOffset(8, 182), ZIndex = 13, TextYAlignment = Enum.TextYAlignment.Top })
		-- varianti
		local vx = 8
		local unlocked = variants[def.Id] or {}
		for _, v in ipairs(def.Variants) do
			local isU = has and unlocked[v.Id]
			local dot = UI.Frame(card, { Size = UDim2.fromOffset(40, 20), Position = UDim2.fromOffset(vx, 230), BackgroundColor3 = isU and v.Color or Color3.fromRGB(190, 195, 210), ZIndex = 13 })
			UI.Corner(dot, UDim.new(1, 0))
			UI.Label(dot, isU and "" or "🔒", { Size = UDim2.fromScale(1, 1), TextSize = 10, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 14 })
			vx += 46
		end
	end
	-- traguardi della famiglia + globali
	local claimed = (State.Get("Album") or { Claimed = {} }).Claimed
	local mlist = UI.Frame(scroll, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, ZIndex = 12 })
	UI.List(mlist, Enum.FillDirection.Vertical, 6)
	UI.Label(mlist, "🏅 " .. Strings.AlbumMilestone .. " (famiglia e globali)", { Font = UI.Theme.FontBold, TextSize = 15, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 0, ZIndex = 13 })
	local order = 0
	for _, m in ipairs(Album.List) do
		if m.Family == family or m.Family == nil then
			order += 1
			local reached = m.Family and byFamily[family] >= m.Count or (not m.Family and total >= m.Count)
			local isClaimed = claimed[m.Id] == true
			local row = UI.Card(mlist, { Size = UDim2.new(1, -8, 0, 56), LayoutOrder = order, BackgroundColor3 = isClaimed and Color3.fromRGB(220, 245, 230) or C.PanelAlt })
			local rewards = {}
			if m.Reward.Fragments then
				table.insert(rewards, "💎 " .. m.Reward.Fragments)
			end
			if m.Reward.Tokens then
				table.insert(rewards, "🎨 " .. m.Reward.Tokens)
			end
			if m.Reward.Sparks then
				table.insert(rewards, "✦ " .. m.Reward.Sparks)
			end
			if m.Reward.Decoration then
				table.insert(rewards, "🌸 decorazione")
			end
			if m.Reward.Cosmetic then
				table.insert(rewards, "🏷 targhetta")
			end
			UI.Label(row, string.format("%s  <font color=\"#6a7a95\">(%d %s)</font>", m.Title, m.Count, m.Family and "creature" or "creature in totale"), { Font = UI.Theme.FontBold, TextSize = 15, Size = UDim2.new(1, -330, 0, 26), Position = UDim2.fromOffset(12, 6), ZIndex = 13 })
			UI.Label(row, table.concat(rewards, "   "), { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.new(1, -330, 0, 20), Position = UDim2.fromOffset(12, 30), ZIndex = 13 })
			local b = UI.Button(row, isClaimed and "✔ Riscosso" or (reached and "🎁 Riscuoti" or "Non raggiunto"), function()
				if reached and not isClaimed then
					local ok, msg = Net.Invoke("ClaimAlbumMilestone", m.Id)
					if not ok then
						Toast.Show(msg or Strings.Error, "warning")
					end
				end
			end, { Size = UDim2.fromOffset(170, 40), Position = UDim2.new(1, -182, 0.5, -20), Color = isClaimed and C.TextMuted or (reached and C.Success or C.TextMuted), TextSize = 14 })
			b.ZIndex = 13
		end
	end
end

local function renderMastery()
	body:ClearAllChildren()
	local scroll = UI.Scroll(body)
	UI.List(scroll, Enum.FillDirection.Vertical, 12)
	UI.Padding(scroll, 6)
	local mastery = State.Get("Mastery") or { Collection = 0, Raid = 0, Defense = 0, ClaimedTiers = {} }
	local desc = {
		Collection = "Cresce con nuove creature e varianti. Tier II sblocca il deposito automatico.",
		Raid = "Cresce con ogni incursione (riuscita o no). Sblocca varianti Crepuscolo.",
		Defense = "Cresce con layout pubblicati e incursioni respinte. Sblocca alternative tattiche e moduli firma.",
	}
	for i, track in ipairs({ "Collection", "Raid", "Defense" }) do
		local points = mastery[track] or 0
		local tier = Album.TierFor(points, Config.Mastery.Tiers)
		local nextTh = Config.Mastery.Tiers[tier + 1]
		local card = UI.Card(scroll, { Size = UDim2.new(1, -8, 0, 150), LayoutOrder = i })
		local title = Album.MasteryRewards[track][tier] and Album.MasteryRewards[track][tier].Title or "—"
		UI.Label(card, string.format("%s · Tier %d  <font color=\"#6a7a95\">%s</font>", Strings["Mastery" .. track], tier, title), { Font = UI.Theme.Font, TextSize = 20, Size = UDim2.new(1, -24, 0, 28), Position = UDim2.fromOffset(12, 8), ZIndex = 13 })
		UI.Label(card, desc[track], { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.new(1, -24, 0, 36), Position = UDim2.fromOffset(12, 36), ZIndex = 13, TextYAlignment = Enum.TextYAlignment.Top })
		local bar = UI.Progress(card, { Size = UDim2.new(1, -24, 0, 20), Position = UDim2.fromOffset(12, 76), FillColor = C.Info })
		if nextTh then
			bar:Set(points, nextTh, string.format("%d / %d punti al Tier %d", points, nextTh, tier + 1))
		else
			bar:Set(1, 1, "Maestria massima")
		end
		local nextReward = Album.MasteryRewards[track][tier + 1]
		UI.Label(card, nextReward and ("Prossimo: " .. nextReward.Title .. "  💎 " .. (nextReward.Fragments or 0) .. (nextReward.Tokens and ("  🎨 " .. nextReward.Tokens) or "") .. (nextReward.Unlock == "AutoDeposit" and "  + deposito automatico" or "")) or "", { TextSize = 13, Size = UDim2.new(1, -24, 0, 40), Position = UDim2.fromOffset(12, 102), ZIndex = 13 })
	end
	UI.Label(scroll, "La maestria dà identità e opzioni tattiche laterali, non vantaggi cumulativi.", { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 10, ZIndex = 13 })
end

function AlbumPanel.Init(screenGui)
	panel = UI.Panel(screenGui, "📖 " .. Strings.AlbumTitle)
	tabs = UI.Tabs(panel.Content, {
		{ Id = "sole", Label = "☀ Sole" }, { Id = "pioggia", Label = "🌧 Pioggia" }, { Id = "vento", Label = "🍃 Vento" }, { Id = "aurora", Label = "🌌 Aurora" }, { Id = "mastery", Label = "🏅 " .. Strings.AlbumMastery },
	}, function(name)
		current = name
		if name == "mastery" then
			renderMastery()
		else
			renderFamily(name)
		end
	end)
	body = UI.Frame(panel.Content, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -54), Position = UDim2.fromOffset(0, 54), ZIndex = 12 })
	panel.OnOpen = function()
		tabs:Select(current)
	end
	State.Changed:Connect(function(key)
		if panel.IsOpen and (key == "OwnedCreatureIds" or key == "Album" or key == "Mastery" or key == "UnlockedVariants") then
			tabs:Select(current)
		end
	end)
end

function AlbumPanel.Toggle()
	panel:Toggle()
end
function AlbumPanel.Open()
	panel:Open()
end
function AlbumPanel.Close()
	panel:Close()
end

return AlbumPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">BuildPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	BuildPanel: menu Costruisci con schede Creature / Difese / Decorazioni / Potenziamenti,
	barra energia, contatori slot, stato percorso, pubblicazione, prova, ripristino, codici.
	Più la toolbar flottante durante il posizionamento.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Creatures = require(Shared.Catalog.Creatures)
local Defenses = require(Shared.Catalog.Defenses)
local Decorations = require(Shared.Catalog.Decorations)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Util.Net)
local CreatureModel = require(Shared.Models.CreatureModel)
local ModuleModel = require(Shared.Models.ModuleModel)
local DecorationModel = require(Shared.Models.DecorationModel)
local UI = require(script.Parent.UI)
local Toast = require(script.Parent.Toast)
local State = require(script.Parent.Parent.Controllers.State)
local Build = require(script.Parent.Parent.Controllers.BuildController)
local Audio = require(script.Parent.Parent.Controllers.Audio)

local BuildPanel = {}
local C = UI.Colors
local Players = game:GetService("Players")

local function playerAtHome()
	return Players.LocalPlayer:GetAttribute("Location") == "home"
end
local panel, tabs, body, statusBar, energyBar, slotsLabel, pathLabel
local toolbar, toolbarLabel, toolbarStatus
local currentTab = "creatures"

local function masteryTier(track)
	local m = State.Get("Mastery")
	if not m then
		return 0
	end
	local tier = 0
	for i, th in ipairs(Config.Mastery.Tiers) do
		if (m[track] or 0) >= th then
			tier = i
		end
	end
	return tier
end

local function refreshStatus(result)
	result = result or Build.Validate()
	energyBar:Set(result.Energy, Config.Defense.EnergyBudget, string.format(Strings.BuildEnergy, result.Energy, Config.Defense.EnergyBudget))
	local D = Config.Defense
	slotsLabel.Text = string.format(Strings.BuildSlots, result.Counts.ostacolo, D.MaxObstacles, result.Counts.distrazione, D.MaxDistractions, result.Counts.firma, D.MaxSignature)
	if result.Ok then
		pathLabel.Text = Strings.BuildPathOk .. (#Build.Layout.Modules > 0 and ("  ·  Difficoltà " .. Format.Stars(require(Shared.LayoutValidator).DifficultyStars(result.Difficulty), 5)) or "")
		pathLabel.TextColor3 = C.Success
	else
		pathLabel.Text = "✖ " .. (result.Reason or Strings.BuildPathBlocked)
		pathLabel.TextColor3 = C.Danger
	end
	if toolbarStatus then
		toolbarStatus.Text = pathLabel.Text .. "  ·  " .. string.format(Strings.BuildEnergy, result.Energy, Config.Defense.EnergyBudget)
		toolbarStatus.TextColor3 = pathLabel.TextColor3
	end
end

-- ───────────────────────── schede ─────────────────────────

local function renderCreatures()
	body:ClearAllChildren()
	local scroll = UI.Scroll(body)
	UI.Grid(scroll, UDim2.fromOffset(170, 250), 10)
	UI.Padding(scroll, 6)
	local creatures = State.Get("Creatures") or {}
	local placed, capacity = 0, Config.PlotSlots.Capacities[State.Get("PlotLevel") or 1]
	for _, c in pairs(creatures) do
		if c.x ~= nil then
			placed += 1
		end
	end
	local uids = {}
	for uid in pairs(creatures) do
		table.insert(uids, uid)
	end
	table.sort(uids)
	local order = 0
	for _, uid in ipairs(uids) do
		local c = creatures[uid]
		local def = Creatures.Get(c.Id)
		if def then
			order += 1
			local card = UI.Card(scroll, { Size = UDim2.fromOffset(170, 250), LayoutOrder = order })
			UI.Viewport(card, CreatureModel.Build(c.Id, c.Variant, nil), { Size = UDim2.new(1, -16, 0, 110), Position = UDim2.fromOffset(8, 8) })
			UI.Label(card, def.Name, { Font = UI.Theme.Font, TextSize = 18, Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 122), ZIndex = 13 })
			UI.Pill(card, Strings.Rarity[def.Rarity], C.Rarity[def.Rarity], { Position = UDim2.fromOffset(8, 146), Size = UDim2.fromOffset(80, 20) })
			UI.Pill(card, Strings.Family[def.Family], C.Family[def.Family], { Position = UDim2.fromOffset(92, 146), Size = UDim2.fromOffset(70, 20) })
			UI.Label(card, string.format("✦ %d / %ds", def.Production, Config.Production.BaseInterval), { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 168), ZIndex = 13 })
			if c.x ~= nil then
				local b = UI.Button(card, "Sposta", function()
					panel:Close()
					Build.Enter("creature", { Uid = uid })
				end, { Size = UDim2.new(0.5, -10, 0, 36), Position = UDim2.fromOffset(8, 206), Color = C.Info, TextSize = 14 })
				b.ZIndex = 13
				local r = UI.Button(card, "Ritira", function()
					Net.Invoke("RemoveCreature", uid)
				end, { Size = UDim2.new(0.5, -10, 0, 36), Position = UDim2.new(0.5, 2, 0, 206), Color = C.TextMuted, TextSize = 14 })
				r.ZIndex = 13
			else
				local full = placed >= capacity
				local b = UI.Button(card, full and "Vivaio pieno" or "Posiziona", function()
					if full then
						Toast.Show("Amplia il vivaio dalla scheda Potenziamenti", "warning")
						return
					end
					panel:Close()
					Build.Enter("creature", { Uid = uid })
				end, { Size = UDim2.new(1, -16, 0, 36), Position = UDim2.fromOffset(8, 206), Color = full and C.TextMuted or C.Success, TextSize = 14 })
				b.ZIndex = 13
			end
			-- varianti sbloccate
			local variants = (State.Get("UnlockedVariants") or {})[c.Id] or { base = true }
			local vx = 8
			for _, v in ipairs(def.Variants) do
				local unlocked = variants[v.Id] == true
				local dot = UI.Button(card, unlocked and "" or "🔒", function()
					if unlocked then
						Net.Invoke("SetVariant", uid, v.Id)
					end
				end, { Size = UDim2.fromOffset(28, 18), Position = UDim2.fromOffset(vx, 186), Color = unlocked and v.Color or Color3.fromRGB(200, 200, 210), TextSize = 10, Corner = UDim.new(1, 0) })
				dot.ZIndex = 13
				if c.Variant == v.Id then
					UI.Stroke(dot, C.Text, 2)
				end
				vx += 32
			end
		end
	end
	local info = UI.Label(scroll, string.format("Creature esposte: %d / %d · oltre la 6ª il rendimento cala", placed, capacity), { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.fromOffset(340, 40), LayoutOrder = 999, ZIndex = 13 })
	info.TextWrapped = true
end

local function renderDefenses()
	body:ClearAllChildren()
	local scroll = UI.Scroll(body)
	UI.List(scroll, Enum.FillDirection.Vertical, 8)
	UI.Padding(scroll, 6)
	local unlocked = State.Get("UnlockedModules") or {}
	local unlockedAlts = State.Get("UnlockedAlternatives") or {}
	local chosenAlt = State.Get("ModuleAlternative") or {}
	local defenseTier = masteryTier("Defense")
	for i, def in ipairs(Defenses.List) do
		local isUnlocked = unlocked[def.Id] == true
		local card = UI.Card(scroll, { Size = UDim2.new(1, -8, 0, 150), LayoutOrder = i })
		UI.Viewport(card, ModuleModel.Build(def.Id, chosenAlt[def.Id], "home", nil), { Size = UDim2.fromOffset(130, 130), Position = UDim2.fromOffset(8, 10), Zoom = 1.0 })
		UI.Label(card, def.Name, { Font = UI.Theme.Font, TextSize = 20, Size = UDim2.new(1, -300, 0, 26), Position = UDim2.fromOffset(150, 8), ZIndex = 13 })
		UI.Pill(card, Defenses.CategoryNames[def.Category], def.Category == "ostacolo" and C.Info or (def.Category == "distrazione" and C.Token or C.Accent), { Position = UDim2.fromOffset(150, 36), Size = UDim2.fromOffset(110, 20) })
		UI.Label(card, string.format("⚡ %d energia · difficoltà %s", def.Energy, Format.Stars(math.clamp(math.floor(def.Difficulty + 0.5), 1, 5), 5)), { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.new(1, -300, 0, 18), Position = UDim2.fromOffset(268, 37), ZIndex = 13 })
		UI.Label(card, def.Description, { TextSize = 14, Size = UDim2.new(1, -300, 0, 44), Position = UDim2.fromOffset(150, 60), ZIndex = 13, TextYAlignment = Enum.TextYAlignment.Top })
		-- alternative tattiche
		if #def.Alternatives > 0 then
			local ax = 150
			local function altButton(id, name, available)
				local b = UI.Button(card, (chosenAlt[def.Id] or "base") == id and ("● " .. name) or name, function()
					if not available then
						Toast.Show(Strings.BuildLocked, "warning")
						return
					end
					local ok, msg = Net.Invoke("SetModuleAlternative", def.Id, id)
					if not ok then
						Toast.Show(msg or Strings.Error, "warning")
					else
						renderDefenses()
					end
				end, { Size = UDim2.fromOffset(150, 28), Position = UDim2.fromOffset(ax, 110), Color = available and C.PanelDark or C.TextMuted, TextSize = 12, Corner = UDim.new(1, 0) })
				b.ZIndex = 13
				ax += 156
			end
			altButton("base", "Base", true)
			for _, alt in ipairs(def.Alternatives) do
				local avail = unlockedAlts[def.Id] and unlockedAlts[def.Id][alt.Id]
				altButton(alt.Id, alt.Name .. (avail and "" or (" (Difesa " .. alt.Unlock.Tier .. ")")), avail == true)
			end
		end
		local btn
		if isUnlocked then
			btn = UI.Button(card, "Posiziona", function()
				panel:Close()
				Build.Enter("module", { Id = def.Id, Alt = chosenAlt[def.Id] })
			end, { Size = UDim2.fromOffset(130, 44), Position = UDim2.new(1, -142, 0, 12), Color = C.Success })
		elseif def.Unlock.Kind == "sparks" then
			btn = UI.Button(card, string.format(Strings.BuildUnlockCost, def.Unlock.Cost), function()
				local ok, msg = Net.Invoke("UnlockModule", def.Id)
				if ok then
					renderDefenses()
				else
					Toast.Show(msg or Strings.Error, "warning")
				end
			end, { Size = UDim2.fromOffset(130, 44), Position = UDim2.new(1, -142, 0, 12), Color = C.AccentDark, TextSize = 14 })
		else
			btn = UI.Button(card, string.format("Maestria Difesa %d", def.Unlock.Tier or 1), nil, { Size = UDim2.fromOffset(130, 44), Position = UDim2.new(1, -142, 0, 12), Color = C.TextMuted, TextSize = 13 })
		end
		btn.ZIndex = 13
		UI.Label(card, string.format("Maestria Difesa attuale: %d", defenseTier), { TextSize = 12, TextColor3 = C.TextMuted, Size = UDim2.fromOffset(130, 30), Position = UDim2.new(1, -142, 0, 60), ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Center })
	end
end

local function renderDecorations()
	body:ClearAllChildren()
	local scroll = UI.Scroll(body)
	UI.Grid(scroll, UDim2.fromOffset(170, 230), 10)
	UI.Padding(scroll, 6)
	local decos = State.Get("Decorations") or { Owned = {}, Placed = {} }
	local tokens = State.Get("StyleTokens") or 0
	local order = 0
	for _, def in ipairs(Decorations.List) do
		local owned = decos.Owned[def.Id] == true
		if owned or def.TokenPrice then
			order += 1
			local card = UI.Card(scroll, { Size = UDim2.fromOffset(170, 230), LayoutOrder = order })
			UI.Viewport(card, DecorationModel.Build(def.Id, nil, false), { Size = UDim2.new(1, -16, 0, 110), Position = UDim2.fromOffset(8, 8) })
			UI.Label(card, def.Name, { Font = UI.Theme.Font, TextSize = 17, Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 122), ZIndex = 13 })
			UI.Label(card, def.Description, { TextSize = 12, TextColor3 = C.TextMuted, Size = UDim2.new(1, -16, 0, 40), Position = UDim2.fromOffset(8, 144), ZIndex = 13, TextYAlignment = Enum.TextYAlignment.Top })
			local b
			if owned then
				b = UI.Button(card, "Posiziona", function()
					panel:Close()
					Build.Enter("decoration", { Id = def.Id })
				end, { Size = UDim2.new(1, -16, 0, 36), Position = UDim2.fromOffset(8, 188), Color = C.Success, TextSize = 14 })
			else
				b = UI.Button(card, string.format("🎨 %d gettoni", def.TokenPrice), function()
					local ok, msg = Net.Invoke("BuyCosmetic", def.Id)
					if ok then
						renderDecorations()
					else
						Toast.Show(msg or Strings.Error, "warning")
					end
				end, { Size = UDim2.new(1, -16, 0, 36), Position = UDim2.fromOffset(8, 188), Color = tokens >= def.TokenPrice and C.Token or C.TextMuted, TextSize = 14 })
			end
			b.ZIndex = 13
		end
	end
	local placedInfo = UI.Label(scroll, string.format("Posizionate: %d / %d · tocca una decorazione nel vivaio (modalità modifica) per rimuoverla", #decos.Placed, Decorations.MaxPlaced), { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.fromOffset(340, 60), LayoutOrder = 999, ZIndex = 13 })
	placedInfo.TextWrapped = true
end

local function renderUpgrades()
	body:ClearAllChildren()
	local scroll = UI.Scroll(body)
	UI.List(scroll, Enum.FillDirection.Vertical, 10)
	UI.Padding(scroll, 6)
	local sparks = State.Get("Sparks") or { Vault = 0, Exposed = 0, VaultLevel = 1 }
	local total = sparks.Vault + sparks.Exposed
	-- cassaforte
	local vcard = UI.Card(scroll, { Size = UDim2.new(1, -8, 0, 120), LayoutOrder = 1 })
	UI.Label(vcard, "🔒 Cassaforte", { Font = UI.Theme.Font, TextSize = 20, Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(12, 8), ZIndex = 13 })
	local nextLevel = sparks.VaultLevel + 1
	local vcost = Config.Vault.UpgradeCosts[nextLevel]
	UI.Label(vcard, string.format("Livello %d · capienza %s%s", sparks.VaultLevel, Format.Number(Config.Vault.Capacities[sparks.VaultLevel]), vcost and (" → " .. Format.Number(Config.Vault.Capacities[nextLevel])) or " (massimo)"), { TextSize = 15, Size = UDim2.new(1, -200, 0, 40), Position = UDim2.fromOffset(12, 40), ZIndex = 13 })
	UI.Label(vcard, "Le scintille depositate non possono essere sottratte.", { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.new(1, -200, 0, 30), Position = UDim2.fromOffset(12, 82), ZIndex = 13 })
	if vcost then
		local b = UI.Button(vcard, string.format("Potenzia · %s ✦", Format.Number(vcost)), function()
			local ok, msg = Net.Invoke("UpgradeVault")
			if ok then
				renderUpgrades()
			else
				Toast.Show(msg or Strings.Error, "warning")
			end
		end, { Size = UDim2.fromOffset(180, 48), Position = UDim2.new(1, -192, 0.5, -24), Color = total >= vcost and C.AccentDark or C.TextMuted, TextSize = 15 })
		b.ZIndex = 13
	end
	-- espansione vivaio
	local pcard = UI.Card(scroll, { Size = UDim2.new(1, -8, 0, 120), LayoutOrder = 2 })
	local plotLevel = State.Get("PlotLevel") or 1
	local pnext = plotLevel + 1
	local pcost = Config.PlotSlots.UpgradeCosts[pnext]
	UI.Label(pcard, "🌿 Espansione del vivaio", { Font = UI.Theme.Font, TextSize = 20, Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(12, 8), ZIndex = 13 })
	UI.Label(pcard, string.format("Livello %d · %d creature esponibili%s", plotLevel, Config.PlotSlots.Capacities[plotLevel], pcost and (" → " .. Config.PlotSlots.Capacities[pnext]) or " (massimo)"), { TextSize = 15, Size = UDim2.new(1, -200, 0, 40), Position = UDim2.fromOffset(12, 40), ZIndex = 13 })
	UI.Label(pcard, "Oltre la sesta creatura il rendimento marginale cala: varietà, non quantità.", { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.new(1, -200, 0, 30), Position = UDim2.fromOffset(12, 82), ZIndex = 13 })
	if pcost then
		local b = UI.Button(pcard, string.format("Amplia · %s ✦", Format.Number(pcost)), function()
			local ok, msg = Net.Invoke("UpgradePlot")
			if ok then
				renderUpgrades()
			else
				Toast.Show(msg or Strings.Error, "warning")
			end
		end, { Size = UDim2.fromOffset(180, 48), Position = UDim2.new(1, -192, 0.5, -24), Color = total >= pcost and C.AccentDark or C.TextMuted, TextSize = 15 })
		b.ZIndex = 13
	end
	-- importa codice layout
	local icard = UI.Card(scroll, { Size = UDim2.new(1, -8, 0, 110), LayoutOrder = 3 })
	UI.Label(icard, "🔗 Importa un layout dalla galleria", { Font = UI.Theme.Font, TextSize = 20, Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(12, 8), ZIndex = 13 })
	local box = UI.TextBox(icard, "Codice (es. NV-1A2B3)", { Size = UDim2.new(1, -220, 0, 44), Position = UDim2.fromOffset(12, 50) })
	local ib = UI.Button(icard, Strings.GalleryImport, function()
		local ok, res = Net.Invoke("ImportLayoutCode", box.Text)
		if ok and type(res) == "table" then
			Build.Start()
			Build.SetLayout(res.Layout)
			if #res.Missing > 0 then
				Toast.Show("Moduli da sbloccare: " .. table.concat(res.Missing, ", "), "warning")
			else
				Toast.Show("Layout importato nell'editor: pubblica per attivarlo", "success")
			end
			refreshStatus()
		else
			Toast.Show(type(res) == "string" and res or Strings.Error, "warning")
		end
	end, { Size = UDim2.fromOffset(190, 44), Position = UDim2.new(1, -202, 0, 50), Color = C.Info, TextSize = 15 })
	ib.ZIndex = 13
end

local renderers = { creatures = renderCreatures, defenses = renderDefenses, decorations = renderDecorations, upgrades = renderUpgrades }

-- ───────────────────────── toolbar di posizionamento ─────────────────────────

local function buildToolbar(screenGui)
	toolbar = UI.Frame(screenGui, { Name = "BuildToolbar", BackgroundColor3 = C.PanelDark, BackgroundTransparency = 0.1, Size = UDim2.new(0, 760, 0, 96), Position = UDim2.new(0.5, 0, 1, -16), AnchorPoint = Vector2.new(0.5, 1), Visible = false, ZIndex = 20 })
	UI.Corner(toolbar, UDim.new(0, 18))
	UI.Stroke(toolbar, C.Accent, 2)
	toolbarLabel = UI.Label(toolbar, "", { Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(14, 6), TextColor3 = C.TextOnDark, Font = UI.Theme.FontBold, TextSize = 15, ZIndex = 21 })
	toolbarStatus = UI.Label(toolbar, "", { Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(14, 26), TextColor3 = C.TextOnDark, TextSize = 13, ZIndex = 21 })
	local row = UI.Frame(toolbar, { BackgroundTransparency = 1, Size = UDim2.new(1, -24, 0, 42), Position = UDim2.fromOffset(12, 48), ZIndex = 21 })
	UI.List(row, Enum.FillDirection.Horizontal, 8)
	local function tb(text, fn, color, order)
		local b = UI.Button(row, text, fn, { Size = UDim2.new(0, 118, 1, 0), Color = color, LayoutOrder = order, TextSize = 14 })
		b.ZIndex = 22
		return b
	end
	tb("📋 Menu", function()
		panel:Open()
	end, C.Info, 1)
	tb("↻ " .. Strings.BuildRotate, function()
		Build.Rotate()
	end, C.PanelDark, 2)
	tb("✋ Modifica", function()
		Build.Enter("edit")
	end, C.PanelDark, 3)
	tb("✔ " .. Strings.BuildPublish, function()
		if Build.Publish() then
			Audio.Play("Success")
		end
	end, C.Success, 4)
	tb("▶ " .. Strings.BuildTest, function()
		local ok, msg = Net.Invoke("StartLayoutTest")
		if not ok then
			Toast.Show(msg or Strings.Error, "warning")
		else
			Build.Stop()
		end
	end, C.AccentDark, 5)
	tb("✕ Esci", function()
		Build.Stop()
	end, C.Danger, 6)
end

local function describeMode(mode, payload)
	if mode == "module" then
		local def = Defenses.Get(payload.Id)
		return "Posiziona: " .. (def and def.Name or payload.Id) .. "  ·  " .. Strings.BuildPlaceHint
	elseif mode == "creature" then
		local c = (State.Get("Creatures") or {})[payload.Uid]
		local def = c and Creatures.Get(c.Id)
		return "Posiziona: " .. (def and def.Name or "creatura") .. "  ·  tocca una cella libera"
	elseif mode == "decoration" then
		local def = Decorations.ById[payload.Id]
		return "Posiziona: " .. (def and def.Name or payload.Id) .. "  ·  " .. Strings.BuildPlaceHint
	end
	return "Modalità modifica: tocca un modulo per rimuoverlo, una creatura per spostarla, una decorazione per toglierla"
end

-- ───────────────────────── init ─────────────────────────

function BuildPanel.Init(screenGui)
	panel = UI.Panel(screenGui, "🔨 " .. Strings.BuildTitle)
	local content = panel.Content
	statusBar = UI.Frame(content, { BackgroundColor3 = C.PanelAlt, Size = UDim2.new(1, 0, 0, 74), ZIndex = 12 })
	UI.Corner(statusBar)
	energyBar = UI.Progress(statusBar, { Size = UDim2.new(0.45, -16, 0, 20), Position = UDim2.fromOffset(12, 10), FillColor = C.Accent })
	slotsLabel = UI.Label(statusBar, "", { Size = UDim2.new(0.55, -16, 0, 20), Position = UDim2.new(0.45, 8, 0, 10), TextSize = 13, ZIndex = 13 })
	pathLabel = UI.Label(statusBar, "", { Size = UDim2.new(0.6, -16, 0, 22), Position = UDim2.fromOffset(12, 40), TextSize = 14, Font = UI.Theme.FontBold, ZIndex = 13 })
	local actions = UI.Frame(statusBar, { BackgroundTransparency = 1, Size = UDim2.new(0.4, 0, 0, 30), Position = UDim2.new(0.6, 0, 0, 38), ZIndex = 13 })
	UI.List(actions, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right)
	local function ab(text, fn, color, order)
		local b = UI.Button(actions, text, fn, { Size = UDim2.new(0, 112, 1, 0), Color = color, LayoutOrder = order, TextSize = 12, Corner = UI.Theme.CornerSmall })
		b.ZIndex = 14
	end
	ab(Strings.BuildPublish, function()
		Build.Start()
		if Build.Publish() then
			Audio.Play("Success")
			refreshStatus()
		end
	end, C.Success, 1)
	ab(Strings.BuildTest, function()
		local ok, msg = Net.Invoke("StartLayoutTest")
		if ok then
			panel:Close()
			Build.Stop()
		else
			Toast.Show(msg or Strings.Error, "warning")
		end
	end, C.AccentDark, 2)
	ab("Ripristina", function()
		Build.Start()
		Build.RestoreLastValid()
		refreshStatus()
	end, C.Info, 3)
	ab(Strings.BuildClear, function()
		Build.Start()
		Build.Clear()
		refreshStatus()
	end, C.Danger, 4)

	tabs = UI.Tabs(content, {
		{ Id = "creatures", Label = "🐣 " .. Strings.BuildCreatures },
		{ Id = "defenses", Label = "🛡 " .. Strings.BuildDefenses },
		{ Id = "decorations", Label = "🌸 " .. Strings.BuildDecor },
		{ Id = "upgrades", Label = "⬆ Potenziamenti" },
	}, function(name)
		currentTab = name
		renderers[name]()
	end, { Position = UDim2.fromOffset(0, 82) })
	body = UI.Frame(content, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -136), Position = UDim2.fromOffset(0, 136), ZIndex = 12 })

	panel.OnOpen = function()
		if playerAtHome() then
			Build.Start()
		end
		tabs:Select(currentTab)
		refreshStatus()
	end

	buildToolbar(screenGui)
	Build.Toast = Toast.Show
	Build.Changed:Connect(function(result)
		refreshStatus(result)
	end)
	Build.ModeChanged:Connect(function(mode, payload)
		toolbar.Visible = mode ~= nil
		if mode then
			toolbarLabel.Text = describeMode(mode, payload)
			refreshStatus()
		end
	end)
	State.Changed:Connect(function(key)
		if panel.IsOpen and (key == "Creatures" or key == "UnlockedModules" or key == "Decorations" or key == "Sparks" or key == "PlotLevel" or key == "ModuleAlternative" or key == "StyleTokens" or key == "UnlockedVariants") then
			renderers[currentTab]()
		end
	end)
end

function BuildPanel.Open()
	if not playerAtHome() then
		Toast.Show("Torna nel tuo vivaio per costruire (pad HUB → Torna al tuo vivaio)", "warning")
	end
	panel:Open()
end

function BuildPanel.Close()
	panel:Close()
end

function BuildPanel.Toggle()
	if panel.IsOpen then
		panel:Close()
	else
		BuildPanel.Open()
	end
end

return BuildPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">CocoonPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Bozzoli: scelta deterministica della famiglia, anteprima esplicita del percorso di sblocco.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Creatures = require(Shared.Catalog.Creatures)
local Net = require(Shared.Util.Net)
local CreatureModel = require(Shared.Models.CreatureModel)
local UI = require(script.Parent.UI)
local Toast = require(script.Parent.Toast)
local State = require(script.Parent.Parent.Controllers.State)

local CocoonPanel = {}
local C = UI.Colors
local panel, body

local function render()
	body:ClearAllChildren()
	local scroll = UI.Scroll(body)
	UI.List(scroll, Enum.FillDirection.Vertical, 10)
	UI.Padding(scroll, 6)
	local cocoon = State.Get("Cocoon") or {}
	local fragments = State.Get("Fragments") or 0
	UI.Label(scroll, string.format("💎 Frammenti di cielo: %d  ·  " .. Strings.CocoonCost, fragments, Config.Cocoon.FragmentCost), { Font = UI.Theme.FontBold, TextSize = 15, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 0, ZIndex = 13 })
	if cocoon.Active then
		local a = cocoon.Active
		local def = Creatures.Get(a.CreatureId)
		local card = UI.Card(scroll, { Size = UDim2.new(1, -8, 0, 170), LayoutOrder = 1, BackgroundColor3 = Color3.fromRGB(255, 245, 225) })
		UI.Viewport(card, CreatureModel.Build(a.CreatureId, "base", nil), { Size = UDim2.fromOffset(150, 150), Position = UDim2.fromOffset(10, 10) })
		UI.Label(card, "🥚 " .. Strings.CocoonActive .. " · " .. Strings.Family[a.Family], { Font = UI.Theme.Font, TextSize = 20, Size = UDim2.new(1, -180, 0, 28), Position = UDim2.fromOffset(170, 10), ZIndex = 13 })
		UI.Label(card, string.format("Si schiuderà in: <b>%s</b> (%s)", def and def.Name or "?", Strings.Rarity[def and def.Rarity or "comune"]), { TextSize = 15, Size = UDim2.new(1, -180, 0, 24), Position = UDim2.fromOffset(170, 42), ZIndex = 13 })
		UI.Label(card, Strings.CocoonPath .. ": " .. a.GoalText, { TextSize = 15, Size = UDim2.new(1, -180, 0, 24), Position = UDim2.fromOffset(170, 68), ZIndex = 13 })
		local bar = UI.Progress(card, { Size = UDim2.new(1, -190, 0, 22), Position = UDim2.fromOffset(170, 100), FillColor = C.Accent })
		bar:Set(a.Progress, a.Target)
		UI.Label(card, "Continua a giocare: il progresso si aggiorna da solo.", { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.new(1, -180, 0, 24), Position = UDim2.fromOffset(170, 130), ZIndex = 13 })
	end
	UI.Label(scroll, Strings.CocoonChoose .. " — vedrai prima quale creatura otterrai e cosa serve per sbloccarla. Nessuna casualità, nessun doppione.", { TextSize = 14, TextColor3 = C.TextMuted, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 2, ZIndex = 13 })
	local grid = UI.Frame(scroll, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 300), LayoutOrder = 3, ZIndex = 12 })
	UI.Grid(grid, UDim2.new(0.25, -10, 0, 290), 10)
	for i, family in ipairs(Creatures.Families) do
		local info = Creatures.FamilyInfo[family]
		local card = UI.Card(grid, { LayoutOrder = i })
		UI.Gradient(card, Color3.new(1, 1, 1), C.Family[family], 90)
		UI.Label(card, Strings.Family[family], { Font = UI.Theme.Font, TextSize = 22, Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 8), ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Center })
		UI.Label(card, info.Description, { TextSize = 13, Size = UDim2.new(1, -16, 0, 36), Position = UDim2.fromOffset(8, 40), ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Center })
		local preview = Net.Invoke("GetCocoonPreview", family)
		if type(preview) == "table" and not preview.Complete then
			UI.Viewport(card, CreatureModel.Build(preview.CreatureId, "base", nil), { Size = UDim2.new(1, -16, 0, 110), Position = UDim2.fromOffset(8, 80), BackgroundTransparency = 0.3 })
			UI.Label(card, string.format("<b>%s</b> · %s", preview.CreatureName, Strings.Rarity[preview.Rarity]), { TextSize = 14, Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 194), ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Center })
			UI.Label(card, "🎯 " .. preview.Goal.Text, { TextSize = 12, TextColor3 = C.TextMuted, Size = UDim2.new(1, -16, 0, 32), Position = UDim2.fromOffset(8, 214), ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Center })
			local canStart = not cocoon.Active and preview.CanAfford
			local b = UI.Button(card, cocoon.Active and "Bozzolo in corso" or (preview.CanAfford and string.format("Avvia · 💎 %d", preview.Cost) or Strings.CocoonNoFragments), function()
				if not canStart then
					return
				end
				local ok, msg = Net.Invoke("StartCocoon", family)
				if ok then
					render()
				else
					Toast.Show(msg or Strings.Error, "warning")
				end
			end, { Size = UDim2.new(1, -16, 0, 38), Position = UDim2.fromOffset(8, 246), Color = canStart and C.Success or C.TextMuted, TextSize = 14 })
			b.ZIndex = 13
		else
			UI.Label(card, "✔ " .. Strings.CocoonFamilyComplete, { Font = UI.Theme.FontBold, TextSize = 16, Size = UDim2.new(1, -16, 0, 60), Position = UDim2.fromOffset(8, 120), ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.Success })
		end
	end
	UI.Label(scroll, "I frammenti si ottengono da commissioni, album e maestria. Non sono in vendita.", { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 4, ZIndex = 13 })
end

function CocoonPanel.Init(screenGui)
	panel = UI.Panel(screenGui, "🥚 " .. Strings.CocoonTitle)
	body = UI.Frame(panel.Content, { BackgroundTransparency = 1, ZIndex = 12 })
	panel.OnOpen = render
	State.Changed:Connect(function(key)
		if panel.IsOpen and (key == "Cocoon" or key == "Fragments" or key == "OwnedCreatureIds") then
			render()
		end
	end)
end

function CocoonPanel.Toggle()
	panel:Toggle()
end
function CocoonPanel.Open()
	panel:Open()
end
function CocoonPanel.Close()
	panel:Close()
end

return CocoonPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">CommissionPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Commissioni del giorno + sfida del tema settimanale.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Strings = require(Shared.Strings)
local Themes = require(Shared.Catalog.Themes)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Util.Net)
local UI = require(script.Parent.UI)
local Toast = require(script.Parent.Toast)
local State = require(script.Parent.Parent.Controllers.State)

local CommissionPanel = {}
local C = UI.Colors
local panel, list, resetLabel
local CATEGORY = { raccolta = { "✦", "Raccolta", C.Accent }, costruzione = { "🔨", "Costruzione", C.Info }, visita = { "🖼", "Visita", C.Token }, incursione = { "🌀", "Incursione", C.Danger } }

local function rewardText(r)
	local parts = {}
	if r.Sparks then
		table.insert(parts, "✦ " .. r.Sparks)
	end
	if r.Fragments then
		table.insert(parts, "💎 " .. r.Fragments)
	end
	table.insert(parts, "🎨 5")
	return table.concat(parts, "   ")
end

local function render()
	list:ClearAllChildren()
	UI.List(list, Enum.FillDirection.Vertical, 10)
	UI.Padding(list, 6)
	local data = State.Get("Commissions")
	if not data then
		return
	end
	for i, c in ipairs(data.List) do
		local cat = CATEGORY[c.Category] or { "•", c.Category, C.Info }
		local card = UI.Card(list, { Size = UDim2.new(1, -8, 0, 112), LayoutOrder = i })
		UI.Label(card, cat[1], { Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(10, 10), TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 13 })
		UI.Pill(card, cat[2], cat[3], { Position = UDim2.fromOffset(8, 58), Size = UDim2.fromOffset(90, 20) })
		UI.Label(card, c.Text, { Font = UI.Theme.Font, TextSize = 18, Size = UDim2.new(1, -340, 0, 26), Position = UDim2.fromOffset(110, 10), ZIndex = 13 })
		UI.Label(card, rewardText(c.Reward), { TextSize = 14, TextColor3 = C.TextMuted, Size = UDim2.new(1, -340, 0, 20), Position = UDim2.fromOffset(110, 38), ZIndex = 13 })
		local bar = UI.Progress(card, { Size = UDim2.new(1, -340, 0, 18), Position = UDim2.fromOffset(110, 66), FillColor = c.Complete and C.Success or C.Info })
		bar:Set(c.Progress, c.Target)
		if c.Claimed then
			local b = UI.Button(card, "✔ " .. Strings.CommissionClaimed, nil, { Size = UDim2.fromOffset(200, 44), Position = UDim2.new(1, -212, 0, 12), Color = C.TextMuted })
			b.ZIndex = 13
		elseif c.Complete then
			local b = UI.Button(card, "🎁 " .. Strings.CommissionClaim, function()
				local ok, msg = Net.Invoke("ClaimCommission", c.Index)
				if not ok then
					Toast.Show(msg or Strings.Error, "warning")
				end
			end, { Size = UDim2.fromOffset(200, 44), Position = UDim2.new(1, -212, 0, 12), Color = C.Success })
			b.ZIndex = 13
		else
			local b = UI.Button(card, data.RerollAvailable and ("↺ " .. Strings.CommissionReroll) or Strings.CommissionRerollUsed, function()
				if not data.RerollAvailable then
					return
				end
				local ok, msg = Net.Invoke("RerollCommission", c.Index)
				if not ok then
					Toast.Show(msg or Strings.Error, "warning")
				end
			end, { Size = UDim2.fromOffset(200, 44), Position = UDim2.new(1, -212, 0, 12), Color = data.RerollAvailable and C.Info or C.TextMuted, TextSize = 13 })
			b.ZIndex = 13
		end
		UI.Label(card, "Nessuna commissione richiede di colpire giocatori reali", { TextSize = 11, TextColor3 = C.TextMuted, Size = UDim2.fromOffset(200, 30), Position = UDim2.new(1, -212, 0, 62), ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Center })
	end
	-- tema settimanale
	local info = State.Get("ServerInfo")
	local wp = info and info.WeeklyProgress
	local theme = info and Themes.ById[info.ThemeId]
	if theme and wp then
		local card = UI.Card(list, { Size = UDim2.new(1, -8, 0, 120), LayoutOrder = 50, BackgroundColor3 = Color3.fromRGB(235, 228, 255) })
		UI.Label(card, "🌤 " .. Strings.WeeklyTheme .. ": " .. theme.Name, { Font = UI.Theme.Font, TextSize = 18, Size = UDim2.new(1, -240, 0, 26), Position = UDim2.fromOffset(12, 8), ZIndex = 13 })
		UI.Label(card, theme.Description .. "\n" .. Strings.WeeklyChallenge .. ": " .. theme.Challenge.Text, { TextSize = 13, Size = UDim2.new(1, -240, 0, 44), Position = UDim2.fromOffset(12, 34), ZIndex = 13, TextYAlignment = Enum.TextYAlignment.Top })
		local bar = UI.Progress(card, { Size = UDim2.new(1, -240, 0, 18), Position = UDim2.fromOffset(12, 86), FillColor = C.Token })
		bar:Set(wp.Progress, wp.Target)
		local rewardLabel = theme.Challenge.Reward.Tokens and ("🎨 " .. theme.Challenge.Reward.Tokens) or "Cosmetico esclusivo"
		local b = UI.Button(card, wp.Claimed and "✔ Riscossa" or ((wp.Progress >= wp.Target) and ("🎁 Riscuoti " .. rewardLabel) or (rewardLabel .. " · " .. Format.Time(wp.SecondsToNextWeek))), function()
			if wp.Claimed or wp.Progress < wp.Target then
				return
			end
			local ok, msg = Net.Invoke("ClaimWeeklyChallenge")
			if not ok then
				Toast.Show(msg or Strings.Error, "warning")
			end
		end, { Size = UDim2.fromOffset(210, 44), Position = UDim2.new(1, -222, 0, 12), Color = (wp.Claimed and C.TextMuted) or ((wp.Progress >= wp.Target) and C.Success or C.Token), TextSize = 13 })
		b.ZIndex = 13
	end
	resetLabel.Text = string.format(Strings.CommissionReset, Format.Time(data.SecondsToReset or 0))
end

function CommissionPanel.Init(screenGui)
	panel = UI.Panel(screenGui, "📋 " .. Strings.CommissionsTitle, UDim2.new(0.8, 0, 0.8, 0))
	resetLabel = UI.Label(panel.Content, "", { TextSize = 14, TextColor3 = C.TextMuted, Size = UDim2.new(1, 0, 0, 22), ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Right })
	list = UI.Scroll(panel.Content, { Size = UDim2.new(1, 0, 1, -26), Position = UDim2.fromOffset(0, 26) })
	panel.OnOpen = render
	State.Changed:Connect(function(key)
		if panel.IsOpen and (key == "Commissions" or key == "ServerInfo" or key == "WeeklyChallengeClaimed") then
			render()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(30)
			if panel.IsOpen then
				local data = State.Get("Commissions")
				if data and data.SecondsToReset then
					data.SecondsToReset -= 30
					resetLabel.Text = string.format(Strings.CommissionReset, Format.Time(data.SecondsToReset))
				end
			end
		end
	end)
end

function CommissionPanel.Toggle()
	panel:Toggle()
end
function CommissionPanel.Open()
	panel:Open()
end
function CommissionPanel.Close()
	panel:Close()
end

return CommissionPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">DemoPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Vivaio dimostrativo: spiega cosa mostra e come leggere un layout.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Strings = require(Shared.Strings)
local Simulated = require(Shared.Catalog.SimulatedVivai)
local Defenses = require(Shared.Catalog.Defenses)
local Creatures = require(Shared.Catalog.Creatures)
local UI = require(script.Parent.UI)

local DemoPanel = {}
local panel

function DemoPanel.Init(screenGui)
	panel = UI.Panel(screenGui, "🏝 " .. Strings.PromptDemo, UDim2.new(0.6, 0, 0.7, 0))
	local content = panel.Content
	local scroll = UI.Scroll(content)
	UI.List(scroll, Enum.FillDirection.Vertical, 8)
	UI.Padding(scroll, 6)
	local demo = Simulated.ByKey.sim_faro
	UI.Label(scroll, "Questo vivaio mostra come si legge un layout: l'incursore entra dall'INGRESSO, raggiunge la pozza al centro ed esce dall'USCITA. Ogni layout deve lasciare almeno un percorso completabile.", { TextSize = 15, Size = UDim2.new(1, 0, 0, 70), LayoutOrder = 1, ZIndex = 13 })
	UI.Label(scroll, "Moduli esposti", { Font = UI.Theme.Font, TextSize = 18, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 2, ZIndex = 13 })
	for i, m in ipairs(demo.Layout.Modules) do
		local def = Defenses.Get(m.Id)
		if def then
			UI.Label(scroll, string.format("• <b>%s</b> (%s, ⚡%d): %s", def.Name, Defenses.CategoryNames[def.Category], def.Energy, def.Description), { TextSize = 14, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 10 + i, ZIndex = 13 })
		end
	end
	UI.Label(scroll, "Creature in mostra", { Font = UI.Theme.Font, TextSize = 18, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 30, ZIndex = 13 })
	for i, c in ipairs(demo.Creatures) do
		local def = Creatures.Get(c.Id)
		if def then
			UI.Label(scroll, string.format("• <b>%s</b> · %s · %s — %s", def.Name, Strings.Family[def.Family], Strings.Rarity[def.Rarity], def.Description), { TextSize = 14, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 30 + i, ZIndex = 13 })
		end
	end
	UI.Label(scroll, "Suggerimento: nel tuo vivaio apri Costruisci → Difese, posiziona un modulo e usa «Prova il percorso» per testarlo gratis.", { TextSize = 14, TextColor3 = UI.Colors.TextMuted, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 60, ZIndex = 13 })
end

function DemoPanel.Open()
	panel:Open()
end
function DemoPanel.Close()
	panel:Close()
end

return DemoPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">GalleryPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Galleria dei vivai pubblicati: visita, «mi piace», codici layout.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Strings = require(Shared.Strings)
local Cosmetics = require(Shared.Catalog.Cosmetics)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Util.Net)
local UI = require(script.Parent.UI)
local Toast = require(script.Parent.Toast)

local GalleryPanel = {}
local C = UI.Colors
local panel, body, header

local function render()
	body:ClearAllChildren()
	header:ClearAllChildren()
	local data = Net.Invoke("GetGallery")
	if type(data) ~= "table" then
		UI.Label(body, Strings.Error, { ZIndex = 13 })
		return
	end
	UI.Label(header, string.format(Strings.GalleryCode, data.MyCode) .. (data.Published and "" or "  ·  pubblica un layout per apparire in galleria"), { Font = UI.Theme.FontBold, TextSize = 14, Size = UDim2.new(0.6, 0, 1, 0), ZIndex = 13 })
	UI.Label(header, string.format("Ricompense di visita oggi: %d / %d", data.VisitsToday, data.VisitsMax), { TextSize = 14, TextColor3 = C.TextMuted, Size = UDim2.new(0.4, 0, 1, 0), Position = UDim2.fromScale(0.6, 0), ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Right })
	local scroll = UI.Scroll(body)
	UI.Grid(scroll, UDim2.fromOffset(240, 190), 10)
	UI.Padding(scroll, 6)
	if #data.List == 0 then
		UI.Label(scroll, Strings.GalleryEmpty, { Size = UDim2.fromOffset(600, 60), ZIndex = 13 })
		return
	end
	for i, e in ipairs(data.List) do
		local skin = Cosmetics.Get(e.Skin or "skin_prato")
		local card = UI.Card(scroll, { Size = UDim2.fromOffset(240, 190), LayoutOrder = i })
		local swatch = UI.Frame(card, { Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = skin and skin.Data.Color or C.Success, ZIndex = 13 })
		UI.Corner(swatch, UI.Theme.Corner)
		UI.Label(card, (e.Online and "🟢 " or "") .. e.Name .. (e.IsMine and " (tu)" or ""), { Font = UI.Theme.Font, TextSize = 17, Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 16), ZIndex = 13, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false })
		local plate = e.Nameplate and Cosmetics.Get(e.Nameplate)
		if plate and plate.Data.Text then
			UI.Pill(card, plate.Data.Text, plate.Data.Color or C.Info, { Position = UDim2.fromOffset(8, 42), Size = UDim2.fromOffset(100, 18) })
		end
		UI.Label(card, string.format("♥ %d   ·   difesa %s\n🐣 %d creature · 🛡 %d moduli", e.Likes, Format.Stars(e.Stars, 5), e.Creatures, e.Modules), { TextSize = 13, Size = UDim2.new(1, -16, 0, 44), Position = UDim2.fromOffset(8, 64), ZIndex = 13 })
		UI.Label(card, "Codice: " .. e.ShareCode, { TextSize = 12, TextColor3 = C.TextMuted, Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 108), ZIndex = 13 })
		if not e.IsMine then
			local v = UI.Button(card, "🚶 " .. Strings.GalleryVisit, function()
				local ok, msg = Net.Invoke("VisitVivaio", e.Key)
				if ok then
					panel:Close()
				else
					Toast.Show(msg or Strings.Error, "warning")
				end
			end, { Size = UDim2.new(0.5, -10, 0, 40), Position = UDim2.fromOffset(8, 138), Color = C.Info, TextSize = 14 })
			v.ZIndex = 13
			local l = UI.Button(card, e.LikedByMe and Strings.GalleryLiked or ("♡ " .. Strings.GalleryLike), function()
				local ok, msg = Net.Invoke("LikeVivaio", e.Key)
				if ok then
					render()
				else
					Toast.Show(msg or Strings.Error, "warning")
				end
			end, { Size = UDim2.new(0.5, -10, 0, 40), Position = UDim2.new(0.5, 2, 0, 138), Color = e.LikedByMe and C.TextMuted or C.Danger, TextSize = 14 })
			l.ZIndex = 13
		else
			UI.Label(card, "Il tuo vivaio", { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.new(1, -16, 0, 40), Position = UDim2.fromOffset(8, 138), ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Center })
		end
	end
end

function GalleryPanel.Init(screenGui)
	panel = UI.Panel(screenGui, "🖼 " .. Strings.GalleryTitle)
	header = UI.Frame(panel.Content, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), ZIndex = 12 })
	body = UI.Frame(panel.Content, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -30), Position = UDim2.fromOffset(0, 30), ZIndex = 12 })
	panel.OnOpen = render
end

function GalleryPanel.Toggle()
	panel:Toggle()
end
function GalleryPanel.Open()
	panel:Open()
end
function GalleryPanel.Close()
	panel:Close()
end

return GalleryPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	HUD: espone sempre le quattro informazioni richieste dal GDD (scintille da depositare,
	cassaforte, protezione, prossimo obiettivo), valute secondarie, menu principale con
	pulsanti grandi e azioni contestuali (Raccogli tutto / Deposita tutto).
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Themes = require(Shared.Catalog.Themes)
local Commissions = require(Shared.Catalog.Commissions)
local LayoutValidator = require(Shared.LayoutValidator)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Util.Net)
local UI = require(script.Parent.UI)
local State = require(script.Parent.Parent.Controllers.State)

local HUD = {}
local C = UI.Colors
local player = Players.LocalPlayer
local root, cards, menuButtons, contextFrame, currencyLabel, themeLabel, homeButton
local callbacks: any = {}

local MENU = {
	{ Id = "build", Icon = "🔨", Label = Strings.MenuBuild, Key = Enum.KeyCode.B },
	{ Id = "raid", Icon = "🌀", Label = Strings.MenuRaid, Key = Enum.KeyCode.N },
	{ Id = "board", Icon = "📋", Label = Strings.MenuCommissions, Key = Enum.KeyCode.C },
	{ Id = "album", Icon = "📖", Label = Strings.MenuAlbum, Key = Enum.KeyCode.V },
	{ Id = "cocoon", Icon = "🥚", Label = Strings.MenuCocoon, Key = Enum.KeyCode.K },
	{ Id = "gallery", Icon = "🖼", Label = Strings.MenuGallery, Key = Enum.KeyCode.L },
	{ Id = "shop", Icon = "🛍", Label = Strings.MenuShop, Key = Enum.KeyCode.P },
	{ Id = "settings", Icon = "⚙", Label = Strings.MenuSettings, Key = Enum.KeyCode.O },
}

local function infoCard(parent, icon, title, order, color)
	local card = UI.Frame(parent, { BackgroundColor3 = C.Panel, Size = UDim2.new(0.25, -8, 1, 0), LayoutOrder = order, ZIndex = 5, BackgroundTransparency = 0.05 })
	UI.Corner(card)
	UI.Stroke(card, color, 2, 0.2)
	UI.Label(card, icon, { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(8, 10), TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 6 })
	UI.Label(card, title, { Size = UDim2.new(1, -56, 0, 18), Position = UDim2.fromOffset(50, 6), TextSize = 12, TextColor3 = C.TextMuted, Font = UI.Theme.FontBold, ZIndex = 6 })
	local value = UI.Label(card, "—", { Size = UDim2.new(1, -56, 0, 30), Position = UDim2.fromOffset(50, 24), TextSize = 19, Font = UI.Theme.Font, ZIndex = 6, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false })
	return { Frame = card, Value = value }
end

function HUD.Init(screenGui, cb)
	callbacks = cb or {}
	root = UI.Frame(screenGui, { Name = "HUD", BackgroundTransparency = 1, ZIndex = 5 })

	-- barra superiore con le 4 informazioni
	local top = UI.Frame(root, { Name = "Top", BackgroundTransparency = 1, Size = UDim2.new(1, -40, 0, 62), Position = UDim2.fromOffset(20, 12), ZIndex = 5 })
	UI.List(top, Enum.FillDirection.Horizontal, 8)
	cards = {
		Exposed = infoCard(top, "✦", Strings.HudExposed, 1, C.Accent),
		Vault = infoCard(top, "🔒", Strings.HudVault, 2, C.Info),
		Protection = infoCard(top, "🛡", Strings.HudProtection, 3, C.Shield),
		Goal = infoCard(top, "🎯", Strings.HudNextGoal, 4, C.Success),
	}

	-- valute secondarie + tema
	local sub = UI.Frame(root, { Name = "Sub", BackgroundColor3 = C.PanelDark, BackgroundTransparency = 0.25, Size = UDim2.new(0, 420, 0, 28), Position = UDim2.new(1, -20, 0, 80), AnchorPoint = Vector2.new(1, 0), ZIndex = 5 })
	UI.Corner(sub, UDim.new(1, 0))
	currencyLabel = UI.Label(sub, "", { Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.fromOffset(14, 0), TextSize = 14, TextColor3 = C.TextOnDark, Font = UI.Theme.FontBold, ZIndex = 6 })
	themeLabel = UI.Label(sub, "", { Size = UDim2.new(0.5, -14, 1, 0), Position = UDim2.fromScale(0.5, 0), TextSize = 13, TextColor3 = C.TextOnDark, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 6 })

	-- menu a sinistra
	local menu = UI.Frame(root, { Name = "Menu", BackgroundTransparency = 1, Size = UDim2.new(0, 150, 0, #MENU * 54), Position = UDim2.new(0, 16, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 5 })
	UI.List(menu, Enum.FillDirection.Vertical, 6)
	menuButtons = {}
	for i, m in ipairs(MENU) do
		local b = UI.Button(menu, m.Icon .. "  " .. m.Label, function()
			if callbacks.OnMenu then
				callbacks.OnMenu(m.Id)
			end
		end, { Size = UDim2.new(1, 0, 0, 48), Color = C.PanelDark, LayoutOrder = i, TextSize = 16, Name = "Menu_" .. m.Id })
		b.TextXAlignment = Enum.TextXAlignment.Left
		UI.Padding(b, 0, 12, 0)
		b.ZIndex = 6
		b.BackgroundTransparency = 0.15
		menuButtons[m.Id] = b
	end

	-- azioni contestuali (in basso al centro)
	contextFrame = UI.Frame(root, { Name = "Context", BackgroundTransparency = 1, Size = UDim2.new(0, 420, 0, 56), Position = UDim2.new(0.5, 0, 1, -22), AnchorPoint = Vector2.new(0.5, 1), ZIndex = 5 })
	UI.List(contextFrame, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	local collectBtn = UI.Button(contextFrame, "✦ " .. Strings.CollectAll .. "  [F]", function()
		Net.Fire("CollectAll")
	end, { Size = UDim2.new(0.5, -5, 1, 0), Color = C.AccentDark, LayoutOrder = 1 })
	collectBtn.ZIndex = 6
	local depositBtn = UI.Button(contextFrame, "🔒 " .. Strings.DepositAll .. "  [G]", function()
		Net.Fire("DepositAll")
	end, { Size = UDim2.new(0.5, -5, 1, 0), Color = C.Info, LayoutOrder = 2 })
	depositBtn.ZIndex = 6

	homeButton = UI.Button(root, "🏠 " .. Strings.PromptHome, function()
		Net.Invoke("ReturnHome")
	end, { Size = UDim2.new(0, 260, 0, 48), Position = UDim2.new(0.5, 0, 1, -90), AnchorPoint = Vector2.new(0.5, 1), Color = C.Success, Visible = false })
	homeButton.ZIndex = 6

	-- scorciatoie tastiera
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.F then
			Net.Fire("CollectAll")
		elseif input.KeyCode == Enum.KeyCode.G then
			Net.Fire("DepositAll")
		else
			for _, m in ipairs(MENU) do
				if input.KeyCode == m.Key and callbacks.OnMenu then
					callbacks.OnMenu(m.Id)
				end
			end
		end
	end)

	-- posizione del giocatore: a casa, hub, raid, visita
	local function onLocation()
		local loc = player:GetAttribute("Location") or "hub"
		contextFrame.Visible = loc == "home"
		homeButton.Visible = loc == "hub" or loc == "visit"
		menu.Visible = loc ~= "raid"
	end
	player:GetAttributeChangedSignal("Location"):Connect(onLocation)
	onLocation()

	HUD.Bind()
end

local function protectionText()
	local raid = State.Get("Raid")
	local now = os.time()
	if raid and raid.ShieldUntil and raid.ShieldUntil > now then
		return string.format(Strings.ProtectionShield, Format.Time(raid.ShieldUntil - now)), C.Shield
	end
	if raid and raid.NewPlayerShield then
		return Strings.ProtectionNewbie, C.Shield
	end
	local layout = State.Get("LastValidLayout")
	if layout and layout.Modules and #layout.Modules > 0 then
		local res = LayoutValidator.Validate(layout, {})
		local stars = LayoutValidator.DifficultyStars(res.Difficulty or 0)
		return string.format(Strings.ProtectionLevel, Format.Stars(stars, 5)), C.Text
	end
	return Strings.ProtectionNone, C.Danger
end

local function goalText()
	local tut = State.Get("Tutorial")
	if tut and tut.Active and tut.Step <= Config.Tutorial.Steps then
		return string.format("Tutorial %d/%d", tut.Step, Config.Tutorial.Steps)
	end
	local comm = State.Get("Commissions")
	if comm and comm.List then
		for _, c in ipairs(comm.List) do
			if c.Complete and not c.Claimed then
				return "Riscuoti: " .. c.Text
			end
		end
		for _, c in ipairs(comm.List) do
			if not c.Claimed then
				return string.format("%s (%d/%d)", c.Text, c.Progress, c.Target)
			end
		end
	end
	local cocoon = State.Get("Cocoon")
	if cocoon and cocoon.Active then
		return string.format("Bozzolo: %s (%d/%d)", cocoon.Active.GoalText, cocoon.Active.Progress, cocoon.Active.Target)
	end
	return "Esplora la galleria dei vivai"
end

function HUD.Refresh()
	if not State.IsReady then
		return
	end
	local sparks = State.Get("Sparks") or { Exposed = 0, Vault = 0, VaultLevel = 1 }
	local cap = Config.Vault.Capacities[sparks.VaultLevel] or 0
	cards.Exposed.Value.Text = Format.Number(sparks.Exposed)
	cards.Exposed.Value.TextColor3 = sparks.Exposed > 0 and C.AccentDark or C.Text
	cards.Vault.Value.Text = string.format("%s / %s", Format.Number(sparks.Vault), Format.Number(cap))
	cards.Vault.Value.TextColor3 = sparks.Vault >= cap and C.Danger or C.Text
	local pt, pc = protectionText()
	cards.Protection.Value.Text = pt
	cards.Protection.Value.TextColor3 = pc
	cards.Goal.Value.Text = goalText()
	currencyLabel.Text = string.format("💎 %d   🎨 %d", State.Get("Fragments") or 0, State.Get("StyleTokens") or 0)
	local info = State.Get("ServerInfo")
	if info and info.ThemeId then
		local theme = Themes.ById[info.ThemeId]
		themeLabel.Text = theme and ("🌤 " .. theme.Name) or ""
	end
end

function HUD.Bind()
	State.Changed:Connect(function()
		HUD.Refresh()
	end)
	State.OnReady(HUD.Refresh)
	-- timer scudo
	task.spawn(function()
		while true do
			task.wait(1)
			HUD.Refresh()
		end
	end)
end

function HUD.SetVisible(visible)
	if root then
		root.Visible = visible
	end
end

function HUD.CardPosition(name)
	local card = cards and cards[name]
	if card then
		return card.Frame.AbsolutePosition + card.Frame.AbsoluteSize / 2
	end
	return Vector2.new(200, 40)
end

local highlightStrokes = {}
function HUD.Highlight(menuId, on)
	local b = menuButtons and menuButtons[menuId]
	if not b then
		return
	end
	local stroke = highlightStrokes[menuId]
	if not stroke then
		stroke = UI.Stroke(b, C.Accent, 3, 1)
		highlightStrokes[menuId] = stroke
	end
	stroke.Transparency = on and 0 or 1
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">RaidPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Incursioni: scelta del bersaglio, HUD durante il raid, riepilogo finale.
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Util.Net)
local UI = require(script.Parent.UI)
local Toast = require(script.Parent.Toast)
local State = require(script.Parent.Parent.Controllers.State)

local RaidPanel = {}
local C = UI.Colors
local panel, body, overlay, timerBar, objectiveLabel, titleLabel, flash, summaryPanel
local raidActive = false
local raidDuration, raidStart = 90, 0
local countdownLabel

local function render()
	body:ClearAllChildren()
	local scroll = UI.Scroll(body)
	UI.List(scroll, Enum.FillDirection.Vertical, 10)
	UI.Padding(scroll, 6)
	local loading = UI.Label(scroll, "Cerco vivai idonei…", { TextSize = 15, TextColor3 = C.TextMuted, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 0, ZIndex = 13 })
	task.spawn(function()
		local data, err = Net.Invoke("RequestRaidTargets")
		if not scroll.Parent then
			return
		end
		if type(data) ~= "table" then
			loading.Text = err or Strings.RaidNoTargets
			return
		end
		loading:Destroy()
		local raid = State.Get("Raid") or {}
		UI.Label(scroll, string.format("Incursioni: %d · riuscite: %d · difese respinte: %d", raid.Attempts or 0, raid.Successes or 0, raid.Defended or 0), { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 0, ZIndex = 13 })
		UI.Label(scroll, "Regole: durata 90 s · massimo 25% delle scintille esposte · in caso di errore torni al checkpoint, nessun combattimento · chi difende non perde mai creature né scintille depositate.", { TextSize = 13, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 1, ZIndex = 13 })
		for i, t in ipairs(data.Targets) do
			local card = UI.Card(scroll, { Size = UDim2.new(1, -8, 0, 120), LayoutOrder = 10 + i, BackgroundColor3 = t.Simulated and Color3.fromRGB(230, 240, 255) or C.PanelAlt })
			UI.Label(card, (t.Simulated and "🤖 " or "🏝 ") .. t.Name, { Font = UI.Theme.Font, TextSize = 19, Size = UDim2.new(1, -220, 0, 26), Position = UDim2.fromOffset(12, 8), ZIndex = 13 })
			UI.Label(card, string.format("%s: %s   ·   🛡 %d moduli   ·   fascia %d", Strings.RaidDifficulty, Format.Stars(t.Difficulty, 5), t.ModuleCount, t.Tier), { TextSize = 14, Size = UDim2.new(1, -220, 0, 22), Position = UDim2.fromOffset(12, 36), ZIndex = 13 })
			UI.Label(card, string.format("%s: ~%s   ·   %s: ✦ %s", Strings.RaidExposed, Format.Number(t.ExposedEstimate), Strings.RaidReward, Format.Number(t.MaxTake)), { TextSize = 14, Size = UDim2.new(1, -220, 0, 22), Position = UDim2.fromOffset(12, 60), ZIndex = 13 })
			UI.Label(card, t.Simulated and Strings.RaidSimulatedNote or "Giocatore reale · identità non mostrata · il bottino va nelle tue scintille esposte", { TextSize = 12, TextColor3 = C.TextMuted, Size = UDim2.new(1, -220, 0, 22), Position = UDim2.fromOffset(12, 88), ZIndex = 13 })
			local b = UI.Button(card, "🌀 " .. Strings.RaidStart, function()
				local ok, msg = Net.Invoke("StartRaid", t.Key)
				if ok then
					panel:Close()
				else
					Toast.Show(msg or Strings.Error, "warning")
					render()
				end
			end, { Size = UDim2.fromOffset(190, 52), Position = UDim2.new(1, -202, 0.5, -26), Color = t.Simulated and C.Info or C.Danger })
			b.ZIndex = 13
		end
		if data.Cooldown and data.Cooldown > 0 then
			UI.Label(scroll, string.format(Strings.RaidCooldown, data.Cooldown), { TextSize = 13, TextColor3 = C.Danger, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 5, ZIndex = 13 })
		end
		local rb = UI.Button(scroll, "↻ " .. Strings.RaidRefresh, render, { Size = UDim2.new(1, -8, 0, 44), LayoutOrder = 50, Color = C.PanelDark, TextSize = 14 })
		rb.ZIndex = 13
		-- storico recente (senza identità)
		if raid.History and #raid.History > 0 then
			UI.Label(scroll, "Riepiloghi recenti", { Font = UI.Theme.FontBold, TextSize = 15, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 60, ZIndex = 13 })
			for i = #raid.History, math.max(1, #raid.History - 5), -1 do
				local h = raid.History[i]
				local text
				if h.Type == "won" then
					text = string.format("✔ Incursione riuscita · +%d ✦%s", h.Amount, h.Simulated and " (simulata)" or "")
				elseif h.Type == "failed" then
					text = string.format("✖ Incursione respinta · +%d ✦ partecipazione", h.Amount)
				elseif h.Type == "defended" then
					text = string.format("🛡 La tua difesa ha respinto un'incursione · bonus +%d ✦", h.Amount)
				else
					text = string.format("⚠ Hai subito un'incursione · -%d ✦ · consolazione +%d", h.Amount, h.Consolation or 0)
				end
				UI.Label(scroll, text, { TextSize = 13, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 60 + (#raid.History - i) + 1, ZIndex = 13 })
			end
		end
	end)
end

-- ───────────────────────── HUD in-raid ─────────────────────────

local function buildOverlay(screenGui)
	overlay = UI.Frame(screenGui, { Name = "RaidOverlay", BackgroundTransparency = 1, Visible = false, ZIndex = 30 })
	local top = UI.Frame(overlay, { BackgroundColor3 = C.PanelDark, BackgroundTransparency = 0.15, Size = UDim2.new(0, 560, 0, 84), Position = UDim2.new(0.5, 0, 0, 86), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 31 })
	UI.Corner(top, UDim.new(0, 18))
	UI.Stroke(top, C.Danger, 2)
	titleLabel = UI.Label(top, "", { Size = UDim2.new(1, -24, 0, 24), Position = UDim2.fromOffset(12, 6), TextColor3 = C.TextOnDark, Font = UI.Theme.Font, TextSize = 18, ZIndex = 32 })
	objectiveLabel = UI.Label(top, "", { Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(12, 30), TextColor3 = C.Accent, Font = UI.Theme.FontBold, TextSize = 15, ZIndex = 32 })
	timerBar = UI.Progress(top, { Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(12, 58), FillColor = C.Success })
	timerBar.Frame.ZIndex = 32
	local abort = UI.Button(overlay, "✕ " .. Strings.PromptExitRaid, function()
		Net.Fire("RaidAbort")
	end, { Size = UDim2.fromOffset(220, 44), Position = UDim2.new(0.5, 0, 1, -20), AnchorPoint = Vector2.new(0.5, 1), Color = C.Danger, TextSize = 14 })
	abort.ZIndex = 32
	flash = UI.Frame(overlay, { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, ZIndex = 29 })
	countdownLabel = UI.Label(overlay, "", { Size = UDim2.new(1, 0, 0, 120), Position = UDim2.new(0, 0, 0.35, 0), Font = UI.Theme.Font, TextSize = 96, TextColor3 = C.Accent, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 33, TextStrokeTransparency = 0.3 })
end

local function flashScreen(color, alpha, duration)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = alpha
	TweenService:Create(flash, TweenInfo.new(duration or 0.6), { BackgroundTransparency = 1 }):Play()
end

local function showSummary(s)
	if summaryPanel then
		summaryPanel.Overlay:Destroy()
	end
	summaryPanel = UI.Panel(overlay.Parent, s.Success and ("✔ " .. Strings.RaidSuccess) or ("✖ " .. Strings.RaidFail), UDim2.new(0.5, 0, 0.6, 0))
	local content = summaryPanel.Content
	UI.List(content, Enum.FillDirection.Vertical, 8)
	UI.Padding(content, 8)
	local lines = {}
	if s.Test then
		table.insert(lines, Strings.RaidTestNote)
	end
	if s.Success then
		if not s.Test then
			table.insert(lines, string.format(Strings.RaidSummaryTake, s.Take) .. (s.Simulated and " (simulata, ricompensa ridotta)" or " → ora sono esposte: depositale!"))
		end
	else
		if s.Participation > 0 then
			table.insert(lines, string.format(Strings.RaidSummaryParticipation, s.Participation))
		end
	end
	if not s.Test then
		table.insert(lines, string.format(Strings.RaidSummaryMastery, s.Mastery))
	end
	table.insert(lines, string.format("Durata: %d s · checkpoint: %d", s.Duration, s.Checkpoints or 0))
	for _, f in ipairs(s.Feedback or {}) do
		table.insert(lines, "• " .. f)
	end
	for i, l in ipairs(lines) do
		UI.Label(content, l, { TextSize = 16, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = i, ZIndex = 13 })
	end
	local b = UI.Button(content, Strings.Close, function()
		summaryPanel:Close()
	end, { Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 99, Color = s.Success and C.Success or C.Info })
	b.ZIndex = 13
	summaryPanel:Open()
end

function RaidPanel.HandleEvent(name, payload)
	if name == "Start" then
		raidActive = true
		raidDuration = payload.Duration
		raidStart = os.clock() + (payload.Countdown or 0)
		overlay.Visible = true
		titleLabel.Text = string.format("%s · difficoltà %s%s", payload.TargetName, Format.Stars(payload.Difficulty or 1, 5), payload.Test and " · PROVA" or "")
		objectiveLabel.Text = Strings.RaidObjective1
		timerBar:Set(raidDuration, raidDuration, string.format(Strings.RaidTimer, raidDuration))
		-- conto alla rovescia
		task.spawn(function()
			for n = payload.Countdown or 3, 1, -1 do
				countdownLabel.Text = tostring(n)
				countdownLabel.TextTransparency = 0
				TweenService:Create(countdownLabel, TweenInfo.new(0.9), { TextTransparency = 1 }):Play()
				task.wait(1)
			end
			countdownLabel.Text = "VIA!"
			countdownLabel.TextTransparency = 0
			TweenService:Create(countdownLabel, TweenInfo.new(0.8), { TextTransparency = 1 }):Play()
		end)
	elseif name == "Go" then
		raidStart = os.clock()
	elseif name == "Collected" then
		objectiveLabel.Text = Strings.RaidObjective2
		flashScreen(C.Accent, 0.5, 0.5)
	elseif name == "Checkpoint" then
		flashScreen(C.Danger, 0.6, 0.5)
		Toast.Show(Strings.RaidCheckpoint .. (payload.Reason and (" (" .. payload.Reason .. ")") or ""), "warning")
	elseif name == "Spotted" then
		flashScreen(Color3.fromRGB(255, 250, 200), 0.3, 0.4)
	elseif name == "Dazzled" then
		flashScreen(Color3.new(1, 1, 1), 0.05, payload.Seconds or 3)
		Toast.Show(Strings.RaidDazzled, "warning")
	elseif name == "Bell" then
		Toast.Show("🔔 La campana del vento ha invertito le correnti!", "info")
	elseif name == "Summary" then
		raidActive = false
		overlay.Visible = false
		showSummary(payload)
	end
end

function RaidPanel.Init(screenGui)
	panel = UI.Panel(screenGui, "🌀 " .. Strings.RaidTitle)
	body = UI.Frame(panel.Content, { BackgroundTransparency = 1, ZIndex = 12 })
	panel.OnOpen = render
	buildOverlay(screenGui)
	task.spawn(function()
		while true do
			task.wait(0.1)
			if raidActive then
				local remaining = math.max(0, raidDuration - (os.clock() - raidStart))
				timerBar:Set(remaining, raidDuration, string.format(Strings.RaidTimer, math.ceil(remaining)))
				timerBar.Frame.Fill.BackgroundColor3 = remaining < 15 and C.Danger or (remaining < 40 and C.Accent or C.Success)
			end
		end
	end)
end

function RaidPanel.IsActive()
	return raidActive
end
function RaidPanel.Toggle()
	panel:Toggle()
end
function RaidPanel.Open()
	panel:Open()
end
function RaidPanel.Close()
	panel:Close()
end

return RaidPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">SettingsPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Opzioni: audio, effetti ridotti, deposito automatico, privacy galleria, tutorial.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Strings = require(Shared.Strings)
local Net = require(Shared.Util.Net)
local UI = require(script.Parent.UI)
local Toast = require(script.Parent.Toast)
local State = require(script.Parent.Parent.Controllers.State)
local Audio = require(script.Parent.Parent.Controllers.Audio)

local SettingsPanel = {}
local C = UI.Colors
local panel, body
SettingsPanel.ReducedEffectsChanged = nil -- callback impostata da Main

local function render()
	body:ClearAllChildren()
	local scroll = UI.Scroll(body)
	UI.List(scroll, Enum.FillDirection.Vertical, 8)
	UI.Padding(scroll, 6)
	local s = State.Get("Settings") or {}
	local function toggle(key, text, order, extra)
		UI.Toggle(scroll, text, s[key], function(v)
			Net.Fire("SetSetting", key, v)
			if extra then
				extra(v)
			end
		end, order)
	end
	toggle("AudioEnabled", "🔊 " .. Strings.SettingsAudio, 1, function(v)
		Audio.SetEnabled(v)
	end)
	toggle("ReducedEffects", "🌫 " .. Strings.SettingsReducedFx, 2, function(v)
		if SettingsPanel.ReducedEffectsChanged then
			SettingsPanel.ReducedEffectsChanged(v)
		end
	end)
	if State.Get("AutoDepositUnlocked") then
		toggle("AutoDeposit", "🔒 " .. Strings.SettingsAutoDeposit, 3)
	else
		local row = UI.Card(scroll, { Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 3 })
		UI.Label(row, "🔒 " .. Strings.SettingsAutoDeposit .. "  —  " .. Strings.SettingsAutoDepositLocked, { Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(14, 0), ZIndex = 13, TextColor3 = C.TextMuted })
	end
	toggle("HideProfile", "🙈 " .. Strings.SettingsHideProfile, 4)
	toggle("ShowName", "🏷 " .. Strings.SettingsShowName, 5)
	local tut = State.Get("Tutorial") or {}
	local b = UI.Button(scroll, "🎓 " .. Strings.SettingsReplayTutorial, function()
		local ok = Net.Invoke("TutorialAdvance", 0)
		if ok then
			panel:Close()
		end
	end, { Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 6, Color = C.Info })
	b.ZIndex = 13
	if tut.Active then
		local sk = UI.Button(scroll, "⏭ " .. Strings.TutorialSkip .. (tut.CompletedOnce and "" or " (disponibile dalla seconda volta)"), function()
			local ok, msg = Net.Invoke("TutorialSkip")
			if not ok then
				Toast.Show(msg or Strings.Error, "warning")
			end
		end, { Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 7, Color = tut.CompletedOnce and C.AccentDark or C.TextMuted })
		sk.ZIndex = 13
	end
	UI.Label(scroll, "Controlli: WASD/levetta per muoverti · E per interagire · F raccogli tutto · G deposita · B costruisci · R ruota · X modalità modifica · N incursione · C commissioni · V album · K bozzoli · L galleria · P negozio · O opzioni", { TextSize = 12, TextColor3 = C.TextMuted, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = 8, ZIndex = 13 })
	local info = State.Get("ServerInfo")
	if info and info.Mock then
		UI.Label(scroll, "⚠ Modalità Studio senza DataStore: i progressi non vengono salvati. Attiva «Enable Studio Access to API Services».", { TextSize = 12, TextColor3 = C.Danger, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 9, ZIndex = 13 })
	end
end

function SettingsPanel.Init(screenGui)
	panel = UI.Panel(screenGui, "⚙ " .. Strings.SettingsTitle, UDim2.new(0.6, 0, 0.8, 0))
	body = UI.Frame(panel.Content, { BackgroundTransparency = 1, ZIndex = 12 })
	panel.OnOpen = render
	State.Observe("Settings", function(s)
		Audio.SetEnabled(s.AudioEnabled ~= false)
		if SettingsPanel.ReducedEffectsChanged then
			SettingsPanel.ReducedEffectsChanged(s.ReducedEffects == true)
		end
	end)
end

function SettingsPanel.Toggle()
	panel:Toggle()
end
function SettingsPanel.Open()
	panel:Open()
end
function SettingsPanel.Close()
	panel:Close()
end

return SettingsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Bottega dello stile: cosmetici con gettoni (e Robux opzionali), Pass delle Nuvole trasparente.
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Cosmetics = require(Shared.Catalog.Cosmetics)
local Net = require(Shared.Util.Net)
local UI = require(script.Parent.UI)
local Toast = require(script.Parent.Toast)
local State = require(script.Parent.Parent.Controllers.State)

local ShopPanel = {}
local C = UI.Colors
local panel, tabs, body, tokensLabel
local current = "skin"
local priceCache = {}

local function robuxPrice(productId)
	if priceCache[productId] ~= nil then
		return priceCache[productId]
	end
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(productId, Enum.InfoType.Product)
	end)
	priceCache[productId] = ok and info and info.PriceInRobux or false
	return priceCache[productId]
end

local function renderSlot(slot)
	body:ClearAllChildren()
	local scroll = UI.Scroll(body)
	UI.Grid(scroll, UDim2.fromOffset(220, 170), 10)
	UI.Padding(scroll, 6)
	local cos = State.Get("Cosmetics") or { Owned = {}, Equipped = {} }
	local tokens = State.Get("StyleTokens") or 0
	local order = 0
	for _, c in ipairs(Cosmetics.List) do
		if c.Slot == slot then
			order += 1
			local owned = cos.Owned[c.Id] == true
			local equipped = cos.Equipped[slot] == c.Id
			local card = UI.Card(scroll, { Size = UDim2.fromOffset(220, 170), LayoutOrder = order, BackgroundColor3 = equipped and Color3.fromRGB(225, 245, 235) or C.PanelAlt })
			local swatchColor = c.Data.Color or c.Data.Tint or c.Data.Trim or C.Info
			local sw = UI.Frame(card, { Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = swatchColor, ZIndex = 13 })
			UI.Corner(sw, UDim.new(1, 0))
			if c.Data.Text then
				UI.Label(sw, c.Data.Text, { Size = UDim2.fromScale(1, 1), TextSize = 20, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 14 })
			end
			UI.Label(card, c.Name, { Font = UI.Theme.Font, TextSize = 16, Size = UDim2.new(1, -70, 0, 24), Position = UDim2.fromOffset(62, 10), ZIndex = 13 })
			UI.Label(card, c.Description, { TextSize = 12, TextColor3 = C.TextMuted, Size = UDim2.new(1, -70, 0, 40), Position = UDim2.fromOffset(62, 34), ZIndex = 13, TextYAlignment = Enum.TextYAlignment.Top })
			local y = 118
			if owned then
				local b = UI.Button(card, equipped and ("✔ " .. Strings.ShopEquipped) or Strings.ShopEquip, function()
					if not equipped then
						Net.Invoke("EquipCosmetic", c.Id)
					end
				end, { Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, y), Color = equipped and C.TextMuted or C.Success, TextSize = 14 })
				b.ZIndex = 13
			else
				local productId = Config.Monetization.CosmeticProducts[c.Id]
				local hasRobux = productId and productId ~= 0
				if c.TokenPrice then
					local b = UI.Button(card, string.format("🎨 " .. Strings.ShopBuyTokens, c.TokenPrice), function()
						local ok, msg = Net.Invoke("BuyCosmetic", c.Id)
						if not ok then
							Toast.Show(msg or Strings.Error, "warning")
						end
					end, { Size = UDim2.new(hasRobux and 0.5 or 1, -(hasRobux and 14 or 20), 0, 40), Position = UDim2.fromOffset(10, y), Color = tokens >= c.TokenPrice and C.Token or C.TextMuted, TextSize = 13 })
					b.ZIndex = 13
				else
					local src = ({ pass = "Pass delle Nuvole", founder = "Bundle fondatore", weekly = "Sfida settimanale", album = "Traguardo album" })[c.Source] or "Non in vendita"
					UI.Label(card, "Da: " .. src, { TextSize = 12, TextColor3 = C.TextMuted, Size = UDim2.new(hasRobux and 0.5 or 1, -20, 0, 40), Position = UDim2.fromOffset(10, y), ZIndex = 13 })
				end
				if hasRobux then
					local price = robuxPrice(productId)
					local b = UI.Button(card, price and ("R$ " .. price) or Strings.ShopBuyRobux, function()
						Net.Invoke("PromptPurchase", c.Id)
					end, { Size = UDim2.new(0.5, -14, 0, 40), Position = UDim2.new(0.5, 4, 0, y), Color = C.Success, TextSize = 13 })
					b.ZIndex = 13
				end
			end
		end
	end
end

local function renderPass()
	body:ClearAllChildren()
	local scroll = UI.Scroll(body)
	UI.List(scroll, Enum.FillDirection.Vertical, 8)
	UI.Padding(scroll, 6)
	local pass = State.Get("Pass") or { Points = 0, ClaimedFree = {}, ClaimedPremium = {}, Premium = false }
	UI.Label(scroll, Strings.ShopPassTitle .. string.format("  ·  %d punti", pass.Points), { Font = UI.Theme.Font, TextSize = 20, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 0, ZIndex = 13 })
	UI.Label(scroll, Strings.ShopPassNote .. ". Punti: +10 per commissione, +4 per incursione, +15 per traguardo album. Nessuna scadenza.", { TextSize = 13, TextColor3 = C.TextMuted, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 1, ZIndex = 13 })
	if not pass.Premium then
		local id = Config.Monetization.CosmeticPassGamePassId
		local b = UI.Button(scroll, id ~= 0 and "Sblocca la corsia Premium (solo estetica)" or "Corsia Premium: non disponibile in questa build", function()
			if id ~= 0 then
				pcall(function()
					MarketplaceService:PromptGamePassPurchase(game:GetService("Players").LocalPlayer, id)
				end)
			end
		end, { Size = UDim2.new(1, -8, 0, 44), LayoutOrder = 2, Color = id ~= 0 and C.Token or C.TextMuted, TextSize = 14 })
		b.ZIndex = 13
	end
	local function describe(r)
		if r.Tokens then
			return "🎨 " .. r.Tokens .. " gettoni"
		end
		if r.Cosmetic then
			local c = Cosmetics.Get(r.Cosmetic)
			return "✨ " .. (c and c.Name or r.Cosmetic)
		end
		return "—"
	end
	for i, tier in ipairs(Cosmetics.Pass.Tiers) do
		local reached = pass.Points >= tier.Points
		local freeClaimed = pass.ClaimedFree[tostring(i)] == true
		local premClaimed = pass.ClaimedPremium[tostring(i)] == true
		local card = UI.Card(scroll, { Size = UDim2.new(1, -8, 0, 70), LayoutOrder = 10 + i, BackgroundColor3 = reached and C.PanelAlt or Color3.fromRGB(225, 230, 240) })
		UI.Label(card, string.format("Livello %d · %d punti", i, tier.Points), { Font = UI.Theme.FontBold, TextSize = 15, Size = UDim2.fromOffset(170, 30), Position = UDim2.fromOffset(12, 6), ZIndex = 13 })
		UI.Label(card, "Gratis: " .. describe(tier.Free) .. (freeClaimed and " ✔" or ""), { TextSize = 13, Size = UDim2.fromOffset(260, 24), Position = UDim2.fromOffset(12, 36), ZIndex = 13 })
		UI.Label(card, "Premium: " .. describe(tier.Premium) .. (premClaimed and " ✔" or ""), { TextSize = 13, TextColor3 = C.Token, Size = UDim2.fromOffset(260, 24), Position = UDim2.fromOffset(290, 36), ZIndex = 13 })
		local claimable = reached and (not freeClaimed or (pass.Premium and not premClaimed))
		local b = UI.Button(card, claimable and "🎁 Riscuoti" or (reached and "✔ Riscosso" or "Bloccato"), function()
			if claimable then
				local ok, msg = Net.Invoke("ClaimPassTier", i)
				if not ok then
					Toast.Show(msg or Strings.Error, "warning")
				end
			end
		end, { Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -162, 0.5, -20), Color = claimable and C.Success or C.TextMuted, TextSize = 14 })
		b.ZIndex = 13
	end
end

function ShopPanel.Init(screenGui)
	panel = UI.Panel(screenGui, "🛍 " .. Strings.ShopTitle)
	tokensLabel = UI.Label(panel.Content, "", { Font = UI.Theme.FontBold, TextSize = 15, Size = UDim2.new(1, 0, 0, 22), ZIndex = 13 })
	tabs = UI.Tabs(panel.Content, {
		{ Id = "skin", Label = "🏝 Skin" }, { Id = "sky", Label = "🌅 Cieli" }, { Id = "trail", Label = "✨ Scie" }, { Id = "emote", Label = "🙂 Emote" }, { Id = "nameplate", Label = "🏷 Targhette" }, { Id = "pass", Label = "🎫 Pass" },
	}, function(name)
		current = name
		if name == "pass" then
			renderPass()
		else
			renderSlot(name)
		end
	end, { Position = UDim2.fromOffset(0, 26) })
	body = UI.Frame(panel.Content, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -104), Position = UDim2.fromOffset(0, 80), ZIndex = 12 })
	UI.Label(panel.Content, Strings.ShopEthics, { TextSize = 12, TextColor3 = C.TextMuted, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, -22), ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Center })
	panel.OnOpen = function()
		tokensLabel.Text = string.format(Strings.ShopTokens, State.Get("StyleTokens") or 0) .. "  ·  i gettoni si guadagnano con commissioni, album e maestria"
		tabs:Select(current)
	end
	State.Changed:Connect(function(key)
		if panel.IsOpen and (key == "Cosmetics" or key == "StyleTokens" or key == "Pass") then
			tokensLabel.Text = string.format(Strings.ShopTokens, State.Get("StyleTokens") or 0)
			tabs:Select(current)
		end
	end)
end

function ShopPanel.Toggle()
	panel:Toggle()
end
function ShopPanel.Open()
	panel:Open()
end
function ShopPanel.Close()
	panel:Close()
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">Toast</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Notifiche brevi in alto al centro, con icona testuale per tipo (non solo colore).
local TweenService = game:GetService("TweenService")
local UI = require(script.Parent.UI)

local Toast = {}
local container
local ICONS = { info = "ℹ", success = "✔", warning = "⚠", error = "✖" }
local COLORS = { info = UI.Colors.Info, success = UI.Colors.Success, warning = UI.Colors.Accent, error = UI.Colors.Danger }

function Toast.Init(screenGui)
	container = UI.Frame(screenGui, { Name = "Toasts", BackgroundTransparency = 1, Size = UDim2.new(0, 460, 0, 300), Position = UDim2.new(0.5, 0, 0, 90), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 50 })
	UI.List(container, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
end

function Toast.Show(message, kind)
	if not container then
		return
	end
	kind = kind or "info"
	local f = UI.Frame(container, { BackgroundColor3 = UI.Colors.PanelDark, Size = UDim2.new(1, 0, 0, 52), ZIndex = 51, BackgroundTransparency = 1 })
	UI.Corner(f)
	UI.Stroke(f, COLORS[kind] or UI.Colors.Info, 2)
	local icon = UI.Label(f, ICONS[kind] or "ℹ", { Size = UDim2.fromOffset(40, 52), Position = UDim2.fromOffset(10, 0), TextSize = 24, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = COLORS[kind], ZIndex = 52, TextTransparency = 1 })
	local label = UI.Label(f, message, { Size = UDim2.new(1, -64, 1, 0), Position = UDim2.fromOffset(54, 0), TextColor3 = UI.Colors.TextOnDark, TextSize = 16, ZIndex = 52, TextTransparency = 1 })
	TweenService:Create(f, TweenInfo.new(0.2), { BackgroundTransparency = 0.08 }):Play()
	TweenService:Create(label, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()
	TweenService:Create(icon, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()
	task.delay(math.clamp(2.5 + #message / 30, 3, 7), function()
		TweenService:Create(f, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
		TweenService:Create(icon, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
		task.wait(0.32)
		f:Destroy()
	end)
	-- massimo 4 toast visibili
	local children = container:GetChildren()
	local frames = {}
	for _, c in ipairs(children) do
		if c:IsA("Frame") then
			table.insert(frames, c)
		end
	end
	while #frames > 4 do
		local oldest = table.remove(frames, 1)
		if oldest then
			oldest:Destroy()
		end
	end
end

return Toast
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	UI: costruttore di interfaccia con tema coerente. Pulsanti grandi, testo leggibile,
	indicazioni testuali oltre ai colori (accessibilità), animazioni leggere.
]]
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Theme = require(ReplicatedStorage.Shared.Theme)

local UI = {}
local C = Theme.Colors

local function apply(inst, props)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	return inst
end

function UI.Corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = radius or Theme.Corner
	c.Parent = parent
	return c
end

function UI.Stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or C.Stroke
	s.Thickness = thickness or Theme.StrokeThickness
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function UI.Padding(parent, all, h, v)
	local p = Instance.new("UIPadding")
	local ph = UDim.new(0, h or all or 8)
	local pv = UDim.new(0, v or all or 8)
	p.PaddingLeft, p.PaddingRight, p.PaddingTop, p.PaddingBottom = ph, ph, pv, pv
	p.Parent = parent
	return p
end

function UI.List(parent, direction, padding, align)
	local l = Instance.new("UIListLayout")
	l.FillDirection = direction or Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, padding or 8)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.HorizontalAlignment = align or Enum.HorizontalAlignment.Left
	l.Parent = parent
	return l
end

function UI.Grid(parent, cellSize, padding)
	local g = Instance.new("UIGridLayout")
	g.CellSize = cellSize or UDim2.fromOffset(150, 190)
	g.CellPadding = UDim2.fromOffset(padding or 10, padding or 10)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = parent
	return g
end

function UI.Gradient(parent, c1, c2, rotation)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

function UI.Frame(parent, props)
	local f = Instance.new("Frame")
	f.BackgroundColor3 = C.Panel
	f.BorderSizePixel = 0
	f.Size = UDim2.fromScale(1, 1)
	apply(f, props)
	f.Parent = parent
	return f
end

function UI.Label(parent, text, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Theme.FontBody
	l.TextColor3 = C.Text
	l.TextSize = Theme.TextSize.Body
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	l.RichText = true
	l.Size = UDim2.new(1, 0, 0, 24)
	l.Text = text or ""
	apply(l, props)
	l.Parent = parent
	return l
end

function UI.Title(parent, text, props)
	return UI.Label(parent, text, apply({ Font = Theme.Font, TextSize = Theme.TextSize.Header, Size = UDim2.new(1, 0, 0, 32) }, props))
end

-- Pulsante grande con stato hover/pressed. onClick riceve il pulsante.
function UI.Button(parent, text, onClick, props)
	props = props or {}
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BackgroundColor3 = props.Color or C.Info
	b.BorderSizePixel = 0
	b.Font = Theme.Font
	b.TextColor3 = props.TextColor or C.TextOnDark
	b.TextSize = props.TextSize or Theme.TextSize.Body
	b.TextWrapped = true
	b.Size = props.Size or UDim2.new(1, 0, 0, Theme.ButtonHeight)
	b.Text = text
	b.LayoutOrder = props.LayoutOrder or 0
	b.Position = props.Position or UDim2.new()
	b.AnchorPoint = props.AnchorPoint or Vector2.new()
	b.Visible = props.Visible ~= false
	b.Name = props.Name or "Button"
	UI.Corner(b, props.Corner or Theme.Corner)
	UI.Stroke(b, Color3.new(1, 1, 1), 1.5, 0.75)
	local base = b.BackgroundColor3
	local function tint(f)
		return Color3.new(math.clamp(base.R * f, 0, 1), math.clamp(base.G * f, 0, 1), math.clamp(base.B * f, 0, 1))
	end
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = tint(1.08) }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = base }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.08), { BackgroundColor3 = tint(0.9) }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.08), { BackgroundColor3 = base }):Play()
	end)
	if onClick then
		b.Activated:Connect(function()
			onClick(b)
		end)
	end
	b.Parent = parent
	-- permette di cambiare colore base da fuori
	b:SetAttribute("BaseColor", base)
	b:GetAttributeChangedSignal("BaseColor"):Connect(function()
		base = b:GetAttribute("BaseColor")
		b.BackgroundColor3 = base
	end)
	return b
end

function UI.SetButtonColor(b, color)
	b:SetAttribute("BaseColor", color)
end

function UI.SetEnabled(b, enabled)
	b.Active = enabled
	b.AutoButtonColor = false
	b.TextTransparency = enabled and 0 or 0.45
	b.BackgroundTransparency = enabled and 0 or 0.4
end

-- Pannello modale centrato con titolo e pulsante chiudi. Ritorna (panel, content)
function UI.Panel(parent, title, size)
	local overlay = UI.Frame(parent, { Name = "Overlay_" .. title, BackgroundColor3 = Color3.fromRGB(20, 30, 60), BackgroundTransparency = 0.45, Visible = false, ZIndex = 10 })
	local panel = UI.Frame(overlay, { Name = "Panel", Size = size or UDim2.new(0.86, 0, 0.84, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 11 })
	UI.Corner(panel, UDim.new(0, 20))
	UI.Stroke(panel, C.Stroke, 3)
	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(1100, 720)
	sizeConstraint.Parent = panel
	local header = UI.Frame(panel, { Name = "Header", Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = C.PanelAlt, ZIndex = 12 })
	UI.Corner(header, UDim.new(0, 20))
	local headerFix = UI.Frame(header, { Size = UDim2.new(1, 0, 0.5, 0), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = C.PanelAlt, ZIndex = 12 })
	UI.Label(header, title, { Font = Theme.Font, TextSize = Theme.TextSize.Title, Size = UDim2.new(1, -140, 1, 0), Position = UDim2.fromOffset(20, 0), ZIndex = 13 })
	local close = UI.Button(header, "✕", nil, { Size = UDim2.fromOffset(44, 44), Position = UDim2.new(1, -52, 0.5, -22), Color = C.Danger, Name = "Close", Corner = UDim.new(0, 12) })
	close.ZIndex = 13
	local content = UI.Frame(panel, { Name = "Content", Size = UDim2.new(1, -24, 1, -72), Position = UDim2.fromOffset(12, 64), BackgroundTransparency = 1, ZIndex = 12 })
	local api = { Overlay = overlay, Panel = panel, Content = content, CloseButton = close, Header = header, IsOpen = false }
	function api:Open()
		if self.IsOpen then
			return
		end
		self.IsOpen = true
		overlay.Visible = true
		panel.Size = UDim2.new((size or UDim2.new(0.86, 0, 0.84, 0)).X.Scale * 0.92, 0, (size or UDim2.new(0.86, 0, 0.84, 0)).Y.Scale * 0.92, 0)
		overlay.BackgroundTransparency = 1
		TweenService:Create(overlay, TweenInfo.new(0.18), { BackgroundTransparency = 0.45 }):Play()
		TweenService:Create(panel, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = size or UDim2.new(0.86, 0, 0.84, 0) }):Play()
		if self.OnOpen then
			self.OnOpen()
		end
	end
	function api:Close()
		if not self.IsOpen then
			return
		end
		self.IsOpen = false
		overlay.Visible = false
		if self.OnClose then
			self.OnClose()
		end
	end
	function api:Toggle()
		if self.IsOpen then
			self:Close()
		else
			self:Open()
		end
	end
	close.Activated:Connect(function()
		api:Close()
	end)
	-- click sullo sfondo chiude
	local bgButton = Instance.new("TextButton")
	bgButton.BackgroundTransparency = 1
	bgButton.Text = ""
	bgButton.Size = UDim2.fromScale(1, 1)
	bgButton.ZIndex = 10
	bgButton.Parent = overlay
	bgButton.Activated:Connect(function()
		api:Close()
	end)
	headerFix.ZIndex = 12
	return api
end

function UI.Scroll(parent, props)
	local s = Instance.new("ScrollingFrame")
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.Size = UDim2.fromScale(1, 1)
	s.CanvasSize = UDim2.new()
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.ScrollBarThickness = 8
	s.ScrollBarImageColor3 = C.Stroke
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	s.ZIndex = 12
	apply(s, props)
	s.Parent = parent
	return s
end

-- Card con bordo e sfondo
function UI.Card(parent, props)
	local f = UI.Frame(parent, apply({ BackgroundColor3 = C.PanelAlt, Size = UDim2.new(1, 0, 0, 90), ZIndex = 12 }, props))
	UI.Corner(f, Theme.Corner)
	UI.Stroke(f, C.Stroke, 1.5, 0.5)
	return f
end

-- Barra di progresso con etichetta testuale
function UI.Progress(parent, props)
	local bg = UI.Frame(parent, apply({ BackgroundColor3 = Color3.fromRGB(210, 222, 240), Size = UDim2.new(1, 0, 0, 18), ZIndex = 12 }, props))
	UI.Corner(bg, UDim.new(1, 0))
	local fill = UI.Frame(bg, { Name = "Fill", BackgroundColor3 = (props and props.FillColor) or C.Success, Size = UDim2.fromScale(0, 1), ZIndex = 13 })
	UI.Corner(fill, UDim.new(1, 0))
	local label = UI.Label(bg, "", { Font = Theme.FontBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 14, TextColor3 = C.Text })
	local api = { Frame = bg }
	function api:Set(value, max, text)
		local frac = max > 0 and math.clamp(value / max, 0, 1) or 0
		TweenService:Create(fill, TweenInfo.new(0.25), { Size = UDim2.fromScale(frac, 1) }):Play()
		label.Text = text or string.format("%d / %d", value, max)
	end
	return api
end

-- Interruttore con testo "Attivo/Spento" (accessibilità: non solo colore)
function UI.Toggle(parent, text, initial, onChange, layoutOrder)
	local row = UI.Frame(parent, { BackgroundColor3 = C.PanelAlt, Size = UDim2.new(1, 0, 0, 56), ZIndex = 12, LayoutOrder = layoutOrder or 0 })
	UI.Corner(row)
	UI.Label(row, text, { Size = UDim2.new(1, -150, 1, 0), Position = UDim2.fromOffset(14, 0), ZIndex = 13 })
	local value = initial == true
	local btn
	local function render()
		btn.Text = value and "● Attivo" or "○ Spento"
		UI.SetButtonColor(btn, value and C.Success or C.TextMuted)
	end
	btn = UI.Button(row, "", function()
		value = not value
		render()
		onChange(value)
	end, { Size = UDim2.fromOffset(120, 40), Position = UDim2.new(1, -132, 0.5, -20), Color = C.Success })
	btn.ZIndex = 13
	render()
	local api = { Row = row }
	function api:Set(v)
		value = v == true
		render()
	end
	return api
end

-- Anteprima 3D di un modello in un ViewportFrame (ruota lentamente)
local viewports = {}
function UI.Viewport(parent, model, props)
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundColor3 = (props and props.BackgroundColor3) or Color3.fromRGB(222, 236, 255)
	vp.BackgroundTransparency = (props and props.BackgroundTransparency) or 0
	vp.BorderSizePixel = 0
	vp.Size = (props and props.Size) or UDim2.fromScale(1, 1)
	vp.Position = (props and props.Position) or UDim2.new()
	vp.Ambient = Color3.fromRGB(180, 190, 220)
	vp.LightColor = Color3.fromRGB(255, 250, 240)
	vp.LightDirection = Vector3.new(-1, -2, -1)
	vp.ZIndex = (props and props.ZIndex) or 13
	UI.Corner(vp, Theme.CornerSmall)
	local cam = Instance.new("Camera")
	cam.Parent = vp
	vp.CurrentCamera = cam
	local world = Instance.new("WorldModel")
	world.Parent = vp
	if model then
		model.Parent = world
		local cf, size = model:GetBoundingBox()
		local radius = math.max(size.X, size.Y, size.Z) * ((props and props.Zoom) or 1.15) + 1
		local entry = { Camera = cam, Center = cf.Position, Radius = radius, Angle = math.random() * math.pi * 2, Frame = vp }
		table.insert(viewports, entry)
		cam.CFrame = CFrame.lookAt(entry.Center + Vector3.new(math.cos(entry.Angle) * radius, radius * 0.45, math.sin(entry.Angle) * radius), entry.Center)
	end
	vp.Parent = parent
	return vp
end

RunService.RenderStepped:Connect(function(dt)
	for i = #viewports, 1, -1 do
		local v = viewports[i]
		if not v.Frame.Parent then
			table.remove(viewports, i)
		elseif v.Frame.Visible and v.Frame.AbsoluteSize.X > 0 then
			v.Angle += dt * 0.6
			v.Camera.CFrame = CFrame.lookAt(v.Center + Vector3.new(math.cos(v.Angle) * v.Radius, v.Radius * 0.45, math.sin(v.Angle) * v.Radius), v.Center)
		end
	end
end)

-- Testo con "pillola" colorata (es. rarità) — colore + testo
function UI.Pill(parent, text, color, props)
	local f = UI.Frame(parent, apply({ BackgroundColor3 = color, Size = UDim2.fromOffset(90, 22), ZIndex = 13 }, props))
	UI.Corner(f, UDim.new(1, 0))
	UI.Label(f, text, { Font = Theme.FontBold, TextSize = 12, TextColor3 = Color3.new(1, 1, 1), TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 14 })
	return f
end

function UI.TextBox(parent, placeholder, props)
	local t = Instance.new("TextBox")
	t.BackgroundColor3 = Color3.new(1, 1, 1)
	t.BorderSizePixel = 0
	t.Font = Theme.FontBody
	t.TextSize = Theme.TextSize.Body
	t.TextColor3 = C.Text
	t.PlaceholderText = placeholder or ""
	t.PlaceholderColor3 = C.TextMuted
	t.Text = ""
	t.ClearTextOnFocus = false
	t.Size = UDim2.new(1, 0, 0, 44)
	t.ZIndex = 13
	apply(t, props)
	UI.Corner(t, Theme.CornerSmall)
	UI.Stroke(t, C.Stroke, 1.5)
	t.Parent = parent
	return t
end

-- Tab bar: ritorna api:Select(name); onSelect(name)
function UI.Tabs(parent, names, onSelect, props)
	local bar = UI.Frame(parent, apply({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), ZIndex = 12 }, props))
	UI.List(bar, Enum.FillDirection.Horizontal, 8)
	local buttons = {}
	local api = {}
	function api:Select(name)
		for n, b in pairs(buttons) do
			UI.SetButtonColor(b, n == name and C.Info or C.TextMuted)
		end
		onSelect(name)
	end
	for i, n in ipairs(names) do
		local label = type(n) == "table" and n.Label or n
		local id = type(n) == "table" and n.Id or n
		buttons[id] = UI.Button(bar, label, function()
			api:Select(id)
		end, { Size = UDim2.new(1 / #names, -8, 1, 0), Color = C.TextMuted, LayoutOrder = i, TextSize = 16 })
		buttons[id].ZIndex = 13
	end
	return api
end

UI.Colors = C
UI.Theme = Theme
return UI
]]></string>
