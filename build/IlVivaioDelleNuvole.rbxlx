          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!nonstrict
local Format = {}

function Format.Number(n)
	n = math.floor(n + 0.5)
	if n >= 1_000_000 then
		return string.format("%.1fM", n / 1_000_000)
	elseif n >= 10_000 then
		return string.format("%.1fk", n / 1000)
	end
	-- separatore migliaia con punto (stile italiano)
	local s = tostring(n)
	local formatted = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	if formatted:sub(1, 1) == "." then
		formatted = formatted:sub(2)
	end
	return formatted
end

function Format.Time(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	end
	return string.format("%d:%02d", m, s)
end

function Format.Percent(x)
	return string.format("%d%%", math.floor(x * 100 + 0.5))
end

function Format.Stars(n, max)
	max = max or 5
	local s = ""
	for i = 1, max do
		s ..= (i <= n) and "●" or "○"
	end
	return s
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">GridUtil</string>
            <string name="Source"><![CDATA[--!nonstrict
local Config = require(script.Parent.Parent.Config)

local GridUtil = {}
local G = Config.Grid

function GridUtil.InBounds(x, z)
	return x >= 0 and z >= 0 and x < G.Size and z < G.Size
end

function GridUtil.Key(x, z)
	return x .. "," .. z
end

function GridUtil.FromKey(key)
	local x, z = key:match("^(%-?%d+),(%-?%d+)$")
	return tonumber(x), tonumber(z)
end

-- Centro di una cella in coordinate locali del plot (origine = centro del plot)
function GridUtil.CellToLocal(x, z, y)
	local half = G.Size * G.CellSize / 2
	return Vector3.new((x + 0.5) * G.CellSize - half, y or 0, (z + 0.5) * G.CellSize - half)
end

function GridUtil.CellToWorld(origin: CFrame, x, z, y)
	return origin:PointToWorldSpace(GridUtil.CellToLocal(x, z, y))
end

function GridUtil.WorldToCell(origin: CFrame, worldPos: Vector3)
	local localPos = origin:PointToObjectSpace(worldPos)
	local half = G.Size * G.CellSize / 2
	local x = math.floor((localPos.X + half) / G.CellSize)
	local z = math.floor((localPos.Z + half) / G.CellSize)
	return x, z
end

-- Ruota un footprint (lista di {dx,dz}) di rot*90° in senso orario
function GridUtil.RotateFootprint(footprint, rot)
	rot = (rot or 0) % 4
	local out = {}
	for _, cell in ipairs(footprint) do
		local dx, dz = cell[1], cell[2]
		for _ = 1, rot do
			dx, dz = -dz, dx
		end
		table.insert(out, { dx, dz })
	end
	return out
end

-- Celle occupate da un modulo con footprint, posizione e rotazione
function GridUtil.ModuleCells(footprint, cx, cz, rot)
	local out = {}
	for _, d in ipairs(GridUtil.RotateFootprint(footprint, rot)) do
		table.insert(out, { x = cx + d[1], z = cz + d[2] })
	end
	return out
end

function GridUtil.ReservedSet()
	local set = {}
	for _, list in ipairs({ G.EntranceCells, G.ExitCells, G.PozzaCells }) do
		for _, c in ipairs(list) do
			set[GridUtil.Key(c.x, c.z)] = true
		end
	end
	return set
end

return GridUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Accesso ai remoti lato client/server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local RemoteList = require(script.Parent.Parent.Remotes)

local Net = {}
local folder

local function getFolder()
	if folder then
		return folder
	end
	if RunService:IsServer() then
		folder = ReplicatedStorage:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			for _, name in ipairs(RemoteList.Events) do
				local ev = Instance.new("RemoteEvent")
				ev.Name = name
				ev.Parent = folder
			end
			for _, name in ipairs(RemoteList.Functions) do
				local fn = Instance.new("RemoteFunction")
				fn.Name = name
				fn.Parent = folder
			end
			folder.Parent = ReplicatedStorage
		end
	else
		folder = ReplicatedStorage:WaitForChild("Remotes")
	end
	return folder
end

function Net.Event(name): RemoteEvent
	local f = getFolder()
	local r = RunService:IsServer() and f:FindFirstChild(name) or f:WaitForChild(name)
	assert(r, "Remote event mancante: " .. name)
	return r
end

function Net.Function(name): RemoteFunction
	local f = getFolder()
	local r = RunService:IsServer() and f:FindFirstChild(name) or f:WaitForChild(name)
	assert(r, "Remote function mancante: " .. name)
	return r
end

-- Client: invoca con pcall e timeout morbido
function Net.Invoke(name, ...)
	local ok, a, b, c = pcall(function(...)
		return Net.Function(name):InvokeServer(...)
	end, ...)
	if not ok then
		warn("[Net] Invoke fallita", name, a)
		return false, "Errore di rete"
	end
	return a, b, c
end

function Net.Fire(name, ...)
	Net.Event(name):FireServer(...)
end

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Signal leggero (stile GoodSignal) senza dipendenze.
local Signal = {}
Signal.__index = Signal

local Connection = {}
Connection.__index = Connection

function Connection.new(signal, fn)
	return setmetatable({ _signal = signal, _fn = fn, Connected = true }, Connection)
end

function Connection:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false
	local list = self._signal._handlers
	for i = #list, 1, -1 do
		if list[i] == self then
			table.remove(list, i)
			break
		end
	end
end
Connection.Destroy = Connection.Disconnect

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local conn = Connection.new(self, fn)
	table.insert(self._handlers, conn)
	return conn
end

function Signal:Once(fn)
	local conn
	conn = self:Connect(function(...)
		conn:Disconnect()
		fn(...)
	end)
	return conn
end

function Signal:Fire(...)
	local snapshot = table.clone(self._handlers)
	for _, conn in ipairs(snapshot) do
		if conn.Connected then
			task.spawn(conn._fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for _, conn in ipairs(self._handlers) do
		conn.Connected = false
	end
	table.clear(self._handlers)
end
Signal.Destroy = Signal.DisconnectAll

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">TableUtil</string>
            <string name="Source"><![CDATA[--!nonstrict
local TableUtil = {}

function TableUtil.DeepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local out = {}
	for k, v in pairs(t) do
		out[k] = TableUtil.DeepCopy(v)
	end
	return out
end

-- Aggiunge le chiavi mancanti del template al target (ricorsivo), senza sovrascrivere i valori esistenti.
function TableUtil.Reconcile(target, template)
	for k, v in pairs(template) do
		if target[k] == nil then
			target[k] = TableUtil.DeepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" and not TableUtil.IsArray(v) then
			TableUtil.Reconcile(target[k], v)
		end
	end
	return target
end

function TableUtil.IsArray(t)
	if type(t) ~= "table" then
		return false
	end
	local n = #t
	if n == 0 then
		return next(t) == nil
	end
	return next(t, n) == nil
end

function TableUtil.Count(t)
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

function TableUtil.Keys(t)
	local out = {}
	for k in pairs(t) do
		table.insert(out, k)
	end
	return out
end

function TableUtil.Values(t)
	local out = {}
	for _, v in pairs(t) do
		table.insert(out, v)
	end
	return out
end

function TableUtil.Find(t, predicate)
	for k, v in pairs(t) do
		if predicate(v, k) then
			return v, k
		end
	end
	return nil
end

function TableUtil.Filter(t, predicate)
	local out = {}
	for _, v in ipairs(t) do
		if predicate(v) then
			table.insert(out, v)
		end
	end
	return out
end

function TableUtil.Map(t, fn)
	local out = {}
	for i, v in ipairs(t) do
		out[i] = fn(v, i)
	end
	return out
end

-- Shuffle deterministico con Random fornito
function TableUtil.Shuffle(t, rng)
	rng = rng or Random.new()
	for i = #t, 2, -1 do
		local j = rng:NextInteger(1, i)
		t[i], t[j] = t[j], t[i]
	end
	return t
end

function TableUtil.Truncate(list, maxLen)
	while #list > maxLen do
		table.remove(list, 1)
	end
	return list
end

return TableUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">TimeUtil</string>
            <string name="Source"><![CDATA[--!nonstrict
local TimeUtil = {}

-- Chiave del giorno UTC (es. "2026-10-07"); le commissioni si rinnovano a mezzanotte UTC.
function TimeUtil.DayKey(t)
	t = t or os.time()
	return os.date("!%Y-%m-%d", t)
end

function TimeUtil.SecondsToNextDay(t)
	t = t or os.time()
	local d = os.date("!*t", t)
	local elapsed = d.hour * 3600 + d.min * 60 + d.sec
	return 86400 - elapsed
end

-- Numero della settimana (dal lunedì) usato per i temi settimanali
function TimeUtil.WeekIndex(t)
	t = t or os.time()
	-- 1970-01-01 era un giovedì; spostiamo di 3 giorni per allineare al lunedì
	return math.floor((t + 3 * 86400) / (7 * 86400))
end

function TimeUtil.SecondsToNextWeek(t)
	t = t or os.time()
	local weekStart = (TimeUtil.WeekIndex(t) * 7 * 86400) - 3 * 86400
	return weekStart + 7 * 86400 - t
end

-- Hash deterministico (FNV-1a) di una stringa → intero positivo, per semi riproducibili
function TimeUtil.Hash(str)
	local h = 2166136261
	for i = 1, #str do
		h = bit32.bxor(h, string.byte(str, i))
		h = (h * 16777619) % 4294967296
	end
	return h
end

return TimeUtil
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
