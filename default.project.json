{
  "name": "IlVivaioDelleNuvole",
  "globIgnorePaths": ["**/*.md"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": { "$path": "src/Shared" }
    },

    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$path": "src/ReplicatedFirst"
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": { "$path": "src/Server" }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CharacterWalkSpeed": 18,
        "CharacterJumpHeight": 8.5,
        "CameraMaxZoomDistance": 60,
        "CameraMinZoomDistance": 4,
        "EnableMouseLockOption": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": { "$path": "src/Client" }
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false,
        "ScreenOrientation": "LandscapeSensor"
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": false,
        "Gravity": 150
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "ClockTime": 13.5,
        "Brightness": 2.4,
        "Ambient": [0.56, 0.63, 0.78],
        "OutdoorAmbient": [0.55, 0.65, 0.85],
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.6,
        "GlobalShadows": true,
        "ShadowSoftness": 0.35,
        "FogEnd": 2200,
        "FogStart": 900,
        "FogColor": [0.84, 0.9, 1]
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true,
        "AmbientReverb": "Mountains"
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 2
      }
    }
  }
}
